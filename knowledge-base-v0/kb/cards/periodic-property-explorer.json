  "app": {
    "title": "Periodic table property explorer",
    "summary": "A person chooses one element property and reads its trend across a periodic table, where each cell is coloured by the value and carries a bar starting at zero, with hover giving the number and its place on a scale under the table. They click elements to pin them into a side panel that keeps the latest pin's values and its rank for each property, and lists all pinned elements in a table sorted by the chosen property. With two or more pinned, the panel also gives the difference in one property between the last two; the pins and the chosen property are remembered between visits.",
    "task": {
      "text": "Compare chosen elements on a few physical properties and see where each sits in the trend across the periodic table.",
      "verbs": [
        "compare",
        "lookup",
        "explore",
        "derive"
      ]
    },
    "data": {
      "text": "A fixed set of elements, each with a few numeric properties, some of which are missing for some elements.",
      "item": "an element on the periodic table with its property values",
      "shapes": [
        "per element",
        "table"
      ]
    },
    "stage": {
      "text": "exploring reference values and comparing items while reasoning about a result or teaching it",
      "terms": [
        "explore",
        "compare"
      ]
    },
    "mechanism": {
      "text": "A periodic-table grid is coloured and barred by the property picked in a switch, with hover showing a tooltip and moving a marker along the colour legend. Clicking a cell pins it into a side panel, which shows the newest pin in detail with ranks and all pins in a comparison table sorted by the chosen property, and outlines the pinned cells back on the grid.",
      "views": [
        "fixed-layout grid",
        "heatmap",
        "detail panel",
        "table view",
        "legend"
      ],
      "interactions": [
        "hover for detail",
        "select",
        "multi-select",
        "toggle view",
        "sort"
      ],
      "patterns": [
        "overview and detail",
        "linked views",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "food science, mineral fortification of plant-based drinks",
      "disciplines": [
        "food science"
      ],
      "terms": [
        "mineral fortification",
        "periodic trends",
        "mineral binding"
      ]
    },
    "workflow": {
      "name": "colour a fixed layout by a chosen property and compare the items picked from it",
      "steps": [
        {
          "step": "look over every item at a glance",
          "here": "Elements H to Xe sit in their periodic-table places; each cell is coloured on one blue scale from the lowest to the highest value and carries a small bar starting at zero, elements with no value are left blank with a dashed outline, and a scale under the table gives the minimum, maximum and units.",
          "parts": [
            "periodic-table",
            "colour-legend"
          ]
        },
        {
          "step": "switch which value the overview shows",
          "here": "A three-way switch changes the property between Pauling electronegativity, atomic radius and first ionization energy; the colours, bars, scale and the order of the pinned table follow, and the choice is remembered.",
          "parts": [
            "property-switch"
          ]
        },
        {
          "step": "point at an item to read its value",
          "here": "Hovering a cell shows a tooltip with the element and its value, and moves a marker to that value on the scale under the table.",
          "parts": [
            "hover-tooltip",
            "colour-legend"
          ]
        },
        {
          "step": "pick out items to keep at hand",
          "here": "Clicking a cell pins it to the side panel and outlines it on the table; clicking it again unpins it, Unpin all clears the panel, and the pins are kept between visits.",
          "parts": [
            "periodic-table",
            "pin-panel"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "The last pinned element, or one brought up from the pinned table, shows its group, period and all three values, each with its rank among the elements, put as nth highest or nth lowest by which half it falls in.",
          "parts": [
            "pinned-detail"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "With two or more pinned, a table lists them with all three properties as columns, highest first by the chosen property, and each row can be brought into the detail card or unpinned.",
          "parts": [
            "compare-table"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Under the pinned table the electronegativity difference between the last two pinned is stated, or the panel says which of them has no Pauling value.",
          "parts": [
            "compare-table"
          ]
        }
      ],
      "distinctive": [
        "Each cell has a bar starting at zero beside its colour, so a trend along a row can be read without trusting the colour alone.",
        "Elements with no value for a property are left blank and listed under the scale, never drawn as zero.",
        "Ranks are worded as nth highest or nth lowest depending on which half of the elements the value falls in.",
        "The electronegativity difference between two pinned elements is given, as a guide to how ionic a bond between them is.",
        "The pinned table keeps all three properties whichever one colours the table."
      ]
    }
  },
