  "app": {
    "title": "Periodic table property explorer",
    "summary": "A person picks one element property to colour a periodic table by, and reads the trend across groups and periods from the cell colours, a bar in each cell and a colour scale. Hovering an element shows its value and marks where it falls on the scale. Clicking elements pins them to a side panel that gives the latest one's full values with its rank among all elements, and sets every pinned element in a comparison table sorted by the chosen property. Pins and the chosen property are kept between visits.",
    "task": {
      "text": "See how a property varies across the periodic table and compare chosen elements on it, with each element's rank.",
      "verbs": [
        "compare",
        "lookup",
        "explore",
        "identify"
      ]
    },
    "data": {
      "text": "A built-in table of elements with a few numeric atomic properties each, some missing, placed on the periodic table by atomic number.",
      "item": "a chemical element with its atomic number, group, period and property values",
      "shapes": [
        "per element",
        "table"
      ]
    },
    "stage": {
      "text": "exploring how atomic properties trend across the periodic table and comparing chosen elements",
      "terms": [
        "explore",
        "compare"
      ]
    },
    "mechanism": {
      "text": "A property switch recolours a fixed-layout periodic table on a sequential scale, with a legend whose marker follows the hovered element; clicking a cell pins it, and the pinned panel shows the latest pin in detail and all pins in a comparison table that highlights the chosen property.",
      "views": [
        "fixed-layout grid",
        "heatmap",
        "detail panel",
        "table view"
      ],
      "interactions": [
        "toggle view",
        "hover for detail",
        "select",
        "multi-select",
        "sort"
      ],
      "patterns": [
        "overview and detail",
        "linked views",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "periodic trends in atomic properties, in chemistry",
      "disciplines": [
        "chemistry"
      ],
      "terms": [
        "chemistry",
        "periodic trends"
      ]
    },
    "workflow": {
      "name": "colour a fixed layout by one value at a time and compare chosen items",
      "steps": [
        {
          "step": "choose which value to show",
          "here": "a three-button switch picks electronegativity, atomic radius or first ionization energy; the table, legend and panel all redraw",
          "parts": [
            "property-switch"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "each element sits at its group and period, coloured light-to-dark blue from lowest to highest value, with its value printed and a bar from zero; elements with no value are dashed and listed under the legend",
          "parts": [
            "periodic-table",
            "scale-legend"
          ]
        },
        {
          "step": "read one item's value and where it falls",
          "here": "hovering or focusing a cell shows a tooltip with its value and unit and moves a marker along the colour scale to that value",
          "parts": [
            "hover-tooltip",
            "scale-legend"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "clicking a cell pins it; the panel shows the latest pin's symbol, name, Z, group, period and all three values, each with its rank (nth highest or lowest of n)",
          "parts": [
            "pin-panel",
            "element-detail"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "with two or more pinned, a table lists them sorted highest-first by the chosen property, with that column highlighted, plus the electronegativity difference of the last two pinned",
          "parts": [
            "compare-table"
          ]
        },
        {
          "step": "adjust the selection",
          "here": "a symbol in the table brings that element to the detail card; Unpin removes one and Unpin all clears the panel; pins and the chosen property are saved in the browser",
          "parts": [
            "compare-table",
            "pin-panel"
          ]
        }
      ],
      "distinctive": [
        "items are placed by period and group computed from atomic number, so the layout itself carries meaning",
        "each value is shown twice: colour scaled from lowest to highest, and a bar scaled from zero, so relative size is not exaggerated",
        "the detail card ranks the element among all elements for every property, not only the one shown",
        "the electronegativity difference between the last two pinned elements is computed, the quantity used to judge bond character",
        "missing values (noble gases with no Pauling value) are drawn distinctly and named under the legend"
      ]
    }
  },
