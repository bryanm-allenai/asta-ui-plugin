  },
  "app": {
    "title": "UglyMol agent viewer: a crystallographic model with its electron density, plus a reciprocal-lattice spin-off",
    "summary": "A person loads an atomic model, either a bundled sample, an altered test copy or their own file, and can add one or two density maps (the main map, then a difference map). They rotate, zoom and slab through the 3D scene and move the contour level of each map up or down in sigma steps. They double-click atoms to read their labels and step from residue to residue to check whether each part of the model is supported by the density. They can save the current view as a permalink. A companion page shows reciprocal-lattice points from a CSV or JSON file, coloured by lattice, and narrows them by resolution range and by lattice.",
    "task": {
      "text": "Check how well an atomic model fits its experimental density by inspecting residues against contoured maps in 3D.",
      "verbs": [
        "review",
        "explore",
        "identify",
        "locate",
        "lookup"
      ]
    },
    "data": {
      "text": "A 3D atomic model of a macromolecule in PDB format, together with gridded density maps over the unit cell (CCP4/MRC/DSN6), and optionally a list of reciprocal-lattice points with a lattice id.",
      "item": "an atom or residue of the model, seen inside the contoured density around it",
      "shapes": [
        "field",
        "hierarchy",
        "table"
      ]
    },
    "stage": {
      "text": "checking a refined model against its density after refinement, before accepting or depositing it",
      "terms": [
        "review",
        "confirm",
        "explore"
      ]
    },
    "mechanism": {
      "text": "A full-screen WebGL canvas draws the model and isosurface meshes of the density within a radius of the view centre, and these are recomputed as the person moves or changes the contour level. Keyboard shortcuts in the style of Coot change sigma level, styles, slab and residue, and a heads-up line reports each change or the atom that was picked.",
      "views": [
        "canvas",
        "detail panel",
        "form"
      ],
      "interactions": [
        "zoom and pan",
        "select",
        "keyboard shortcuts",
        "toggle view",
        "import",
        "filter",
        "export"
      ],
      "patterns": [
        "focus and context"
      ]
    },
    "field": {
      "text": "model-to-density validation in macromolecular X-ray crystallography",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "crystallography",
        "electron density",
        "structural biology"
      ]
    },
    "workflow": {
      "name": "inspect a 3D model against the measured volume it was fitted to",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Toolbar buttons load the original sample model, a test copy with an altered atom and a deleted atom, or a demo model with two maps from the network. File inputs take your own .pdb, and .map/.ccp4/.mrc/.dsn6 files, where a second map becomes the difference map.",
          "parts": [
            "load-toolbar"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Mouse drags rotate, zoom, pan and move the slab through the 3D scene. The keys s, l, t and w cycle the model, ligand, water and map styles, and u shows the unit-cell box.",
          "parts": [
            "structure-canvas"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "+/- moves the main map's contour level by 0.1 sigma and Shift +/- moves the difference map's. [ and ] change the radius around the centre where marching cubes rebuilds the mesh.",
          "parts": [
            "map-contouring"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "A double-click picks the nearest atom, draws a marker on it and writes its full label in the HUD. Space or Shift+Space recentres on the next or previous residue, and p jumps to the nearest Cα.",
          "parts": [
            "atom-pick-hud",
            "structure-canvas"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "In the reciprocal viewer, the arrow keys set the lower and upper resolution limits, and v cycles through all points, unindexed points or one lattice, to separate overlapping lattices.",
          "parts": [
            "reciprocal-viewer"
          ]
        },
        {
          "step": "export the result",
          "here": "Shift+P writes the current centre, eye position and zoom into the URL fragment as a permalink to copy. The help overlay (H) lists every shortcut.",
          "parts": [
            "permalink",
            "help-overlay"
          ]
        }
      ],
      "distinctive": [
        "Contour levels are set in multiples of the map's RMS (sigma), separately for the main map and the difference map, which is drawn with positive and negative contours.",
        "Density is meshed only inside a sphere around the view centre, and the mesh is rebuilt as the person moves, so large maps stay interactive.",
        "Controls copy a desktop modelling program (Coot), so the mouse and keys already feel familiar to people in the field.",
        "A bundled test model has one atom moved and one deleted on purpose, so the person can practise finding parts of the model that the density does not support.",
        "A companion view shows reciprocal-lattice points, filtered by resolution shell and by lattice id, to screen for split lattices."
      ]
    }
  },
