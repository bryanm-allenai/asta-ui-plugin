  "app": {
    "title": "PixelMap – Neuropixels Channelmap Generator",
    "summary": "The person picks a probe model and its recording settings: reference, gains and filter. They then build a set of recording sites on a drawing of the probe's shanks. They can apply a preset, type electrode ranges, upload an existing table, click single sites or drag one of five box tools. Each choice instantly marks the sites it blocks through shared hardware wiring. They can lay an activity survey from the rig and a brain-atlas region map over the probe to steer the choice, and undo or redo as they go. When the count reaches the probe's channel budget, they download the channel table, a PDF of the layout and a spike-sorter channel map, or copy a link that rebuilds the layout.",
    "task": {
      "text": "Design a valid set of recording sites for a high-density probe under its hardware wiring limits, guided by atlas anatomy and recorded activity, and export it as the acquisition table.",
      "verbs": [
        "plan",
        "locate",
        "identify",
        "derive"
      ]
    },
    "data": {
      "text": "A fixed layout of electrode sites on probe shanks with a wiring map that links sites sharing readout lines. It can be overlaid with one activity value per site from a survey file and with brain regions looked up in a 3D atlas volume along the probe's path.",
      "item": "an electrode site on a probe shank",
      "shapes": [
        "per element",
        "table",
        "field"
      ]
    },
    "stage": {
      "text": "planning which probe sites to record before or just after implantation, ahead of recording and spike sorting",
      "terms": [
        "plan"
      ]
    },
    "mechanism": {
      "text": "A tall plot of the probe's shanks colours every site as selected, blocked or available. Clicks and drag-box tools change the selection, and the blocked sites are recomputed from the wiring map each time. A survey heat bar and atlas region bands can be drawn beside the sites, and the locator slices and region legend in the side panel follow the probe position as it is edited. A counter tracks how close the selection is to the channel budget and unlocks the downloads when it is reached.",
      "views": [
        "fixed-layout grid",
        "heatmap",
        "form",
        "summary stats",
        "image viewer",
        "list"
      ],
      "interactions": [
        "select",
        "multi-select",
        "brush",
        "hover for detail",
        "zoom and pan",
        "import",
        "export",
        "undo",
        "keyboard shortcuts",
        "toggle view"
      ],
      "patterns": [
        "linked views",
        "focus and context"
      ]
    },
    "field": {
      "text": "channel-map design for Neuropixels extracellular electrophysiology in neuroscience",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "neuroscience",
        "extracellular electrophysiology",
        "neuropixels"
      ]
    },
    "workflow": {
      "name": "choose a subset of positions on a fixed layout under hardware limits and export the configuration",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Pick a probe group and part number, which loads its site positions and wiring map, then set reference, gains and filter. Optionally upload an existing .imro table to start from.",
          "parts": [
            "controls-panel",
            "selection-methods"
          ]
        },
        {
          "step": "select positions on the layout, with the conflicts shown",
          "here": "Use a preset, a typed range like '1-5,7' on a chosen shank, a click on a site, or a drag box (select, deselect, zigzag, interleaved, deselect dependents). Selected sites turn red and the sites they block turn black.",
          "parts": [
            "probe-plot",
            "selection-methods"
          ]
        },
        {
          "step": "overlay measured activity per position",
          "here": "Load a survey .txt file (Shank, Xum, Zum, Val) to draw a viridis bar beside each site, with vmin and vmax editable to rescale the colours.",
          "parts": [
            "survey-overlay",
            "probe-plot"
          ]
        },
        {
          "step": "locate the layout in a reference space",
          "here": "Choose a brain atlas, enter the tip position (AP/ML/DV, optionally relative to bregma), pitch, yaw and shank orientation, then compute region bands behind the shanks, a three-slice locator, a region legend and the tip depth below the brain surface.",
          "parts": [
            "anatomy-overlay",
            "summary-panel"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "A counter shows selected over budget (384 or 1536) and turns green when the target is reached. Undo, redo and Ctrl/⌘+Z step through selection changes.",
          "parts": [
            "counter-undo"
          ]
        },
        {
          "step": "export the result",
          "here": "Download the .imro table, a PDF of the layout and a Kilosort channel map, optionally in the legacy IMRO format, or copy a shareable URL that encodes the whole configuration.",
          "parts": [
            "export-share"
          ]
        }
      ],
      "distinctive": [
        "Selecting a site makes other sites unavailable because they share readout lines or ADCs, and the interface works this out from a wiring map on every edit.",
        "A 'deselect dependents' box frees the blocked sites inside it by deselecting the sites elsewhere on the probe that block them.",
        "The selection has a fixed channel budget: box selection fills sites from the bottom of the leftmost shank upward and stops when the budget is full, and export unlocks only when the target count is reached.",
        "The probe is placed in a stereotaxic atlas with pitch, yaw, bregma offset and DV-squish calibration to predict the brain region at each site.",
        "An activity survey recorded on the same probe after implantation can be overlaid to favour active sites over white matter."
      ]
    }
  },
