  "app": {
    "title": "EchoMetrics — Carcass Ultrasound Analyzer",
    "summary": "A person picks individual or batch mode. In batch mode they enter a batch code first. They load an ultrasound image, which opens in a zoomable annotation window. There they click two points on the scale bar to calibrate one centimetre, place control points around the muscle cross-section to trace its outline, and click two points across the fat layer. The interface computes the muscle area and the fat thickness in real units and shows them beside the annotated image. In batch mode each image is saved as a numbered row, and the whole batch can be downloaded as an Excel sheet.",
    "task": {
      "text": "Measure an area and a thickness on each ultrasound image by calibrating its scale bar and tracing the structures by hand, and collect the measurements for a batch into a spreadsheet.",
      "verbs": [
        "derive",
        "annotate",
        "record"
      ]
    },
    "data": {
      "text": "B-mode ultrasound images that each include a scale bar, measured one at a time, and the table of measurements built up from them.",
      "item": "one ultrasound image of a cross-section",
      "shapes": [
        "image",
        "image collection",
        "table"
      ]
    },
    "stage": {
      "text": "measuring traits on ultrasound scans after imaging, before statistical analysis",
      "terms": [
        "analyze",
        "collect"
      ]
    },
    "mechanism": {
      "text": "Loading an image opens a modal canvas that walks the person through three fixed steps: a two-point calibration, a closed traced outline, and a two-point distance. Points can be zoomed, dragged and undone. Once the last point is placed, the server converts the pixel geometry to cm² and cm, the results panel shows the numbers, and the annotated image appears in the main view. In batch mode each result is added as a row for the Excel export.",
      "views": [
        "image viewer",
        "summary stats",
        "form"
      ],
      "interactions": [
        "import",
        "zoom and pan",
        "drag to arrange",
        "undo",
        "keyboard shortcuts",
        "export",
        "toggle view"
      ],
      "patterns": [
        "review queue"
      ]
    },
    "field": {
      "text": "ultrasound carcass trait measurement in animal science",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "animal science",
        "carcass ultrasound",
        "morphometry"
      ]
    },
    "workflow": {
      "name": "calibrate an image's scale and measure traced shapes on it, image by image",
      "steps": [
        {
          "step": "set up the session",
          "here": "Individual or Batch radio. Batch needs a batch code and Start Batch before you can upload, and each image is then numbered from that code.",
          "parts": [
            "controls-panel"
          ]
        },
        {
          "step": "bring the data in",
          "here": "A file input uploads one image, which is held in server memory, and opens the annotation modal.",
          "parts": [
            "controls-panel",
            "annotation-modal"
          ]
        },
        {
          "step": "calibrate the image scale",
          "here": "Two clicks on the scale bar mark exactly 1 cm, which sets pixels per cm.",
          "parts": [
            "annotation-modal"
          ]
        },
        {
          "step": "select a region and outline it",
          "here": "Clicked control points form a smooth closed contour around the muscle. Points can be dragged, and right-click or Backspace undoes the last one. Enter or Confirm Shape needs at least 3 points.",
          "parts": [
            "annotation-modal"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Two clicks across the fat layer. The server then works out the contour area in cm², the distance in cm and the calibration in px/cm.",
          "parts": [
            "annotation-modal",
            "results-panel"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "In batch mode each result is stored as the next coded row, and the instructions show how many images are saved and which code comes next.",
          "parts": [
            "controls-panel",
            "result-image"
          ]
        },
        {
          "step": "export the result",
          "here": "Download Excel sends the batch rows to the server, which returns <batch>_results.xlsx with columns Image, AOL (cm²) and EGS (cm).",
          "parts": [
            "controls-panel"
          ]
        }
      ],
      "distinctive": [
        "Every image is calibrated on its own from its 1 cm scale bar, so measurements stay in real units even when the image scale changes.",
        "The annotation follows a fixed order: calibration first, then the area outline, then the thickness line. Each step moves on by itself once its points are placed.",
        "The outline is drawn as a smooth curve through the control points and densely sampled before the area is computed.",
        "Images live only in server memory and are discarded after measurement. Batch rows build up in the browser until export."
      ]
    }
  },
