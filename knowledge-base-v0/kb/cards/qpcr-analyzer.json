  "app": {
    "title": "qPCR Analyzer",
    "summary": "A person uploads a well-level qPCR export and confirms which columns hold well, target, sample and Cq values, plus optional group and batch. They give each sample a biological group, and a batch if it came from more than one run. They set a replicate tolerance and check which wells are excluded as outliers, then choose one or more housekeeping genes. They run ΔCt and, optionally, batch-aware ΔΔCt against a reference group, which gives bar plots of relative expression per target and a workbook or CSV bundle they can download.",
    "task": {
      "text": "Turn raw qPCR cycle-threshold values into relative expression per sample, normalised to housekeeping genes and optionally to a reference group within each batch.",
      "verbs": [
        "derive",
        "clean",
        "compare",
        "summarize"
      ]
    },
    "data": {
      "text": "A table of qPCR wells, one row per well, giving the target gene, sample, Cq value and an optional group and batch, with technical replicates grouped by sample and target.",
      "item": "a well on a qPCR plate: one technical replicate of one target in one sample",
      "shapes": [
        "table",
        "categories"
      ]
    },
    "stage": {
      "text": "analysing instrument Cq exports into relative expression, after the plate run and its replicate check",
      "terms": [
        "analyze",
        "clean"
      ]
    },
    "mechanism": {
      "text": "A vertical stepper on the left takes the person through upload, mapping, grouping, outlier exclusion, housekeeping choice and the two calculations, and each Continue button stays disabled until the earlier steps are done. Tabs on the right update as data comes in: summary, data preview, excluded replicate blocks, housekeeping exclusions, per-target bar charts and downloads. Any change to an earlier step clears the stale results until the calculation is run again.",
      "views": [
        "form",
        "table view",
        "summary stats",
        "bar chart",
        "small multiples",
        "list"
      ],
      "interactions": [
        "import",
        "inline edit",
        "multi-select",
        "exclude and refit",
        "select",
        "toggle view",
        "hover for detail",
        "export"
      ],
      "patterns": [
        "status pipeline",
        "small multiples",
        "dashboard"
      ]
    },
    "field": {
      "text": "relative quantification of RT-qPCR gene expression (ΔCt / ΔΔCt) in molecular biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "molecular biology",
        "rt qpcr",
        "gene expression"
      ]
    },
    "workflow": {
      "name": "normalise replicate measurements to reference controls and compute relative values per group",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload an .xlsx, .xls, .csv, .tsv or .txt file. The header row is found automatically, and columns are matched by fuzzy name to Well, Target, Sample and Cq, plus optional Group and Batch, which the person confirms or reassigns.",
          "parts": [
            "setup-steps",
            "results-tabs"
          ]
        },
        {
          "step": "assign each item to a condition",
          "here": "Give each sample a biological group in an editable table. Optionally switch on multi-batch mode and assign batches; a check makes sure each sample belongs to exactly one group and one batch.",
          "parts": [
            "groups-batches"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "Set a replicate tolerance in cycles. Wells outside the tightest contiguous run of replicates, and wells with no Cq, are pre-selected for exclusion. The person can edit that list, and the excluded-blocks tab shows each replicate set.",
          "parts": [
            "outlier-review",
            "results-tabs"
          ]
        },
        {
          "step": "choose the reference measures to normalise against",
          "here": "Pick one or more housekeeping genes and review the samples that lack a usable housekeeping Cq, which are skipped for that gene only. Apply locks in the selection.",
          "parts": [
            "housekeeping"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Run ΔCt for each housekeeping gene, then optionally choose a reference group and run ΔΔCt, which anchors each batch on its own reference group. Each target gets a bar plot of mean ± SD relative expression with sample dots.",
          "parts": [
            "expression-charts"
          ]
        },
        {
          "step": "export the result",
          "here": "Download an Excel workbook or a zip of CSVs with the raw data, long-format ΔCt/ΔΔCt sheets and grouped wide tables, plus one combined PNG per housekeeping gene.",
          "parts": [
            "downloads"
          ]
        }
      ],
      "distinctive": [
        "ΔΔCt is batch-aware: each run is normalised to its own reference-group mean before the runs are merged, which removes run-to-run variation",
        "replicate outliers are flagged by keeping the tightest contiguous run of replicates within a tolerance in cycles, and missing Cq values are always flagged",
        "several housekeeping genes can be used at once, each giving its own result set, and a sample missing one housekeeping gene is skipped only for that gene",
        "changing any earlier step clears the plotted results and downloads so that exports never disagree with the settings on screen",
        "formatted export sheets are checked against the long-format source when they are built, and a mismatch raises an error"
      ]
    }
  },
