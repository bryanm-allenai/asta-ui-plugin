  "app": {
    "title": "FigureLab: multi-panel publication figure assembly",
    "summary": "A person drops a set of images into the tool and arranges them as panels in a rows-by-columns grid, or places them freely on a canvas. They crop, rotate and adjust each panel, set its calibration so a correct scale bar is drawn, and add panel letters, headings, arrows, insets and text. Before exporting they can measure regions, run consistency, exposure and journal-compliance checks, and generate a caption. The result is a figure file at a chosen physical width and DPI, in raster, vector or PDF form, along with a session file, settings metadata and reproducibility scripts.",
    "task": {
      "text": "Assemble a set of images into one labelled, calibrated, multi-panel figure that meets a journal's submission requirements, and export it.",
      "verbs": [
        "organize",
        "annotate",
        "review",
        "derive",
        "write"
      ]
    },
    "data": {
      "text": "A set of image files, mostly microscopy, gels or blots, each with its own calibration in physical units per pixel and its own display adjustments, plus annotations drawn over the assembled figure.",
      "item": "an image placed as one panel of a figure",
      "shapes": [
        "image collection",
        "image",
        "notes"
      ]
    },
    "stage": {
      "text": "assembling finished images into a figure for a manuscript, before submission",
      "terms": [
        "report",
        "review"
      ]
    },
    "mechanism": {
      "text": "A sidebar of collapsible sections (images, layout, style, annotate, export and checks) drives one rendered figure canvas. Each change re-renders the canvas, and the annotation layer above it takes drawing, selecting and dragging. A mini grid map shows which image sits in which cell. Checks, comparisons and measurements open in modals or in result panels inside the sidebar.",
      "views": [
        "canvas",
        "sidebar list",
        "form",
        "fixed-layout grid",
        "side-by-side panes",
        "summary stats",
        "line chart"
      ],
      "interactions": [
        "import",
        "drag to arrange",
        "inline edit",
        "select",
        "zoom and pan",
        "apply label",
        "write notes",
        "undo",
        "export",
        "keyboard shortcuts",
        "hover for detail"
      ],
      "patterns": [
        "master-detail",
        "rubric",
        "side-by-side comparison",
        "version history"
      ]
    },
    "field": {
      "text": "assembling publication figures from microscopy images in cell biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "microscopy",
        "figure assembly",
        "image processing"
      ]
    },
    "workflow": {
      "name": "assemble a set of images into a labelled multi-panel figure and export it",
      "steps": [
        {
          "step": "bring the data in",
          "here": "drag images or TIFF/LSM files onto the drop zone. Each one becomes a lettered panel, and any calibration embedded in the file is read in automatically",
          "parts": [
            "images-panel"
          ]
        },
        {
          "step": "arrange items into a layout",
          "here": "set rows, columns, panel size and gaps, or apply a journal layout template. Reorder panels by dragging the list handle or the panel on the canvas, and check placement on the mini grid map. A freeform mode adds align, distribute and snap",
          "parts": [
            "layout-panel",
            "images-panel",
            "figure-canvas"
          ]
        },
        {
          "step": "adjust and calibrate each item",
          "here": "for each panel, open its settings to crop in the crop editor, rotate or flip it, and change brightness, contrast, gamma and LUT. Set µm/px from an objective preset or by clicking two points in the calibration modal, then pick an automatic scale-bar length. Match scale across panels and copy one panel's settings to all the others",
          "parts": [
            "images-panel",
            "style-panel"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "choose an arrow, box, ellipse, text, inset, ruler or counter tool and draw on the canvas. Each annotation can be selected, moved and restyled from a floating toolbar and is listed in the sidebar, with undo and redo. Panel letters, headings and their fonts come from the style section",
          "parts": [
            "annotate-panel",
            "figure-canvas",
            "style-panel"
          ]
        },
        {
          "step": "check the result against criteria",
          "here": "check journal compliance, run a deep figure audit across panels (LUT and brightness consistency, calibration, font size) and an exposure analysis. Compare two panels side by side, and measure an ROI, a line profile or a thresholded cell count",
          "parts": [
            "check-panel"
          ]
        },
        {
          "step": "write up the result",
          "here": "generate a structured caption from each panel's notes and calibration, and keep figure notes alongside the session",
          "parts": [
            "export-panel"
          ]
        },
        {
          "step": "export the result",
          "here": "choose a file name and DPI, then export PNG, JPEG, WebP, TIFF, PDF, SVG or a multi-page PDF. Settings metadata can go out as CSV, the figure as R or Python scripts or a reproducibility log, and the whole session as JSON or a share link",
          "parts": [
            "export-panel",
            "figure-canvas"
          ]
        }
      ],
      "distinctive": [
        "scale bars are computed from each panel's physical calibration after cropping, so the bar stays true to the region actually shown",
        "exports are re-rendered at the true pixel count for the chosen DPI and printed width, and the resolution is written into the file itself",
        "an audit flags inconsistencies across panels (mismatched LUTs, brightness scaling, missing calibration, over-exposure) before submission",
        "the figure can be regenerated from its source files by exported R or Python scripts, and the adjustments are logged into the PNG"
      ]
    }
  },
