  "app": {
    "title": "ProtoFold-Lab",
    "summary": "A person pastes an amino-acid sequence and sets the parameters of a stochastic search: number of Monte Carlo steps, starting temperature, cooling rate and an optional random seed. The server checks the sequence and the parameter ranges. It then folds a coarse-grained chain by simulated annealing and keeps the lowest-energy conformation it finds. The person gets back a report page: headline structural metrics with a confidence band, a short interpretation, three diagnostic plots (the projected fold, a residue contact map and the energy trajectory), the run configuration, and a per-residue feature table. From there they can start another run.",
    "task": {
      "text": "Generate a coarse-grained structural hypothesis for one protein sequence and read its compactness, contact and stability diagnostics.",
      "verbs": [
        "derive",
        "explore",
        "summarize"
      ]
    },
    "data": {
      "text": "One amino-acid sequence as input. The output is a simulated 3D chain summarised as metrics, a residue-by-residue contact matrix, an energy value per optimisation step, and a per-residue feature table.",
      "item": "a residue in a protein sequence",
      "shapes": [
        "sequence",
        "table",
        "time series"
      ]
    },
    "stage": {
      "text": "exploring structural hypotheses for a new sequence, before atomistic modelling or experimental structure work",
      "terms": [
        "explore"
      ]
    },
    "mechanism": {
      "text": "A parameter form submits the sequence and the annealing settings to the server, which runs the simulation and renders a single report page. The page stacks number cards, a text summary, static plots of the fold, its contacts and its energy descent, the run settings and a residue table, all for that one run.",
      "views": [
        "form",
        "summary stats",
        "scatter plot",
        "heatmap",
        "line chart",
        "table view"
      ],
      "interactions": [
        "import"
      ],
      "patterns": [
        "dashboard"
      ]
    },
    "field": {
      "text": "coarse-grained protein structure prediction by Monte Carlo simulated annealing in structural bioinformatics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "structural bioinformatics",
        "coarse grained modelling",
        "protein folding"
      ]
    },
    "workflow": {
      "name": "run a parameterised simulation on one input and read its diagnostic report",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Paste a sequence in one-letter codes. As the person types, characters that are not amino acids are stripped and letters are uppercased. The server rejects sequences shorter than 8 residues or containing invalid codes.",
          "parts": [
            "run-form"
          ]
        },
        {
          "step": "set the parameters of the computation",
          "here": "Choose Monte Carlo steps (500–10000), initial temperature (0.5–5.0), cooling rate (0.990–0.9999) and an optional seed. Out-of-range values come back as an error banner above the form.",
          "parts": [
            "run-form"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "'Run structural exploration' starts a pivot-move simulated annealing run on a Cα-like chain and keeps the best-energy conformation. From it the run derives radius of gyration, contact density, a hydrophobic-core score, a 0–100 stability score with a confidence band, and a secondary-structure bias.",
          "parts": [
            "run-form",
            "metric-cards"
          ]
        },
        {
          "step": "read the summary numbers",
          "here": "Six stat cards show the headline metrics. An interpretation snapshot adds the fold bias, the accepted-move ratio, the non-local contact count and the method notes.",
          "parts": [
            "metric-cards",
            "interpretation-snapshot"
          ]
        },
        {
          "step": "inspect diagnostic plots",
          "here": "Three plots: the fold projected onto two principal components with points coloured by hydropathy, a residue contact map, and the energy across Monte Carlo steps.",
          "parts": [
            "diagnostic-plots"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "A per-residue table lists each residue's code, name, hydropathy, charge, distance from the centre and polarity class. Next to it, the run configuration records the settings and seed used, and 'Run another sequence' returns to the form.",
          "parts": [
            "residue-table",
            "results-report"
          ]
        }
      ],
      "distinctive": [
        "The energy is a hand-built heuristic with separate terms: a pseudo-bond length restraint, steric clashes, hydrophobic contact reward, electrostatics with salt bridges, a polar penalty and compactness.",
        "The stability score is mapped to named confidence bands, so each run ends in a qualitative verdict as well as numbers.",
        "The seed is recorded with the run (or marked 'randomized'), so that a stochastic result can be reproduced.",
        "The 3D chain is shown flat, through a principal-component projection coloured by residue hydropathy.",
        "Separate command-line scripts score the same method against experimental PDB structures (radius-of-gyration error, long-range contact F1, Kabsch-aligned Cα RMSD) next to an extended-chain baseline and external models."
      ]
    }
  },
