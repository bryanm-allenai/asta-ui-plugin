  "app": {
    "title": "Glycan Mass Spec Annotator",
    "summary": "A person pastes or loads a list of observed m/z peaks, with optional intensities. They set the most residues of each monosaccharide type a candidate may contain, then choose the ion species, the charge and a ppm tolerance. The tool lists every composition within those limits, computes each one's theoretical m/z, and gives every peak its candidate compositions ranked by ppm error, along with a summary of how many peaks matched. The person can export all matches as a CSV.",
    "task": {
      "text": "Annotate observed mass-spectrometry peaks with candidate glycan compositions whose theoretical m/z falls within a ppm tolerance, and export the matches.",
      "verbs": [
        "annotate",
        "derive",
        "identify",
        "summarize"
      ]
    },
    "data": {
      "text": "A peak list of observed m/z values with optional intensities, matched against candidate monosaccharide compositions enumerated within residue-count limits",
      "item": "an observed peak (m/z, with optional intensity) on a mass spectrum",
      "shapes": [
        "table"
      ]
    },
    "stage": {
      "text": "annotating peak lists from a glycan mass spectrum with candidate compositions, before structural confirmation",
      "terms": [
        "annotate",
        "analyze"
      ]
    },
    "mechanism": {
      "text": "A settings panel takes the peak list, the residue-count limits, the ion species, the charge and the ppm tolerance. One button enumerates the compositions, matches them to the peaks and fills a results table with a summary line, and the export button is disabled until that run has finished.",
      "views": [
        "form",
        "table view",
        "summary stats"
      ],
      "interactions": [
        "import",
        "export"
      ],
      "patterns": [
        "overview and detail"
      ]
    },
    "field": {
      "text": "composition matching of glycan mass spectra in glycomics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "glycomics",
        "mass spectrometry",
        "composition matching"
      ]
    },
    "workflow": {
      "name": "match observed values against an enumerated candidate list within a tolerance",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Paste m/z values, one per line or as CSV/TSV with an optional intensity column, or load a peak-list file. Load example fills in a known peak and runs the match.",
          "parts": [
            "peak-input"
          ]
        },
        {
          "step": "set the limits of the candidate space",
          "here": "Set the maximum number of Hex, HexNAc, Fuc, NeuAc and NeuGc residues (0–40 each). The search is capped at 50,000 combinations.",
          "parts": [
            "search-settings"
          ]
        },
        {
          "step": "set the matching conditions",
          "here": "Choose the ion species ([M+zH]z+, [M−zH]z−, [M+Na]+), the charge 1–5 (fixed at 1 for sodium) and the ppm tolerance.",
          "parts": [
            "search-settings"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Annotate peaks lists every composition, computes its monoisotopic neutral mass (including water) and its m/z, and uses binary search to find the candidates within tolerance of each peak.",
          "parts": [
            "search-settings",
            "results-table"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The table shows each peak with up to 20 matches ranked by absolute ppm error, or 'No match'. A summary line counts the peaks, the peaks with matches, the compositions searched and the total matches.",
          "parts": [
            "results-table",
            "results-summary"
          ]
        },
        {
          "step": "export the result",
          "here": "Export CSV downloads every peak with its top-ranked matches, neutral mass, theoretical m/z, ppm error and total match count.",
          "parts": [
            "export-button"
          ]
        }
      ],
      "distinctive": [
        "Candidates are generated by listing every combination of residue counts within the user's limits, with no reference library",
        "Theoretical m/z depends on the ion species and the charge, and sodium adducts are allowed only at charge 1",
        "Matching uses a relative ppm tolerance, and matches are ranked by absolute ppm error",
        "The interface warns that a composition match is not a structure identification, and that isomers can share the same m/z"
      ]
    }
  },
