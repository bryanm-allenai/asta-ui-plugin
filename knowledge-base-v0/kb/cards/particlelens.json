  "app": {
    "title": "ParticleLens",
    "summary": "A person opens a microscope image and sets its physical scale. They can let the tool find a scale bar in the lower-right corner, type a length per pixel, or draw a line across a scale of known length. They choose diameter limits and detection settings, adjust brightness, contrast and gamma in a live preview, and run automatic circle detection. They then check the circles on the image: they move or delete wrong ones, draw in missed ones by dragging across their diameter, and pick particles from the table. Last, they look at the count, mean, median and range and a size histogram with a cumulative line, and export a CSV of measurements and an annotated image.",
    "task": {
      "text": "Measure the diameters of roughly circular objects in a calibrated microscope image, correct the automatic detections by hand, and export the corrected size distribution.",
      "verbs": [
        "derive",
        "identify",
        "clean",
        "summarize",
        "annotate"
      ]
    },
    "data": {
      "text": "A single microscope image with a physical scale. Detection turns it into a table of fitted circles, each with a centre, radius, diameter in physical units, visible fraction and edge score.",
      "item": "a detected circular particle or droplet in the image",
      "shapes": [
        "image",
        "table"
      ]
    },
    "stage": {
      "text": "measuring particle sizes from raw micrographs, before comparing size distributions",
      "terms": [
        "analyze",
        "clean"
      ]
    },
    "mechanism": {
      "text": "A settings sidebar drives detection on a zoomable image canvas, where circles are drawn and edited with a tool rail and keyboard shortcuts. A results panel with tabs links a particle table, summary statistics and a histogram to the canvas, and a separate tab holds the export options.",
      "views": [
        "image viewer",
        "form",
        "table view",
        "summary stats",
        "bar chart",
        "line chart"
      ],
      "interactions": [
        "import",
        "select",
        "multi-select",
        "drag to arrange",
        "zoom and pan",
        "keyboard shortcuts",
        "exclude and refit",
        "toggle view",
        "export"
      ],
      "patterns": [
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "particle size analysis of microscope images by circle detection",
      "disciplines": [
        "materials science"
      ],
      "terms": [
        "particle size distribution",
        "droplet analysis",
        "microscopy"
      ]
    },
    "workflow": {
      "name": "detect objects in an image automatically, correct them by hand, and export measurements",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Open or drag in a microscope image. Run Detection stays disabled until an image is loaded and a scale is set.",
          "parts": [
            "image-canvas"
          ]
        },
        {
          "step": "calibrate the measurement scale",
          "here": "Enter a scale length and a length per pixel, rely on automatic lower-right scale-bar detection, or use the Redraw scale bar tool to draw across a bar of known length.",
          "parts": [
            "detection-settings",
            "edit-toolbar"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Set the minimum and maximum diameter, the sensitivity, the edge thresholds and the contour fit limits. Preview brightness, contrast, gamma and CLAHE or background correction, then run Hough and contour circle detection.",
          "parts": [
            "detection-settings",
            "image-adjustments"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "Select circles and drag or arrow-key them into place, delete false detections, and add missed particles by dragging across their diameter (shortcuts v, h, c, r and Delete). The statistics and histogram update after each edit.",
          "parts": [
            "edit-toolbar",
            "image-canvas"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Click a row in the data table to select that particle on the canvas. The table shows each particle's source, centre, radius, diameter and visible fraction.",
          "parts": [
            "results-table"
          ]
        },
        {
          "step": "summarize the distribution",
          "here": "Count, mean, median and range are computed over particles that are at least 50% visible. A histogram with an adjustable bin count shows a cumulative percentage line and can be shown as a floating overlay on the image.",
          "parts": [
            "results-table",
            "distribution-chart"
          ]
        },
        {
          "step": "export the result",
          "here": "Export the corrected measurements as CSV, an annotated PNG, or both. Options set how many particles get labels, whether to include the selection highlight, a scale bar and a legend, and an outer margin with its colour. The chart can be downloaded as a PNG.",
          "parts": [
            "export-panel",
            "distribution-chart"
          ]
        }
      ],
      "distinctive": [
        "Every measurement depends on a pixel-to-micron calibration, which can come from automatic scale-bar detection, a typed value or a line drawn by hand.",
        "Particles cut off by the image edge get a visible fraction, and only those at least half visible count toward the distribution.",
        "Detection combines a Hough circle pass with contour-based circle fitting and scores each circle by how much of its edge is supported.",
        "Image adjustments change only the preview and the input to detection; the source image is kept, and a press-and-hold control shows the original.",
        "Missed particles are added by dragging across their diameter, so the drawn line is itself a measurement."
      ]
    }
  },
