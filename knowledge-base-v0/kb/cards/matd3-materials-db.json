  "app": {
    "title": "MatD3 materials database (HybriD3)",
    "summary": "A staff contributor registers the publication, the material and any new property or unit, then fills in one data set. The data set holds descriptive fields, synthesis, experimental and computational details, and one or more subsets of pasted or file-loaded values, each subset under its own fixed conditions. The server parses the values, including uncertainty and bound notation, and stores them. Lattice constants with atomic coordinates and band-structure files get their own handling. Anyone can then search materials by formula, component, property, author, DOI or a band-gap range, open a material's page of data sets, view each one as a figure or a table, and compare two side by side. Contributors can verify, hide, delete or report a data set, download it as a zip, or publish it to get a DOI.",
    "task": {
      "text": "Enter published experimental and computational measurements of materials, with their provenance, into a shared public database where others can search, compare, verify and cite them.",
      "verbs": [
        "curate",
        "record",
        "lookup",
        "compare",
        "review"
      ]
    },
    "data": {
      "text": "A relational collection of materials. Each material has data sets of one physical property, tied to a publication, split into subsets under fixed conditions, and holding numerical values with errors and bounds, plus attached files and method details.",
      "item": "a data set: one property measured or computed for one material, from one publication",
      "shapes": [
        "table",
        "hierarchy",
        "notes"
      ]
    },
    "stage": {
      "text": "maintaining a shared database of published materials data after results are out",
      "terms": [
        "maintain"
      ]
    },
    "mechanism": {
      "text": "A long entry form, with side forms for new references, materials, properties and units, writes a data set that the server parses into subsets and values. A search form leads to a material's page listing its data sets, each drawn as a chart or a table, with buttons to compare, verify, hide, report, download or publish.",
      "views": [
        "form",
        "list",
        "detail panel",
        "line chart",
        "table view",
        "side-by-side panes"
      ],
      "interactions": [
        "import",
        "search",
        "filter",
        "select",
        "toggle view",
        "write notes",
        "export"
      ],
      "patterns": [
        "master-detail",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "curated experimental and computational property data for solid materials, especially hybrid organic-inorganic perovskites, in materials science",
      "disciplines": [
        "materials science"
      ],
      "terms": [
        "materials database",
        "hybrid perovskites",
        "dft"
      ]
    },
    "workflow": {
      "name": "enter measured values with their provenance into a shared database, then find, check and publish them",
      "steps": [
        {
          "step": "register the source and the item the values belong to",
          "here": "Side forms define a new reference (typed, or read from a RIS/BibTeX file, with its authors), a new material (formula, organic and inorganic components, IUPAC name, alternate names, derived systems), a new property or a new unit",
          "parts": [
            "new-entry-forms"
          ]
        },
        {
          "step": "bring the data in",
          "here": "The Add Data form picks the reference, material and properties, sets experimental or theoretical, the sample type and space group, and records synthesis, experimental and computational details (code, functional, k-point grid, basis set and so on)",
          "parts": [
            "add-data-form"
          ]
        },
        {
          "step": "enter the values group by group, each with its fixed conditions",
          "here": "Each numbered subset takes pasted or file-loaded values (x-y pairs when there are two axes), a crystal system, a label and fixed properties. Values written as <, >, ~, ± or 1.23(4) are parsed into a type, an error and an upper bound. Atomic structure takes lattice constants and coordinates, and band structure takes k-paths and band files",
          "parts": [
            "subset-entry"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Search materials by formula, physical property, organic or inorganic component, author or DOI, or by a band-gap range limited to experimental, computational or any",
          "parts": [
            "search-view"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "A material's page lists its data sets with the atomic structure first. Each draws as a chart or a table of subset values with its conditions, method details and linked data sets, and two data sets can be compared side by side",
          "parts": [
            "system-page"
          ]
        },
        {
          "step": "keep a record of changes",
          "here": "Contributors toggle public visibility or figure display, delete their own data sets, and mark data sets as verified. Anyone logged in can report an issue by email",
          "parts": [
            "dataset-controls"
          ]
        },
        {
          "step": "export the result",
          "here": "Download a data set's info file, input data and attachments as a zip, or upload it to Figshare to mint and publish a DOI",
          "parts": [
            "export-publish"
          ]
        }
      ],
      "distinctive": [
        "Values keep their uncertainty notation: bounds, approximations, ± and parenthesised errors are parsed into a value type, an error and an upper bound",
        "Each data set is split into subsets that each carry fixed conditions (fixed properties with units) and a crystal system, and these become the legend of the chart",
        "Every data set records whether it is experimental or computational, with the method details each kind needs (synthesis, experimental method, or code, functional, k-point grid, relativity and basis set)",
        "Some properties get special handling: atomic structure takes lattice constants and coordinates for a 3D viewer, and band structure is plotted from uploaded band files and a k-path",
        "Data sets can be verified by staff, linked to related data sets, and given a DOI through Figshare"
      ]
    }
  },
