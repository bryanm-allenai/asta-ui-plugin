  "app": {
    "title": "ΨDataViz (PsiDataViz): Scientific Data Visualization",
    "summary": "A person points the interface at a public lab data folder or repository, or picks one from a search of open data repositories, and scans it. The scan groups files that share a base name into datasets and reports them by technique and by compound, with a coverage report of which formats could not be read and why. The person picks a technique, filters the dataset table by sample, date or compound, and clicks rows to parse and overlay them on one plot, optionally normalised, alongside heatmaps, a 3D molecule view and the parsed metadata. For a single dataset they can check that its different file formats hold the same data. They then convert it to a standard format, or export the selection as a runnable notebook.",
    "task": {
      "text": "Find and read a lab's instrument data files across many formats, overlay and compare the datasets, and convert them to standard open formats.",
      "verbs": [
        "explore",
        "compare",
        "lookup",
        "summarize",
        "derive"
      ]
    },
    "data": {
      "text": "A folder or repository of raw instrument and computational output files in many vendor formats. Files that share a base name are collapsed into one dataset, and each dataset is parsed into 1D signals (spectra, thermograms, chromatograms), 2D maps or images, molecular structures or audio.",
      "item": "a dataset: one measurement saved in one or more file formats, with its technique, sample and date",
      "shapes": [
        "table",
        "spectra",
        "image",
        "media",
        "hierarchy"
      ]
    },
    "stage": {
      "text": "exploring raw instrument files in a shared lab folder, before analysis",
      "terms": [
        "explore"
      ]
    },
    "mechanism": {
      "text": "A scan of a source fills technique and compound chips and a coverage report. Choosing a technique fills a filterable dataset table, and each row clicked there is parsed and added to an overlay panel that sends each dataset to the right view: a line plot, heatmap or slice viewer, a 3D structure viewer or an audio player. Clicking a peak on a computed spectrum animates the matching vibrational mode in the 3D viewer, and a single selected dataset can be format-compared, converted or exported as a notebook.",
      "views": [
        "table view",
        "line chart",
        "heatmap",
        "image viewer",
        "summary stats",
        "3d structure viewer"
      ],
      "interactions": [
        "import",
        "search",
        "filter",
        "multi-select",
        "select",
        "toggle view",
        "hover for detail",
        "zoom and pan",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "linked views"
      ]
    },
    "field": {
      "text": "multi-technique instrument data (spectroscopy, diffraction, thermal analysis) in chemistry",
      "disciplines": [
        "chemistry"
      ],
      "terms": [
        "spectroscopy",
        "fair data"
      ]
    },
    "workflow": {
      "name": "catalogue a data folder, overlay chosen datasets and convert them to standard formats",
      "steps": [
        {
          "step": "bring the data in",
          "here": "paste a public GitHub, Codeberg, Google Drive or Box link, with an optional path keyword, or click a preset or a result from a search of open repositories, then Scan",
          "parts": [
            "source-picker"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "the scan reports how many datasets came from how many files, how the folder is organised, chips counting datasets per technique and per compound, and the percentage readable, with the unread formats and the reasons",
          "parts": [
            "scan-overview"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "click a technique chip to load its datasets into the table, then narrow by compound chip or by typing a sample or date",
          "parts": [
            "scan-overview",
            "dataset-table"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "clicking rows parses each dataset and overlays it on one plot, with a Normalize toggle and line or point modes; 2D data goes to heatmap tabs, and computed jobs show their molecule",
          "parts": [
            "dataset-table",
            "overlay-panel",
            "spectrum-plot",
            "structure-viewer"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "for one dataset saved in several formats, Compare formats parses each format and reports whether the data are identical, or lists the differences",
          "parts": [
            "format-compare"
          ]
        },
        {
          "step": "export the result",
          "here": "Convert offers JCAMP-DX, CSDM, HDF5, CSV, Parquet or Feather, with recommended formats chosen by data kind; the notebook menu writes a Colab or marimo notebook that re-fetches the selected datasets",
          "parts": [
            "export-menu"
          ]
        }
      ],
      "distinctive": [
        "files that share a base name across formats collapse into one dataset, and the formats can be checked against each other for identical data",
        "a parsing-coverage report ranks unread file extensions by count, with guidance on how to export proprietary formats",
        "each technique gets its plotting convention: reversed axes for NMR and FTIR, sticks for mass spectra, a wavelength slider for diode-array chromatography",
        "clicking a peak on a computed IR or Raman spectrum animates that vibrational mode on the 3D molecule",
        "a compound guessed from the dataset name, or known from the source, is resolved to a 3D structure automatically"
      ]
    }
  },
