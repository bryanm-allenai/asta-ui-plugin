  "app": {
    "title": "GeoResistivity — Apparent Resistivity Calculator",
    "summary": "A person records a survey's header details, then types the potential difference and current for each spacing on a digital copy of the paper sounding sheet, which comes pre-filled with the standard spacings and their geometric factors. Readings can also be imported from a CSV file after previewing it and mapping its columns. As values are typed, the interface checks each row, combines repeated readings at a position into one apparent resistivity with its spread, and draws the sounding curve on log-log axes with one segment per potential-electrode spacing. Bad readings are excluded with a required reason, and every correction is kept in a change history with undo. The result is the sounding curve as a figure, CSV files of the positions and readings, a PDF or HTML report, and a project file.",
    "task": {
      "text": "Turn field readings from a vertical electrical sounding into apparent resistivities per electrode spacing and a quality-checked sounding curve, ready to interpret and report.",
      "verbs": [
        "record",
        "derive",
        "clean",
        "curate",
        "summarize"
      ]
    },
    "data": {
      "text": "Readings of potential difference and current at a fixed schedule of electrode spacings for one sounding, with repeats and overlap readings, plus survey header details.",
      "item": "a reading at one current-electrode half-spacing and potential-electrode spacing on a sounding sheet",
      "shapes": [
        "table",
        "notes",
        "versions"
      ]
    },
    "stage": {
      "text": "entering and checking sounding readings in the field or office, before curve interpretation",
      "terms": [
        "collect",
        "clean",
        "analyze"
      ]
    },
    "mechanism": {
      "text": "An editable sheet of fixed spacings drives a live positions table and a log-log sounding curve that recompute as each value is typed; row problems are listed beside them, exclusions and corrections are logged to a history with undo, and the result leaves as a figure, CSVs, a report or a project file.",
      "views": [
        "table view",
        "line chart",
        "form",
        "summary stats",
        "list"
      ],
      "interactions": [
        "inline edit",
        "import",
        "accept or reject",
        "toggle view",
        "undo",
        "export",
        "filter",
        "write notes"
      ],
      "patterns": [
        "overview and detail",
        "version history"
      ]
    },
    "field": {
      "text": "vertical electrical sounding with the Schlumberger array in applied geophysics",
      "disciplines": [
        "earth science"
      ],
      "terms": [
        "geophysics",
        "electrical resistivity",
        "vertical electrical sounding"
      ]
    },
    "workflow": {
      "name": "enter measurements on a fixed schedule, derive a value per position and plot the curve",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Survey details form for the sheet header; the sheet starts from the standard schedule or a saved template, or rows are imported from a CSV after preview, decimal detection and column mapping",
          "parts": [
            "survey-details",
            "csv-import",
            "project-controls"
          ]
        },
        {
          "step": "enter a reading for each position",
          "here": "Type ΔV and I into rows of the editable sheet, with units chosen above it; K is computed per row from AB/2 and MN",
          "parts": [
            "field-sheet"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Repeated readings at one position are combined as K times the mean of ΔV/I, with coefficient of variation, standard error and flags",
          "parts": [
            "field-sheet",
            "positions-table"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "Tick Exclude with a mandatory reason; invalid or incomplete rows are listed by row and column, and the table and curve update",
          "parts": [
            "field-sheet",
            "positions-table"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Log-log curve with equal decades as on bilog paper, one segment per MN, optional error bars, flagged points circled",
          "parts": [
            "sounding-curve"
          ]
        },
        {
          "step": "keep a record of changes",
          "here": "Corrections, deleted rows, replaced sheets and unit changes are logged with time; undo last change; filter by row; export history",
          "parts": [
            "change-history"
          ]
        },
        {
          "step": "export the result",
          "here": "Export the curve as PNG/SVG/PDF at standard size or bilog paper scale, points and readings CSVs, an A4 PDF or HTML report, and a project file",
          "parts": [
            "sounding-curve",
            "exports-report",
            "project-controls"
          ]
        }
      ],
      "distinctive": [
        "The sheet is pre-filled with the 45 standard AB/2 × MN positions of the paper Schlumberger sheet, with K computed from the exact formula",
        "Overlap readings at the same AB/2 with the next MN are kept as separate curve segments so the shift between segments stays visible",
        "The figure can be exported to bilog paper scale, set in millimetres per decade, so a print can be laid over master curves",
        "Ambiguous numbers like 1,000 are rejected under a single decimal convention, and a coefficient-of-variation limit flags noisy repeated readings",
        "The report carries a hash of the project content so two reports of the same data can be matched"
      ]
    }
  },
