  "app": {
    "title": "Resistance-island dashboard: gene neighbourhoods, gene families and antibiograms",
    "summary": "A person narrows a large collection of genomic neighbourhoods around resistance genes by search, species, lineage, drug class, subclass, tier and mobile-element filters, then picks one from a list. They read its gene map in contig coordinates, its gene table and its record, or choose a gene family, drug class or architecture type to line up every neighbourhood that carries it on that gene, with a table of how often each neighbour is kept. They can open a gene family's own record, with per-position variation, domain architecture and a rotatable predicted structure, and on a third page set measured susceptibility against genotype, comparing carriers with non-carriers of each family for each antibiotic or reading one isolate at a time. Every record has an address that can be copied and cited.",
    "task": {
      "text": "Find where resistance genes sit in their genomes, what they travel with, how each gene family varies and folds, and whether the lab susceptibility results agree with the genotype.",
      "verbs": [
        "locate",
        "compare",
        "explore",
        "lookup",
        "summarize",
        "confirm"
      ]
    },
    "data": {
      "text": "Precomputed results of a comparative-genomics pipeline: gene neighbourhoods with their ordered genes, recurrent neighbourhood architectures, protein clusters with per-position variation, domains and predicted backbone coordinates, and measured susceptibility tests per isolate beside the isolate's gene list.",
      "item": "a genomic neighbourhood of about ten genes either side of a resistance gene on one contig",
      "shapes": [
        "table",
        "sequence",
        "spans",
        "hierarchy",
        "categories",
        "judgements"
      ]
    },
    "stage": {
      "text": "exploring and comparing finished genome annotations, after the analysis pipeline has run",
      "terms": [
        "explore",
        "compare",
        "confirm"
      ]
    },
    "mechanism": {
      "text": "A filtered sidebar list drives a gene-map view, a gene table and a record panel; choosing a cluster, class or architecture type switches the map to a stack of every matching neighbourhood aligned on that gene, with a conservation table. Cross-page links carry the selection in the address, so a gene in a map opens its family record with a rotatable structure, and the antibiogram page tabulates resistance rates among carriers and non-carriers.",
      "views": [
        "sidebar list",
        "sequence track",
        "table view",
        "detail panel",
        "bar chart",
        "summary stats",
        "canvas"
      ],
      "interactions": [
        "search",
        "filter",
        "sort",
        "select",
        "hover for detail",
        "toggle view",
        "zoom and pan"
      ],
      "patterns": [
        "master-detail",
        "overview and detail",
        "linked views",
        "side-by-side comparison",
        "dashboard"
      ]
    },
    "field": {
      "text": "comparative genomics of antimicrobial-resistance gene context in microbiology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "antimicrobial resistance",
        "comparative genomics",
        "pangenome"
      ]
    },
    "workflow": {
      "name": "browse genomic neighbourhoods and compare them aligned on a shared gene",
      "steps": [
        {
          "step": "filter to the items that matter",
          "here": "search box plus species, lineage, drug class, subclass, tier, integrity and mobile-element selects and a sort narrow the island list",
          "parts": [
            "island-browser"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "selecting an island draws its gene map in contig coordinates with fit or detail scale, a gene table and a record panel with its architecture type and a copy-id button",
          "parts": [
            "island-browser",
            "gene-map",
            "island-record",
            "genes-table"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "choosing a cluster, drug class or architecture type stacks every island that carries it, aligned on that gene, with a table of how often each neighbouring cluster is kept",
          "parts": [
            "aligned-stack"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "a gene family record shows identity, anchor tier, per-position variation, Pfam domains, fold matches and a rotatable Cα trace coloured by confidence or variation",
          "parts": [
            "cluster-record"
          ]
        },
        {
          "step": "summarize",
          "here": "a distribution tab counts islands across species, lineages and classes, following the tier filter",
          "parts": [
            "distribution"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "pick an antibiotic, gene family and minimum carriers to see resistant, intermediate and susceptible rates among carriers and non-carriers, with expected genes flagged",
          "parts": [
            "genotype-phenotype"
          ]
        }
      ],
      "distinctive": []
    }
  },
