  "app": {
    "title": "Chemiscope – interactive structure/property explorer for materials and molecules",
    "summary": "A person loads a dataset of atomic structures and their computed properties, either from a file, a link, or a built-in example. Every structure (or atomic environment) appears as a point on a map whose axes and colours are chosen from the properties or descriptors, and clicking a point opens that structure in a 3D viewer beside a table of its property values. After arranging the map and viewer, the person saves the dataset together with its visualization state, or saves only the settings, so the same view can be reopened or shared.",
    "task": {
      "text": "Explore a database of molecules or materials by relating where each structure sits on a descriptor or property map to its 3D atomic structure and property values.",
      "verbs": [
        "explore",
        "identify",
        "compare",
        "lookup"
      ]
    },
    "data": {
      "text": "A collection of atomic structures (element names, coordinates, optional unit cell) with properties attached to each structure or to each atom-centred environment, stored as chemiscope JSON, optionally gzipped and with structures loaded on demand.",
      "item": "one atomic structure, or one atom-centred environment within a structure, with its property values",
      "shapes": [
        "table",
        "3d structure"
      ]
    },
    "stage": {
      "text": "exploring a computed structure-property database, before deeper analysis and for sharing a saved view",
      "terms": [
        "explore"
      ]
    },
    "mechanism": {
      "text": "A property map and a 3D structure viewer sit side by side and are linked: selecting a point on the map loads its structure and fills the property table under the viewer. A load/save dialog brings datasets in and writes the dataset plus visualization state, or the settings alone, back out as JSON.",
      "views": [
        "scatter plot",
        "3d structure viewer",
        "detail panel",
        "table view"
      ],
      "interactions": [
        "import",
        "select",
        "hover for detail",
        "zoom and pan",
        "toggle view",
        "export"
      ],
      "patterns": [
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "structure-property maps of atomistic datasets in computational materials science and chemistry",
      "disciplines": [
        "materials science",
        "chemistry"
      ],
      "terms": [
        "atomistic simulation",
        "structure property map",
        "materials science"
      ]
    },
    "workflow": {
      "name": "explore a collection on a map linked to each item's detail view, then save the view",
      "steps": [
        {
          "step": "bring the data in",
          "here": "pick a .json or .json.gz chemiscope file in the Load/Save dialog, choose a dataset from the Examples menu, or pass a ?load= URL; files of 75 MB or more are streamed with structures kept in browser storage and read back on demand",
          "parts": [
            "dataset-loader",
            "examples-menu"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "each structure or environment is a point on the map, positioned and coloured by properties or descriptors chosen in the map settings",
          "parts": [
            "map-panel"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "clicking a map point shows that structure in the 3D viewer and its property values in the table beneath it",
          "parts": [
            "map-panel",
            "structure-panel",
            "info-table"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "selected environments can be pinned and kept across the map and viewer, and are saved with the settings as the selected set",
          "parts": [
            "map-panel",
            "structure-panel"
          ]
        },
        {
          "step": "export the result",
          "here": "save the dataset as JSON with the visualization state and optionally all on-demand structures, or save just map, structure and selected-environment settings to reload later",
          "parts": [
            "save-controls"
          ]
        }
      ],
      "distinctive": [
        "items can be whole structures or atom-centred environments inside them, so one map point may stand for a single atom's surroundings",
        "the visualization state (map axes, colours, structure display, pinned selections) is a separate JSON file that can be saved, reloaded and applied to the same dataset",
        "very large datasets stream into browser storage and structures are only parsed when displayed",
        "NaN values are preserved through reading and writing the JSON"
      ]
    }
  },
