  "app": {
    "title": "Calcium Imaging Dashboard",
    "summary": "A person opens a database of segmented cells built from several imaging sessions, then picks a cohort and an animal and puts that animal's sessions in order. In each session they select cell footprints on the image, look at their activity traces and quality distributions, and discard artifacts or merge duplicate detections. Next they register every session's field of view to a reference session, check the alignment scores and nudge it by hand where needed. Last, they match cells across all sessions into tracks, resolve conflicts, and save one curated database with the matching result.",
    "task": {
      "text": "Clean the cells segmented in each imaging session, align the sessions to a common frame, and track the same cells across sessions.",
      "verbs": [
        "clean",
        "derive",
        "compare",
        "organize",
        "curate"
      ]
    },
    "data": {
      "text": "Repeated imaging sessions for each animal, stored in a hierarchical HDF5 database. Each session has a stack of spatial footprints, one activity trace per cell, a max-projection image and optional per-cell quality metrics.",
      "item": "a segmented cell in one session: its spatial footprint and its activity trace",
      "shapes": [
        "image collection",
        "image",
        "time series",
        "table",
        "hierarchy",
        "versions"
      ]
    },
    "stage": {
      "text": "curating segmented cells and registering them across sessions, after source extraction and before longitudinal analysis",
      "terms": [
        "clean",
        "analyze"
      ]
    },
    "mechanism": {
      "text": "A header sets the scope (cohort, animal, working or raw copy), and a session list drives three tabs that share one undoable workspace. Cleaning links a footprint map to traces and quality histograms. Alignment shows before and after overlays with scores and a sortable grid-search table. Matching links a centroid map, a presence heatmap, a track list and distribution charts, and the header Save writes everything as one checkpoint.",
      "views": [
        "image viewer",
        "sidebar list",
        "line chart",
        "bar chart",
        "heatmap",
        "table view",
        "side-by-side panes",
        "summary stats"
      ],
      "interactions": [
        "import",
        "select",
        "multi-select",
        "brush",
        "zoom and pan",
        "hover for detail",
        "exclude and refit",
        "toggle view",
        "sort",
        "filter",
        "drag to arrange",
        "undo",
        "export"
      ],
      "patterns": [
        "linked views",
        "overview and detail",
        "master-detail",
        "side-by-side comparison",
        "dashboard"
      ]
    },
    "field": {
      "text": "longitudinal cell registration of calcium imaging in neuroscience",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "neuroscience",
        "calcium imaging",
        "cell registration"
      ]
    },
    "workflow": {
      "name": "clean detected objects, register images across sessions, and track the objects over time",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Browse opens an HDF5 database, Cohort and Animal set the scope, and a Working Copy / Raw Preview switch picks the view; the session list can be reordered with arrows",
          "parts": [
            "header-scope",
            "session-list"
          ]
        },
        {
          "step": "find bad items and drop them",
          "here": "click or ellipse-drag footprints on the map and read their traces; Find & Select Candidates applies enabled area, contrast, eccentricity and native CaImAn rules but only selects; Discard Selected or Discard Unselected removes cells",
          "parts": [
            "cleaning-view",
            "quality-tools"
          ]
        },
        {
          "step": "merge duplicate items",
          "here": "Merge Selected combines footprints and traces; Run Auto-Merge groups cells by distance, temporal correlation and spatial overlap, and pairwise distributions help set those limits",
          "parts": [
            "cleaning-view",
            "quality-tools"
          ]
        },
        {
          "step": "align every image to a common reference",
          "here": "Run Auto Alignment with a translation, rigid, similarity or non-rigid mode, Direct or Sequential to a reference session, using the MIP or the footprint sum; check MIP and footprint NCC and before/after coherence, then nudge shift, rotation and scale",
          "parts": [
            "alignment-view"
          ]
        },
        {
          "step": "compare parameter settings and keep the best",
          "here": "a grid search over mode, strategy, source and reference fills a table that can be sorted and filtered by NCC and displacement; applying a row sets that session's transform",
          "parts": [
            "grid-search-table"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Execute Matching links cells across all sessions into master tracks by a distance limit, an overlap limit, a cost weight and a cosine or Jaccard metric; Optimize Params aims for a target track count. Counts, coverage, a presence heatmap and matched-vs-other histograms show the result",
          "parts": [
            "matching-view"
          ]
        },
        {
          "step": "find conflicts and resolve them",
          "here": "check master-cell rows to find intra-session collisions, check them out with traces and metrics, apply the merges or delete groups, and rerun matching; Undo/Redo and Save write a _curated checkpoint",
          "parts": [
            "conflict-merge",
            "header-scope"
          ]
        }
      ],
      "distinctive": [
        "Rule-based quality detection only selects candidates; deleting still needs an explicit discard, so the rules guide the person and never decide",
        "Two image sources (max projection and summed footprints) are scored separately, because a high score on one does not prove a good registration",
        "Sequential alignment crawls neighbour to neighbour from a root session and accumulates the transforms, for sessions that drift too far to align directly",
        "Cell identity across sessions is a one-per-session assignment, so duplicates within a session show up as collisions to merge before rematching",
        "The raw database is never changed; all tabs share one in-memory, undoable workspace saved as a sibling _curated file"
      ]
    }
  },
