  "app": {
    "title": "Minimalist Image Annotation",
    "summary": "A person opens a folder of images and steps through them one at a time with buttons or the keyboard, zooming and panning each one. On each image they mark positive and negative points with left and right clicks, or switch modes to draw bounding boxes with two clicks, and they can type a free-text description for the image. If an image has a matching mask file beside it, the mask is drawn over it with adjustable opacity. They can remove marks by undo, clear, or middle-clicking one, reload earlier work from a JSON file, and save every image's points, boxes and description as one JSON file.",
    "task": {
      "text": "Mark points and bounding boxes on each image in a folder, add a description, and save the labels as a JSON file for training vision models.",
      "verbs": [
        "annotate",
        "locate"
      ]
    },
    "data": {
      "text": "A folder of image files, optionally with a mask image for each, plus per-image annotations: positive and negative points, bounding boxes and a free-text description, saved as JSON keyed by file name.",
      "item": "one image file in the folder, with its points, boxes and description",
      "shapes": [
        "image collection",
        "image",
        "notes"
      ]
    },
    "stage": {
      "text": "labelling images with points and boxes before training a detection or segmentation model",
      "terms": [
        "annotate"
      ]
    },
    "mechanism": {
      "text": "A stack of layered canvases shows one image large, with the optional mask, the annotations, a rubber-band box preview and a crosshair as separate layers. Mouse buttons place positive or negative points or box corners in image coordinates under zoom and pan, and a toolbar steps through the folder, switches mode, undoes, and saves or loads the JSON.",
      "views": [
        "image viewer",
        "form"
      ],
      "interactions": [
        "import",
        "zoom and pan",
        "apply label",
        "keyboard shortcuts",
        "undo",
        "write notes",
        "toggle view",
        "export"
      ],
      "patterns": [
        "review queue"
      ]
    },
    "field": {
      "text": "image labelling for object detection and segmentation in computer vision",
      "disciplines": [
        "computer science"
      ],
      "terms": [
        "computer vision",
        "object detection",
        "semantic segmentation"
      ]
    },
    "workflow": {
      "name": "mark regions on each image in a collection and save the labels",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Select Folder picks the image files (and any imgname_mask.png files); Load Annotations can reload an earlier annotations.json",
          "parts": [
            "toolbar",
            "save-load"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "Previous and Next buttons, or A/D and the arrow keys, move to the neighbouring image and fit it to the view",
          "parts": [
            "image-navigation",
            "image-canvas"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "the image fills the canvas with a crosshair; wheel zooms around the pointer, left-drag pans, Reset View refits it, and a matching mask is overlaid with an opacity slider",
          "parts": [
            "image-canvas",
            "mask-overlay"
          ]
        },
        {
          "step": "mark places on the item with a label",
          "here": "in point mode left click adds a positive point and right click a negative one; in box mode two left clicks draw a bounding box; middle click deletes the nearest mark, and Undo/Ctrl+Z or Clear remove marks",
          "parts": [
            "annotation-tools"
          ]
        },
        {
          "step": "write a note on each item",
          "here": "a text box under the canvas stores a description for the current image",
          "parts": [
            "description-box"
          ]
        },
        {
          "step": "export the result",
          "here": "Save Annotations downloads annotations.json with every image's points, boxes and description keyed by file name",
          "parts": [
            "save-load"
          ]
        }
      ],
      "distinctive": [
        "points are positive or negative by mouse button, the prompt style used for weakly supervised and interactive segmentation",
        "a mask file named after the image is overlaid on it with adjustable opacity, and only when its size matches the image",
        "all coordinates are stored in original image pixels, independent of zoom and pan",
        "runs entirely in the browser with no data sent anywhere, stated in a privacy note"
      ]
    }
  },
