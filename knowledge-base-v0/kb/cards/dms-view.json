  "app": {
    "title": "dms-view",
    "summary": "A person loads a table of per-site and per-mutation measurements, a protein structure file and a markdown description, each from a URL. They pick an experimental condition, a site-level metric and a mutation-level metric. Then they select sites of interest on a site-by-site line plot by clicking, brushing or typing site labels. A zoom bar narrows the plot to one region. Selected sites appear as stacked letter logos showing each mutation's effect, and as coloured residues on the 3D structure. The view's state is kept in a shareable URL, and each panel can be downloaded as SVG or PNG.",
    "task": {
      "text": "Explore how every mutation at every site of a protein affects a measured function under different conditions, and see where the sites of interest sit on the protein's 3D structure.",
      "verbs": [
        "explore",
        "identify",
        "locate",
        "compare"
      ]
    },
    "data": {
      "text": "A long-format table of mutational scanning results: for each site and condition, one or more site-level summary metrics and per-amino-acid mutation metrics, mapped to chains and residue numbers in a protein structure file, plus a markdown description of the experiment.",
      "item": "a site (residue position) of a protein under one experimental condition, with its mutation-level values",
      "shapes": [
        "table",
        "sequence",
        "per element",
        "document"
      ]
    },
    "stage": {
      "text": "exploring computed mutational scanning results, before writing figures for a paper",
      "terms": [
        "explore",
        "analyze"
      ]
    },
    "mechanism": {
      "text": "A focus line plot of a site metric along the protein, with a zoom bar below it, is the main view. Sites selected there by click, brush or typed labels are drawn in a logo plot of their mutation values and highlighted on the 3D structure in the same colours. Dropdowns switch the condition and metrics, and every view redraws.",
      "views": [
        "line chart",
        "sequence track",
        "bar chart",
        "document reader"
      ],
      "interactions": [
        "select",
        "multi-select",
        "brush",
        "zoom and pan",
        "hover for detail",
        "toggle view",
        "search",
        "import",
        "export"
      ],
      "patterns": [
        "linked views",
        "overview and detail",
        "focus and context"
      ]
    },
    "field": {
      "text": "deep mutational scanning of proteins in molecular biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "deep mutational scanning",
        "protein structure",
        "viral escape"
      ]
    },
    "workflow": {
      "name": "select positions along a sequence and see them in linked detail and structure views",
      "steps": [
        {
          "step": "bring the data in",
          "here": "URL fields load the metrics CSV, a PDB structure and a markdown description. A load error shows the server's message in an alert. URLs are read from and written back to the page's query string.",
          "parts": [
            "data-controls",
            "protein-panel",
            "description-panel"
          ]
        },
        {
          "step": "choose which condition and measure to view",
          "here": "Dropdowns built from the CSV columns switch the condition, the site_* metric drawn on the line plot and the mut_* metric drawn in the logo plot",
          "parts": [
            "site-plot",
            "logo-plot"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "A line plot shows the chosen metric site by site, with tooltips for site, value and wildtype. An area zoom bar below it is brushed to narrow the plot to one region.",
          "parts": [
            "site-plot"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Sites are selected by clicking points, by brushing a box, or by typing comma-separated site labels. A select/deselect radio, or holding Shift, turns the brush into an eraser, and 'clear selections' resets everything. The site with the highest value is selected by default.",
          "parts": [
            "data-controls",
            "site-plot"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "The logo plot stacks one amino-acid letter per mutation at each selected site, sized by its value, above or below zero. The NGL structure viewer draws the selected residues as spacefill in the matching viridis colour.",
          "parts": [
            "logo-plot",
            "protein-panel"
          ]
        },
        {
          "step": "export the result",
          "here": "Download SVG buttons save the line plot and the logo plot, and Download PNG saves the structure render. The URL captures the whole view so it can be shared.",
          "parts": [
            "site-plot",
            "logo-plot",
            "protein-panel"
          ]
        }
      ],
      "distinctive": [
        "Sequence positions in the data are mapped to chain and residue numbers in a structure file, so one selection lights up the same sites on several homologous chains in 3D",
        "Mutation values are drawn as stacked letter logos, with positive values stacked up and negative ones down, coloured by amino-acid biochemical class or by a custom colour column",
        "Gaps in site numbering are kept, so missing sites show as breaks in the zoom-bar area",
        "The full view state (data URLs, condition, metrics, selected sites, structure colours) is written into the page URL, so the view can be shared or used to recreate a paper figure"
      ]
    }
  },
