  "app": {
    "title": "SoloLab — STIX · RPW · EPD Temporal Analysis Tool",
    "summary": "A person brings in data from several instruments that observed the same event: they upload spectrogram files or search and download them from the public archives, and fetch particle flux for one day. For each instrument they can subtract a background, taken from a quiet time interval or a separate background file with a chosen statistic. They preview the result and the background with its spread, then load it, and a status grid shows what is loaded. They set how each instrument is drawn and stack the chosen instruments into one multi-panel figure on a shared time axis, in an order they pick, over a time window that starts as the overlap of all of them. They can also rebuild X-ray images over one interval or a sequence of tiles, and save the whole session as a data pack file to reload later.",
    "task": {
      "text": "Clean the background out of several instruments' time series for one event and stack them on a shared time axis, so the signals can be matched up in time.",
      "verbs": [
        "compare",
        "clean",
        "explore",
        "derive"
      ]
    },
    "data": {
      "text": "Time series of intensity from several instruments over the same period: spectrograms of counts or power over time and energy or frequency, per-channel particle fluxes over time, and images rebuilt from pixel data.",
      "item": "one instrument's observation file for an event: a time-by-energy or time-by-frequency spectrogram, or a day of per-channel particle flux",
      "shapes": [
        "time series",
        "image",
        "image collection"
      ]
    },
    "stage": {
      "text": "cleaning and lining up raw instrument data from one event, to explore it across instruments before detailed analysis",
      "terms": [
        "clean",
        "explore",
        "compare"
      ]
    },
    "mechanism": {
      "text": "Each instrument has its own import page with a control column and a preview chart. Buttons there stay disabled until a file is loaded, and the background controls appear only after a first preview. A shared status grid in the sidebar shows which instruments are loaded. Plot settings are saved per instrument and drive a combined page that stacks the chosen instruments as panels on one time axis, in an order set with up/down buttons.",
      "views": [
        "heatmap",
        "line chart",
        "form",
        "summary stats",
        "image viewer",
        "small multiples"
      ],
      "interactions": [
        "import",
        "search",
        "select",
        "toggle view",
        "zoom and pan",
        "hover for detail",
        "time slider",
        "exclude and refit",
        "drag to arrange",
        "export"
      ],
      "patterns": [
        "side-by-side comparison",
        "focus and context",
        "dashboard"
      ]
    },
    "field": {
      "text": "multi-instrument time-series quicklooks with background subtraction in heliophysics",
      "disciplines": [
        "astronomy"
      ],
      "terms": [
        "heliophysics",
        "dynamic spectra",
        "x ray imaging"
      ]
    },
    "workflow": {
      "name": "line up several sources' time series of one event on a shared time axis",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload a FITS or CDF file per instrument, or search the STIX Data Center by start time, duration and product and download one result, or download a day of EPD flux by date, particle type and resample interval.",
          "parts": [
            "stix-import",
            "rpw-epd-import"
          ]
        },
        {
          "step": "estimate a baseline from a quiet stretch and subtract it",
          "here": "After a preview, tick to subtract a background from a time range (prefilled with the file's span) and/or a background file. Pick a statistic (mean, median, min, max, percentile), preview the subtracted data with the interval marked, and plot the background per channel with its spread.",
          "parts": [
            "background-subtraction",
            "rpw-epd-import"
          ]
        },
        {
          "step": "track which sources are ready",
          "here": "LOAD stores the final data for the session, and a 2x2 badge grid in the sidebar shows each instrument's status and time range.",
          "parts": [
            "session-sidebar"
          ]
        },
        {
          "step": "choose how each source is drawn",
          "here": "Tabs per instrument set the plot type (spectrogram, time profiles, overlay), log axes, smoothing, energy or frequency limits, and lists of energy bins, frequencies or channels, with a preview plot.",
          "parts": [
            "plot-prefs"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Pick the loaded instruments, order the panels top to bottom with up/down buttons, optionally limit to a date range prefilled with the overlap of all selected data, set line width and font size, then PLOT one stacked figure on a shared time axis.",
          "parts": [
            "combined-plot",
            "panel-order"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "From STIX pixel data, estimate the flare location, then reconstruct images with a chosen algorithm and energy ranges over one interval or a sequence of tiles. Step or play through the tiles, or view them as a mosaic, with the interval highlighted on a lightcurve.",
          "parts": [
            "stix-imaging"
          ]
        },
        {
          "step": "export the result",
          "here": "Save Data Pack downloads all loaded instrument data as a compressed .pkl named after the instruments it holds, which can be uploaded later. Reconstructed images can be downloaded one at a time or all at once.",
          "parts": [
            "session-sidebar",
            "stix-imaging"
          ]
        }
      ],
      "distinctive": [
        "the combined figure's default time window is the overlap of every selected instrument's coverage, worked out from each one's loaded time range",
        "the background is taken per channel or per frequency with a chosen statistic, and its spread is kept so it can be drawn as error bars; a tooltip warns that min and max are unreliable on spiky counts",
        "the sources differ in kind (X-ray counts by energy, radio power by frequency, particle flux by channel), and each has its own preprocessing before they share one axis",
        "the order of panels in the stack can be set by hand and is remembered across pages",
        "the whole loaded session can be saved and reloaded as one data pack file, so nothing has to be downloaded again"
      ]
    }
  },
