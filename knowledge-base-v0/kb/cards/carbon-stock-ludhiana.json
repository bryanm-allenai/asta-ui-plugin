  "app": {
    "title": "Carbon Stock Intelligence — gridded soil carbon and NPP dashboard",
    "summary": "A person opens a district overview with headline totals, a breakdown by land class and notes on the estimates. On a map, they colour every grid cell by one variable or by where its value came from, and search for a place or click a point to load the cells nearby and read the closest one. They then check the estimates on separate pages: totals under different assumptions, an independent cross-check, the monthly vegetation index and value distributions, followed by model accuracy against baselines and feature importance. Finally they page through a cell table, filter it, and export the current page of cell values as CSV.",
    "task": {
      "text": "Present a finished per-cell estimate of soil carbon stock and annual plant carbon flux, with its uncertainty, sensitivity and model validation, so each cell's value and source can be looked up and exported.",
      "verbs": [
        "explore",
        "lookup",
        "summarize",
        "compare",
        "locate"
      ]
    },
    "data": {
      "text": "A regular grid of cells covering one region, each with modelled soil and vegetation carbon values, terrain, land class and a label for where each value came from, plus district totals, sensitivity variants, model validation metrics and a monthly vegetation-index series.",
      "item": "a 250 m grid cell with its estimated values and their sources",
      "shapes": [
        "geospatial",
        "field",
        "table",
        "time series"
      ]
    },
    "stage": {
      "text": "presenting and checking finished gridded estimates after the modelling pipeline has run",
      "terms": [
        "report",
        "confirm"
      ]
    },
    "mechanism": {
      "text": "A navbar switches between an overview of headline numbers, a tiled map where a layer toggle recolours the grid cells and a click or place search loads nearby cells into a detail panel, analytics and model pages with tables and charts of the totals and validation results, and a paged, filterable cell table that updates its summary numbers, scatter plot and histogram and exports to CSV.",
      "views": [
        "map",
        "summary stats",
        "bar chart",
        "line chart",
        "scatter plot",
        "table view",
        "detail panel"
      ],
      "interactions": [
        "toggle view",
        "select",
        "search",
        "hover for detail",
        "zoom and pan",
        "filter",
        "export"
      ],
      "patterns": [
        "dashboard",
        "overview and detail"
      ]
    },
    "field": {
      "text": "remote-sensing estimation of carbon stocks on a grid, with random forests checked by spatial cross-validation, in earth science",
      "disciplines": [
        "earth science"
      ],
      "terms": [
        "remote sensing",
        "digital soil mapping",
        "carbon accounting"
      ]
    },
    "workflow": {
      "name": "inspect a gridded estimate and export the values per cell",
      "steps": [
        {
          "step": "look over every item at a glance",
          "here": "The home page counts up the district soil stock, the annual flux, the mean density and model R², and shows a bar chart of stock by land class next to notes on the estimates.",
          "parts": [
            "overview"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "On the map, buttons recolour cells by elevation, agricultural class, NPP, SOC or value source. A place search, or a click anywhere, loads the cells around that point and opens the nearest cell's values in a panel.",
          "parts": [
            "carbon-map",
            "place-search",
            "cell-panel"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "The analytics page shows the district totals with ranges, the stock under different boundary and rebuild assumptions, a crop-yield cross-check of the flux, monthly median NDVI with seasonal peaks, and histograms of cell values.",
          "parts": [
            "analytics"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "The model page shows two model cards with R² rings, RMSE and the coordinates-only baseline, a permutation-importance chart, and a table of every validation result: model types, feature ablations and block sizes.",
          "parts": [
            "model-validation"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "The cell explorer pages through cells 100 at a time. It filters the page by cell id and by minimum and maximum NPP, and updates the page means, a scatter of NPP against SOC and an NPP histogram.",
          "parts": [
            "cell-explorer"
          ]
        },
        {
          "step": "export the result",
          "here": "Export page CSV saves the filtered rows of the current page, with each value's source column.",
          "parts": [
            "csv-export"
          ]
        }
      ],
      "distinctive": [
        "Every cell value carries a source label (observed, interpolated, no data, outside product domain), and the map can colour cells by that source instead of by value.",
        "Stock (tC) and flux (tC/yr) are always reported separately, and the notes on the estimates say they are never summed.",
        "Model accuracy is reported from spatial-block cross-validation against a coordinates-only baseline and the training mean, with ablations and block-size sensitivity.",
        "The satellite-product flux is checked against an independent crop-yield lower bound and a light-use-efficiency estimate.",
        "The map starts from a random sample of cells and loads the full set of cells around any point the person clicks or searches."
      ]
    }
  },
