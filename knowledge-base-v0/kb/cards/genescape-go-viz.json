  "app": {
    "title": "GeneScape: Gene Ontology subgraph for a gene list",
    "summary": "A person pastes a list of genes (or ontology term ids), picks the organism's annotation database, and can narrow by ontology domain, a minimum coverage (how many input genes share a function) and a word or regex pattern. Pressing Draw Tree maps the genes to their ontology terms, keeps the ones that pass the filters, and draws them with all their ancestors as a directed graph, coloured by domain and labelled with coverage counts; if no coverage is given the tool estimates a cutoff. A second tab lists the matching functions in a filterable table sorted by coverage, with node and edge counts and any unknown symbols reported. The annotation table can be downloaded as CSV and the graph as a DOT file.",
    "task": {
      "text": "Place a list of genes in the context of a functional ontology, showing which functions they share and how specific those functions are, and narrow the result to a readable subgraph.",
      "verbs": [
        "explore",
        "summarize",
        "identify",
        "derive"
      ]
    },
    "data": {
      "text": "A pasted list of gene symbols or ontology ids, matched against a prebuilt per-organism index of gene-to-term associations and the ontology's directed acyclic graph of terms.",
      "item": "an ontology term annotated to one or more genes in the input list",
      "shapes": [
        "table",
        "network",
        "hierarchy"
      ]
    },
    "stage": {
      "text": "exploring the functions behind a gene list produced by an earlier genomic analysis, before interpretation",
      "terms": [
        "explore",
        "analyze"
      ]
    },
    "mechanism": {
      "text": "Sidebar inputs (gene list, organism, domain, coverage, pattern) feed one server run that builds the filtered ancestor subgraph; the run fills both a Graphviz drawing with zoom buttons and an annotation table on separate tabs, and the same results are offered as CSV and DOT downloads.",
      "views": [
        "form",
        "network diagram",
        "table view",
        "summary stats"
      ],
      "interactions": [
        "import",
        "filter",
        "search",
        "zoom and pan",
        "sort",
        "toggle view",
        "export"
      ],
      "patterns": []
    },
    "field": {
      "text": "gene ontology functional annotation of gene lists in bioinformatics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "bioinformatics",
        "functional analysis",
        "gene ontology"
      ]
    },
    "workflow": {
      "name": "map a list of items onto a reference hierarchy and prune it to a readable subgraph",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Paste gene symbols or GO ids, one per line, into the Gene List box and pick the organism's index from a dropdown.",
          "parts": [
            "input-sidebar"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Restrict to one GO domain (BP, MF, CC), set a minimum Coverage, and type a word or regex that term names must match; a blank coverage is estimated automatically.",
          "parts": [
            "filter-controls"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Draw Tree maps genes to terms, counts per term how many input genes carry it, keeps passing terms and adds all their ontology ancestors, reporting node/edge counts and unknown symbols.",
          "parts": [
            "filter-controls",
            "graph-panel"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The subgraph is drawn as a Graphviz digraph, coloured by domain, with input terms green (dark green for leaves) and labels showing total annotations [n] and coverage (k/N); zoom in, out and reset.",
          "parts": [
            "graph-panel",
            "zoom-controls"
          ]
        },
        {
          "step": "summarize the result in a table",
          "here": "The Annotations tab lists each matching function with its coverage, domain, GO id and genes, sorted by coverage, with per-column filters.",
          "parts": [
            "annotations-table"
          ]
        },
        {
          "step": "export the result",
          "here": "Download the annotation table as genescape.csv and the graph as a DOT file.",
          "parts": [
            "downloads"
          ]
        }
      ],
      "distinctive": [
        "Filtered terms are drawn together with every ancestor up to the ontology roots, so each function is seen at its depth in the hierarchy.",
        "Each node carries two counts: how many input items carry the term (k/N) and how many items in the whole organism are annotated to it, separating list-specific from genome-wide frequency.",
        "When no minimum coverage is given, a cutoff is estimated from the number of distinct coverage values so the graph stays manageable.",
        "Prebuilt indices for several model organisms are selectable, and input may mix gene symbols with ontology ids."
      ]
    }
  },
