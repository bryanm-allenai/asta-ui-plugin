  "app": {
    "title": "MetaSprint Dose-Response: interactive E156 micro-paper reader",
    "summary": "A person reads a 156-word, seven-sentence abstract in which each sentence is tagged with its role in the argument: question, dataset, method, primary result, robustness, interpretation or boundary. Pointing at a sentence shows its role, and clicking a role in a coloured sentence map scrolls to that sentence and highlights it. Below the abstract they can check the study notes, references and AI disclosure, and open the linked analysis app. A word-count check confirms the 156-word limit, and the person can copy the abstract text, download the whole paper record as JSON, or print it.",
    "task": {
      "text": "Read a short structured methods abstract sentence by sentence by its role, check it meets the format, and take the text or its record away.",
      "verbs": [
        "lookup",
        "locate",
        "review"
      ]
    },
    "data": {
      "text": "One short structured paper record: a seven-sentence abstract with a fixed role for each sentence, metadata notes, a reference list, a disclosure and links to assets.",
      "item": "a sentence of a seven-sentence structured abstract, tagged with its rhetorical role",
      "shapes": [
        "document",
        "categories",
        "notes"
      ]
    },
    "stage": {
      "text": "reporting a finished methods study as a structured micro-paper",
      "terms": [
        "report"
      ]
    },
    "mechanism": {
      "text": "The abstract is drawn as a single paragraph of role-coloured sentence spans, and pointing at a span shows its role label. A strip of role segments under it acts as a map: clicking a segment scrolls to its sentence and highlights it. Notes, references and a footer with a word-count check and copy, JSON and print actions sit below.",
      "views": [
        "document reader",
        "summary stats"
      ],
      "interactions": [
        "hover for detail",
        "select",
        "keyboard shortcuts",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "linked views"
      ]
    },
    "field": {
      "text": "dose-response meta-analysis methods in clinical evidence synthesis",
      "disciplines": [
        "medicine"
      ],
      "terms": [
        "dose response meta analysis",
        "evidence synthesis",
        "meta analysis"
      ]
    },
    "workflow": {
      "name": "read a structured abstract by its sentence roles and take the text away",
      "steps": [
        {
          "step": "bring the data in",
          "here": "The paper record (title, byline, seven role-tagged sentences, notes, references, assets) is embedded in the page and drawn when it loads",
          "parts": [
            "paper-reader"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "The abstract is shown as one paragraph of sentence spans; pointing at or focusing a span shows a coloured tag naming its role (S1 Question to S7 Boundary)",
          "parts": [
            "paper-reader"
          ]
        },
        {
          "step": "locate a part of the document by its role",
          "here": "Clicking or pressing Enter on a segment of the coloured sentence map scrolls to that sentence and tints it in the role colour",
          "parts": [
            "sentence-map"
          ]
        },
        {
          "step": "check supporting details and sources",
          "here": "Outside Notes list type, primary estimand, version and validation status; References and an AI disclosure follow; figures and an Open Interactive App link appear when the record has those assets",
          "parts": [
            "notes-references",
            "figures-app-link"
          ]
        },
        {
          "step": "check the text against a format rule",
          "here": "The footer counts the words in the abstract and shows a tick only when there are exactly 156",
          "parts": [
            "footer-actions"
          ]
        },
        {
          "step": "export the result",
          "here": "Copy puts the abstract text on the clipboard, JSON downloads the whole paper record named by its slug, and Print gives a print layout",
          "parts": [
            "footer-actions"
          ]
        }
      ],
      "distinctive": [
        "The abstract follows a fixed seven-sentence scheme (question, dataset, method, primary result, robustness, interpretation, boundary), and each role has its own colour",
        "A hard 156-word limit is checked live in the footer",
        "The paper record carries its own format validation checks (one paragraph, sentence count, a result sentence with an interval and an estimand, a boundary sentence), and their status is shown as a note",
        "The dose-response analysis app itself is only linked from this reader; its single HTML file is not included in the code"
      ]
    }
