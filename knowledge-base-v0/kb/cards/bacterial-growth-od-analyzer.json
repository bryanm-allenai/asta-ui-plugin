  "app": {
    "title": "Bacterial Growth Analyzer",
    "summary": "The person loads a plate-reader export, picks the plate format and clicks the replicate sample wells on a plate grid. They can also pick blank wells, fit a background model to them and subtract it, then check raw against corrected curves well by well. In advanced mode, two groups of wells can be added, subtracted, multiplied or divided. They then set time intervals on the averaged curve, pick a growth model or let AIC choose one, and fit it. Each fit gives parameter estimates with errors, a lag time and confidence bands. Change-point detection can propose the phase boundaries, and a custom ODE can be fitted instead. The fitted parameters download as a CSV, and the fit settings save as JSON so they can be applied again.",
    "task": {
      "text": "Turn raw optical-density time courses from a well plate into fitted growth parameters with uncertainty, after correcting for blank wells.",
      "verbs": [
        "derive",
        "clean",
        "identify",
        "compare"
      ]
    },
    "data": {
      "text": "A plate-reader export: one time column and one column of readings per well, laid out on a plate of known rows and columns.",
      "item": "a well on a multi-well plate, with its reading over time",
      "shapes": [
        "grid of series",
        "time series",
        "per element",
        "table"
      ]
    },
    "stage": {
      "text": "fitting growth curves from raw plate-reader runs after an experiment, before reporting",
      "terms": [
        "analyze",
        "clean"
      ]
    },
    "mechanism": {
      "text": "Each step is a separate tab reached from a sidebar with a progress tracker, and each tab passes its prepared table to the next. A clickable plate grid picks the sample and blank wells. Line charts show the raw, corrected and averaged curves. Each fit sits in an expandable form for its time interval, model, initial guesses and bounds, and draws the fitted curve with a confidence band and a parameter table. A summary chart and a results table collect all the fits for export.",
      "views": [
        "fixed-layout grid",
        "line chart",
        "table view",
        "form",
        "summary stats"
      ],
      "interactions": [
        "import",
        "multi-select",
        "select",
        "toggle view",
        "time slider",
        "exclude and refit",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "status pipeline"
      ]
    },
    "field": {
      "text": "growth-curve model fitting of optical-density plate-reader data in microbiology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "microbiology",
        "growth curves",
        "plate reader"
      ]
    },
    "workflow": {
      "name": "pick replicates on a layout, correct against blanks, fit models over chosen intervals and export the parameters",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Choose a plate format (24, 84, 96, 1536 wells or custom rows × columns) and upload a headerless CSV or XLSX with time followed by one column per well.",
          "parts": [
            "upload-view"
          ]
        },
        {
          "step": "select the replicate items on their fixed layout",
          "here": "Click wells on a lettered plate grid, or tick rows and columns and apply them, to choose the sample wells. Then plot them, with their mean and standard deviation.",
          "parts": [
            "plate-picker",
            "upload-view",
            "background-view"
          ]
        },
        {
          "step": "correct against control items",
          "here": "Turn on background subtraction and pick blank wells. Fit a power law or quadratic to them, or use their average, and subtract it from the samples. Negative values are clipped to zero, and a raw vs corrected chart checks one well at a time.",
          "parts": [
            "background-view",
            "plate-picker"
          ]
        },
        {
          "step": "combine groups arithmetically",
          "here": "In advanced mode, Group 1 and Group 2 are added, subtracted, multiplied or divided in a chosen order, and the result becomes the data to fit.",
          "parts": [
            "group-operations"
          ]
        },
        {
          "step": "find where the curve changes phase",
          "here": "Thresholded-derivative (Savitzky–Golay smoothing) or slope-based change-point detection on the averaged curve gives a table of phase start, end and duration.",
          "parts": [
            "phase-detection"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Add a fit for a start–end time window, choose exponential, logistic, Baranyi, lag-exponential-saturation, Gompertz, a custom expression, or Automatic Fit (lowest AIC), and set guesses and bounds. Fitting gives estimates, standard errors, p-values, R², lag time and a confidence band. A custom ODE system can be fitted instead.",
          "parts": [
            "fitting-view",
            "ode-fit"
          ]
        },
        {
          "step": "export the result",
          "here": "A summary chart overlays every fit. 'Download Results CSV' saves the parameter table, and an editable fit configuration JSON can be downloaded and uploaded later to rerun the same fits automatically.",
          "parts": [
            "fit-results"
          ]
        }
      ],
      "distinctive": [
        "Wells are picked on a plate grid of the chosen format, with row and column tick boxes for bulk selection.",
        "The background can be modelled over time (power law or quadratic fitted to the blank wells) rather than only averaged, before it is subtracted.",
        "Fits are made per time interval on the replicate mean. Lag time is derived from the fitted parameters, and each fit is marked POOR when R² is below 0.90 or the variance ratio is above 0.20.",
        "Automatic Fit compares the candidate growth models by AIC and keeps the best one.",
        "Fit settings round-trip as JSON, so the same intervals and models can be applied to a new run."
      ]
    }
  },
