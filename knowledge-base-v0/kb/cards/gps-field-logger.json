  },
  "app": {
    "title": "Field Logger: randomized block field session logger",
    "summary": "The person names a session, defines the study's measurement scenarios and blocks, and records the session's conditions: a weather snapshot for the site and, for each receiver, when it was powered on and when it reached RTK fix. From the blocks and scenarios the app builds a seeded, randomized visit schedule with an estimated total time, which the person can re-shuffle before beginning. They then step through the points one at a time, starting and stopping a timer at each. A completed point can be redone with a logged reason. At the end they export the session as CSV and JSON, and finished sessions stay in a history where they can be exported again.",
    "task": {
      "text": "Run a structured field data-collection session on a randomized block design, timestamping each measurement point and the session's equipment and conditions so the session can be analysed later.",
      "verbs": [
        "record",
        "plan",
        "monitor",
        "curate"
      ]
    },
    "data": {
      "text": "A field session record: user-defined blocks and scenarios, a generated schedule of points (one per block × scenario) with start and end timestamps and re-collection counts, receiver power-on and fix events, a weather snapshot, settings and free-text notes.",
      "item": "a measurement point: one block × scenario combination, visited in scheduled order with start and end times",
      "shapes": [
        "events",
        "table",
        "categories",
        "notes"
      ]
    },
    "stage": {
      "text": "collecting timed measurements in the field, following a randomized schedule",
      "terms": [
        "collect",
        "plan"
      ]
    },
    "mechanism": {
      "text": "A Setup tab gathers the design (scenarios, blocks), the session conditions and the settings, and shows a live preview of the seeded schedule. Begin stays hidden until the design is complete and a receiver has a fix. The Collect tab then shows one point card at a time with start and stop controls, a progress bar and a timeline grouped by block, where tapping a completed point opens it for re-collection with a reason.",
      "views": [
        "form",
        "detail panel",
        "list",
        "timeline",
        "summary stats"
      ],
      "interactions": [
        "inline edit",
        "select",
        "export",
        "write notes",
        "import"
      ],
      "patterns": [
        "review queue",
        "status pipeline",
        "overview and detail"
      ]
    },
    "field": {
      "text": "randomized complete block field trials logging GNSS receiver sessions in agricultural engineering",
      "disciplines": [
        "engineering"
      ],
      "terms": [
        "rcbd",
        "rtk gnss",
        "precision agriculture"
      ]
    },
    "workflow": {
      "name": "log timed measurements at points on a randomized schedule",
      "steps": [
        {
          "step": "define the categories the study is built from",
          "here": "Measurement scenarios are added with a name, an optional description and an emoji icon. Study blocks are added with a name and condition notes. Both can be removed until collection begins.",
          "parts": [
            "design-builder"
          ]
        },
        {
          "step": "record the conditions of the session",
          "here": "Weather is fetched from device GPS, a place-name search with a picker, or manual lat/lon. Each receiver logs Power On and RTK Fixed taps, and time-to-first-fix is computed from them. Free-text field notes are also kept.",
          "parts": [
            "weather-snapshot",
            "receiver-log",
            "setup-tab"
          ]
        },
        {
          "step": "lay out the order of the work",
          "here": "One point is made per block × scenario. Block order and the scenario order within each block are shuffled with a seeded RNG. The preview shows the seed, the point count and the estimated total hours, and can be re-shuffled. BEGIN DATA COLLECTION appears only when receivers, scenarios and blocks exist and a receiver has an RTK fix.",
          "parts": [
            "schedule-preview"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "A card shows the current point's scenario, block, visit order, point ID and block notes. START COLLECTION starts a running timer, and END COLLECTION stamps the end time and moves to the next point.",
          "parts": [
            "collect-tab"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "A progress bar counts completed points against the total, and a timeline grouped by block shows each point's status and times.",
          "parts": [
            "collect-tab"
          ]
        },
        {
          "step": "redo an item, with a reason",
          "here": "Tapping a completed point opens it. RE-COLLECT THIS POINT opens a sheet of fixed reasons (equipment lost fix, tripod bumped, wrong location, and others). The point returns to pending, and its re-collect count goes up.",
          "parts": [
            "recollect-sheet"
          ]
        },
        {
          "step": "export the result",
          "here": "When all points are done, JSON and CSV exports and Finish appear. Finish archives the session to History, where past sessions can be viewed and exported again.",
          "parts": [
            "collect-tab",
            "session-history"
          ]
        }
      ],
      "distinctive": [
        "Collection cannot begin until at least one receiver has reached an RTK fix, and time-to-first-fix is logged per receiver",
        "The visit schedule is a randomized complete block design: block order and the scenario order within each block are shuffled with a seed, and the seed is recorded in the exports",
        "An estimated total session time is computed from the points × (dwell time + travel/setup time)",
        "Re-collections are counted and keep a reason from a fixed list, so redone points show up in the exported data",
        "A weather snapshot for the site is stored with the session and included in the export"
      ]
    }
  },
