  "app": {
    "title": "Neurosift (v2)",
    "summary": "A person searches a public neuroscience data archive by keyword, by meaning, or by the kinds of data objects a dataset contains, then opens one dataset to read its metadata and browse its files. Opening a file streams it remotely and lists every data object it holds in a table, with the views suited to each object's type. The person opens one or several objects in tabs, where time series, spike rasters, intervals, images and tables are drawn and can be scrolled and zoomed in time. They come away with a shareable link to exactly the view they were looking at, and a Python snippet that loads the same object.",
    "task": {
      "text": "Find a shared neurophysiology recording and look inside it, object by object, without downloading it.",
      "verbs": [
        "explore",
        "lookup",
        "locate"
      ]
    },
    "data": {
      "text": "Remote archives of standardized neurophysiology files, each a hierarchy of typed data objects (time series, unit spike trains, interval tables, image series) with metadata.",
      "item": "a typed data object inside one recording file",
      "shapes": [
        "hierarchy",
        "time series",
        "table",
        "events",
        "image collection"
      ]
    },
    "stage": {
      "text": "exploring shared recordings before reuse or analysis",
      "terms": [
        "explore"
      ]
    },
    "mechanism": {
      "text": "A search page leads to a dataset page with its metadata beside a file browser; opening a file shows its overview in a side panel and a table of objects in the main workspace, where each object opens in its own tab rendered by the view registered for its type. Time-based views scroll and zoom along time, and each tab can be shared as a link that reopens it.",
      "views": [
        "list",
        "detail panel",
        "tree view",
        "table view",
        "line chart",
        "sidebar list"
      ],
      "interactions": [
        "search",
        "filter",
        "select",
        "multi-select",
        "toggle view",
        "zoom and pan",
        "time slider",
        "hover for detail",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "master-detail"
      ]
    },
    "field": {
      "text": "browsing standardized neurophysiology data files in neuroscience",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "neuroscience",
        "neurophysiology",
        "nwb"
      ]
    },
    "workflow": {
      "name": "find a dataset in an archive and inspect its contents object by object",
      "steps": [
        {
          "step": "filter to the items that matter",
          "here": "search the archive in basic, semantic or neurodata-type mode; type mode lets the person tick object types and lists datasets that contain them, with View More to page on",
          "parts": [
            "archive-search"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "a dataset page shows its title, contributors, license and version selector beside a file browser that can be limited to NWB files and loaded in growing pages",
          "parts": [
            "dataset-files"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "opening a file streams it and lists every neurodata object in a table with its type and the views that can draw it, beside an overview of the session and subject",
          "parts": [
            "file-overview",
            "object-table"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "ticking several objects and pressing Open selected puts them in one multi-view tab; each object can also open alone in a tab with its type's view",
          "parts": [
            "object-table",
            "workspace"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "a time-series tab draws channels against time with editable start and duration, pan and zoom",
          "parts": [
            "timeseries-view"
          ]
        },
        {
          "step": "export the result",
          "here": "the share button copies a link that reopens the file, dataset version and tab; a Python Usage tab gives the code to load it",
          "parts": [
            "share-tab",
            "workspace"
          ]
        }
      ],
      "distinctive": [
        "files are read remotely in byte ranges, so large recordings are inspected without downloading them",
        "which view an object gets is decided by its schema type, through a registry of plugins matched to the file's type specifications",
        "the archive can be searched by the types of data object datasets contain, not only by text",
        "every open view has a URL, so a view can be cited or attached to a bug report"
      ]
    }
