  },
  "app": {
    "title": "One-Stop Analysis",
    "summary": "A person uploads a well-layout metadata file and one or more plate-reader result files, sets which plate and well columns to join on, and chooses which columns to keep. They can mask wells by a flag column or a list of well IDs, and add formula columns. Merging gives a combined table, which they can check on a plate heatmap and a bar chart of group means. Per-plate statistics then compare each group against a chosen control, or against a disease-state control: effect sizes, screening-quality metrics, Welch tests with multiple-testing correction, and 4PL EC50 fits with two-way ANOVA. Last, the data is reshaped into GraphPad Prism XY, column or grouped tables, with a preview chart that shows significance stars, ready to copy or download.",
    "task": {
      "text": "Join plate-reader results to the plate layout, check them for quality, compute per-group statistics against controls, and produce tables ready to paste into Prism.",
      "verbs": [
        "derive",
        "compare",
        "clean",
        "summarize",
        "explore"
      ]
    },
    "data": {
      "text": "Per-well measurement tables from plate readers, joined to a per-well layout table of conditions, treatments, doses and plates",
      "item": "a well on a 96- or 384-well plate, with its conditions and measured values",
      "shapes": [
        "table",
        "per element",
        "judgements"
      ]
    },
    "stage": {
      "text": "analysing plate-based assay results after the reader run, before figures in Prism",
      "terms": [
        "analyze",
        "clean",
        "compare"
      ]
    },
    "mechanism": {
      "text": "A six-step wizard: upload and merge-key cards feed column selection, masking and formula columns. The merge produces a table that every later view reads. Global plate, value and group-by settings drive a plate heatmap and a bar chart, then tabbed statistics tables. A Prism step reshapes the same rows into tables with a preview chart.",
      "views": [
        "table view",
        "fixed-layout grid",
        "heatmap",
        "bar chart",
        "line chart",
        "summary stats",
        "form"
      ],
      "interactions": [
        "import",
        "select",
        "filter",
        "hover for detail",
        "toggle view",
        "exclude and refit",
        "sort",
        "export"
      ],
      "patterns": [
        "status pipeline",
        "dashboard"
      ]
    },
    "field": {
      "text": "plate-based assay statistics and dose-response screening in cell biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "plate based assay",
        "dose response",
        "assay window"
      ]
    },
    "workflow": {
      "name": "join measurements to a sample layout, compute group statistics against controls and export publication tables",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload a metadata CSV/TSV and one or more result files, or load the built-in template. Merge Key cards pick the Well and Plate columns for each file and show how many wells matched.",
          "parts": [
            "upload-merge-key"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "Choose the metadata and result columns to keep and rename them. Mask wells by an omit column and value or by a typed list of wells. Add formula columns such as (a+b)/c.",
          "parts": [
            "configure-columns"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Merge & Analyze gives match counts and a merged table that can hide masked wells. A plate heatmap shows each well's value in plate layout, and a bar chart shows group means with SEM, per plate.",
          "parts": [
            "merged-table",
            "plate-heatmap",
            "bar-chart"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Assay Window and Disease Window tabs compute fold change, Z-score, SSMD, Z', pooled SD and D-ratio, in mean and robust median/MAD forms, plus Welch p-values against a control, per plate. Outliers can be removed by Grubbs, IQR or ROUT, and p-values corrected by Holm or BH. A Dose-Response tab fits 4PL EC50s and runs a two-way ANOVA with post-hoc tests.",
          "parts": [
            "statistics-tables"
          ]
        },
        {
          "step": "export the result",
          "here": "Choose an XY, Column or Grouped Prism table and set the group-by columns, filters, sort order and how to split into separate tables. Transform it, preview the chart with 4PL fits and significance stars, then copy the TSV to Prism or download it as a CSV. Stats, merged data and figures also export as CSV or PNG.",
          "parts": [
            "prism-export",
            "statistics-tables",
            "merged-table"
          ]
        }
      ],
      "distinctive": [
        "Wells are matched on a Plate + Well key, with A1/A01 forms normalised. If a result file has no plate column, that file falls back to matching on Well only, with a warning.",
        "Screening-quality metrics (Z', SSMD, D-ratio) are reported in both mean and robust median/MAD versions for each group against the control.",
        "A second comparison axis (disease state against its control) is computed within each treatment group.",
        "The output is reshaped specifically into GraphPad Prism XY, column and grouped table layouts. When a zero dose sits on a log axis, the person chooses whether to replace it or drop it."
      ]
    }
  },
