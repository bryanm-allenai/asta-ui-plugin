  "app": {
    "title": "SpatialAIM results explorer",
    "summary": "The person points the sidebar at a single-cell reference file, a spatial transcriptomics file, an optional segmentation mask and an output folder. The pair is checked as soon as both files are set. They choose a tree linkage, any existing annotations to also start from, and one or more mapping methods. Run queues sweeps that cut the cluster tree at every number of cell types K and map each spot to one type, with a progress bar for each sweep. An overview table ranks every combination of starting clusters and method at its best K. In Explore, the person reads three criterion curves over K, jumps to the best K overall or for one criterion, and inspects the mapped cell types on UMAP and spatial maps, naming them and checking their marker genes. They can also set several methods side by side at one K and download any figure.",
    "task": {
      "text": "Pick the number of cell types at which a single-cell reference can be reliably mapped onto spatial data, and pick the mapping method to use, by scoring a sweep over K against several criteria.",
      "verbs": [
        "decide",
        "compare",
        "derive",
        "explore",
        "annotate"
      ]
    },
    "data": {
      "text": "A single-cell expression reference and a spatial expression dataset with spot coordinates. They are swept into one mapping per K, and each K's metrics go into one row of a table.",
      "item": "one combination of starting clusters, mapping method and K: a cut of a cluster tree into K cell types, with every spatial spot assigned to one of them",
      "shapes": [
        "table",
        "geospatial",
        "hierarchy",
        "categories"
      ]
    },
    "stage": {
      "text": "choosing the cell-type granularity and mapping method after both datasets are measured, before biological interpretation",
      "terms": [
        "analyze",
        "compare",
        "decide"
      ]
    },
    "mechanism": {
      "text": "A sidebar sets up the inputs and queues the sweeps. Pages share remembered choices of starting clusters, method and K. A ranked overview table opens a combination in Explore. There, linked criterion curves and best-K buttons move one K slider, which redraws the UMAP and spatial maps, the marker genes and the report cards. A right click on a cell type opens its detail dialog.",
      "views": [
        "table view",
        "line chart",
        "scatter plot",
        "map",
        "bar chart",
        "detail panel",
        "side-by-side panes",
        "form",
        "summary stats"
      ],
      "interactions": [
        "import",
        "select",
        "multi-select",
        "filter",
        "sort",
        "hover for detail",
        "zoom and pan",
        "toggle view",
        "parameter slider",
        "inline edit",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "linked views",
        "master-detail",
        "side-by-side comparison",
        "dashboard"
      ]
    },
    "field": {
      "text": "mapping a single-cell reference onto spatial transcriptomics in bioinformatics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "spatial transcriptomics",
        "cell type mapping",
        "single cell rna seq"
      ]
    },
    "workflow": {
      "name": "choose a granularity by sweeping a parameter and scoring every level",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Path fields (with browse buttons) for the scRNA .h5ad, ST .h5ad, an optional segmentation .tif and an output directory. The pair is validated as soon as both files are set, and problems open in a dialog.",
          "parts": [
            "setup-sidebar"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Pick average or Ward linkage, any annotation columns to also start from, and the baseline or reference mappers. Run queues the sweeps one after another, with a progress bar for each starting point.",
          "parts": [
            "setup-sidebar",
            "explore-page"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "The Overview ranks each starting point and method at its own best overall K by the overall score, with each criterion's score beside it. Multiselects filter the table, and a selected row opens in Explore.",
          "parts": [
            "overview-table"
          ]
        },
        {
          "step": "pick the level that scores best on several criteria",
          "here": "The Choose K card plots reconstruction, spatial organisation and coherence over K. The curves are linked, and a click on one sets the K slider. Best-K buttons per criterion and overall move the slider too, and a dialog shows the criterion-vs-criterion scatters with a Pareto filter.",
          "parts": [
            "choose-k-card",
            "explore-page"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "At the chosen K, UMAP and spatial maps share one legend, with a confidence threshold and a confidence colouring. A right click on a cell type opens a dialog where the person names it and looks at its marker genes, maps and violins.",
          "parts": [
            "mapping-maps",
            "cell-type-dialog",
            "reference-page"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Compare puts the chosen methods' spatial maps under one reference UMAP at one K, followed by combined reconstruction, cell-fraction, assortativity and modularity cards.",
          "parts": [
            "compare-page"
          ]
        },
        {
          "step": "export the result",
          "here": "Every figure has an Export popover that renders it as PNG, SVG or PDF to download.",
          "parts": [
            "mapping-maps",
            "compare-page"
          ]
        }
      ],
      "distinctive": [
        "Each criterion combines two curves by their harmonic mean, and the overall score is the harmonic mean of the criteria, so a K must do well on all of them",
        "Reconstruction is shown against a label-shuffle null, so the person sees how far a K sits above chance",
        "Pages and buttons unlock as runs finish: Overview and Reference after the first finished sweep, Compare once a starting point has two finished methods",
        "Cell-type names are tied to a K and shared by every method, because all methods cut the same tree",
        "An optional segmentation mask adds a shape-consistency score and a shape view for each cell type"
      ]
    }
  },
