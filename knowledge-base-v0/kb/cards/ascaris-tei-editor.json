  "app": {
    "title": "Ascaris: TEI editor for digital scholarly editions",
    "summary": "A person types or uploads a text, then selects passages and marks each one as a person, place, work, organization, event or term. The marked entities collect in a side panel, where duplicates can be merged by dragging one onto another and each entity gets labels and an authority record. Clicking a marked mention opens its annotations. A metadata tab describes the edition bibliographically, and a facsimile tab attaches page images. The result downloads as a TEI XML file with the entities in a stand-off section and the annotations linked to their mentions.",
    "task": {
      "text": "Encode a text as a digital scholarly edition by marking and identifying the named entities it mentions, annotating those mentions, describing the edition with metadata, and exporting it as TEI XML.",
      "verbs": [
        "annotate",
        "identify",
        "reconcile",
        "curate",
        "write"
      ]
    },
    "data": {
      "text": "One plain text per document, with marked mentions linked to typed entities, free-text annotations on the mentions, structured bibliographic metadata and attached page images.",
      "item": "a marked mention of a named entity in a text",
      "shapes": [
        "document",
        "spans",
        "categories",
        "notes",
        "table",
        "image collection"
      ]
    },
    "stage": {
      "text": "encoding and annotating a transcribed text, through to publishing it as a TEI edition",
      "terms": [
        "annotate",
        "report"
      ]
    },
    "mechanism": {
      "text": "An editable text pane with a toolbar of entity-type buttons wraps the selected text in a highlighted mention and adds the entity to a tabbed sidebar list, where entities of the same type merge by drag and drop and are described in place. Clicking a mention opens a dialog of its annotations. Tabs switch the main pane to a metadata form and a facsimile upload table, and a download menu exports TEI.",
      "views": [
        "text editor",
        "document reader",
        "sidebar list",
        "detail panel",
        "form",
        "table view"
      ],
      "interactions": [
        "import",
        "select text span",
        "apply label",
        "select",
        "drag to arrange",
        "inline edit",
        "write notes",
        "toggle view",
        "export"
      ],
      "patterns": [
        "category palette",
        "master-detail",
        "linked views"
      ]
    },
    "field": {
      "text": "named-entity markup for TEI digital scholarly editions in the digital humanities",
      "disciplines": [
        "humanities"
      ],
      "terms": [
        "digital scholarly editing",
        "tei encoding",
        "semantic publishing"
      ]
    },
    "workflow": {
      "name": "mark entities in a text, describe them, and export a structured edition",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Give the document a title, then type the text or upload a .txt, .docx or .pdf file. The text is extracted and the editor opens.",
          "parts": [
            "new-document"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "Select text in the editable pane and press Person, Place, Work, Organization, Event or Term. The mention is highlighted in its type's colour and a new entity appears in the side panel. Edits save automatically one second after typing stops.",
          "parts": [
            "text-editor"
          ]
        },
        {
          "step": "link mentions of the same thing and identify each entity",
          "here": "Drag one entity's block onto another of the same type to move its mentions and labels to the target. Expand a block to edit its labels and add an authority record URI.",
          "parts": [
            "entity-panel"
          ]
        },
        {
          "step": "write notes on marked items",
          "here": "Click a highlighted mention to open its annotations dialog. Add, edit or delete annotations, each with text, language, a motivation and a rights licence.",
          "parts": [
            "annotation-dialog"
          ]
        },
        {
          "step": "describe the item with structured metadata",
          "here": "In the Metadata tab, use plus and minus buttons to add or remove rows for titles, responsibilities, publication authority, place and date, identifiers, category (from a SKOS vocabulary), creation date, licence, sources, notes and abstract, then press Save Changes.",
          "parts": [
            "metadata-form"
          ]
        },
        {
          "step": "attach supporting images",
          "here": "In the Facsimile tab, upload png or jpg page images. They are listed with thumbnails.",
          "parts": [
            "facsimile-panel"
          ]
        },
        {
          "step": "export the result",
          "here": "Download › XML-TEI writes one <p> per line with each mention as a <ref>, the entities in <standOff> lists, the annotations in <listAnnotation>, and the metadata in the <teiHeader>, plus extent counts.",
          "parts": [
            "tei-export"
          ]
        }
      ],
      "distinctive": [
        "The six entity types map to TEI lists (listPerson, listPlace, listOrg, listBibl, listEvent and a term list), and the export is meant to validate against tei_all.",
        "Entities can be reconciled by dragging them onto each other, but only within the same type and document, and a merge cannot be undone.",
        "Each entity carries an authority record URI (such as VIAF or GeoNames) that is exported as sameAs.",
        "Annotation motivations follow the Web Annotation vocabulary, and each annotation carries a Creative Commons rights choice and created and modified timestamps.",
        "The document category is chosen from a SKOS concept scheme read from a Turtle file."
      ]
    }
  },
