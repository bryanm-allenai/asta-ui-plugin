  "app": {
    "title": "Country Flow — Panel designer · BD FACSCanto II",
    "summary": "The person names an experiment, chooses a species and turns a live/dead dye on or off. They search their lab's antibody catalog to pick the markers to measure, and can mark some as backbone so those markers go on every panel. A solver assigns each marker to a panel and a detector using reagents that are in stock. It flags markers that do not fit or have no usable reagent, warns about low-stock, expired or spillover-prone choices, and offers to add a panel. The person adds or removes panels until everything fits, enters the operator and run date, then exports a printable panel figure and a CSV with one row per panel × detector for the lab notebook.",
    "task": {
      "text": "Plan a multicolour flow cytometry experiment by splitting the chosen markers across panels so that each one gets a free detector and an antibody the lab has in stock, then record the plan for the notebook.",
      "verbs": [
        "plan",
        "derive",
        "curate",
        "lookup",
        "decide"
      ]
    },
    "data": {
      "text": "An inventory of antibody reagents (marker, species, fluor, clone, vendor, lot, location, expiry, stock status) matched against a fixed set of instrument detectors, which yields an assignment of markers to panel × detector slots.",
      "item": "an antibody vial in the catalog, or a marker placed in one detector slot of one panel",
      "shapes": [
        "table",
        "per element",
        "categories"
      ]
    },
    "stage": {
      "text": "planning the stain panels before a cytometry run, using the lab's antibody inventory",
      "terms": [
        "plan",
        "maintain"
      ]
    },
    "mechanism": {
      "text": "A setup column of experiment settings and a searchable marker picker drives a solver that redraws a board of panel tables on every change, with alerts for markers that do not fit and buttons to add panels. A separate catalog tab keeps the reagent inventory the solver draws on, and an export tab draws the same assignment as a printable figure and writes it out as a CSV.",
      "views": [
        "form",
        "list",
        "table view",
        "summary stats",
        "canvas"
      ],
      "interactions": [
        "search",
        "select",
        "keyboard shortcuts",
        "filter",
        "inline edit",
        "import",
        "export",
        "toggle view"
      ],
      "patterns": [
        "master-detail",
        "overview and detail"
      ]
    },
    "field": {
      "text": "multicolour flow cytometry panel design in immunology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "flow cytometry",
        "immunology",
        "panel design"
      ]
    },
    "workflow": {
      "name": "assign requested items to limited slots from an inventory and record the plan",
      "steps": [
        {
          "step": "set up the run's constraints",
          "here": "Experiment name, Human or Mouse species, and a checkbox for PI live/dead that reserves the PerCP-Cy5.5 detector on every panel. Switching species clears the picks.",
          "parts": [
            "experiment-setup"
          ]
        },
        {
          "step": "choose the items to place",
          "here": "A combobox search over the species' catalog markers, with arrow keys and Enter to add, shows which fluors are in stock for each marker. Each picked marker can be toggled Backbone or removed, and a counter shows slots needed against slots available.",
          "parts": [
            "marker-picker"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "A branch-and-bound solver places as many markers as possible, keeps panels evenly loaded, and avoids low-stock or expired vials and detectors that PI spills into. Each panel is drawn as a detector × marker × reagent × location table.",
          "parts": [
            "panel-board"
          ]
        },
        {
          "step": "resolve what does not fit",
          "here": "A red alert lists the markers left without a free detector, says how many panels the set needs and offers an 'Add Panel X' button. A note lists markers with no usable reagent, and 'Things to check' lists warnings about spillover, low stock and expiry.",
          "parts": [
            "panel-board"
          ]
        },
        {
          "step": "keep the inventory in order",
          "here": "The catalog tab filters by species and text, and lets the person add, edit or delete antibodies, import a CSV with loose header matching, sync from a published Google Sheet (replace or merge), and download the catalog or a blank template.",
          "parts": [
            "catalog-view",
            "catalog-import",
            "antibody-form"
          ]
        },
        {
          "step": "export the result",
          "here": "After the operator and run date are entered, the panels are drawn as a canvas figure that can be downloaded as a PNG or printed, and a CSV is written with one row per panel × detector.",
          "parts": [
            "export-view"
          ]
        }
      ],
      "distinctive": [
        "The slots are fixed by an instrument configuration: a set number of detectors per panel, each reading a family of fluor names, plus a viability dye that takes one detector on every panel.",
        "Backbone markers must take the same detector and reagent on every panel, while other markers go on one panel each.",
        "The solver's score ranks the most markers placed first, then even panel load, then penalties for low-stock or expired vials and for detectors that receive spillover from the viability dye.",
        "When the markers do not fit, the app computes the smallest number of panels that would hold them and offers to add one.",
        "Only reagents marked as not Out and read by a configured detector can be used, so the inventory directly limits what the plan can contain."
      ]
    }
  },
