  "app": {
    "title": "BlotGrid",
    "summary": "A person uploads one or more blot scans, one per replicate; text recognition fills in the target rows and lane names, and the scan can be straightened against a guide grid. The app proposes a box around every band in each target-by-lane cell, all the same size, and the person moves, adds, excludes and approves boxes on the image and in a table, checking doubtful ones against their intensity profile. They then run background-subtracted densitometry, divide each band by the loading control in the same lane (optionally as fold change against a reference lane), pool replicates into mean with SD, SEM or confidence interval and an optional significance test, and export a styled bar chart with the underlying CSV/XLSX tables.",
    "task": {
      "text": "Measure the intensity of every band on blot scans, normalize each target to a loading control in the same lane, and summarize replicates into an exportable figure and table.",
      "verbs": [
        "derive",
        "locate",
        "clean",
        "summarize",
        "compare"
      ]
    },
    "data": {
      "text": "Scanned blot images, each a grid of lanes (samples or conditions) by target rows, measured into a table of band intensities per blot, target and lane.",
      "item": "a band at one target row and one lane on a blot scan",
      "shapes": [
        "image collection",
        "image",
        "table"
      ]
    },
    "stage": {
      "text": "quantifying blot scans after imaging, before plotting and statistics",
      "terms": [
        "analyze"
      ]
    },
    "mechanism": {
      "text": "Tabs lead from upload through box layout, densitometry, normalization and replicate statistics to a chart; on the layout tab the on-image box editor and the editable box table change the same layout, and choosing a box shows its vertical intensity profile with the integrated interval. Any change to boxes or measurement settings clears the downstream results so they must be recomputed.",
      "views": [
        "image viewer",
        "thumbnail grid",
        "table view",
        "line chart",
        "bar chart",
        "form",
        "summary stats"
      ],
      "interactions": [
        "import",
        "select",
        "drag to arrange",
        "inline edit",
        "keyboard shortcuts",
        "zoom and pan",
        "accept or reject",
        "exclude and refit",
        "export"
      ],
      "patterns": [
        "linked views",
        "master-detail",
        "overview and detail"
      ]
    },
    "field": {
      "text": "Western blot densitometry in molecular biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "western blot",
        "densitometry"
      ]
    },
    "workflow": {
      "name": "measure regions on images, normalize to a reference, and summarize replicates",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload TIFF/PNG/JPG scans (one per replicate); local OCR reads printed target and lane labels or infers a neutral grid, and an optional alignment-grid panel estimates and applies a straightening angle.",
          "parts": [
            "upload-tab",
            "experiment-setup"
          ]
        },
        {
          "step": "mark every region to be measured",
          "here": "Detect all bands proposes one fixed-size box per band in each target × lane cell (classical, GelGenie or a local checkpoint), colour-coded as accepted, control, needs review or excluded fallback.",
          "parts": [
            "roi-tab",
            "roi-canvas"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "Drag boxes on the blot, nudge with arrow keys, add missed bands by target and lane, untick Use in the table, inspect a box's vertical intensity profile, and approve labels after attesting the whole image was reviewed.",
          "parts": [
            "roi-canvas",
            "roi-table",
            "band-profile"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Run densitometry on all blots: net integrated density with local, rolling-ball or fixed background, profile-guided or full-rectangle, flagging saturated and non-positive bands.",
          "parts": [
            "quantify-normalize",
            "experiment-setup"
          ]
        },
        {
          "step": "compute a value relative to a reference",
          "here": "Divide each target by the loading control in the same lane, optionally as fold change against a chosen reference lane; without a control, net intensity is carried forward.",
          "parts": [
            "quantify-normalize"
          ]
        },
        {
          "step": "summarize replicates and test differences",
          "here": "Pool blots by lane label into mean, SD, SEM, t-based 95% CI and N per target and condition, with an optional t-test or ANOVA for one target.",
          "parts": [
            "quantify-normalize"
          ]
        },
        {
          "step": "export the result",
          "here": "Style a bar chart per target (error bars, points, palette, size in inches) and download PNG/TIFF/SVG/PDF, a summary CSV, an all-data XLSX, and a project JSON.",
          "parts": [
            "plot-export",
            "experiment-setup"
          ]
        }
      ],
      "distinctive": [
        "Every box on a blot shares one locked width and height, so resizing any handle resizes all and no band gets its own measurement area.",
        "Normalization is per lane against a chosen loading-control row, and is skipped honestly (intensity in arbitrary units) when no control is present.",
        "Saturated pixels are flagged in either band polarity, since clipped exposures break the linear range.",
        "Scan straightening always rotates from the untouched upload against a display-only guide grid, and any rotation or box change clears approvals and results.",
        "A restored project only reapplies saved box layouts after the re-uploaded image matches its stored SHA-256."
      ]
    }
  },
