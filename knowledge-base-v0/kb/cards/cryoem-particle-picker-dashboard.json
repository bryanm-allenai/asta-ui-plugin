  "app": {
    "title": "Particle Picker Statistics Dashboard",
    "summary": "A person drops in a particle-picking file in RELION .star, coordinate CSV or EMAN2 .box format. The interface reads the file, finds the column naming each micrograph and the coordinate columns, and shows the file's name, size and type. It then shows summary counts of particles per micrograph, a bar chart of micrographs ranked by how many particles each has, a histogram of those counts, and a scatter plot of where the particles sit. The person gets an overview of how evenly picking spread across the micrographs and the image area.",
    "task": {
      "text": "Summarise a particle-picking result by counting particles per micrograph and showing where the picks fall, so a person can judge whether picking went evenly.",
      "verbs": [
        "summarize",
        "explore"
      ]
    },
    "data": {
      "text": "A table of picked particles from one picking run. Each row has image coordinates and, where present, the micrograph it came from plus other per-particle metadata such as defocus.",
      "item": "a picked particle: its x and y position on a micrograph, and the micrograph's name",
      "shapes": [
        "table"
      ]
    },
    "stage": {
      "text": "checking particle picks after automated picking, before classification",
      "terms": [
        "explore"
      ]
    },
    "mechanism": {
      "text": "Loading a file reveals a single scrolling dashboard of stacked cards: summary number tiles, then a ranked bar chart, a histogram and a coordinate scatter plot, all drawn from the same per-micrograph grouping. Each chart can be hovered for values and zoomed with Plotly. A Python Dash version of the same dashboard adds a binned density heatmap and defocus histograms.",
      "views": [
        "summary stats",
        "bar chart",
        "scatter plot",
        "heatmap"
      ],
      "interactions": [
        "import",
        "hover for detail",
        "zoom and pan"
      ],
      "patterns": [
        "dashboard"
      ]
    },
    "field": {
      "text": "particle-picking quality statistics in cryo-EM",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "cryo em",
        "particle picking",
        "structural biology"
      ]
    },
    "workflow": {
      "name": "summarise a collection by counts per group and spatial spread",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Drag a .star, .csv or .box file onto the drop area, or click to browse. Files over 50MB or with the wrong extension are refused, and the file's name, size and type are shown.",
          "parts": [
            "upload-panel"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Particles are grouped by an automatically found micrograph column into per-micrograph counts. From these come the total, mean, min, max and standard deviation, shown as tiles.",
          "parts": [
            "summary-tiles"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "A bar chart ranks micrographs by particle count, showing the top 50. Hovering a bar gives the micrograph's name and count.",
          "parts": [
            "distribution-chart"
          ]
        },
        {
          "step": "summarise the spread of a quantity",
          "here": "A 30-bin histogram shows how particles-per-micrograph counts are distributed across the whole run.",
          "parts": [
            "histogram-chart"
          ]
        },
        {
          "step": "see where items fall in space",
          "here": "A WebGL scatter plots every particle's x and y coordinates, sampling down to 10,000 points for large files. The Dash version adds a binned density heatmap and defocus histograms.",
          "parts": [
            "scatter-chart",
            "dash-dashboard"
          ]
        }
      ],
      "distinctive": [
        "Reads three community file formats (RELION .star data_particles loop, coordinate CSV, EMAN2 .box) and guesses the micrograph and coordinate columns from a list of known names",
        "Spread of particles per micrograph is the quantity of interest, shown as ranked bars, a histogram and a standard deviation",
        "Large pick sets are randomly sampled to 10,000 points before the coordinate scatter is drawn",
        "The server version also bins picks into a 2D density heatmap and plots defocus distributions when those columns exist"
      ]
    }
  },
