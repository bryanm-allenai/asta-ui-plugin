  "app": {
    "title": "Yellow fever in Brazil: case and vaccination dashboard",
    "summary": "A person opens a dashboard of charts built from bundled case records (one per municipality, month, sex and age band) and vaccine dose counts. They open a filter panel, choose a year, region, state, age band and sex, and apply it. The region chart then sums cases at the next level down: by region, by state once a region is chosen, or by municipality once a state is chosen. The efficacy chart sets cases against vaccine doses over time. Fixed charts beside them show yearly cases, the monthly seasonal pattern, and cases by age band and sex, so the person gets a descriptive overview of where, when and among whom cases occur.",
    "task": {
      "text": "Summarise disease case counts by place, period and population group, and set them against vaccination doses, in one filterable descriptive dashboard.",
      "verbs": [
        "summarize",
        "explore",
        "compare"
      ]
    },
    "data": {
      "text": "Aggregated surveillance records of confirmed cases by municipality, month, sex and age band, with coordinates, plus vaccine doses applied by state, month and year.",
      "item": "an aggregated case count for one municipality in one month, sex and age band",
      "shapes": [
        "table",
        "time series"
      ]
    },
    "stage": {
      "text": "describing surveillance case counts once they are compiled, before deeper analysis",
      "terms": [
        "explore"
      ]
    },
    "mechanism": {
      "text": "A collapsible filter form sends its choices to a data service, which filters the case and dose records and re-aggregates them for the region bar chart and the cases-versus-doses line chart. Fixed line, scatter and stacked column charts sit beside them in a two-column grid, and every chart shows values on hover.",
      "views": [
        "form",
        "bar chart",
        "line chart",
        "scatter plot"
      ],
      "interactions": [
        "filter",
        "hover for detail"
      ],
      "patterns": [
        "dashboard"
      ]
    },
    "field": {
      "text": "descriptive epidemiology of case surveillance and vaccination in public health",
      "disciplines": [
        "medicine"
      ],
      "terms": [
        "descriptive epidemiology",
        "disease surveillance",
        "vaccination coverage"
      ]
    },
    "workflow": {
      "name": "summarise counts by place, period and group in a filterable dashboard",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Case records and dose counts load from bundled JSON files at start-up, with an empty filter. There is no upload.",
          "parts": [
            "chart-grid",
            "region-chart",
            "efficacy-chart"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "In the expandable Filtro panel the person picks Ano, Região, Estado, Idade and Gênero, then presses Aplicar Filtro. Resetar Filtro clears all the choices.",
          "parts": [
            "filter-panel"
          ]
        },
        {
          "step": "total the counts by category, one level down from the current selection",
          "here": "Cases are summed by region. Once a region is chosen they are summed by state, and once a state is chosen, by municipality, in a column chart.",
          "parts": [
            "region-chart"
          ]
        },
        {
          "step": "set two quantities against each other over time",
          "here": "Lines for cases and vaccine doses applied are drawn per year, or per year-month when a year is filtered, in a chart titled as campaign efficacy.",
          "parts": [
            "efficacy-chart"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Fixed line charts show case counts per year and the mean cases for each calendar month as a seasonal profile.",
          "parts": [
            "temporal-charts"
          ]
        },
        {
          "step": "break the counts down by population group",
          "here": "A stacked column chart shows cases by age band, split by sex, with stack totals. A scatter plot shows age against case counts.",
          "parts": [
            "age-sex-charts"
          ]
        }
      ],
      "distinctive": [
        "The level the region chart totals at follows the filter: region, then state, then municipality.",
        "Case counts are set against vaccine doses on one chart, to judge whether vaccination campaigns were effective.",
        "Dose counts are filtered only by year, region and state, because the dose records carry no age or sex.",
        "A seasonal profile averages cases by calendar month across years.",
        "Cases are broken down by age band and sex together in stacked columns."
      ]
    }
