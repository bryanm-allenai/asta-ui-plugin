  "app": {
    "title": "Sentinel Browser (vresto)",
    "summary": "A person picks a date range and draws an area on a map. The map's grid tiles are shaded by how many satellite scenes cover each one in those dates. They search the catalogue with filters for collection, product level and cloud cover, open a quicklook or the metadata of a result, or click a grid tile, choose one of its scenes and stream its true-colour image onto the map. They can lay contextual raster overlays over the streamed tile and click to read the value under the cursor. They can also pick a point and chart its vegetation index over a period, scrub through the dates to bring each date's image onto the map, and export the series as CSV. In a separate tab they fetch a product's bands and download chosen band and resolution pairs to a folder.",
    "task": {
      "text": "Find the satellite scenes that cover an area and period, preview them on a map, read values and time series at points, and download the bands needed for analysis.",
      "verbs": [
        "explore",
        "locate",
        "lookup",
        "summarize",
        "derive"
      ]
    },
    "data": {
      "text": "A catalogue of multispectral satellite scenes on a fixed global tiling grid, each with an acquisition date, cloud cover and per-band raster files, plus gridded contextual layers (land cover, elevation, vegetation, temperature, soil moisture) and per-point time series sampled from the scenes",
      "item": "one satellite scene (product) covering one grid tile on one date",
      "shapes": [
        "geospatial",
        "image collection",
        "field",
        "time series",
        "table"
      ]
    },
    "stage": {
      "text": "exploring and gathering satellite imagery for a study area, before analysis",
      "terms": [
        "explore",
        "collect"
      ]
    },
    "mechanism": {
      "text": "A central map shows the tiling grid coloured by scene counts for the chosen dates. Clicking a tile opens a scene chooser and streams the chosen image onto the map, where overlays and a value inspector read rasters at a point. A floating panel charts one point over time, and its slider brings the selected date's image back onto the map. A side panel searches the catalogue and lists result cards that open quicklooks and metadata, and a download tab turns a band-by-resolution checkbox matrix into files.",
      "views": [
        "map",
        "sidebar list",
        "list",
        "line chart",
        "detail panel",
        "image viewer",
        "form",
        "summary stats"
      ],
      "interactions": [
        "zoom and pan",
        "select",
        "filter",
        "search",
        "hover for detail",
        "toggle view",
        "time slider",
        "multi-select",
        "export",
        "import"
      ],
      "patterns": [
        "overview and detail",
        "linked views",
        "master-detail",
        "focus and context"
      ]
    },
    "field": {
      "text": "satellite remote sensing and earth observation in earth science",
      "disciplines": [
        "earth science"
      ],
      "terms": [
        "remote sensing",
        "earth observation",
        "ndvi"
      ]
    },
    "workflow": {
      "name": "find the images that cover a place and period, preview them, and pull data out of them",
      "steps": [
        {
          "step": "filter to the items that matter",
          "here": "a date range picker, a drawn area on the map, and a search panel with collection, product level, cloud-cover slider and max results; Search fills a list of product cards",
          "parts": [
            "map-view",
            "search-panel"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "grid tiles are shaded by scenes per month in the chosen dates; zoomed out, whole grid zones are shaded instead; hovering a tile shows its count and best cloud cover",
          "parts": [
            "map-view"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "clicking a tile opens a chooser of its scenes with thumbnails and streams the chosen true-colour image onto the map; result cards open a quicklook or parsed metadata in a dialog",
          "parts": [
            "scene-chooser",
            "product-viewer"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "switch on a contextual overlay (land cover, elevation, vegetation index, surface temperature, soil moisture and more) and turn on Inspect values to read the value under a click in a popup",
          "parts": [
            "overlay-controls",
            "map-view"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Pick a point charts a variable over a chosen period, with clear readings as a line and cloudy or snowy readings as grey dots; the slider or a chart click brings that date's image onto the map",
          "parts": [
            "pixel-history"
          ]
        },
        {
          "step": "export the result",
          "here": "CSV saves the point's series; the download tab fetches a product's bands into a band-by-resolution checkbox matrix with select-by-resolution buttons, then downloads the chosen files to a folder",
          "parts": [
            "pixel-history",
            "download-tab"
          ]
        }
      ],
      "distinctive": [
        "coverage is shown on a fixed global tiling grid, coloured by how many scenes fall in the chosen dates, so a person sees where imagery is dense before searching",
        "each point reading is flagged clear, cloud, shadow or snow by the scene's own per-pixel classification, not the scene-wide cloud percentage",
        "the time-series slider is linked back to the map, so a dip in the curve can be checked against that date's image",
        "the map click is shared by modes: selecting tiles, inspecting overlay values and picking a history point exclude one another",
        "imagery streams from either an authenticated or an anonymous public source, depending on which credentials are present"
      ]
    }
  },
