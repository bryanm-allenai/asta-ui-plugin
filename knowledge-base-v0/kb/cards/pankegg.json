  "app": {
    "title": "PanKEGG: browse and compare metagenome bins by quality, taxonomy and KEGG pathway completeness",
    "summary": "A person builds a database from their per-sample annotation, classification and quality outputs, then opens it in the browser. They browse the bins of each sample, sort and filter them by completeness, contamination, a quality threshold or a taxonomic rank, and plot bin quality. They browse the pathways found, with a completion percentage that is recalculated for the samples or bins they pick, open the orthologs behind each pathway, and copy them out to colour the pathway in KEGG. They compare two samples or two bins through pathway heatmaps, quality scatter plots, PCA and tables of shared pathways, compare taxonomic make-up across samples, and export the filtered bin and pathway tables as files.",
    "task": {
      "text": "Explore and compare metagenome bins across samples by their quality, taxonomy and how complete their metabolic pathways are.",
      "verbs": [
        "explore",
        "compare",
        "derive",
        "summarize",
        "identify",
        "lookup"
      ]
    },
    "data": {
      "text": "A relational database of genome bins grouped by sample. Each bin has quality estimates, a taxonomic classification down to species and annotated orthologs, and the orthologs are linked to reference pathways that have a known total number of orthologs.",
      "item": "a genome bin from one sample, with its quality, taxonomy and annotated orthologs",
      "shapes": [
        "table",
        "hierarchy",
        "categories",
        "network"
      ]
    },
    "stage": {
      "text": "exploring and comparing annotated genome bins after binning, classification and annotation, before downstream analysis",
      "terms": [
        "explore",
        "compare"
      ]
    },
    "mechanism": {
      "text": "Server-rendered tables of bins, pathways and orthologs are linked to each other: a bin opens its pathways or orthologs, and a pathway opens the bins that carry it. Filters recompute pathway completion for the chosen subset. Separate comparison pages fetch JSON for two chosen samples or bins and draw heatmaps, scatter plots, PCA and bar charts of shared pathways next to each other.",
      "views": [
        "table view",
        "heatmap",
        "scatter plot",
        "bar chart",
        "side-by-side panes",
        "detail panel",
        "summary stats"
      ],
      "interactions": [
        "filter",
        "search",
        "sort",
        "select",
        "toggle view",
        "hover for detail",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "side-by-side comparison",
        "linked views",
        "master-detail"
      ]
    },
    "field": {
      "text": "metagenome bin quality, taxonomy and KEGG pathway completeness in metagenomics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "metagenomics",
        "bioinformatics",
        "metabolic pathways"
      ]
    },
    "workflow": {
      "name": "browse annotated items by group, filter by quality, and compare their feature content",
      "steps": [
        {
          "step": "bring the data in",
          "here": "A command-line step builds an SQLite database from a CSV that lists, for each sample, its annotation, classification and quality files. The app is then started on that database.",
          "parts": [
            "bins-browser"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Bins are listed under their sample. The person can sort by name, completeness or contamination, switch on a quality filter (completeness − 5×contamination > 50), and search by sample, bin or any taxonomic rank, including 'unclassified'.",
          "parts": [
            "bins-browser",
            "bin-quality-plot"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Each pathway gets a completion percentage (orthologs detected ÷ orthologs the pathway has in total), recalculated for the sample or bin chips chosen in the filter. The person can also search by map name or ortholog ID.",
          "parts": [
            "maps-browser"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "'Toggle ko_ids' lists a pathway's orthologs, coloured by whether they officially belong to it. 'Highlight pathways' opens a side panel that copies the IDs, ready to paste into KEGG's map colouring.",
          "parts": [
            "maps-browser",
            "ko-highlight-panel"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Two samples or two bins are picked from dropdowns. Their pathway-completion heatmaps (by pathway group), quality scatter plots and bin PCA appear next to each other, along with a searchable table and bar chart of the pathways they share or don't share.",
          "parts": [
            "sample-vs-sample",
            "bin-vs-bin"
          ]
        },
        {
          "step": "summarize the collection by category",
          "here": "For a chosen rank, a bar chart shows each sample's taxonomic composition as a share of its bins, and a clustered heatmap shows pathways against taxa. A PCA of samples is based on maps, orthologs or taxonomy.",
          "parts": [
            "taxonomy-comparison",
            "sample-pca"
          ]
        },
        {
          "step": "export the result",
          "here": "'Export Current State' saves the filtered pathway table, and the bin list exports too, as files for further analysis.",
          "parts": [
            "maps-browser"
          ]
        }
      ],
      "distinctive": [
        "Pathway completion is the share of a reference pathway's orthologs that were detected, and it is recomputed for whichever samples or bins are selected.",
        "A fixed field threshold on quality (completeness − 5×contamination > 50) acts both as a filter on the bin list and as the dividing line in the quality scatter plots.",
        "Orthologs are coloured by whether they officially belong to the pathway, and they can be copied out to colour the pathway diagram in an external reference database.",
        "Pathway heatmaps are split by a fixed grouping of pathways into reference sub-categories, and the person picks which groups to draw.",
        "Taxa can be compared at any of seven ranks, and placeholder rank labels count as 'unclassified'."
      ]
    }
  },
