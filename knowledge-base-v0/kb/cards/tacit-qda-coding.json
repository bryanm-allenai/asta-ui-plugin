  "app": {
    "title": "TACIT",
    "summary": "A researcher loads interview transcripts as Word files and picks a coding framework: a pluggable set of dimensions with polarities, definitions and literature. They can also draft a framework from retrieved literature, or let a codebook grow through open coding. A language model drafts coded segments for each transcript, window by window. The researcher then works through every segment, confirming, revising or deleting its codes and adding passages the model missed, and every change goes into an audit trail. The confirmed codings feed crosstabs by respondent attributes, co-occurrence and theme structures, and a blind double-coding reliability check. The results are exported as Excel, Word and JSON files, with a methods sentence ready for the paper.",
    "task": {
      "text": "Code qualitative transcripts against a theoretical framework with a model's draft, keep the researcher's corrections as an audited record, and report how the codes vary, cluster and agree between coders.",
      "verbs": [
        "annotate",
        "review",
        "reconcile",
        "summarize",
        "derive",
        "organize",
        "write"
      ]
    },
    "data": {
      "text": "A corpus of interview or hearing transcripts, each with respondent attributes, coded into segments against a codebook of dimensions and polarities, plus reviewers' change logs and coders' judgements.",
      "item": "a coded segment of one respondent's transcript: a verbatim passage with its codes and rationale",
      "shapes": [
        "text corpus",
        "spans",
        "categories",
        "judgements",
        "table",
        "events",
        "network",
        "hierarchy"
      ]
    },
    "stage": {
      "text": "coding and reviewing transcripts against a framework, then analysing and checking the codes before write-up",
      "terms": [
        "annotate",
        "review",
        "analyze",
        "confirm"
      ]
    },
    "mechanism": {
      "text": "Tabs follow the work in order: run the coding, review segments one page at a time from a respondent picker with code multiselects and status filters, then crosstab, co-occurrence heatmap, theme and reliability views that are all computed from the same workspace of reviewed records. A sidebar holds the framework, model provider and language settings that drive every tab.",
      "views": [
        "form",
        "list",
        "detail panel",
        "table view",
        "heatmap",
        "summary stats",
        "network diagram",
        "tree view",
        "text editor"
      ],
      "interactions": [
        "import",
        "select",
        "filter",
        "apply label",
        "inline edit",
        "accept or reject",
        "undo",
        "export",
        "write notes",
