        "dashboard"
      ]
    },
    "field": {
      "text": "theory-driven thematic analysis of interview transcripts in qualitative social research",
      "disciplines": [
        "social science"
      ],
      "terms": [
        "thematic analysis",
        "deductive coding",
        "inter rater reliability"
      ]
    },
    "workflow": {
      "name": "apply codes from a codebook to passages of text, review them and check agreement",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload .docx transcripts; the sidebar picks the active framework (dimensions × polarity) and the model provider. A Framework builder tab can draft a framework from OpenAlex abstracts and approve it one dimension at a time.",
          "parts": [
            "sidebar-settings",
            "run-analysis",
            "framework-builder"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "A model codes each transcript in overlapping windows into verbatim segments with codes and rationales. There is a dry run on pasted text first, and an open mode in which the codebook grows across transcripts.",
          "parts": [
            "run-analysis"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "Pick a respondent, filter to pending segments or one code, and go through 5 per page: edit the title, quote and codes, then Confirm or Delete. Deleted segments can be restored, and missed passages added with a reason. A progress bar counts reviewed segments.",
          "parts": [
            "code-review"
          ]
        },
        {
          "step": "keep a record of changes",
          "here": "Every change is logged against the model's original codes. A review report gives review, modify and delete rates, code-level changes, the full audit trail and a methods sentence. Quotes are checked word for word against the transcript.",
          "parts": [
            "code-review"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Crosstabs of codes, dimensions or polarity by respondent descriptor, with a chi-square that is withheld when its assumptions fail. Also a co-occurrence heatmap, a cross-case matrix and polarity balance. Themes are grouped by a model or by clustering and drawn as a Gioia data structure.",
          "parts": [
            "cross-analysis",
            "theme-structure"
          ]
        },
        {
          "step": "find where people disagree and resolve it",
          "here": "Build a sampling frame of respondent turns, draw a seeded blind sample, issue coding sheets and read them back. This gives per-code and pooled κ, PABAK, AC1 and Krippendorff's α, a disagreement list and the model's precision and recall.",
          "parts": [
            "reliability"
          ]
        },
        {
          "step": "export the result",
          "here": "Download Excel, Word and JSON, plus each transcript as a Word file with codes as comments on the coded passages, or an unmarked copy with the codebook for hand coding.",
          "parts": [
            "export"
          ]
        }
      ],
      "distinctive": [
        "The model's coding is kept only as a draft. Its original codes are stored beside the researcher's final ones, so the correction rate becomes a reportable number.",
        "The framework is a pluggable file of dimensions, optional polarity poles, definitions, exclusions and grounding citations, and it drives the prompts, the labels and which analyses appear.",
        "Statistics refuse to print when their assumptions fail (a chi-square p-value is withheld), and the reliability frame includes unmarked units so recall means something.",
        "Shipped reference codings are read-only: editing one saves a derived copy and records where it came from.",
        "Models can run locally, and runs whose prompt would not fit the context window are refused, so transcripts need not leave the machine."
      ]
    }
  },
