  "app": {
    "title": "ReVSeq Dashboard: multi-virus sequencing surveillance",
    "summary": "A person opens an overview of weekly detections for every virus, shown as stacked bars from both sequencing and PCR, and hovers to see how many detections the other method confirmed. They choose one virus from a menu, switch between sequencing and PCR counts, and play a week-by-week map of detections by region. They then check sequencing depth along the annotated genome for all samples, for each subtype or for individual samples, picking a segment for segmented viruses, and see where the samples sit on embedded phylogenetic trees. A separate co-infection page shows which viruses occur together in the same sample as a pair-count heatmap with a co-infection frequency bar, and shows the coverage of each virus in a chosen co-infected sample. What they come away with is a shared, up-to-date picture of what is circulating, where, how well it was sequenced, and what occurs together.",
    "task": {
      "text": "Publish and read an up-to-date surveillance overview of pathogen detections by week and region, together with genome coverage quality, phylogenetic placement and co-occurrence for each pathogen.",
      "verbs": [
        "monitor",
        "summarize",
        "compare",
        "locate",
        "explore"
      ]
    },
    "data": {
      "text": "Per-sample detection metadata from two assays (sequencing and PCR) with date, region and agreement flags; per-position read depth for each sample across reference genomes or segments; GenBank gene annotations; and phylogenetic tree datasets.",
      "item": "a clinical sample with the pathogens detected in it, its collection week and region, and its read depth along the genome",
      "shapes": [
        "table",
        "time series",
        "geospatial",
        "sequence",
        "spans",
        "hierarchy",
        "categories"
      ]
    },
    "stage": {
      "text": "sharing surveillance results after sequencing and data curation, for exploration by partners",
      "terms": [
        "report",
        "explore"
      ]
    },
    "mechanism": {
      "text": "Server-side services pre-render Plotly charts from harmonised metadata and depth files, and the pages embed them in frames. A menu moves between an all-pathogen overview, one page per pathogen and a co-infection page. Radio buttons switch the data source (sequencing or PCR) and the coverage level (all samples, subtypes or individuals), and dropdowns pick a segment, subtype or co-infected sample, which is fetched without reloading the page.",
      "views": [
        "bar chart",
        "map",
        "line chart",
        "sequence track",
        "heatmap",
        "summary stats",
        "dendrogram"
      ],
      "interactions": [
        "hover for detail",
        "toggle view",
        "select",
        "time slider",
        "zoom and pan"
      ],
      "patterns": [
        "dashboard",
        "overview and detail",
        "small multiples"
      ]
    },
    "field": {
      "text": "genomic surveillance of respiratory viruses, using read-depth coverage and phylogenetics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "genomic surveillance",
        "virology",
        "phylogenetics"
      ]
    },
    "workflow": {
      "name": "publish a surveillance overview of detections over time and place, with data quality per item",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Curation pipelines turn BAM files and metadata into TSVs and depth JSONs. On load, virus names and region spellings are harmonised to configured canonical names, and charts are re-rendered only when an input file has changed.",
          "parts": [
            "home-overview"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The home page shows weekly stacked bars of detections per virus, separately for sequencing and PCR, with total sequence and detection counts. Hovering a bar shows how many detections the other assay matched out of the weekly total.",
          "parts": [
            "home-overview"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "A 'Select strain' menu opens one virus's page. Sequencing/PCR radio buttons switch its bar chart, its map and its total-count metric together.",
          "parts": [
            "strain-page",
            "strain-weekly-bars-map"
          ]
        },
        {
          "step": "locate where and when it happens",
          "here": "A choropleth of detections per region is animated by week, with a slider to scrub through the weeks.",
          "parts": [
            "strain-weekly-bars-map",
            "home-overview"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "A coverage plot shows depth (log scale) along the genome: median and IQR across all samples, one median per subtype, or individual sample traces capped at a set number. A gene annotation track sits beneath, and a segment selector appears for segmented viruses.",
          "parts": [
            "coverage-pileup"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Embedded Nextstrain/Auspice trees place the new samples among public genomes, filtered to show the new nodes.",
          "parts": [
            "phylo-tree"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "The co-infection page counts the samples that share each pair of viruses in an upper-triangle heatmap, with a bar of each virus's co-infection frequency. Choosing a co-infected sample loads a coverage plot for each virus found in it.",
          "parts": [
            "coinfection-heatmap",
            "coinfection-sample-pileup"
          ]
        }
      ],
      "distinctive": [
        "Two detection assays (sequencing and PCR) are kept as separate sources throughout, and each count shows how many detections the other assay matched.",
        "Data quality is read as sequencing depth along an annotated reference genome, at three levels: all samples, per subtype and per sample. Segmented genomes are handled one segment at a time.",
        "Co-occurrence of pathogens within one sample is summarised as pair counts, plus a per-pathogen frequency against all detections.",
        "Pathogens, modules, region map (any GeoJSON) and name aliases are set in one configuration file, so other surveillance projects can reuse it without code changes."
      ]
    }
  },
