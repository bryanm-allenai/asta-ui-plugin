  "app": {
    "title": "Sentinel — Antibody Developability Designer",
    "summary": "A person browses a precomputed library of variable-domain sequences as scored cards, or pastes a heavy/light pair to have it scored live, and narrows the collection with filters on the composite score, the count of high-severity liabilities, and which risk axes must be flagged clean. A combination explorer lets them tick which heavy and which light parts to consider, scores every pairing, and shows the grid as a colour-coded matrix with a ranked leaderboard beside it. Clicking any card or cell opens one candidate in full: a radar of its risk axes with their percentile against a reference distribution, a table of residue-level liabilities with their position and region, ranked single-residue fixes each re-scored, a per-position substitution heatmap, and a combined redesign showing the score before and after with the changed residues highlighted in the sequence. Reports and leaderboards export as CSV, and the report prints as a one-page PDF.",
    "task": {
      "text": "Triage candidate molecules by computing risk axes and residue-level liabilities from sequence, ranking them against a reference distribution, and testing single-residue edits that improve the score.",
      "verbs": [
        "triage",
        "derive",
        "compare",
        "identify",
        "decide"
      ]
    },
    "data": {
      "text": "Amino-acid sequences for paired variable domains, each annotated per residue with a numbering code and a region label, plus derived per-candidate metrics with percentiles and flags, and marked liability motifs at known positions.",
      "item": "one candidate molecule: a paired heavy/light variable-domain sequence (or a single domain)",
      "shapes": [
        "sequence",
        "table",
        "spans",
        "per element"
      ]
    },
    "stage": {
      "text": "analysing designed candidates after sequence design and before committing lab work, comparing them against a reference set",
      "terms": [
        "analyze",
        "compare"
      ]
    },
    "mechanism": {
      "text": "A tile gallery and a pairing matrix give the overview, both driven by one filter panel of sliders and per-axis checkboxes; clicking a tile or a matrix cell opens a detail report that combines a radar of percentile axes, a liability table, ranked edit suggestions, a position-by-substitution heatmap, and a before/after sequence diff. Everything is served from an embedded precomputed library, with an optional backend that scores pasted sequences through the same views.",
      "views": [
        "thumbnail grid",
        "heatmap",
        "detail panel",
        "table view",
        "summary stats",
        "radar chart",
        "sequence track",
        "form",
        "list"
      ],
      "interactions": [
        "import",
        "filter",
        "multi-select",
        "select",
        "hover for detail",
        "toggle view",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "master-detail",
        "linked views",
        "dashboard",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "sequence-based developability triage in antibody engineering",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "antibody engineering",
        "developability",
        "protein biophysics"
      ]
    },
    "workflow": {
      "name": "score every candidate against a reference distribution, open the risky ones, and test edits that improve the score",
      "steps": [
        {
          "step": "bring the data in and look over every item at a glance",
          "here": "a tile per library molecule with its score out of 100, a risk band, and counts of green/amber/red axes and high-severity liabilities; or a pasted heavy and light sequence scored live through a connected backend",
          "parts": [
            "library-gallery",
            "custom-sequence-input"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "sliders for minimum score and maximum high-severity liabilities, plus a checkbox per axis to require a clean flag; the same panel drives both the gallery and the pairing matrix",
          "parts": [
            "design-filters"
          ]
        },
        {
          "step": "combine parts and compare every combination",
          "here": "tick which heavy and which light parts to include; every pairing is scored and drawn as a colour-coded matrix with native pairings outlined, next to a ranked top-twelve leaderboard labelled native or chimera",
          "parts": [
            "combination-explorer",
            "design-filters"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "a report with a radar of the axes, each axis as value plus percentile against the reference set with a green/amber/red dot, a plain-language risk summary, and a table of liabilities sorted by severity with residues, site and region",
          "parts": [
            "report-view"
          ]
        },
        {
          "step": "compute a value from the data for every possible edit",
          "here": "ranked single-residue fixes for each flagged liability, each one applied and re-scored with its score change, guardrail counts and binding-risk label; plus a position-by-amino-acid heatmap of the score change for every substitution at every loop position",
          "parts": [
            "mutation-designer",
            "dms-heatmap"
          ]
        },
        {
          "step": "apply the chosen changes together and compare before with after",
          "here": "a redesign panel shows score before → after with the delta, the applied substitutions as chips, which liabilities cleared or appeared, the sequence with changed residues highlighted, and a button to open the redesigned variant's own report",
          "parts": [
            "redesign-panel"
          ]
        },
        {
          "step": "export the result",
          "here": "per-report CSV generated in the browser, a CSV of the current leaderboard, and a print stylesheet that hides the controls so the report saves as a one-page PDF",
          "parts": [
            "report-view",
            "combination-explorer"
          ]
        }
      ],
      "distinctive": [
        "flags are percentiles within a reference distribution of existing clinical-stage molecules rather than absolute thresholds, so an item at the median scores clean and the reference count is shown in the header",
        "every proposed edit is re-run through the whole scoring pipeline rather than looked up, and carries guardrails: whether it clears its target, whether it introduces new severe liabilities or new red axes, and how conservative the substitution is on a substitution matrix",
        "edits in the most binding-critical loop are never auto-recommended and are reported as skipped for manual review, so the combined redesign deliberately leaves that region untouched",
        "a group of structure-derived axes is computed but shown deliberately unflagged, because no reference distribution exists for them yet",
        "a separate page reports rank correlations between each computed axis and measured laboratory assays, with the physically expected axis/assay pairs outlined",
        "the whole app runs from an embedded precomputed library with no server; connecting a backend is what unlocks scoring an arbitrary pasted sequence"
      ]
    }
  },
