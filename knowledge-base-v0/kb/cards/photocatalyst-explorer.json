  "app": {
    "title": "Small-molecule photocatalysts explorer",
    "summary": "A person opens a preloaded library of molecules, each with computed electronic properties and a measured activity, and looks at it as a 2D chemical-space map where the points are coloured by cluster. They can switch to a 3D explorer and choose which properties go on the three axes, the colour and the size, or to a view that shows a held-out blind-test set against the library on the same map. Clicking or box-selecting points opens a 3D stick model of each chosen molecule beside the chart. A header link sends the person to an outside challenge where they predict activity themselves.",
    "task": {
      "text": "Explore a screened molecular library in a descriptor space and a similarity embedding, find active or unusual molecules, and inspect their 3D structures.",
      "verbs": [
        "explore",
        "identify",
        "compare"
      ]
    },
    "data": {
      "text": "A table of molecules with computed electronic descriptors, a measured activity, cluster labels and 2D embedding coordinates, plus a precomputed 3D structure file for each molecule.",
      "item": "a molecule in a screened library, with its descriptors and 3D structure",
      "shapes": [
        "table",
        "3d structure"
      ]
    },
    "stage": {
      "text": "exploring a screened molecule library against computed descriptors, after high-throughput experiments",
      "terms": [
        "explore"
      ]
    },
    "mechanism": {
      "text": "A radio switch picks one of three scatter views of the same molecule table, and dropdowns map any five properties onto the 3D view's axes, colour and size. Clicking or selecting points in the chart opens a 3D structure viewer for each selected molecule.",
      "views": [
        "scatter plot",
        "detail panel",
        "3d structure viewer"
      ],
      "interactions": [
        "toggle view",
        "select",
        "multi-select",
        "hover for detail",
        "zoom and pan"
      ],
      "patterns": [
        "overview and detail",
        "linked views"
      ]
    },
    "field": {
      "text": "high-throughput photocatalyst screening with computed molecular descriptors in chemistry",
      "disciplines": [
        "chemistry"
      ],
      "terms": [
        "photocatalysis",
        "chemical space",
        "cheminformatics"
      ]
    },
    "workflow": {
      "name": "explore a library in a property space and open the structures of chosen items",
      "steps": [
        {
          "step": "bring the data in",
          "here": "The app loads a table of molecules with electronic features and hydrogen evolution rate, and a precomputed 3D structure file for each molecule.",
          "parts": [
            "chart-view",
            "structure-panel"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The default '2D chemical space' view plots a UMAP embedding of the molecules. Points are coloured by cluster and sized by a property, and hovering shows each molecule's ID.",
          "parts": [
            "chart-view",
            "view-switch"
          ]
        },
        {
          "step": "map chosen properties onto the plot's axes, colour and size",
          "here": "In the '5D explorer', the X-, Y- and Z-axis, 'Symbol colour' and 'Symbol size' dropdowns redraw a rotatable 3D scatter, with a colour bar for the chosen property.",
          "parts": [
            "property-mapping",
            "chart-view"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "The 'Blind tests' view puts the held-out blind-test molecules, in red, over the library molecules, in blue, on the same embedding. Points are sized by activity.",
          "parts": [
            "view-switch",
            "chart-view"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Clicking a point (in the 5D explorer) or box- or lasso-selecting points (in the 2D views) opens one 3D stick viewer per molecule, labelled with its ID.",
          "parts": [
            "structure-panel"
          ]
        },
        {
          "step": "hand the person on to an outside prediction task",
          "here": "A header link, 'Take the HER prediction challenges', points to a survey sheet picked at random. The pick changes every minute and whenever the view is switched.",
          "parts": [
            "header-challenge"
          ]
        }
      ],
      "distinctive": [
        "The molecules are placed by a UMAP embedding of a structural similarity kernel (SOAP+REMatch), so nearness on the map means structural similarity, not closeness in any one descriptor.",
        "Five properties can be shown at once: three axes plus marker colour and marker size.",
        "A held-out blind-test set is drawn against the training library on the same embedding.",
        "Selecting several points opens several 3D molecular structures together.",
        "The app links to a human-versus-machine-learning activity prediction challenge."
      ]
    }
  },
