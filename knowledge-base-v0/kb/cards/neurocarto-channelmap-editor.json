  "app": {
    "title": "NeuroCarto: a channel-map editor for Neuropixels probes",
    "summary": "A person starts a new probe of a chosen type, or loads an existing channel-map or meta file from a list. The probe's electrodes appear as dots on its shanks, in micrometres. The person box-selects stretches of electrodes and either turns them on or off directly, or gives them a density category, which builds a blueprint. An automatic selection then picks electrodes that satisfy the blueprint and the probe's wiring rules. A density curve and a channel-efficiency table show how well the result matches, and a brain-atlas slice behind the probe helps aim the selection at anatomy. Once the map is complete, they save it as a readout file, together with its blueprint and view settings.",
    "task": {
      "text": "Design which electrodes on a high-density neural probe are read out, by marking regions with the density wanted and letting a constrained selection produce a valid channel map to save.",
      "verbs": [
        "plan",
        "annotate",
        "derive",
        "decide"
      ]
    },
    "data": {
      "text": "A probe's fixed layout of electrodes on shanks. Each electrode has a position, a readout channel, an on/off state and a category from a blueprint. An optional brain-atlas image sits behind it.",
      "item": "an electrode at a shank, column and row position on the probe",
      "shapes": [
        "per element",
        "categories",
        "image"
      ]
    },
    "stage": {
      "text": "planning a recording's electrode readout before implanting the probe",
      "terms": [
        "plan"
      ]
    },
    "mechanism": {
      "text": "A central figure draws every electrode on the probe's shanks, coloured by state. A box selection there, followed by a state or category button in the left panel, changes the blueprint and re-runs the selection. Side views linked to the same probe then redraw the blueprint colours, the density curve along each shank, the efficiency statistics and the atlas slice behind the probe.",
      "views": [
        "map",
        "summary stats",
        "line chart",
        "image viewer",
        "form"
      ],
      "interactions": [
        "brush",
        "apply label",
        "zoom and pan",
        "hover for detail",
        "import",
        "export",
        "toggle view",
        "inline edit"
      ],
      "patterns": [
        "category palette",
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "designing electrode readout maps for high-density probes in extracellular electrophysiology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "neuroscience",
        "extracellular electrophysiology",
        "neuropixels"
      ]
    },
    "workflow": {
      "name": "lay out a constrained selection over a fixed layout and export it as a configuration",
      "steps": [
        {
          "step": "bring the data in",
          "here": "The 'New' dropdown starts a blank map for a chosen probe type. The 'Input file' list loads an existing .imro, SpikeGLX .meta or saved .config.json, and its blueprint comes with it.",
          "parts": [
            "file-io",
            "control-panel"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Every electrode is a dot on its shank in micrometre coordinates, coloured as used, unused, disabled or highlighted. Pan, wheel-zoom and hover show the channel and position.",
          "parts": [
            "probe-figure"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "Box-select electrodes on the shanks, then click a category: Pre Selected, Full, Half or Quarter Density, Low priority, Excluded or Unset. Enable and Disable set electrodes directly instead.",
          "parts": [
            "state-category-palette",
            "probe-figure",
            "blueprint-overlay"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "With 'Auto' on, or on 'Refresh', the selection is re-run. It picks electrodes that satisfy the blueprint and disables those whose shared channel is already taken.",
          "parts": [
            "state-category-palette",
            "probe-figure"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "An electrode density curve is drawn beside each shank, and a 'Channel Efficiency' table reports statistics comparing the channel map with the blueprint.",
          "parts": [
            "stats-panel"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "A brain-atlas slice can be placed behind the probe. Choose the projection, move the plane slider, rotate and pick regions, then drag or scale the boundary box to line it up with the shanks.",
          "parts": [
            "atlas-overlay"
          ]
        },
        {
          "step": "export the result",
          "here": "'Save' writes the map to the 'Save filename' as .imro, but only when it is complete. The blueprint and a .config.json of the view states are saved alongside, and any problems are reported in the Log area.",
          "parts": [
            "file-io"
          ]
        }
      ],
      "distinctive": [
        "A hardware rule ties each readout channel to one electrode, so choosing one electrode disables the others that share its channel. The map is only valid when every channel is used.",
        "The labels are target densities (full, half, quarter, low priority, excluded). They feed an automatic selector rather than being the final answer.",
        "A brain-atlas slice can be rotated and positioned behind the probe, so the person can aim density at anatomical regions.",
        "A density curve along each shank and a channel-efficiency summary show how closely the selection meets the blueprint.",
        "The blueprint and view state are saved next to the channel map, so a design can be reopened and changed later."
      ]
    }
  },
