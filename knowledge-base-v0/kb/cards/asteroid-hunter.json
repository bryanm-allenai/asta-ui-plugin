  "app": {
    "title": "Asteroid Hunter",
    "summary": "A person uploads three to ten telescope frames of the same patch of sky, and a pipeline aligns them, finds sources that move in a straight line, filters out artifacts and checks each mover against a catalog of known objects. The results page lists every candidate with its sky rate, and a blink viewer flips through the frames with each candidate circled. Clicking a named candidate opens a card with its orbit and an impact-hazard verdict, and from there a 3D orbit view. Alternatively, the person hunts the raw frames by ear without seeing the pipeline's answers: they mark a candidate with the keyboard, confirm it frame by frame, and get a spoken review that checks each mark against the catalog.",
    "task": {
      "text": "Find objects that move between repeated images of the same field and confirm each one against a catalog of known objects, by eye or by ear.",
      "verbs": [
        "identify",
        "locate",
        "confirm",
        "derive",
        "lookup"
      ]
    },
    "data": {
      "text": "A short time sequence of aligned FITS images of one sky field, with candidate moving sources detected in them and cross-matched to an ephemeris catalog.",
      "item": "a candidate moving source, tracked by its position in each frame across the image set",
      "shapes": [
        "image collection",
        "table",
        "judgements"
      ]
    },
    "stage": {
      "text": "searching fresh survey frames for moving objects and confirming them against a catalog, before follow-up observation",
      "terms": [
        "analyze",
        "confirm"
      ]
    },
    "mechanism": {
      "text": "An upload runs a detection pipeline that returns a candidate list and per-frame positions. A blink viewer cycles the frames with clickable candidate markers that open a detail card and an orbit view. A separate sonified view turns a live shift-and-stack score at the keyboard cursor into pitch and pulse, and the marks made there are confirmed frame by frame, then matched against the catalog on a review page that has its own blink comparator.",
      "views": [
        "image viewer",
        "list",
        "detail panel",
        "summary stats",
        "canvas"
      ],
      "interactions": [
        "import",
        "zoom and pan",
        "select",
        "hover for detail",
        "keyboard shortcuts",
        "accept or reject",
        "toggle view",
        "time slider"
      ],
      "patterns": [
        "overview and detail",
        "review queue",
        "linked views"
      ]
    },
    "field": {
      "text": "moving-object detection and astrometry in survey images, in astronomy",
      "disciplines": [
        "astronomy"
      ],
      "terms": [
        "asteroid detection",
        "shift and stack",
        "blink comparator"
      ]
    },
    "workflow": {
      "name": "detect moving objects across a sequence of images and confirm them against a catalog",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Choose 3–10 FITS frames, or a zip of them, and press Detect or 'Hunt by ear'. The server aligns the frames, finds sources, links straight-line movers, filters artifacts and cross-matches each mover with SkyBoT.",
          "parts": [
            "frame-upload"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "A results heading gives the count of moving objects. Each candidate is listed with its rate in arcsec/day, its position, a concentration score, and either its catalog name and separation or 'not in catalog'.",
          "parts": [
            "candidate-list"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Play blinks the aligned frames at an adjustable speed, with Prev/Next to step, and zoom, pan and fullscreen. A circle on each candidate follows its position in every frame, so real movers jump while stars hold still.",
          "parts": [
            "blink-viewer"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "With the blink paused, clicking a named candidate opens a card with its orbital elements, estimated size, class and minimum orbit intersection distance, plus a hazard verdict that uses the Sentry impact probability when there is one. View orbit opens a 3D Sun–Earth–asteroid animation with time, speed and zoom sliders.",
          "parts": [
            "asteroid-card",
            "orbit-viewer"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "In hunt-by-ear, the person moves the cursor with the arrow keys and hears a live shift-and-stack score as pitch and pulse, in roam mode or in tune mode (with [ ] ; ' for speed and direction). Space marks a candidate if its score is above the noise floor, then steps through every frame with the cursor placed at the predicted position, recording the signal in each.",
          "parts": [
            "hunt-stage"
          ]
        },
        {
          "step": "decide keep or drop for each item, with a reason",
          "here": "Enter sends every confirmed mark to the server, which matches it against the catalog by distance and speed. The review page bands each mark as matched, candidate, maybe or noise and explains why, reads the summary aloud, and blinks the clean frames with each candidate's marks drawn in its own colour.",
          "parts": [
            "hunt-review"
          ]
        }
      ],
      "distinctive": [
        "Motion is validated physically: pixel displacement becomes a sky rate in arcsec/day, and a mark only counts as a catalog match when both position and speed agree.",
        "The whole search can be done non-visually: a sonified shift-and-stack score, keyboard-only marking and spoken results, built for blind users first.",
        "The pipeline's answers stay hidden during the by-ear hunt and are only consulted after the person commits their marks, so the hunt is unaided.",
        "Score thresholds measured from empty sky split each mark into noise, low-confidence or candidate, and marks below the floor are refused.",
        "Matched objects get an impact-hazard verdict from their minimum orbit intersection distance with Earth and NASA Sentry data, and a 3D orbit view."
      ]
    }
  },
