  "app": {
    "title": "ProteinScope",
    "summary": "A person types a gene symbol, a protein accession or a structure code, and picks the right protein when the name matches several. The interface then pulls records from several public databases into one profile page: a header with function text and numbered literature references, a row of counts, and panels for 3D structures, the interaction network, domains and families, pathways, structural classification, subcellular location, associated diseases and the sequence. From there the person opens experimental structures one at a time in a 3D viewer, drags and zooms the interaction network, and downloads the sequence as FASTA or a structure as a PDB file.",
    "task": {
      "text": "Look up one protein and see everything the public databases hold about it, from structure and interaction partners to domains, pathways and disease links, on one page.",
      "verbs": [
        "lookup",
        "explore",
        "summarize",
        "identify"
      ]
    },
    "data": {
      "text": "Records fetched live for one protein: an entry with function text, keywords, location and disease notes, its amino-acid sequence, a list of experimental 3D structures with method and resolution, a scored network of interaction partners, and lists of domain, pathway and structural-classification entries.",
      "item": "a protein entry in a sequence database, with its linked structures and annotations",
      "shapes": [
        "table",
        "sequence",
        "network",
        "hierarchy",
        "3d structure"
      ]
    },
    "stage": {
      "text": "exploring what is already known about a protein, before planning experiments or analysis",
      "terms": [
        "explore"
      ]
    },
    "mechanism": {
      "text": "A query box resolves to one entry, through a picker if the name matches several, and fills a long profile page with section links at the top. Within it, a structure list drives a 3D viewer whose display style can be switched, and a draggable force-directed network shows partners with hover scores.",
      "views": [
        "summary stats",
        "detail panel",
        "sidebar list",
        "3d viewer",
        "network diagram",
        "list"
      ],
      "interactions": [
        "search",
        "select",
        "toggle view",
        "zoom and pan",
        "drag to arrange",
        "hover for detail",
        "export"
      ],
      "patterns": [
        "dashboard",
        "master-detail",
        "overview and detail"
      ]
    },
    "field": {
      "text": "protein annotation lookup across public databases in bioinformatics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "bioinformatics",
        "structural biology",
        "protein protein interactions"
      ]
    },
    "workflow": {
      "name": "gather one item's records from several sources into a single profile",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Type a gene symbol, sequence accession or structure code (any case), or click an example chip. The query is matched against accession and structure-code patterns, and gene names are then tried from the most to the least specific.",
          "parts": [
            "query-bar"
          ]
        },
        {
          "step": "choose the right item when a query matches several",
          "here": "A free-text name that matches several entries opens a grid of candidate cards with name, gene, accession and organism. Reviewed entries are sorted first, and clicking a card loads that entry.",
          "parts": [
            "candidate-picker"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The profile header shows the name, gene, organism, review status, keywords and function text with numbered references formatted from literature metadata. A stats row counts length, mass, partners, domain entries, pathways and structures, and section links jump to each panel.",
          "parts": [
            "protein-profile"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "A sidebar lists experimental structures that pass a resolution cutoff for their method, ordered by method and then by resolution. Clicking one loads it in the 3D viewer, where cartoon, surface, ball+stick, licorice or spacefill can be chosen and a legend shows chains or surface charge.",
          "parts": [
            "structure-viewer"
          ]
        },
        {
          "step": "explore the item's connections",
          "here": "A force-directed graph puts the query protein at the hub and its partners around it, with partner–partner edges drawn as well. Nodes can be dragged and the view zoomed; hovering shows the combined score, and clicking a partner opens it in the source database.",
          "parts": [
            "interaction-network"
          ]
        },
        {
          "step": "read its annotations by source",
          "here": "Panels list domain and family entries with type badges, pathways, CATH and SCOP classifications with their hierarchy, subcellular location pills and associated diseases, each linking out to its source.",
          "parts": [
            "annotation-panels"
          ]
        },
        {
          "step": "export the result",
          "here": "Download the sequence as a FASTA file with a header built from the entry, or any listed structure as a PDB file.",
          "parts": [
            "sequence-panel",
            "structure-viewer"
          ]
        }
      ],
      "distinctive": [
        "Seven public databases are queried live in sequence from one identifier, with a loading message for each step, so the profile is assembled rather than stored.",
        "Structures are kept only if they pass a quality cutoff for their method (X-ray ≤3.5 Å, cryo-EM ≤4.0 Å, NMR always kept) and are then ranked by method and resolution.",
        "Interaction edges are drawn as several parallel coloured strands, more strands for higher confidence, and lower-confidence partner–partner links are dashed.",
        "Literature IDs embedded in the function text are removed from the text and rebuilt as a numbered reference list in IEEE style."
      ]
    }
  },
