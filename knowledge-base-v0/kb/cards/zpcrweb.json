  "app": {
    "title": "zpcr//web — qPCR run viewer and Cq analysis",
    "summary": "A person loads an instrument's qPCR run file by dropping it in, picking it from a folder on disk, or choosing a bundled sample, then picks the plate-read step and how curves are grouped (raw optical channel, fluorophore, target, or a table). They choose which wells to show on a plate-shaped grid, using sample-type shortcuts, and turn fluorophores, targets and samples on or off. They then read the amplification curves on a chart where they can switch baseline, scale and overlays. To set thresholds they change a noise multiplier, override a whole target's threshold, or drag a curve's Cq marker. Last, they narrow the results to a Cq range, read the per-well Cq/ΔRFU table (or melting temperatures for a melt step), jump from a table row to its well, and export the table as CSV. The analysis settings are written back into the run file.",
    "task": {
      "text": "Compute and check a quantification cycle for every well and dye in a qPCR run, adjusting thresholds and well selection, and export the results table.",
      "verbs": [
        "derive",
        "explore",
        "identify",
        "compare",
        "lookup"
      ]
    },
    "data": {
      "text": "A real-time PCR run: fluorescence read on several optical channels for every well of a plate at every cycle, plus a plate definition (dye, target, sample and type per well), dye calibration files, the thermal protocol and instrument temperatures.",
      "item": "a well on a 96-well plate, with one amplification curve per dye",
      "shapes": [
        "grid of series",
        "per element",
        "time series",
        "table",
        "categories"
      ]
    },
    "stage": {
      "text": "analysing a finished qPCR run for Cq values, before reporting",
      "terms": [
        "analyze",
        "explore"
      ]
    },
    "mechanism": {
      "text": "A side rail of filters (step, view mode, a plate-shaped well grid, dye/target/sample chips, thresholds, a Cq range) drives one main view that is either the amplification or melt chart or the Cq table. Hovering over a chip, well or threshold row highlights the matching curves in the chart, dragging a Cq marker on the chart sets that curve's threshold, and clicking a table row narrows the rail back to that well, target or sample.",
      "views": [
        "sidebar list",
        "fixed-layout grid",
        "line chart",
        "table view",
        "summary stats"
      ],
      "interactions": [
        "import",
        "filter",
        "toggle view",
        "hover for detail",
        "select",
        "multi-select",
        "sort",
        "inline edit",
        "exclude and refit",
        "export"
      ],
      "patterns": [
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "real-time qPCR amplification and melt-curve analysis in molecular biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "qpcr",
        "quantification cycle",
        "melt curve"
      ]
    },
    "workflow": {
      "name": "compute a per-item value from a grid of curves, tune its parameters, and export a results table",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Drop a .zpcr, .pcrd or .bmrun file on the drop zone, add a folder on disk, or tick a bundled sample; each open file becomes a chip in the file bar.",
          "parts": [
            "load-files"
          ]
        },
        {
          "step": "choose what the main view shows",
          "here": "Pick the plate-read step (amplification or melt), then a View mode: Channel, Fluorophore, Target or Table.",
          "parts": [
            "curves-rail"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Click wells, rows or columns on the 8×12 well grid, use sample-type shortcuts such as standards and NTC, and turn fluorophores/targets and samples on or off. Hovering over any of these highlights its curves.",
          "parts": [
            "well-matrix",
            "curves-rail"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "All selected curves are overlaid on one chart. The person can switch Relative/Absolute values and Linear/Log scale, draw each curve's baseline, overlay dark background, a min/max band, temperature or LED current, and hover to see a well's values.",
          "parts": [
            "curve-chart"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Cq is the cycle where each baseline-corrected curve crosses its threshold. The threshold is set per target from a noise multiplier, a per-target override, or a per-curve override made by dragging the curve's Cq ring on the chart.",
          "parts": [
            "threshold-section",
            "curve-chart"
          ]
        },
        {
          "step": "read the results per item",
          "here": "The Table mode lists Cq and ΔRFU (or Tm for a melt step) per well and target. It can be sorted and narrowed to a Cq range, and clicking a well, target or sample in it narrows the rail to that item.",
          "parts": [
            "cq-table"
          ]
        },
        {
          "step": "export the result",
          "here": "The CSV button saves the Cq/ΔRFU table, or the melting-temperature table for a melt step. Threshold settings are stored in the run file itself.",
          "parts": [
            "cq-table"
          ]
        }
      ],
      "distinctive": [
        "Raw readings from six optical channels are colour-separated into per-dye signals using the instrument's dye calibration files before any Cq is computed.",
        "Thresholds can be set at three levels (a global noise multiplier, a per-target value, and a per-curve value dragged straight on the chart), and every view reads the same single analysis.",
        "A melt step is detected from the reads themselves and swaps in −dF/dT curves and melting-temperature peaks in place of Cq.",
        "Files from a device that carries its own baseline and Cq get File ↔ Computed toggles, so the device's analysis can be compared with the app's.",
        "Analysis parameters are written into the run file so they travel with it, and nothing leaves the browser."
      ]
    }
  },
