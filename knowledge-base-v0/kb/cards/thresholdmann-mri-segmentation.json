  "app": {
    "title": "Thresholdmann",
    "summary": "A person loads a 3D MRI volume from a NIfTI file, or opens a demo volume, and moves through its slices in one of three planes. They place control points in the volume and give each one a local intensity threshold. The thresholds are blended across space by inverse-distance weighting into a threshold that varies from place to place, and the mask overlay updates on every change. They pick the threshold direction, switch between seeing the mask and the threshold field, and can check the mask as a 3D surface. At the end they save the binary mask as a NIfTI file and the control points as JSON, so a script can make the same mask again.",
    "task": {
      "text": "Build a brain mask from an MRI volume with a threshold that varies across space, set by hand at control points, and save the mask and the points that reproduce it.",
      "verbs": [
        "derive",
        "annotate",
        "identify"
      ]
    },
    "data": {
      "text": "A 3D intensity volume read from a NIfTI file, plus a small table of control points, each with voxel coordinates and a local threshold value.",
      "item": "a control point in the volume, with its i, j, k voxel position and its local threshold",
      "shapes": [
        "field",
        "image",
        "table"
      ]
    },
    "stage": {
      "text": "making first brain masks from MRI volumes, before detailed manual editing and analysis",
      "terms": [
        "annotate"
      ]
    },
    "mechanism": {
      "text": "A slice viewer shows the MRI with the thresholded mask laid over it, and the control points are drawn on the current slice. These points are linked to a table that lists every point with a slider and a number box for its threshold. Clicking a row jumps the viewer to that point's slice. Clicking a point highlights its row. Each edit redraws the interpolated threshold right away. A web worker thresholds the whole volume for the 3D surface render and for the mask export.",
      "views": [
        "image viewer",
        "table view",
        "3d surface view"
      ],
      "interactions": [
        "import",
        "select",
        "drag to arrange",
        "inline edit",
        "keyboard shortcuts",
        "toggle view",
        "zoom and pan",
        "export"
      ],
      "patterns": [
        "linked views",
        "master-detail",
        "overview and detail"
      ]
    },
    "field": {
      "text": "segmenting MRI volumes with an interactive, space-varying threshold, in neuroimaging",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "neuroimaging",
        "brain extraction",
        "image segmentation"
      ]
    },
    "workflow": {
      "name": "fit a space-varying threshold from hand-placed control points and export the mask",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Drag a .nii or .nii.gz file onto the upload box, choose one with the file picker, or open the bundled demo MRI. The file name, dimensions and voxel size then appear in the info panel.",
          "parts": [
            "upload-box",
            "tool-panel"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Step through slices with the slice slider and switch between sagittal, axial and coronal planes. The opacity, contrast and brightness sliders change how the overlay and the image look.",
          "parts": [
            "slice-viewer",
            "tool-panel"
          ]
        },
        {
          "step": "place reference points in the data",
          "here": "With the Add, Move and Remove tools (keys A, M, R), click to add a control point, which takes the last threshold used, drag a point to move it, or click a point to delete it. One point is placed at the volume's centre to start.",
          "parts": [
            "control-point-editing",
            "tool-panel"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Set each point's local threshold with its slider or number box. The threshold is blended between points by inverse-distance weighting and the mask overlay redraws at once. Select Up and Select Down set which side of the threshold the mask keeps.",
          "parts": [
            "control-points-table",
            "slice-viewer",
            "tool-panel"
          ]
        },
        {
          "step": "check the result from another angle",
          "here": "Switch the overlay from Threshold Mask to Threshold Value to see the interpolated threshold field itself. Render 3D builds a surface mesh of the mask and opens it in a window where it can be rotated and zoomed.",
          "parts": [
            "tool-panel",
            "render-3d"
          ]
        },
        {
          "step": "export the result",
          "here": "Save Mask thresholds the whole volume in a worker, showing its progress, and downloads a .nii.gz mask. Save Control Points writes the points and their values as JSON, and Load Control Points brings a saved set back.",
          "parts": [
            "save-mask",
            "control-points-file"
          ]
        }
      ],
      "distinctive": [
        "The threshold is not one number. It is blended between control points by inverse-distance weighting, with a weak background value, to make up for brightness gradients across the volume.",
        "A direction toggle sets whether the mask keeps voxels above or below the local threshold, so it works for images with different contrasts.",
        "The control points saved as JSON let a separate script rebuild the same mask from the original volume.",
        "The overlay can show the interpolated threshold field instead of the mask, so the person can see the threshold they have built.",
        "A surface mesh of the mask is computed from the thresholded volume to inspect it in 3D."
      ]
    }
  },
