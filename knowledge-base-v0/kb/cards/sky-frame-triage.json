  "app": {
    "title": "Telescope frame triage before stacking",
    "summary": "A person looks over a night's frames as a grid of thumbnails, each with its seeing, sky background and star count, and can sort them by any of those or switch the display stretch. They step through the frames one at a time in a large view with its quality numbers, keeping each with one key or rejecting it with a numbered reason. A running tally shows how much exposure has been kept against a target and how many more frames are needed. The result leaves as a list of kept files for stacking and a CSV of every decision with its measurements.",
    "task": {
      "text": "Decide which frames of an imaging night are good enough to stack, recording why each rejected frame was dropped, until enough exposure is kept.",
      "verbs": [
        "triage",
        "clean",
        "decide",
        "monitor"
      ]
    },
    "data": {
      "text": "A collection of exposures of the same sky field, each with derived quality measurements and a keep or reject decision.",
      "item": "one exposure frame from a night of imaging",
      "shapes": [
        "image collection",
        "table",
        "judgements",
        "categories"
      ]
    },
    "stage": {
      "text": "selecting good frames after a night of imaging, before stacking",
      "terms": [
        "clean"
      ]
    },
    "mechanism": {
      "text": "A sortable thumbnail grid and a large viewer of the current frame are linked, so clicking a thumbnail opens it and every decision updates its tile, while keyboard keys keep, reject with a reason and move through the sorted order. A header tally recomputes kept exposure against an editable target after each decision.",
      "views": [
        "thumbnail grid",
        "image viewer",
        "detail panel",
        "summary stats"
      ],
      "interactions": [
        "select",
        "sort",
        "toggle view",
        "keyboard shortcuts",
        "accept or reject",
        "apply label",
        "export"
      ],
      "patterns": [
        "review queue",
        "overview and detail",
        "linked views",
        "master-detail"
      ]
    },
    "field": {
      "text": "frame selection by seeing, sky background and star count before image stacking, in observational astronomy",
      "disciplines": [
        "astronomy"
      ],
      "terms": [
        "astronomy",
        "frame selection",
        "image stacking"
      ]
    },
    "workflow": {
      "name": "triage a collection one item at a time toward a target total",
      "steps": [
        {
          "step": "bring the data in",
          "here": "a seeded night of 48 frames is generated in the page, each with UT start, FWHM, elongation, background and stars detected above 5 sigma; there is no file input",
          "parts": [
            "frame-grid"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "thumbnails show each frame with its FWHM, background and star count and its decision; sort by time taken, sharpest, darkest background or most stars, and switch between an asinh and a linear stretch",
          "parts": [
            "frame-grid",
            "sort-control",
            "stretch-control"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "the current frame is drawn large beside its UT start, exposure, FWHM, elongation, background in ADU, stars detected and decision",
          "parts": [
            "frame-viewer"
          ]
        },
        {
          "step": "decide keep or drop for each item, with a reason",
          "here": "k keeps a frame and moves on; r waits for a numbered reason (1 trail, 2 cloud, 3 blur, 4 other); arrow keys move along the sorted order and up or down a grid row",
          "parts": [
            "decision-controls",
            "frame-viewer"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "the header counts kept, rejected by reason and undecided frames, and compares kept minutes of exposure with an editable target, saying how many more frames are needed",
          "parts": [
            "tally-header"
          ]
        },
        {
          "step": "export the result",
          "here": "download the kept file names as a .txt list for stacking, or every frame's measurements and decision as a .csv",
          "parts": [
            "export-buttons"
          ]
        }
      ],
      "distinctive": [
        "total kept exposure is tracked against a target in minutes, so the person knows when enough frames are kept",
        "each frame carries image-quality measures from the field: FWHM in arcseconds, elongation, sky background in ADU and stars above 5 sigma",
        "rejections take a reason from a fixed set of failure kinds (satellite trail, cloud, blur, other), tallied in the header",
        "a nonlinear asinh display stretch can be switched on to show faint stars in every thumbnail and the large view"
      ]
    }
  },
