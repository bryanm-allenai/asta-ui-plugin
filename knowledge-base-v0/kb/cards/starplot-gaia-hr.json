  "app": {
    "title": "StarPlot | Gaia DR3 H–R Diagram",
    "summary": "The person picks one or more preset stellar groups from a categorised list, and the interface queries a live star catalogue for each one, merges the results and plots every star by colour against absolute magnitude on one diagram. They scroll to zoom and drag to pan around regions of the diagram. Pointing at a star shows its derived physical quantities, and clicking pins the popup so they can follow links to external archives. They can switch the colour theme and export the current view as a high-resolution poster image.",
    "task": {
      "text": "Plot catalogue stars from chosen groups on a colour–magnitude diagram so their evolutionary sequences can be explored and compared, and export the figure.",
      "verbs": [
        "explore",
        "compare",
        "lookup",
        "identify"
      ]
    },
    "data": {
      "text": "Rows from an astrometric and photometric star catalogue, fetched per preset group by cone or volume query, with colour, apparent and absolute magnitude, parallax, distance, temperature and sky position.",
      "item": "a single catalogued star with its photometry and parallax",
      "shapes": [
        "table",
        "categories"
      ]
    },
    "stage": {
      "text": "exploring survey catalogue photometry of star groups, before closer analysis or teaching figures",
      "terms": [
        "explore",
        "compare"
      ]
    },
    "mechanism": {
      "text": "Toggle buttons grouped by category choose which preset groups are queried. The merged stars are drawn on one zoomable, pannable canvas scatter with labelled reference regions and a solar marker. Pointing at a point opens a detail popup that can be pinned to reach external archive links, and the same renderer draws an offscreen high-resolution poster for export.",
      "views": [
        "scatter plot",
        "detail panel",
        "summary stats"
      ],
      "interactions": [
        "multi-select",
        "filter",
        "zoom and pan",
        "hover for detail",
        "select",
        "toggle view",
        "export"
      ],
      "patterns": [
        "overview and detail"
      ]
    },
    "field": {
      "text": "colour–magnitude (Hertzsprung–Russell) diagrams of star clusters from Gaia photometry and parallaxes, in astronomy",
      "disciplines": [
        "astronomy"
      ],
      "terms": [
        "hertzsprungrussell diagram",
        "star clusters",
        "gaia dr3"
      ]
    },
    "workflow": {
      "name": "plot chosen groups from a catalogue on one diagram, inspect points and export a figure",
      "steps": [
        {
          "step": "choose which groups to bring in",
          "here": "toggle preset buttons sorted into solar volume, open cluster and globular cluster rows, or use Select All / Select None. Each toggle fetches that group's stars from the Gaia archive (cached locally) and merges them",
          "parts": [
            "target-selector"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "every merged star is drawn by BP−RP colour against absolute G magnitude, with spectral-class guides, region watermarks and a Sun marker. A status bar counts the stars and sources",
          "parts": [
            "hr-diagram",
            "status-bar"
          ]
        },
        {
          "step": "zoom into a region of interest",
          "here": "the mouse wheel zooms around the cursor and dragging pans. Zoom In, Zoom Out and Reset View buttons sit beside the hint",
          "parts": [
            "zoom-pan"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "hovering the nearest star shows its evolutionary stage, source group, spectral type, magnitudes, temperature, luminosity, radius, distance, parallax and RA/Dec. Clicking pins the popup so the ESASky, Gaia DR3 and SIMBAD links can be followed",
          "parts": [
            "star-inspector"
          ]
        },
        {
          "step": "export the result",
          "here": "pick a colour theme, then Export Print Poster renders the current bounds and groups at 3000×2100 with a title and the groups' ages, and saves it as a PNG",
          "parts": [
            "plot-toolbar"
          ]
        }
      ],
      "distinctive": [
        "each preset group is a sky cone with distance, parallax signal-to-noise and magnitude cuts, so only likely members are queried",
        "the y axis is inverted absolute magnitude derived from parallax, and points are coloured by a blackbody-like mapping from colour index",
        "groups are ordered by age, so sequences of young and old clusters can be overlaid on one diagram",
        "fixed reference marks (a Sun marker, spectral-class ticks and labelled main-sequence, giant and white-dwarf regions) orient the reader",
        "the poster export reuses the live renderer at print scale with a header listing the groups and their ages"
      ]
    }
  },
