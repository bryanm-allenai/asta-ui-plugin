  "app": {
    "title": "BlotFigure: Western blot figure builder",
    "summary": "The person drops in every raw picture from one blotting experiment: the exposures and a white-light or merged picture that shows the marker. They confirm how the pictures group into capture layouts and fix the strip outlines found on each membrane. Next they adjust one box per protein, with its lanes and tilt, while each row's exposure is suggested and can be compared with the others. They then click marker bands to calibrate molecular weight and type the lane names, protein names, conditions and annotations onto a live figure. At the end they run a pre-flight check and export a publication figure, with the uncropped originals, a processing log and a densitometry table.",
    "task": {
      "text": "Turn the raw images from one immunoblot experiment into a labelled, publication-ready figure that follows image-integrity rules, with the supporting files reviewers ask for.",
      "verbs": [
        "organize",
        "annotate",
        "derive",
        "compare",
        "review"
      ]
    },
    "data": {
      "text": "Raw instrument images from one experiment: several exposures of each membrane, plus a reference picture showing the size marker. Detected strips, protein boxes with lanes, marker calibration points and figure labels are laid over them.",
      "item": "a protein region (a box with its lanes) on one membrane strip, shown as one row of the figure",
      "shapes": [
        "image collection",
        "image",
        "categories"
      ]
    },
    "stage": {
      "text": "assembling a publication figure from raw blot images after imaging",
      "terms": [
        "report"
      ]
    },
    "mechanism": {
      "text": "A five-step side panel works on a zoomable membrane canvas in the middle, where groups, strips, boxes and marker bands are edited directly. A live figure preview on the right redraws as every edit is made, and labels are typed on it in place. Clicking a band in the figure selects that row on the canvas and in the panel.",
      "views": [
        "image viewer",
        "thumbnail grid",
        "side-by-side panes",
        "sidebar list",
        "form"
      ],
      "interactions": [
        "import",
        "drag to arrange",
        "select",
        "multi-select",
        "zoom and pan",
        "inline edit",
        "toggle view",
        "keyboard shortcuts",
        "undo",
        "export"
      ],
      "patterns": [
        "linked views",
        "overview and detail",
        "side-by-side comparison",
        "guided steps"
      ]
    },
    "field": {
      "text": "Western blot image processing and figure preparation in molecular biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "western blot",
        "immunoblotting",
        "densitometry"
      ]
    },
    "workflow": {
      "name": "assemble raw instrument images into a labelled publication figure",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Drop or choose every exposure and the white-light or merged marker picture, or load the example; the pictures are sorted into exposure and marker kinds",
          "parts": [
            "start-and-import"
          ]
        },
        {
          "step": "group items into clusters",
          "here": "Drag thumbnails between image groups by capture layout, mark each group's reference picture with ★, then confirm",
          "parts": [
            "image-groups"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "On the membrane canvas, move, resize, rotate, draw or delete the blue strip boxes, set the expected lane count, then detect the protein boxes",
          "parts": [
            "membrane-canvas"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "For each protein box, set its lanes and tilt and compare all its exposures as tiles, with saturated pixels in red; pick one and adjust its black and white levels",
          "parts": [
            "protein-boxes",
            "membrane-canvas"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Choose the ladder and click its bands on the marker picture; once two are marked, the other sizes and the target-band sizes are estimated",
          "parts": [
            "marker-calibration"
          ]
        },
        {
          "step": "write up the result",
          "here": "Type lane and protein names on the figure, paste conditions, add group lines, arrows and brackets, set the journal width and fonts",
          "parts": [
            "figure-preview"
          ]
        },
        {
          "step": "export the result",
          "here": "A pre-flight check lists unnamed rows, saturation, small text and low resolution, with one-click fixes; then export PNG, TIFF, SVG or PPTX, the uncropped originals, the processing log and a densitometry CSV",
          "parts": [
            "export-menu"
          ]
        }
      ],
      "distinctive": [
        "Each row comes from exactly one exposure, picked by saturation, signal and background; exposures and membranes are never spliced within a row",
        "Molecular-weight ticks come only from bands the person marks by hand; estimates appear only after two marks on a strip",
        "Effective resolution of the bands is checked against 300 dpi and journal column widths",
        "Supplementary integrity outputs: uncropped originals with the boxes drawn on them, and a processing log with the SHA-256 of every source picture"
      ]
    }
  },
