  "app": {
    "title": "Frequency Analysis in Hydrology (fiako-anfrek)",
    "summary": "The person loads a CSV of one value per year, or uses the bundled example. They look over the series in an editable, filterable table, and a bar-and-bubble chart redraws as they change it. In later tabs they compute descriptive statistics, outlier bounds and the skewness and kurtosis checks for each candidate distribution. They then compute the magnitude at each return period they typed for four distributions, and test each distribution's fit with Kolmogorov-Smirnov and Chi-Square at a chosen significance level. Each stage downloads its results as a CSV or a text report.",
    "task": {
      "text": "Fit candidate probability distributions to an annual maximum series, estimate design magnitudes for chosen return periods, and test which distributions fit.",
      "verbs": [
        "derive",
        "compare",
        "identify",
        "summarize",
        "clean"
      ]
    },
    "data": {
      "text": "A single annual series: one dated row per year with one numeric value, such as the maximum daily rainfall of that year.",
      "item": "one year's maximum value in an annual series",
      "shapes": [
        "time series",
        "table"
      ]
    },
    "stage": {
      "text": "frequency analysis of an annual maximum series, checking the fit before the design values are used",
      "terms": [
        "analyze",
        "confirm"
      ]
    },
    "mechanism": {
      "text": "An upload enables four tabs that all read the same editable table. Filtering, sorting or editing the table changes what every later calculation uses. Each tab has an options column with a Calculate button that draws small-multiple charts, one per distribution, and turns on that tab's download button.",
      "views": [
        "table view",
        "bar chart",
        "line chart",
        "scatter plot",
        "strip plot",
        "small multiples",
        "summary stats"
      ],
      "interactions": [
        "import",
        "inline edit",
        "filter",
        "sort",
        "exclude and refit",
        "hover for detail",
        "zoom and pan",
        "toggle view",
        "export"
      ],
      "patterns": [
        "small multiples",
        "linked views"
      ]
    },
    "field": {
      "text": "hydrological frequency analysis of extreme values for design floods",
      "disciplines": [
        "earth science",
        "engineering"
      ],
      "terms": [
        "hydrology",
        "frequency analysis",
        "goodness of fit"
      ]
    },
    "workflow": {
      "name": "fit candidate distributions to a series and test which one fits",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload a CSV with a DATE index and one value column, or click the example-data button. Loading it unlocks the three analysis tabs and the table download.",
          "parts": [
            "data-sidebar"
          ]
        },
        {
          "step": "look over the series and fix or leave out values",
          "here": "An editable value column with native filter and sort. The bar, line and bubble chart redraws from whatever rows remain, and every later calculation uses the same filtered rows.",
          "parts": [
            "table-view"
          ]
        },
        {
          "step": "compute summary statistics and flag outliers",
          "here": "Calculate draws the series with mean, ±1 standard deviation and the upper and lower outlier bounds, plus a box plot. Cv, Cs and Ck are plotted against each distribution's criteria (Normal, Log Normal, Gumbel; Log Pearson III has none).",
          "parts": [
            "stat-view"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Type the return periods separated by spaces and pick a parameter source for each of four distributions. Calculate draws the magnitudes as grouped lines and bars by return period.",
          "parts": [
            "freq-view"
          ]
        },
        {
          "step": "test each candidate against a critical value",
          "here": "Set alpha and pick the critical-value source for Kolmogorov-Smirnov and Chi-Square. Calculate draws the ranked values, the empirical (Weibull) and fitted CDFs and the Chi-Square class splits per distribution, then sets each computed statistic against its critical value.",
          "parts": [
            "fit-view"
          ]
        },
        {
          "step": "export the result",
          "here": "Each stage has its own download: TABLE.csv, STATOUT.TXT, FREQUENCY.csv, and KS.csv, CHI.csv and FIT.TXT together.",
          "parts": [
            "data-sidebar",
            "stat-view",
            "freq-view",
            "fit-view"
          ]
        }
      ],
      "distinctive": [
        "The same series is fitted with four distributions (Normal, Log Normal, Gumbel, Log Pearson III), each set side by side as small multiples.",
        "Each distribution and each test has a selectable source, either a library or a named textbook method, so results can be matched to a given reference.",
        "Outlier bounds come from a hydrology outlier test using a Kn factor on log values. Zero values are dropped before fitting.",
        "Skewness and kurtosis are checked against each distribution's textbook criteria before fitting, as guidance on which distribution to pick.",
        "The fit is judged at a user-set significance level, with the critical value and the computed statistic shown together for each distribution."
      ]
    }
  },
