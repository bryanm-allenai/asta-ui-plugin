  "app": {
    "title": "Neuroglancer",
    "summary": "A person adds data sources as layers: image volumes, segmentations, meshes, skeletons or annotations. They then move through the volume in linked cross-section and 3-D views that share one position. They pick out segmented objects from a searchable list to show their 3-D shape, adjust how each layer is rendered, and place point, line, box or ellipsoid annotations that are listed and can be jumped back to. The whole view is kept as a JSON state in the URL, which can be shared, edited or captured as a high-resolution screenshot.",
    "task": {
      "text": "Look through very large multi-dimensional volumes with their segmentations and 3-D models, find and inspect objects, and mark locations of interest.",
      "verbs": [
        "explore",
        "locate",
        "identify",
        "annotate",
        "lookup"
      ]
    },
    "data": {
      "text": "Large chunked volumetric images with matching label volumes, 3-D meshes and skeletons of segmented objects, and spatial annotations, all in a shared physical coordinate space.",
      "item": "a segmented object (one label ID) in a volume, with its voxels, mesh and properties",
      "shapes": [
        "field",
        "image collection",
        "per element",
        "table",
        "categories"
      ]
    },
    "stage": {
      "text": "exploring and proofreading a reconstructed volume after imaging and segmentation",
      "terms": [
        "explore",
        "annotate",
        "review"
      ]
    },
    "mechanism": {
      "text": "A layer bar and layer side panels set what is loaded and how it is drawn. A configurable layout of orthogonal cross-section panels and a 3-D projection panel all follow one shared position and zoom, so moving in one moves the others. Selecting a segment in a panel or in the segment list shows its mesh in 3-D, and clicking an annotation in the list moves every view to it.",
      "views": [
        "image viewer",
        "side-by-side panes",
        "sidebar list",
        "detail panel",
        "list",
        "form",
        "text editor"
      ],
      "interactions": [
        "zoom and pan",
        "select",
        "multi-select",
        "search",
        "filter",
        "hover for detail",
        "toggle view",
        "apply label",
        "keyboard shortcuts",
        "inline edit",
        "import",
        "export",
        "drag to arrange"
      ],
      "patterns": [
        "linked views",
        "overview and detail",
        "focus and context",
        "master-detail"
      ]
    },
    "field": {
      "text": "volumetric image and segmentation visualization in connectomics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "connectomics",
        "volume electron microscopy",
        "neuron segmentation"
      ]
    },
    "workflow": {
      "name": "explore a large 3-D volume layer by layer and mark what is found",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Type a source URL (precomputed, zarr, n5, nifti and others) for each layer. The data sources tab shows the detected subsources and the coordinate transform.",
          "parts": [
            "layer-bar",
            "data-sources-tab"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Four-panel layout of xy, xz and yz cross-sections plus a 3-D projection. All share one position, so dragging, scrolling or ctrl-wheel zooming in one moves them all.",
          "parts": [
            "data-panels",
            "position-widget"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "The segment list's query box finds segment IDs or filters by segment properties. Ticking segments makes them visible, and their meshes draw in the 3-D panel.",
          "parts": [
            "segment-list"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Hovering or selecting a voxel opens the selection details panel with the values of every layer at that point and the segment's properties.",
          "parts": [
            "selection-details",
            "data-panels"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "Annotation tools place points, lines, bounding boxes and ellipsoids in the panels. Each one appears in the annotation list, and clicking it moves the view there.",
          "parts": [
            "annotation-tab"
          ]
        },
        {
          "step": "export the result",
          "here": "The whole viewer state is encoded in the URL fragment and can be edited as JSON. A screenshot dialog renders the panels at a chosen scale.",
          "parts": [
            "state-and-screenshot"
          ]
        }
      ],
      "distinctive": [
        "data is streamed in chunks at multiple resolutions from remote stores, so volumes far larger than memory can be browsed",
        "cross-sections can be at any angle, not only axis-aligned, and all panels stay locked to one shared physical position and unit-aware coordinate space",
        "segmented objects are shown three ways at once: as labels in the slices, as 3-D meshes or skeletons, and as rows in a searchable list",
        "per-layer rendering is set by user-editable GLSL shader code with contrast and transfer-function widgets",
        "the complete view, including layers, position and selected segments, is serialized as JSON in the URL so it can be shared exactly"
      ]
    }
  },
