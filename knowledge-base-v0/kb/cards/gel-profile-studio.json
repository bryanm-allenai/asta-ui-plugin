  "app": {
    "title": "Gel Profile Studio — agarose gel lane densitometry",
    "summary": "A person opens a gel image, rotates it if needed, sets the gel area to analyse, and places lane lines by clicking or by automatic lane detection. Each lane becomes an intensity profile along migration distance, with segmented bands. The person can change polarity, background correction, smoothing and normalization, rename lanes, and overlay chosen lanes to compare them. A ladder lane calibrates migration distance to fragment size. Optional checks match expected fragment sizes against the observed bands and compute statistics across replicate gels. The results are exported as profile or band CSVs, a comparison SVG, an annotated image, a report or a project file.",
    "task": {
      "text": "Turn a gel image into per-lane intensity profiles with measured bands, size them against a ladder, and check them against expected fragments.",
      "verbs": [
        "derive",
        "compare",
        "identify",
        "summarize"
      ]
    },
    "data": {
      "text": "A gel image with lanes, read as one-dimensional intensity profiles along migration distance, plus a set of known marker sizes",
      "item": "a lane on a gel image and its intensity profile",
      "shapes": [
        "image",
        "grid of series",
        "table",
        "image collection"
      ]
    },
    "stage": {
      "text": "analysing gel images after electrophoresis, before reporting band sizes and amounts",
      "terms": [
        "analyze",
        "compare"
      ]
    },
    "mechanism": {
      "text": "Lane lines placed on the gel canvas each drive a profile card in the side panel that recomputes whenever a processing setting changes. A Compare tab overlays the chosen lanes on one chart, and modals handle ladder calibration, expected-fragment checks, replicate batches and exports.",
      "views": [
        "image viewer",
        "line chart",
        "list",
        "table view",
        "summary stats",
        "form"
      ],
      "interactions": [
        "select",
        "drag to arrange",
        "inline edit",
        "toggle view",
        "hover for detail",
        "import",
        "export",
        "keyboard shortcuts"
      ],
      "patterns": [
        "linked views",
        "overview and detail",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "lane densitometry of agarose gel electrophoresis in molecular biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "gel densitometry",
        "dna ladder calibration",
        "molecular biology"
      ]
    },
    "workflow": {
      "name": "extract per-lane profiles from an image and calibrate them against a standard",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Open, drop or paste a gel image (TIFF is decoded on demand), or reload a project JSON. Rotate the image 90° and set the gel area to exclude borders and labels.",
          "parts": [
            "gel-workspace",
            "project-export"
          ]
        },
        {
          "step": "mark each item on the image",
          "here": "Click lane centres or use Auto-detect lanes. Drag the lines to move them, set the lane width with a slider, and delete the selected lane with the Delete key.",
          "parts": [
            "gel-workspace"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Each lane is averaged into a migration profile, with a choice of bright or dark signal, background correction (local flanks or rolling baseline), smoothing and normalization. Bands are segmented between valleys to give area, prominence, abundance and clipping.",
          "parts": [
            "profile-panel"
          ]
        },
        {
          "step": "calibrate against a known standard",
          "here": "Choose a ladder preset or enter custom sizes, then click the ladder lane. Peaks are matched to sizes in order, and log10(bp) is fitted against migration with R² and a residual error.",
          "parts": [
            "ladder-calibration"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "The Compare tab overlays the chosen lanes on one chart, can align them by correlation shift, and shows values on hover.",
          "parts": [
            "compare-overlay"
          ]
        },
        {
          "step": "check results against expectations",
          "here": "Expected fragment sizes are matched to observed bands in calibrated log-size space and called matched, uncertain, missing or extra. Replicate gels are run with the same lane positions to give mean, SD and CV.",
          "parts": [
            "expected-fragments",
            "batch-replicates"
          ]
        },
        {
          "step": "export the result",
          "here": "Export profile, band, verification or replicate CSVs, a comparison SVG, an annotated PNG, a standalone HTML report, or a project JSON.",
          "parts": [
            "project-export",
            "expected-fragments",
            "batch-replicates"
          ]
        }
      ],
      "distinctive": [
        "Sizes come from a log-linear fit of log10(bp) against migration distance on a ladder lane, with an approximate 95% size interval.",
        "Background can be subtracted from flanking strips beside each lane or from a rolling baseline.",
        "Lanes with saturated (clipped) pixels are flagged because clipping breaks quantitation.",
        "Expected digest or PCR fragments are scored probabilistically, with penalties for missing and extra bands.",
        "Lane positions are reused across replicate gels to report coefficient of variation."
      ]
    }
  },
