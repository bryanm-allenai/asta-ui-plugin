  },
  "app": {
    "title": "SIEVE — structure-based missense variant interpretation dashboard",
    "summary": "A person enters a gene symbol, a protein variant and a protein accession, and the interface runs a staged pipeline. The pipeline fetches the predicted 3D structure, audits per-residue model confidence, builds a residue contact network and simulates the variant's loss of contacts, while a tracker shows each stage as it finishes. The person then looks at the structure in 3D with the variant site highlighted, the confidence profile along the sequence and the contact neighbourhood around the site. They read a layered assessment that ends in a five-tier classification with database and literature evidence, and can export it as JSON, Markdown or a printable brief. A separate validation run scores every labelled variant of the gene with the same rules and reports a confusion matrix and agreement statistics.",
    "task": {
      "text": "Classify a single protein variant as likely pathogenic or benign from structural, network and conservation evidence, and check how well the rules agree with known labels.",
      "verbs": [
        "derive",
        "decide",
        "identify",
        "explore",
        "summarize"
      ]
    },
    "data": {
      "text": "A predicted 3D protein structure with per-residue confidence, a residue contact graph with per-residue centrality metrics, per-residue conservation scores, and a set of database variants with known clinical labels.",
      "item": "a single amino-acid substitution at one residue of a protein",
      "shapes": [
        "3d structure",
        "sequence",
        "network",
        "table",
        "judgements"
      ]
    },
    "stage": {
      "text": "interpreting a candidate variant after it has been identified, before a clinical report is written",
      "terms": [
        "analyze",
        "decide"
      ]
    },
    "mechanism": {
      "text": "Three input fields drive a backend pipeline whose stages light up in a tracker. When it finishes, a 3D viewer, a confidence line chart and a force-directed contact network all centre on the variant residue, and clicking a residue in 3D opens its network metrics. An assessment panel and a tier summary turn the computed evidence into a classification with export buttons, and a separate validation panel benchmarks the rules against labelled variants as a confusion matrix.",
      "views": [
        "form",
        "3d structure viewer",
        "line chart",
        "network diagram",
        "detail panel",
        "summary stats",
        "table view"
      ],
      "interactions": [
        "select",
        "hover for detail",
        "zoom and pan",
        "toggle view",
        "filter",
        "drag to arrange",
        "export"
      ],
      "patterns": [
        "dashboard",
        "overview and detail",
        "focus and context"
      ]
    },
    "field": {
      "text": "structure-based missense variant pathogenicity prediction in clinical genomics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "variant interpretation",
        "structural bioinformatics",
        "protein contact network"
      ]
    },
    "workflow": {
      "name": "classify one item into a tier from computed evidence, then benchmark the rules against known labels",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Type a gene symbol, a variant such as R155H and a protein accession. Editing any field re-runs the analysis after a short pause, and Enter or Analyze Variant runs it at once. Genes that are already cached take a faster path that only recomputes the variant.",
          "parts": [
            "analysis-panel"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "The backend fetches the predicted structure, annotations and database variants, extracts per-residue confidence, builds an 8 Å Cα contact graph with centrality metrics, and removes the residue's edges to measure the change in path length and components. A five-stage tracker marks each stage done or failed.",
          "parts": [
            "analysis-panel",
            "variant-assessment"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "See the whole protein in 3D, coloured by confidence or another scheme, with the variant residue drawn in red and labelled. Below it are the confidence profile along the sequence with the variant marked, and the contact neighbourhood within 1–4 hops, set with a radius slider.",
          "parts": [
            "structure-viewer",
            "confidence-profile",
            "contact-network"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Click any residue in the 3D view to open its confidence, degree, betweenness percentile and clustering. Hover a network node to see the same metrics.",
          "parts": [
            "residue-detail",
            "contact-network"
          ]
        },
        {
          "step": "reach a classification with its evidence",
          "here": "The assessment shows the network tier, the analysis track chosen by confidence routing, a 3D conservation neighbourhood score, and the disruption numbers. The summary gives tier 1–5 with a rationale, the database significance and counts of agreeing and disagreeing studies.",
          "parts": [
            "variant-assessment",
            "clinical-summary"
          ]
        },
        {
          "step": "export the result",
          "here": "Export the report as JSON, download the Markdown report written by the server, or open a printable clinical brief.",
          "parts": [
            "clinical-summary"
          ]
        },
        {
          "step": "check the rules against known labels",
          "here": "Run Validation scores every labelled database variant of the gene with the same network and chemistry rules. It shows MCC, accuracy, sensitivity and specificity with a 2×2 confusion matrix, and highlights MCC when it is above 0.4.",
          "parts": [
            "validation-suite"
          ]
        }
      ],
      "distinctive": [
        "Per-residue model confidence decides which analysis track a variant takes (structured, low-confidence or disordered), smoothed over a three-residue window.",
        "A variant is simulated by deleting the residue's contacts in the graph and measuring the change in average path length and connected components.",
        "Chemical distance between the two amino acids, and the mean conservation of the residue's 3D neighbours, can move a variant up or down a tier.",
        "The same rules can be benchmarked against every labelled variant of the gene, so the person sees how far to trust the single call."
      ]
    }
  },
