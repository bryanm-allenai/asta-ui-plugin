  "app": {
    "title": "dms-viz: per-site mutation scores on a 3D protein structure",
    "summary": "A person loads a prepared JSON file of per-mutation scores (local file or URL), picks a dataset, and sees every site summarized as a line along the sequence, with a small overview strip to zoom into a region. Clicking or brushing sites opens the per-mutation heatmap for a site and highlights the selected sites, colored by score, on an interactive 3D structure. They switch the summary statistic, choose which experimental conditions to plot and which to paint on the structure, and narrow mutations with threshold sliders. They leave with images of the plot and the structure, and a URL that restores the view.",
    "task": {
      "text": "Find the positions along a protein where mutations have strong effects, and see where those positions sit on the 3D structure, across one or more experimental conditions.",
      "verbs": [
        "explore",
        "locate",
        "summarize",
        "compare",
        "identify"
      ]
    },
    "data": {
      "text": "A table of scores, one row per mutation, with the site, the original and the substituted residue, a condition, and optional filter columns, plus a map from sites to chains of a reference 3D structure.",
      "item": "a site (residue position) in a protein, with a score for each possible substitution under each condition",
      "shapes": [
        "table",
        "sequence",
        "per element"
      ]
    },
    "stage": {
      "text": "exploring per-mutation scores after a mutational scan has been processed, before writing it up",
      "terms": [
        "explore",
        "compare"
      ]
    },
    "mechanism": {
      "text": "An overview strip of per-site summaries drives a zoomable line-and-point plot; clicking or brushing sites there fills a per-mutation heatmap for a site and highlights the same sites on a 3D structure viewer, colored by the summary score. Sidebar controls switch the dataset, summary statistic, conditions and filter thresholds, and every view recomputes.",
      "views": [
        "line chart",
        "heatmap",
        "3d structure viewer",
        "sidebar list",
        "form"
      ],
      "interactions": [
        "brush",
        "select",
        "multi-select",
        "hover for detail",
        "zoom and pan",
        "filter",
        "toggle view",
        "keyboard shortcuts",
        "import",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "linked views",
        "focus and context"
      ]
    },
    "field": {
      "text": "deep mutational scanning mapped onto protein structure in biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "deep mutational scanning",
        "protein structure",
        "mutational effects"
      ]
    },
    "workflow": {
      "name": "map per-position scores onto a 3D structure and pick out the positions that stand out",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload a JSON file made by the companion command-line formatter, or paste a URL and press Enter; an optional markdown description loads alongside, and an example dataset is shown at first.",
          "parts": [
            "data-loader"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Choose the dataset and a summary statistic (sum, mean, max, min, median) that reduces each site's mutations to one value; 'Floor' clamps negative values to zero and 'Display Mutation Count' plots how many mutations each site has.",
          "parts": [
            "chart-options"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The overview strip shows every site; brushing over it zooms the main line-and-point plot to that region of the sequence, and hovering a point shows its values.",
          "parts": [
            "site-chart"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Clicking a point fills the heatmap with the score for every substitution at that site, with the original residue marked, and adds the site to the structure; brushing selects many sites, and double-click or Option-brush deselects them.",
          "parts": [
            "site-chart",
            "structure-viewer"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "The condition legend picks which condition paints the structure; Option-clicking adds or removes conditions from the plot so they overlay.",
          "parts": [
            "chart-options",
            "structure-viewer"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Threshold sliders for each filter column hide mutations below the cutoff, and the plot, heatmap and structure recolor.",
          "parts": [
            "site-filters"
          ]
        },
        {
          "step": "export the result",
          "here": "'Download Protein Image' and 'Download Plot Image' save pictures, and every setting is written into the page URL so the view can be shared.",
          "parts": [
            "export"
          ]
        }
      ],
      "distinctive": [
        "Scores are shown both along the sequence and on a 3D structure, with selection in the plot driving which residues are highlighted in the structure.",
        "Each site holds a full set of substitutions, so a per-site summary (sum, mean, max, min, median) is chosen and the substitutions are shown as a heatmap for each site.",
        "Several experimental conditions share one plot, each in its own color, but only one paints the structure at a time.",
        "The structure display can be tuned (representation, colors and opacity for the protein, selection, peripheral chains and ligands) without changing the data.",
        "The whole view state is kept in the URL, so a configured view can be linked or embedded."
      ]
    }
  },
