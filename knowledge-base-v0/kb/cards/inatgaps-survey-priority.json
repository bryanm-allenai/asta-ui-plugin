  "app": {
    "title": "iNatGaps — Sampling Gap Explorer",
    "summary": "A person picks a study area by searching for a named place, uploading a boundary file or drawing a box on the map. They then choose a grid cell size, a taxon group and an observation period. A scan counts the public occurrence records in each grid cell, colours the cells on the map and ranks them by survey priority, which is a log-scaled score that puts the least-recorded cells first. Clicking a cell on the map or in the ranked list shows its record, species and observer counts and a species list, and the whole grid can be exported as CSV or GeoJSON to plan where to survey.",
    "task": {
      "text": "Find the under-recorded cells of a grid laid over an area and rank them so a person can choose where to survey next.",
      "verbs": [
        "identify",
        "summarize",
        "derive",
        "plan",
        "locate",
        "explore"
      ]
    },
    "data": {
      "text": "Counts of public biodiversity occurrence records gathered over a grid of cells clipped to a place boundary, which can be filtered by taxon group and date range. Each cell can also show its species list and number of observers.",
      "item": "a grid cell over the study area, with its record count and priority score",
      "shapes": [
        "geospatial",
        "table",
        "per element"
      ]
    },
    "stage": {
      "text": "planning where to survey by finding the gaps in existing occurrence records",
      "terms": [
        "plan",
        "explore"
      ]
    },
    "mechanism": {
      "text": "A map colours each grid cell by its log-scaled record count, and a sidebar ranks the same cells by priority. Selecting a cell in either view highlights it in both and opens a detail panel that fetches the cell's species and observers. Summary cards total the cells, the zero-record cells and the records.",
      "views": [
        "map",
        "list",
        "sidebar list",
        "detail panel",
        "summary stats",
        "form"
      ],
      "interactions": [
        "search",
        "select",
        "filter",
        "brush",
        "import",
        "zoom and pan",
        "hover for detail",
        "toggle view",
        "export"
      ],
      "patterns": [
        "linked views",
        "master-detail",
        "overview and detail"
      ]
    },
    "field": {
      "text": "sampling-gap analysis of citizen-science occurrence records in ecology",
      "disciplines": [
        "ecology"
      ],
      "terms": [
        "sampling bias",
        "citizen science",
        "biodiversity survey"
      ]
    },
    "workflow": {
      "name": "rank the cells of a spatial grid by how little they have been sampled",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Search for a place, with an OpenStreetMap search as a fallback, or upload a GeoJSON or KML boundary, or drag a rectangle on the map. The grid is clipped to the outline.",
          "parts": [
            "region-controls",
            "coverage-map"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Choose a grid cell size from 100 m to 150 km, or a tile zoom level in Fast mode, plus a taxon group and an observation period, either a preset or a custom date range.",
          "parts": [
            "region-controls"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Analyze live region queries the record count for each cell. It can skip empty coarse blocks, and the scan shows progress and can be stopped. Each cell is then given a priority from 0 to 100: one minus log(count) over log(max), with a bonus for zero-record cells.",
          "parts": [
            "region-controls",
            "scan-summary"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The map colours cells in five bands, from zero records to most records. The summary cards total the grid cells, the zero-record cells and the records.",
          "parts": [
            "coverage-map",
            "scan-summary"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Clicking a cell on the map or in the ranked list selects it in both views and loads its observation, species and observer counts, a species list, and a link to the same box on iNaturalist.",
          "parts": [
            "ranked-cells",
            "cell-detail",
            "coverage-map"
          ]
        },
        {
          "step": "export the result",
          "here": "Export every cell with its count, area and priority as CSV or GeoJSON, with the filters recorded in the file name and metadata.",
          "parts": [
            "ranked-cells"
          ]
        }
      ],
      "distinctive": [
        "Priority is relative to the busiest cell in the same scan, on a log scale, and the interface says it reflects record effort, not biodiversity.",
        "The grid is clipped to an irregular place boundary, which can come from a place search, an uploaded file or a drawn rectangle.",
        "The scan is rate-limited, with a cap on the number of cells, an option to skip empty coarse blocks first, and counts saved for 24 hours. A Fresh button re-queries everything.",
        "In Fast mode the cells follow web-map tiles at a chosen zoom, and a diagnostics panel checks tile counts against the live API.",
        "Changing a filter marks the results as stale rather than rescanning automatically."
      ]
    }
  },
