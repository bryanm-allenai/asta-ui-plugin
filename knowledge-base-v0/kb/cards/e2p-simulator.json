  "app": {
    "title": "E2P Simulator (Effect-to-Prediction Simulator)",
    "summary": "A person picks a binary or continuous outcome, then sets an effect size in any of several equivalent units, the reliability of the predictor and the outcome, the outcome's base rate, and a decision threshold. The interface converts the effect into its other units, shows the true and observed (attenuated) versions, and draws the group distributions with the threshold, ROC, precision-recall and decision curves, along with a dashboard of classification metrics at that threshold. Further sections work out how many predictors are needed to reach a target ROC-AUC, how calibration shifts when a model moves from a development population to a target population, and the sample size a multivariable prediction model needs under several criteria. Each panel can be exported as an image.",
    "task": {
      "text": "Turn a reported or planned effect size into the predictive performance and clinical utility it would actually give, after allowing for measurement reliability and the outcome base rate.",
      "verbs": [
        "derive",
        "explore",
        "plan",
        "compare",
        "decide"
      ]
    },
    "data": {
      "text": "No data is loaded: the person sets model parameters (effect size, reliabilities, base rate, threshold, number of predictors), and the interface simulates or computes analytically the two groups' score distributions and the metrics that follow from them.",
      "item": "a scenario of parameter values describing one predictor (or set of predictors) and one outcome",
      "shapes": [
        "parameter set"
      ]
    },
    "stage": {
      "text": "planning a study or interpreting a published effect size, before or after the analysis",
      "terms": [
        "plan",
        "analyze"
      ]
    },
    "mechanism": {
      "text": "Sliders and linked number fields in a side panel drive every chart at once: the overlapping distributions with a draggable threshold, ROC, PR and decision curves, and a metrics dashboard all recompute as any parameter moves, and a toggle switches between true and reliability-attenuated effects. Calculator sections below repeat the pattern (parameters on the left, curves on the right) and let the person record curves to compare scenarios.",
      "views": [
        "form",
        "line chart",
        "summary stats",
        "scatter plot",
        "dashboard"
      ],
      "interactions": [
        "inline edit",
        "toggle view",
        "hover for detail",
        "export"
      ],
      "patterns": [
        "linked views",
        "dashboard",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "effect-size interpretation and predictive-utility analysis for biomarker and individual-differences research",
      "disciplines": [
        "mathematics",
        "medicine",
        "psychology"
      ],
      "terms": [
        "effect sizes",
        "diagnostic accuracy",
        "decision curve analysis"
      ]
    },
    "workflow": {
      "name": "translate model parameters into the performance they imply",
      "steps": [
        {
          "step": "choose the kind of outcome",
          "here": "Binary or Continuous buttons switch the main simulator and the outcome-specific calculators below it",
          "parts": [
            "binary-simulator"
          ]
        },
        {
          "step": "set the parameters of the scenario",
          "here": "an effect-size slider, with Cohen's d, U3, odds ratio, log odds ratio, point-biserial r and eta squared as linked fields; sliders for ICC1, ICC2, kappa, base rate and a threshold probability",
          "parts": [
            "parameter-panel"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "each effect-size unit is converted from the others, and the observed effect is attenuated from the true effect by the reliabilities",
          "parts": [
            "parameter-panel",
            "metrics-dashboard"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "group distributions with the threshold line, ROC and PR curves, and a decision curve of net benefit, with a toggle between the true and observed effect",
          "parts": [
            "prediction-curves"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "the multivariable calculator finds how many predictors of a given effect and intercorrelation are needed to reach a target ROC-AUC/PR-AUC; Record curve keeps a scenario to compare against",
          "parts": [
            "multivariable-calculator"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "development and target populations are set separately, and a calibration plot with Brier, ICI, slope and intercept shows how predicted risk drifts between them",
          "parts": [
            "calibration-module"
          ]
        },
        {
          "step": "export the result",
          "here": "each panel's Export button saves a screenshot of that region as an image",
          "parts": [
            "export-control",
            "sample-size-calculator"
          ]
        }
      ],
      "distinctive": [
        "every result is shown twice, for the true and for the observed effect, with the difference set by predictor and outcome reliability",
        "the outcome base rate feeds through to PPV, NPV, PR-AUC and net benefit, so a ranking metric and a real-world metric are read together",
        "one effect can be entered in any of six equivalent units and the others update",
        "sample size is computed under several published criteria at once (events per variable, outcome proportion precision, MAPE, shrinkage, optimism), and the largest is the one that applies"
      ]
    }
  },
