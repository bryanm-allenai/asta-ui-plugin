  "app": {
    "title": "Ouvia Study Portal: multi-role human evaluation of speech translation",
    "summary": "A researcher loads source passages with comprehension questions, participants and assignments from CSV files, and each passage becomes an entry that moves through fixed stages: recorded, translated, evaluated, validated and completed. A sender reads the passage aloud and saves a recording. After the speech is machine-translated offline, a receiver reads the translation and answers the questions in the target language. A bilingual validator listens to the source audio, marks each answer correct or incorrect, flags any audio-text mismatch and rates the translation on a slider. Finally the sender rates satisfaction, trust and reliance on Likert scales, first without and then with the validator's results. The researcher follows progress in counts and charts, then exports the entries and a full JSON snapshot for analysis.",
    "task": {
      "text": "Run a staged, multi-role user study where each item passes from speaker to listener to checker, collecting answers, correctness judgements and ratings about each machine translation.",
      "verbs": [
        "record",
        "rate",
        "review",
        "annotate",
        "monitor",
        "curate"
      ]
    },
    "data": {
      "text": "Source passages with comprehension questions and reference answers; one audio recording and one machine translation per assigned entry; free-text answers, correct/incorrect marks, quality scores and Likert survey ratings tied to entries and to participants with demographic fields.",
      "item": "a conversation entry: one source passage assigned to one speaker, with its recording, translation, answers and judgements",
      "shapes": [
        "table",
        "text corpus",
        "media",
        "judgements",
        "categories"
      ]
    },
    "stage": {
      "text": "collecting human judgements in a user study of translation output, before statistical analysis",
      "terms": [
        "collect",
        "review"
      ]
    },
    "mechanism": {
      "text": "Each role gets a task page that shows only the materials it needs and saves a locked submission, which moves the entry to the next stage of a fixed status pipeline. Admin pages upload CSVs, list and bulk-edit entries by status, chart progress by status and gender, and export the results.",
      "views": [
        "form",
        "table view",
        "list",
        "document reader",
        "summary stats",
        "bar chart",
        "side-by-side panes"
      ],
      "interactions": [
        "import",
        "export",
        "score",
        "accept or reject",
        "search",
        "sort",
        "multi-select",
        "filter",
        "inline edit",
        "hover for detail"
      ],
      "patterns": [
        "status pipeline",
        "review queue",
        "rubric",
        "dashboard",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "user-centred human evaluation of speech translation in NLP",
      "disciplines": [
        "computer science"
      ],
      "terms": [
        "speech translation",
        "human evaluation",
        "question answering evaluation"
      ]
    },
    "workflow": {
      "name": "pass each item through a chain of participant roles that each add a judgement",
      "steps": [
        {
          "step": "bring the data in",
          "here": "The admin uploads CSVs of conversations (passage, questions, answers, translated questions), users, entries, and receiver and validator assignments. Participants can also sign up by role link, which samples their assignments.",
          "parts": [
            "admin-dashboard"
          ]
        },
        {
          "step": "record a spoken version of each source item",
          "here": "The sender reads the passage and clicks Record. A countdown and live waveform run while recording, and Re-record is allowed until Save, which locks the audio and marks the entry recorded.",
          "parts": [
            "sender-recorder",
            "participant-home"
          ]
        },
        {
          "step": "answer questions about each item from the translated version only",
          "here": "The receiver sees the machine-translated conversation beside the translated questions and types an answer to each, or NA. Every answer must be filled before saving.",
          "parts": [
            "receiver-answers"
          ]
        },
        {
          "step": "score each item against criteria",
          "here": "The validator listens to the source audio, marks each receiver answer Yes/No for correctness, ticks an audio-text mismatch box and sets a 0–6 meaning-preservation slider. Save stays blocked until every question is marked and the slider has been moved.",
          "parts": [
            "validator-review"
          ]
        },
        {
          "step": "rate the item on fixed scales, before and after seeing feedback",
          "here": "The sender rates satisfaction, trust and reliance on 1–5 Likert scales. Part 1 shows only the source and the translation. Part 2 adds the validator's per-question results and quality score, and the sender rates again.",
          "parts": [
            "final-survey"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "Participants see a progress bar and get a confirmation code when they finish. The admin sees per-user task counts and charts of assignments and entry status by gender.",
          "parts": [
            "participant-home",
            "study-stats"
          ]
        },
        {
          "step": "export the result",
          "here": "The admin searches and bulk-edits the entries table, exports it as CSV and downloads a full JSON snapshot of entries, responses, reviews and surveys.",
          "parts": [
            "entries-table"
          ]
        }
      ],
      "distinctive": [
        "Each entry passes through a fixed lifecycle (ready, recorded, translated, evaluated, validated, completed). Moving an entry back a stage deletes everything recorded after that stage, and the app lists those deletions before it runs.",
        "Each role sees only part of the material: receivers see only the translation, validators judge answers against the source audio, and senders rate the translation first without and then with the validator's results.",
        "Translation quality is measured by whether comprehension questions are answered correctly from the translation, alongside a holistic 0–6 rating.",
        "Assignments can be balanced by participant gender and trans status, and the admin can require that a sender's assignments match the sender's gender.",
        "The receiver interface can be switched to the target language with a locale file, and admins can preview every role's page with mock data."
      ]
    }
  },
