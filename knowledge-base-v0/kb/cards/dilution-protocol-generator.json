  "app": {
    "title": "Dilution Protocol Generator",
    "summary": "The person first sets out a multi-stage dilution protocol as a row of tube cards. Each card gives the fraction of the first stock and the diluent added at that stage. They then enter the compound's molecular weight and solubility, a list of target concentrations, the volume needed per target, a reserve, a minimum pipetting volume and a maximum dilution factor. Generating the protocol works backwards from what each target needs. It calculates a common stock and how much compound to weigh, chains the targets as a serial dilution, and inserts intermediate tubes wherever one step would exceed the maximum factor. The result is a materials list and a step-by-step tube procedure, which can be exported as CSV or PDF. A separate 96-well plate planner lets the person paint wells by group and export the layout with the protocol.",
    "task": {
      "text": "Turn a set of target concentrations into a practical bench procedure for preparing them: the stock, how much compound to weigh, every transfer and diluent volume, and a plate layout.",
      "verbs": [
        "plan",
        "derive"
      ]
    },
    "data": {
      "text": "A small set of user-entered parameters: compound properties, target concentrations, volume rules and the stages of a dilution protocol. From these the tool computes a table of tubes and transfers, and a 96-well plate layout coloured by group.",
      "item": "a tube in the dilution scheme, with its source, concentration, transfer volume and diluent volume",
      "shapes": [
        "table",
        "per element",
        "categories"
      ]
    },
    "stage": {
      "text": "planning compound dilutions at the bench, before running a plate assay",
      "terms": [
        "plan"
      ]
    },
    "mechanism": {
      "text": "An editable chain of tube cards defines the protocol stages, and parameter forms set the targets and volume limits. Generating the protocol computes volumes backwards from the last stage and draws each target's tubes as filled Eppendorf diagrams beside a transfer table and a materials total. The plate planner beside them is a fixed-layout grid where wells are painted with a chosen group colour.",
      "views": [
        "form",
        "table view",
        "fixed-layout grid",
        "summary stats",
        "list"
      ],
      "interactions": [
        "inline edit",
        "apply label",
        "brush",
        "select",
        "export",
        "toggle view"
      ],
      "patterns": [
        "category palette",
        "overview and detail"
      ]
    },
    "field": {
      "text": "serial dilution and stock preparation for compound-treatment assays in cell and molecular biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "serial dilution",
        "solution preparation",
        "96 well plate"
      ]
    },
    "workflow": {
      "name": "plan the preparation of a set of solutions from targets and constraints",
      "steps": [
        {
          "step": "lay out the stages of the procedure",
          "here": "Tube cards set each stage's fraction of the first stock and the diluent added; stages can be added or removed, and the carrier solvent named on the first card carries through to the others",
          "parts": [
            "protocol-editor"
          ]
        },
        {
          "step": "enter the properties and limits of the material",
          "here": "Compound name, molecular weight, solubility in mg/mL or mM and a source note, with an optional fixed stock concentration or volume; the required starting concentration is shown as soon as targets are entered",
          "parts": [
            "stock-form"
          ]
        },
        {
          "step": "set the targets and the practical constraints",
          "here": "Up to 20 target concentrations with a unit, the usable volume per target, the reserve per tube, the minimum pipetting volume, the maximum dilution factor and an automatic-intermediate switch",
          "parts": [
            "targets-form"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Generate checks the inputs against solubility and integer volumes, chains the targets from highest to lowest, works volumes backwards from use plus reserve, and inserts AUTO intermediate tubes wherever a step exceeds the maximum factor",
          "parts": [
            "targets-form",
            "auto-plan-panel",
            "result"
          ]
        },
        {
          "step": "review the procedure and the material totals",
          "here": "A summary of stock volume and compound mass, a materials table, and for each target a row of filled Eppendorf diagrams with a transfer table",
          "parts": [
            "result"
          ]
        },
        {
          "step": "lay out the samples on the plate",
          "here": "Choose a colour group, then click or drag across wells to paint them; a counter shows how many of the 96 wells are marked",
          "parts": [
            "well-planner"
          ]
        },
        {
          "step": "export the result",
          "here": "CSV of every tube, a print/PDF of protocol, materials and procedure with the plate, or only the sections that are ticked",
          "parts": [
            "export-controls"
          ]
        }
      ],
      "distinctive": [
        "Volumes are computed backwards from final use plus a per-tube reserve, so each upstream tube is prepared with enough to supply everything below it.",
        "Intermediate dilutions are inserted automatically whenever one transfer would exceed a maximum dilution factor, and transfers are kept above a minimum pipetting volume.",
        "The common stock concentration is derived from the highest target and the protocol's total dilution, and is checked against the compound's solubility limit.",
        "Each tube's solvent composition is drawn as a coloured fill in an Eppendorf diagram, so stages that change the carrier fraction are visible."
      ]
    }
  },
