  "app": {
    "title": "ActinoEdit — CRISPR Design Toolkit for Actinomycetes",
    "summary": "A person loads a microbial genome sequence and its annotation (by upload or by path), picks an organism profile that sets the GC window and search strictness, adjusts the PAM pattern, spacer length and mismatch tolerance, and names the gene or coordinate range to target. Running the design scans both strands for protospacer sites, searches the whole genome for near-matches, and scores every candidate, reporting progress in a log that can be cancelled while it runs. The scored candidates arrive in a sortable table that can be narrowed to a recommendation band and a maximum number of near-matches, and the chosen set is downloaded as a spreadsheet or report. The same results can be filed into a named project in a local database, linked to organism and genome records that other pages let the person import, search, edit and export.",
    "task": {
      "text": "Design and shortlist candidate guide sequences for one target region of a microbial genome, then export and file them for later use.",
      "verbs": [
        "plan",
        "derive",
        "rate",
        "decide",
        "curate"
      ]
    },
    "data": {
      "text": "An annotated microbial genome — contig sequences plus gene features — from which candidate target sites are enumerated, each with position, composition and genome-wide near-match counts; alongside a local store of organisms, genomes, genes, design runs and saved candidates.",
      "item": "one candidate guide: a spacer with its adjacent motif, contig, coordinates, strand, GC fraction, near-match count and score",
      "shapes": [
        "sequence",
        "table",
        "spans",
        "hierarchy"
      ]
    },
    "stage": {
      "text": "planning an editing experiment from an annotated genome, before anything is done at the bench, and keeping the designs on file afterwards",
      "terms": [
        "plan",
        "decide",
        "maintain"
      ]
    },
    "mechanism": {
      "text": "A single scrolling column of input cards feeds one long computation that runs on a background thread behind a progress log, a cancel button and a status panel; the result appears as a summary of the target region and a paginated, sortable candidate table with two filters and colour-coded verdict badges, followed by download buttons. Separate pages hold the stored collection, where searchable tables of organisms and genomes open into expansion rows listing the genes and saved candidates beneath each one.",
      "views": [
        "form",
        "table view",
        "summary stats",
        "detail panel",
        "tree view"
      ],
      "interactions": [
        "import",
        "filter",
        "sort",
        "search",
        "export",
        "select",
        "write notes"
      ],
      "patterns": [
        "overview and detail",
        "master-detail",
        "status pipeline"
      ]
    },
    "field": {
      "text": "CRISPR guide RNA design against annotated bacterial genomes, tuned for high-GC industrial strains",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "crispr guide design",
        "microbial genomics",
        "genome engineering"
      ]
    },
    "workflow": {
      "name": "enumerate candidate sites in a reference, score and rank them, then shortlist and file the best",
      "steps": [
        {
          "step": "bring the data in",
          "here": "upload a genome FASTA and a GFF or GenBank annotation, or type their paths; a demo button fills both fields with the bundled example",
          "parts": [
            "design-inputs"
          ]
        },
        {
          "step": "set the parameters the computation will use",
          "here": "pick an organism profile that carries the motif, spacer length, GC window and mismatch strictness, then override the motif pattern, spacer length, mismatch limit and design mode by hand; an optional region file can be supplied for context",
          "parts": [
            "design-inputs"
          ]
        },
        {
          "step": "name the region to work on",
          "here": "one text field accepts a locus tag, a gene name, or a contig:start-end range",
          "parts": [
            "design-inputs"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Run Design scans both strands for motif-adjacent sites, searches the whole genome for near-matches and scores each candidate; it runs on a background thread with a live progress log, a cancel button and a timeout",
          "parts": [
            "run-controls"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "the candidate table sorts on any column and narrows to one verdict band and to a maximum near-match count, with the verdict shown as a coloured badge; a summary names the resolved region and the candidate count, and an empty result explains what to check",
          "parts": [
            "guide-results-table"
          ]
        },
        {
          "step": "export the result",
          "here": "buttons generate and download a table, a multi-sheet workbook and a formatted report, and every completed run is auto-saved to a results folder",
          "parts": [
            "report-downloads"
          ]
        },
        {
          "step": "keep a record of changes",
          "here": "the current design is saved under a named project in the local store, linked to an organism and a genome, and can be re-exported from the library page later",
          "parts": [
            "report-downloads",
            "project-library"
          ]
        }
      ],
      "distinctive": [
        "the organism profile is a named parameter set carrying a preferred composition window and search strictness, so the same genome is scored differently for a high-GC strain than for a low-GC one",
        "a second design mode re-scores candidates by proximity to the start codon and adds extra columns for region type and strand relation, for repression rather than disruption",
        "an optional region file tags each candidate with the biosynthetic cluster it falls inside or is nearest to",
        "the genome-wide near-match search is slow enough to need a background thread, a progress log, a cancel button and a timeout that marks the run as abandoned",
        "the result does not end at a file: designs are filed into a local project store whose organism, genome and gene records have their own searchable, editable pages"
      ]
    }
  },
