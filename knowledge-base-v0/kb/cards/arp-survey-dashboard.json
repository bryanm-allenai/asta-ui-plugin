  "app": {
    "title": "Arp Catalog · iTelescope Project dashboard",
    "summary": "A person picks a night, an observing site, a minimum number of observable hours and a moon tolerance, then computes which catalog targets can be observed that night. For each target the dashboard gives its observable window, transit time, moon phase and separation, a moon-risk rating, an assigned telescope and an estimated cost. The person narrows and sorts the list, compares the targets' windows on visibility bars and checks the moon-risk calendar for the coming weeks. Clicking a row moves a target through Pending, Scheduled, Done and Skipped, and the Scheduled targets are written out as telescope plan files, one per telescope. After imaging, each session is logged with a quality rating that marks the target done. Low-rated sessions go into a re-image queue. Progress by season is tracked and exported as CSV and target lists.",
    "task": {
      "text": "Plan each night's observing toward imaging every object in a fixed catalog, write the telescope plan files, and track which objects are done, need re-imaging or remain.",
      "verbs": [
        "plan",
        "derive",
        "record",
        "curate",
        "rate",
        "summarize"
      ]
    },
    "data": {
      "text": "A fixed catalog of sky targets with coordinates, angular size, season and filter strategy. Alongside it come per-night moon-risk ratings for each target, telescope specs and rates, a log of imaging sessions with quality ratings and notes, and a status for each target.",
      "item": "a target object in the catalog, with sky coordinates, angular size and a filter strategy",
      "shapes": [
        "table",
        "time series",
        "events",
        "judgements",
        "notes"
      ]
    },
    "stage": {
      "text": "planning observing nights and logging completed imaging across a long catalog survey",
      "terms": [
        "plan",
        "collect",
        "maintain"
      ]
    },
    "mechanism": {
      "text": "Computing a session fills both the planner table and the visibility bars. Clicking a row cycles its status, and that status drives both views, the plan-file export and the progress panes. The imaging-log form rates each session with stars, marks the target done and feeds the re-image queue and the summary metrics on the overview.",
      "views": [
        "table view",
        "timeline",
        "heatmap",
        "bar chart",
        "form",
        "summary stats"
      ],
      "interactions": [
        "search",
        "filter",
        "sort",
        "select",
        "score",
        "write notes",
        "export",
        "import",
        "toggle view"
      ],
      "patterns": [
        "dashboard",
        "status pipeline",
        "linked views"
      ]
    },
    "field": {
      "text": "observation planning with moon avoidance for a catalog imaging survey in astronomy",
      "disciplines": [
        "astronomy"
      ],
      "terms": [
        "observation planning",
        "moon avoidance",
        "astrophotography"
      ]
    },
    "workflow": {
      "name": "schedule a fixed list of items session by session and track completion of the whole list",
      "steps": [
        {
          "step": "bring the data in",
          "here": "The catalog, moon-risk data and telescope specs are embedded in the page. A Load NED coords button replaces the catalog coordinates with precise ones from a CSV.",
          "parts": [
            "ned-loader"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Date, site, minimum hours and moon filter, then Compute session: it finds the dark window and each target's rise, transit and set, moon separation and Good/Marginal/Avoid risk, assigned telescope and point cost. Results are sorted by transit.",
          "parts": [
            "session-planner"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Search by number or name, filter by telescope or filter strategy, and hide done targets. Visibility bars sort by transit, hours or number. The moon calendar shows a strip of daily risk for each target, filtered by tonight's risk.",
          "parts": [
            "session-planner",
            "visibility",
            "moon-calendar"
          ]
        },
        {
          "step": "move items through named stages",
          "here": "Clicking a planner row cycles the target through Pending, Scheduled, Done and Skipped. The status is saved in the browser and shown in every view.",
          "parts": [
            "session-planner"
          ]
        },
        {
          "step": "export the result",
          "here": "Generate ACP plan takes only the Scheduled targets and writes one plan file per telescope, with a header giving imaging time, total duration and cost. The person can copy it or download all the files.",
          "parts": [
            "acp-export"
          ]
        },
        {
          "step": "record each observation with a quality score",
          "here": "The imaging log form takes target, date, telescope, exposure, filters, 1 to 5 stars and notes. Saving marks the target Done, and entries rated 2 stars or less go to a re-image list. The log can be exported as CSV.",
          "parts": [
            "imaging-log"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "The overview shows imaged and remaining counts, a progress bar for each season and the re-image queue. The export tab filters targets by season and by remaining, done or re-image. It exports a CSV, a list of remaining targets and a status file.",
          "parts": [
            "overview",
            "progress-export"
          ]
        }
      ],
      "distinctive": [
        "Moon risk is rated Good, Marginal or Avoid from the moon's phase and its angular separation from the target. The required separation grows as the moon gets fuller.",
        "Each target gets a telescope by angular-size tier at the chosen site, and a point cost that is summed for the night.",
        "Plan files contain only the Scheduled targets and are split one file per telescope, in the observatory's plan-directive format.",
        "Sessions rated 2 stars or less go into a re-image queue, so a target marked done can still come back.",
        "Targets are grouped into seasons by right ascension, and progress is tracked per season against the full catalog."
      ]
    }
  },
