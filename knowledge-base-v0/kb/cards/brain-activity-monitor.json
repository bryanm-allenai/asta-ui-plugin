  "app": {
    "title": "Brain Activity Monitor (Streamlit dashboard)",
    "summary": "The person picks a stream source in the sidebar: replay a labelled multichannel EEG recording from a file, or connect to a live headset stream with a discovery timeout. While the stream runs, the page refreshes itself on a set interval. It shows connection and device status, a signal-quality rating for each electrode, the last few seconds of every channel stacked as traces, and the cognitive state for the latest window with a confidence score. Counters show how many windows were processed and how many were rejected, and a log lists recent windows with their prediction, confidence and artifact ratio. The person ends up with a running, explainable estimate of the current state and can see whether the signal is good enough to trust it.",
    "task": {
      "text": "Watch a live or replayed EEG stream and see each window's estimated cognitive state, with its confidence and the signal quality behind it.",
      "verbs": [
        "monitor",
        "identify",
        "summarize"
      ]
    },
    "data": {
      "text": "A continuous multichannel EEG stream, split into overlapping windows. Each window is classified into one of a fixed set of states by threshold rules calibrated offline.",
      "item": "a 4-second window of four-channel EEG, with its predicted state and confidence",
      "shapes": [
        "time series",
        "events",
        "judgements"
      ]
    },
    "stage": {
      "text": "monitoring a recording session as it streams, after the thresholds have been calibrated offline",
      "terms": [
        "collect",
        "confirm"
      ]
    },
    "mechanism": {
      "text": "A sidebar chooses the source and the refresh rate, and a background backend runs the stream. Each refresh redraws the status, electrode-quality, state and statistics panels, the stacked raw-trace chart and the table of recent decisions from that same stream, so all panels show the same moment.",
      "views": [
        "line chart",
        "summary stats",
        "table view",
        "sidebar list"
      ],
      "interactions": [
        "toggle view",
        "import",
        "time slider"
      ],
      "patterns": [
        "dashboard",
        "overview and detail"
      ]
    },
    "field": {
      "text": "real-time EEG band-power state classification in neuroscience",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "eeg",
        "neurofeedback",
        "spectral band power"
      ]
    },
    "workflow": {
      "name": "monitor a live signal stream and its per-window classification",
      "steps": [
        {
          "step": "bring the data in",
          "here": "The Mode select chooses csv replay (a recording picker plus a Loop checkbox) or lsl (a discovery-timeout slider for a live headset). Restart stream restarts the source.",
          "parts": [
            "stream-source-sidebar"
          ]
        },
        {
          "step": "check the source is connected and the signal is usable",
          "here": "A connection badge shows connecting, streaming, stopped or error, with device and battery. Each electrode gets a good, fair, poor or disconnected pill.",
          "parts": [
            "connection-panel",
            "electrode-quality"
          ]
        },
        {
          "step": "watch the raw signal as it arrives",
          "here": "The last 4 seconds of each channel are drawn as stacked, offset line traces against elapsed time. The page reruns on the auto-refresh interval.",
          "parts": [
            "eeg-trace",
            "stream-source-sidebar"
          ]
        },
        {
          "step": "read the current classification and its confidence",
          "here": "A large state badge and a confidence progress bar for the latest classified window, with the time it was last updated.",
          "parts": [
            "cognitive-state"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "Metrics count the windows processed and rejected, and show how old the shown decision is.",
          "parts": [
            "statistics-panel"
          ]
        },
        {
          "step": "keep a record of changes",
          "here": "A table of recent windows, newest first, with window index, time, prediction, confidence and artifact ratio.",
          "parts": [
            "decision-log"
          ]
        }
      ],
      "distinctive": [
        "States come from a weighted vote over band-power thresholds calibrated offline. No trained model is involved, so each prediction can be explained.",
        "Windows with too many artifact-flagged samples are rejected and counted, and each logged decision shows its artifact ratio.",
        "The same panels work for a replayed labelled recording and for a live headset stream, so the person can rehearse on files before going live.",
        "Each electrode's quality is estimated from the raw signal's saturation, amplitude and variance."
      ]
    }
  },
