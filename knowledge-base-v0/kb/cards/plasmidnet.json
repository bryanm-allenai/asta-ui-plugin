  "app": {
    "title": "PlasmidNET – Dashboard",
    "summary": "A person starts with a pre-built database of complete plasmids and moves through tabs. The tabs give charts of the whole collection: its make-up, resistance genes, replicon and mobility typing, co-occurring features, spread by country, host and year, and checks for confounding. The person can search the collection by host genus or species. They can also enter one accession to draw its circular map with genes classified by function, together with its typing details. Several sequences can be aligned side by side with BLASTn, and a single sequence can be scanned for signs of engineering, which gives a 0–100 score. Finally the person downloads chosen datasets as CSV, or the compared sequences as FASTA or GenBank.",
    "task": {
      "text": "Survey a large collection of annotated plasmid sequences by their genes, typing, geography and time, then open, compare and screen single plasmids in detail.",
      "verbs": [
        "explore",
        "summarize",
        "compare",
        "lookup",
        "identify",
        "derive"
      ]
    },
    "data": {
      "text": "A local relational database of complete plasmid records with metadata, taxonomy, replicon/mobility typing, resistance and other gene annotations with positions, and sampling locations and dates. Single sequences can also be fetched from GenBank or uploaded as FASTA/GenBank.",
      "item": "one plasmid: a circular or linear DNA sequence with annotated genes and typing",
      "shapes": [
        "table",
        "sequence",
        "spans",
        "geospatial",
        "time series",
        "categories"
      ]
    },
    "stage": {
      "text": "exploring and analysing a public sequence database, before writing up findings",
      "terms": [
        "explore",
        "analyze",
        "compare"
      ]
    },
    "mechanism": {
      "text": "Tabs switch between dashboards of precomputed charts over the whole database (bar charts, heatmaps, a scatter map with animated time frames, a UMAP scatter plot) and per-item tools where an accession or uploaded sequence draws a zoomable circular feature map, a pairwise alignment figure with tables, or a scored sequence scan. A bottom bar exports chosen datasets as CSV.",
      "views": [
        "summary stats",
        "bar chart",
        "heatmap",
        "map",
        "scatter plot",
        "line chart",
        "sequence track",
        "detail panel",
        "table view",
        "form"
      ],
      "interactions": [
        "toggle view",
        "search",
        "hover for detail",
        "zoom and pan",
        "filter",
        "time slider",
        "import",
        "export"
      ],
      "patterns": [
        "dashboard",
        "overview and detail",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "plasmid genomics and antimicrobial-resistance surveillance in microbiology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "plasmid genomics",
        "antimicrobial resistance",
        "one health"
      ]
    },
    "workflow": {
      "name": "summarise a large collection, then open, compare and screen single items",
      "steps": [
        {
          "step": "look over every item at a glance",
          "here": "Overview, AMR, Inc/MOB/IS and Correlations tabs show distributions of topology, length, GC, drug class, replicon type and mobility, plus cross-tab heatmaps, over the whole database",
          "parts": [
            "tab-shell",
            "collection-dashboards"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "genus and species boxes with a Search button list matching plasmids from the taxonomy table",
          "parts": [
            "taxonomy-search"
          ]
        },
        {
          "step": "compare groups across place and time",
          "here": "a global scatter map coloured by mobility, country bar charts, animated cumulative spread by year for a chosen Inc group or mobility type, and host-category heatmaps",
          "parts": [
            "geography-view"
          ]
        },
        {
          "step": "check whether differences hold up",
          "here": "Analytics tab: species-matched country comparison, bootstrap rarefaction, Simpson's paradox table, UMAP embedding and XGBoost/SHAP feature importance for predicted mobility",
          "parts": [
            "collection-dashboards"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "typing an accession and pressing Visualize draws a circular map with forward and reverse CDS rings, positioned AMR/MOB features and a GC-deviation ring, plus typing details and feature-count badges",
          "parts": [
            "plasmid-viewer"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "accessions pasted one per line, or FASTA/GenBank files uploaded, are aligned pairwise with BLASTn and drawn as a circular comparison with HSP and CDS tables",
          "parts": [
            "compare-view"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "a fetched, uploaded or pasted sequence is scanned for restriction sites, promoters, RBS, vector signatures, IS elements and scars, and given a 0–100 engineering score with a classification",
          "parts": [
            "seq-analysis"
          ]
        },
        {
          "step": "export the result",
          "here": "choose a dataset from a dropdown and Download CSV; compared sequences are downloadable as FASTA or annotated GenBank",
          "parts": [
            "export-bar",
            "compare-view"
          ]
        }
      ],
      "distinctive": [
        "genes are sorted into functional categories (resistance, mobilisation, toxin-antitoxin, virulence, disinfectant resistance, heavy metal) by name prefixes and product keywords, and coloured that way on the circular map",
        "the circular map draws strand-separated gene rings and a GC ring coloured above or below the plasmid's mean",
        "an accession that is not in the local database falls back to a live GenBank fetch",
        "confounding checks (species-matched comparison, rarefaction to equal sample size, Simpson's paradox detection) test whether regional differences in mobility are real or come from sampling",
        "a single sequence is scored 0–100 for signs of laboratory engineering, to judge whether it is natural or engineered"
      ]
    }
  },
