  },
  "app": {
    "title": "Live Earthquake Statistics",
    "summary": "The page loads a week of events from a public catalog feed, then keeps polling two shorter feeds and merges every response into one catalog. The person picks a region, which scopes everything. A map, headline counts and four analysis cards then update: a magnitude-frequency fit with a completeness threshold, a decay fit for the busiest aftershock sequence, hours flagged as unusually busy, and a depth-magnitude scatter. Alongside these runs a log of every revision and deletion the source made while the page was open. Any chart can be switched to a table, and hovering or clicking an event shows its details or opens its source record.",
    "task": {
      "text": "Watch a live event catalog for one region, keep its standard statistics up to date as new and revised records arrive, and log every correction the source makes.",
      "verbs": [
        "monitor",
        "derive",
        "summarize",
        "explore",
        "curate"
      ]
    },
    "data": {
      "text": "A rolling seven-day catalog of timestamped events, each with coordinates, depth, magnitude and review status. It is merged from repeated feed responses, so the same record can change version over time.",
      "item": "one catalogued event with its time, location, depth, magnitude, magnitude type and review status",
      "shapes": [
        "events",
        "geospatial",
        "table",
        "time series",
        "versions"
      ]
    },
    "stage": {
      "text": "watching a live catalog as it arrives, with running statistics, before any study of a particular sequence",
      "terms": [
        "explore",
        "analyze",
        "collect"
      ]
    },
    "mechanism": {
      "text": "One region switch scopes a large map, a row of headline numbers and several analysis cards. All of them read one shared analysis, which is recomputed whenever the merged catalog changes. Each card can flip to a table twin, and a running revision log lists how records changed between polls.",
      "views": [
        "map",
        "summary stats",
        "bar chart",
        "scatter plot",
        "list",
        "table view"
      ],
      "interactions": [
        "filter",
        "hover for detail",
        "select",
        "toggle view"
      ],
      "patterns": [
        "dashboard",
        "version history",
        "overview and detail"
      ]
    },
    "field": {
      "text": "statistical seismology on a live earthquake catalog",
      "disciplines": [
        "earth science"
      ],
      "terms": [
        "seismology",
        "statistical seismology",
        "earthquake catalogs"
      ]
    },
    "workflow": {
      "name": "monitor a live event feed and keep its statistics current",
      "steps": [
        {
          "step": "bring the data in",
          "here": "the past week loads once, then the past-hour feed is polled every 60 s and the past-day feed every 5 min. Each response is merged by event id, and a status strip shows each feed's state",
          "parts": [
            "feed-region-controls"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "a segmented switch picks all events, global M4.5+, or one of four regional boxes. The choice scopes the map, every card and every fit. Pause freezes the display while polling continues",
          "parts": [
            "feed-region-controls"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "every event is plotted on an equal-area map, sized by magnitude and coloured by depth. Rings ripple out from the last hour's events, and a callout follows the latest notable one. Headline tiles give counts for the last day and hour",
          "parts": [
            "stage-map",
            "kpi-tiles",
            "latest-list"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "fits are recomputed on each catalog change: the completeness magnitude and b-value with a bootstrap range, an Omori-Utsu decay fit for the busiest mainshock, and a Poisson test that flags busy hours",
          "parts": [
            "fmd-card",
            "omori-card",
            "hourly-card",
            "kpi-tiles"
          ]
        },
        {
          "step": "keep a record of changes",
          "here": "each newer version of an event is compared field by field. Changes to magnitude, type, status, depth, epicentre, place or id are logged, as are deletions and restorations, newest first",
          "parts": [
            "revision-log"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "hovering a dot or bar shows its values. Clicking a map dot, or a place in a list, opens the event's source page. Every card's Table button lists the numbers behind it",
          "parts": [
            "stage-map",
            "latest-list",
            "fmd-card",
            "hourly-card"
          ]
        }
      ],
      "distinctive": [
        "the source keeps revising its records, so the merge compares version timestamps, follows id changes across networks, and counts an event as deleted only when it is missing under all its ids and still well inside the window",
        "statistics are fitted only above an estimated completeness threshold, which is re-estimated in every bootstrap resample, so the uncertainty interval includes the threshold's own uncertainty",
        "fits refuse to run below a minimum number of events and say how many they would need, instead of showing a number",
        "each hour is tested against a baseline built from the previous 24 hours, so a burst cannot raise its own baseline",
        "every chart has a table twin and an expandable 'how this is measured' panel with the equations and live fitted values"
      ]
    }
  },
