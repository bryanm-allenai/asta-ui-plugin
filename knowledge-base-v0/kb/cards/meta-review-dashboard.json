  "app": {
    "title": "Meta-review dashboard for one submission",
    "summary": "A person writing the meta-review for one submission sees its reviewers' scores on a 1 to 5 scale, with a plain mean and a mean weighted by each reviewer's self-rated expertise, and a table of topics showing which reviewers raised each one as a strength, weakness or question and whether they agree or disagree. They read the reviews side by side or stacked, tag further sentences by selecting them and choosing a topic and a type, and filter the tagged points by type, reviewer or topic. Points and disagreements are added to a draft under section headings, a recommendation is picked, and the meta-review is copied out with the recommendation on top.",
    "task": {
      "text": "Synthesise several peer reviews of one submission into a meta-review with a recommendation, seeing where reviewers agree and disagree.",
      "verbs": [
        "write",
        "compare",
        "reconcile",
        "summarize",
        "annotate",
        "decide"
      ]
    },
    "data": {
      "text": "A handful of written reviews of one submission, each with a score, a self-rated expertise level and a reviewer role, plus points pulled from the reviews and tagged with a type (strength, weakness, question) and a topic.",
      "item": "a point quoted from one reviewer's review, tagged with a type and a topic",
      "shapes": [
        "text corpus",
        "spans",
        "judgements",
        "categories",
        "document"
      ]
    },
    "stage": {
      "text": "synthesising submitted peer reviews into a meta-review, after the reviews are in and before the decision",
      "terms": [
        "review",
        "compare"
      ]
    },
    "mechanism": {
      "text": "A score strip and a topic-by-reviewer agreement table give the overview; clicking a topic filters the tagged-points list, clicking a point scrolls to and flashes its sentence in the review, and selecting text in a review opens a popover to tag it. Each point or disagreement can be added to a textarea draft, where it is placed under the matching section heading, and the list greys out points already in the draft.",
      "views": [
        "strip plot",
        "table view",
        "side-by-side panes",
        "document reader",
        "list",
        "text editor",
        "summary stats"
      ],
      "interactions": [
        "select text span",
        "apply label",
        "filter",
        "select",
        "toggle view",
        "quote into text",
        "hover for detail",
        "write notes"
      ],
      "patterns": [
        "dashboard",
        "agreement summary",
        "linked views",
        "side-by-side comparison",
        "category palette",
        "overview and detail"
      ]
    },
    "field": {
      "text": "meta-reviewing a conference submission from several peer reviews, in HCI",
      "disciplines": [
        "hci"
      ],
      "terms": [
        "hci",
        "peer review",
        "meta review"
      ]
    },
    "workflow": {
      "name": "synthesise several reviewers' judgements of one item into a written decision",
      "steps": [
        {
          "step": "compute a value from the data",
          "here": "Each reviewer is a dot on a 1 to 5 score line, sized by self-rated expertise, with the spread, the plain mean and the expertise-weighted mean marked.",
          "parts": [
            "score-spread"
          ]
        },
        {
          "step": "find where people disagree and resolve it",
          "here": "Points are grouped by topic into a table with one column per reviewer showing S, W or Q letters; topics where one reviewer calls it a strength and another a weakness are ranked first as 'Reviewers disagree' with an Add to draft button.",
          "parts": [
            "agreement-table"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "The reviews are shown in four columns or stacked, each headed with role, score and expertise, with already-tagged sentences highlighted and lettered.",
          "parts": [
            "reviews"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "Selecting a sentence in a review opens a popover to type or pick a topic and mark it Strength, Weakness or Question; the person's own tags can be removed later.",
          "parts": [
            "tag-popover",
            "reviews"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "The tagged-points list filters by type, by reviewer, and by the topic clicked in the agreement table; clicking a point's text scrolls to and flashes it in its review.",
          "parts": [
            "tagged-points",
            "agreement-table"
          ]
        },
        {
          "step": "write up the result",
          "here": "Add section headings inserts Summary, Strengths, Weaknesses, Points of disagreement, Questions for the authors and Recommendation; each added point goes under its type's heading with the reviewer id, and a disagreement line names who saw it as a strength and who as a weakness.",
          "parts": [
            "meta-review-draft",
            "tagged-points"
          ]
        },
        {
          "step": "export the result",
          "here": "A recommendation (Accept, Minor revisions, Major revisions, Reject) is picked and Copy meta-review puts it and the draft on the clipboard; the draft, tags and layout are saved in the browser.",
          "parts": [
            "meta-review-draft"
          ]
        }
      ],
      "distinctive": [
        "the mean score is shown both plain and weighted by each reviewer's self-rated expertise on a 1 to 4 scale",
        "a topic counts as a disagreement when one reviewer called it a strength and another a weakness, and those topics rank first",
        "points are quoted verbatim from the reviews, so the draft knows which ones it already holds and greys them out in the list",
        "added points land under the matching section heading of a fixed meta-review template, or at the cursor if the headings are absent"
      ]
    }
  },
