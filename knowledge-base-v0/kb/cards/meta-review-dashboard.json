  "app": {
    "title": "Meta-review dashboard for one submission",
    "summary": "The meta-reviewer sees all the reviews of one submission together, side by side or stacked, each with its score and the reviewer's self-rated expertise, under a chart of the score spread with a plain and an expertise-weighted mean. Points pulled from the reviews are tagged as strengths, weaknesses or questions under a topic, and the reviewer can select more text in any review to tag it themselves. A table groups the points by topic and reviewer with disagreements first, and clicking a topic narrows the list of points to it. They write the meta-review beside all this, adding a point or a disagreement line with one click under the right heading while used points grey out, then pick a recommendation and copy the result.",
    "task": {
      "text": "Bring several reviewers' judgements of one submission together, surface where they agree and disagree, and write the meta-review and recommendation from them.",
      "verbs": [
        "write",
        "reconcile",
        "compare",
        "annotate",
        "summarize",
        "decide"
      ]
    },
    "data": {
      "text": "A handful of review texts about the same submission, each with a score and the reviewer's self-rated expertise, and the passages in them tagged with a type and a topic.",
      "item": "one reviewer's review of a submission, with the points tagged in it",
      "shapes": [
        "text corpus",
        "judgements",
        "spans",
        "categories"
      ]
    },
    "stage": {
      "text": "reconciling peer reviews into a meta-review and decision",
      "terms": [
        "review",
        "compare",
        "decide"
      ]
    },
    "mechanism": {
      "text": "A score chart, a topic-by-reviewer agreement table and the review texts sit in the main area, while the tagged-point list and the draft sit in a side column; selecting a topic filters the points, clicking a point scrolls to and flashes it in its review, and selecting review text opens a popover to tag it. Adding a point or disagreement inserts it under the matching heading in the draft, and points whose text is already in the draft are greyed out.",
      "views": [
        "strip plot",
        "summary stats",
        "table view",
        "side-by-side panes",
        "document reader",
        "list",
        "text editor"
      ],
      "interactions": [
        "hover for detail",
        "select",
        "filter",
        "toggle view",
        "select text span",
        "apply label",
        "quote into text",
        "export"
      ],
      "patterns": [
        "agreement summary",
        "linked views",
        "side-by-side comparison",
        "category palette"
      ]
    },
    "field": {
      "text": "meta-reviewing a submission to a CSCW conference",
      "disciplines": [
        "hci"
      ],
      "terms": [
        "hci",
        "cscw",
        "peer review"
      ]
    },
    "workflow": {
      "name": "combine several people's reviews of one item into a summary judgement",
      "steps": [
        {
          "step": "compute a value from the data",
          "here": "A strip chart puts each reviewer's score on the 1 to 5 scale as a dot sized by self-rated expertise, marks the range, and draws both the plain mean and the mean weighted by expertise.",
          "parts": [
            "score-spread"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "The four reviews sit side by side in columns or stacked, switched with a layout toggle that is remembered, each headed by its score, the reviewer's role and their expertise, with tagged passages highlighted.",
          "parts": [
            "reviews"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "Points pulled from the reviews in advance are already tagged; selecting more text in a review opens a popover to give it a topic and mark it Strength, Weakness or Question, and these hand-made tags persist across reloads.",
          "parts": [
            "tag-selection",
            "reviews"
          ]
        },
        {
          "step": "find where people disagree and resolve it",
          "here": "A topic-by-reviewer table shows S, W or Q per cell and a status for each topic; topics one reviewer calls a strength and another a weakness are flagged as disagreements and listed first, each with a button that adds a line naming who sees it which way.",
          "parts": [
            "agreement-by-topic"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Clicking a topic row narrows the point list to that topic, which can also be filtered by type and reviewer; clicking a point scrolls to it in its review and flashes it.",
          "parts": [
            "agreement-by-topic",
            "tagged-points",
            "reviews"
          ]
        },
        {
          "step": "write up the result",
          "here": "The meta-review is written in a text box that can be seeded with standard section headings; 'Add to draft' puts a point under Strengths, Weaknesses or Questions (or at the cursor if there are no headings) and greys it out in the list once its text is in the draft.",
          "parts": [
            "meta-review-draft",
            "tagged-points"
          ]
        },
        {
          "step": "export the result",
          "here": "The meta-reviewer picks accept, minor revisions, major revisions or reject, and the copy button puts the recommendation line and the draft on the clipboard.",
          "parts": [
            "meta-review-draft"
          ]
        }
      ],
      "distinctive": [
        "Scores are summarised twice, as a plain mean and as a mean weighted by each reviewer's self-rated expertise, with dot size showing expertise so a lone expert's low score is not hidden.",
        "Disagreement is defined per topic, as one reviewer calling it a strength while another calls it a weakness, and disagreeing topics are sorted to the top and can be written into the draft as a single summary line.",
        "Points go into the draft under the section heading that matches their type, and points already in the draft are greyed out so none is added twice.",
        "Points pulled from the reviews when they were pasted in and points the meta-reviewer tags by hand are pooled into the same agreement table, point list and highlights."
      ]
    }
  },
