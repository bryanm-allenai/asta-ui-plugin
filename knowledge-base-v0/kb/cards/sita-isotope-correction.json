  "app": {
    "title": "SITA — 13C natural-abundance correction",
    "summary": "The person types a fragment's molecular formula and how many of its carbons carry the tracer label, then computes the natural-abundance correction matrix and reads it as an indexed square table. In a second form they enter the same formula and backbone count plus a measured mass distribution vector as comma-separated values. This gives the corrected vector, normalised to sum to 1. Either result can be copied to the clipboard as CSV for use in later flux calculations.",
    "task": {
      "text": "Correct a measured isotopologue distribution of a GC-MS fragment for the natural abundance of heavy isotopes in its non-labelled atoms, giving the correction matrix and the corrected vector.",
      "verbs": [
        "derive"
      ]
    },
    "data": {
      "text": "A fragment's molecular formula and labelled-carbon count, an optional measured mass distribution vector (M+0 … M+n fractions), and a built-in table of natural isotope abundances per element; results are a square correction matrix and a corrected column vector.",
      "item": "one GC-MS fragment of a labelled compound, with its formula and measured mass distribution vector",
      "shapes": [
        "table"
      ]
    },
    "stage": {
      "text": "correcting measured mass isotopomer distributions for natural abundance, before metabolic flux ratio analysis",
      "terms": [
        "analyze"
      ]
    },
    "mechanism": {
      "text": "Two independent forms each post a formula, backbone carbon count and optionally a measured vector to a server that builds and inverts the per-element abundance matrices. The result appears as an indexed numeric table with the diagonal marked and the zero upper triangle faded, plus a copy-as-CSV button and a status line showing compute time or errors.",
      "views": [
        "form",
        "table view"
      ],
      "interactions": [
        "import",
        "export"
      ],
      "patterns": []
    },
    "field": {
      "text": "13C natural-abundance correction of GC-MS mass distribution vectors for metabolic flux analysis",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "metabolic flux analysis",
        "stable isotope tracing",
        "gc ms"
      ]
    },
    "workflow": {
      "name": "compute a correction from parameters and apply it to a measured vector",
      "steps": [
        {
          "step": "bring the data in",
          "here": "type the fragment's molecular formula and the number of backbone carbons subject to 13C labelling; the help text says the matrix size is backbone_c + 1",
          "parts": [
            "matrix-form"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "'compute matrix' builds a binomial abundance matrix for each element, using only the non-backbone carbons, multiplies them together and inverts the product. Errors such as an unparsable formula or a backbone count above the carbon count show inline",
          "parts": [
            "matrix-form",
            "status-line"
          ]
        },
        {
          "step": "look over the result",
          "here": "the inverted matrix is drawn as a table indexed by mass shift, with the diagonal underlined and the zero upper triangle shown as dots, captioned with its size and compute time",
          "parts": [
            "matrix-result"
          ]
        },
        {
          "step": "apply the correction to a measured vector",
          "here": "the second form adds a measured MDV as comma-separated fractions whose length must equal backbone_c + 1; 'compute mdv*' multiplies it by the inverse matrix and normalises it to 1",
          "parts": [
            "mdv-form",
            "status-line"
          ]
        },
        {
          "step": "export the result",
          "here": "a '[ copy ]' button on each result puts the matrix or corrected vector on the clipboard as CSV and briefly flashes the figure green or red",
          "parts": [
            "matrix-result",
            "mdv-result"
          ]
        }
      ],
      "distinctive": [
        "the labelled backbone carbons are left out of the correction because their labelling is the measured signal, so the person must give the labelled-carbon count separately from the formula",
        "per-element isotope distributions are expanded as truncated polynomial powers from fixed NIST natural abundances for H, C, N, O, Si, P, S, Cl and Br",
        "the vector length is tied to the labelled-carbon count (backbone_c + 1), and mismatched input is rejected with a message",
        "the unlabelled-biomass correction is deliberately not offered in the interface; a note points to the programmatic call instead"
      ]
    }
  },
