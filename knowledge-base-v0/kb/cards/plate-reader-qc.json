  "app": {
    "title": "Plate reader growth curve QC",
    "summary": "A person scans a whole multi-well plate laid out as tiny growth curves on one shared axis, where wells that trip quality-control rules are flagged, and can step from one flagged well to the next. Clicking a well opens its curve large with a fitted growth model and its parameters; they click points to drop or restore them and the fit updates, or exclude the whole well. A shaded table under the plate averages a growth parameter over the kept replicate wells for each condition, and the kept wells' parameters download as a CSV.",
    "task": {
      "text": "Find and remove bad wells and time points from a plate of growth curves before fitting growth parameters and comparing conditions.",
      "verbs": [
        "clean",
        "triage",
        "derive",
        "summarize",
        "compare",
        "identify"
      ]
    },
    "data": {
      "text": "Optical density readings over time for every well of a multi-well plate, with rows and columns standing for strains, replicates and drug concentrations, plus the person's exclusions and the fitted parameters.",
      "item": "a well on a 96-well plate with its growth curve",
      "shapes": [
        "grid of series",
        "time series",
        "judgements",
        "table"
      ]
    },
    "stage": {
      "text": "quality control of plate reader runs before analysis",
      "terms": [
        "clean",
        "analyze",
        "compare"
      ]
    },
    "mechanism": {
      "text": "A plate-shaped grid of small curves on a common scale gives the overview, with rule-based flags marking suspect wells, and selecting a well opens a large plot where clicking points drops them and refits. Every exclusion recomputes the well's parameters, its flags, the condition summary heatmap and the counts, and the kept wells export to a file.",
      "views": [
        "fixed-layout grid",
        "small multiples",
        "line chart",
        "detail panel",
        "summary stats",
        "heatmap"
      ],
      "interactions": [
        "select",
        "exclude and refit",
        "accept or reject",
        "export"
      ],
      "patterns": [
        "small multiples",
        "overview and detail",
        "master-detail",
        "review queue",
        "automatic flags"
      ]
    },
    "field": {
      "text": "microbiology, antibiotic susceptibility of bacterial efflux mutants",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "microbiology",
        "antibiotic susceptibility",
        "growth curves"
      ]
    },
    "workflow": {
      "name": "quality-check a grid of curves, then fit and summarise them by condition",
      "steps": [
        {
          "step": "look over every item at a glance",
          "here": "All 96 wells sit in plate layout, rows labelled by strain and columns by drug concentration, each drawn as a small curve of its readings with its logistic fit on one shared y axis; the header counts flagged and excluded wells and dropped points.",
          "parts": [
            "plate-grid"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "Wells that trip a QC rule get a coloured border and a flag mark, and Next flagged well jumps to the next flagged well that is not excluded, in plate order.",
          "parts": [
            "next-flagged",
            "qc-flags"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Clicking a well shows its readings large with the fitted curve and the tangent at the inflection, its fitted parameters and points used, and the rules that fired for it.",
          "parts": [
            "well-detail"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Each well's kept points get a four-parameter logistic fit by least squares, giving lag, maximum growth rate, carrying capacity, baseline and R squared; a well that barely rises is called no growth, is not fitted, and has its lag left blank.",
          "parts": [
            "growth-fit"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "Clicking a point on the large plot drops it or puts it back and the well refits at once, and a button excludes the whole well; the flags, the small curve, the summary and the counts all update.",
          "parts": [
            "point-dropping",
            "well-detail"
          ]
        },
        {
          "step": "summarise the kept items by condition",
          "here": "A shaded table gives the maximum growth rate for each strain and concentration, averaged over the kept replicate wells, with no-growth wells counted as zero, blanks left out, and n=1 or a dash where replicates were excluded.",
          "parts": [
            "condition-summary"
          ]
        },
        {
          "step": "export the result",
          "here": "Download kept wells writes a CSV with one row per kept well: its strain, replicate and concentration, lag, maximum rate, K, baseline, R squared, points used, the dropped time points and its flags.",
          "parts": [
            "csv-export"
          ]
        }
      ],
      "distinctive": [
        "Every small curve shares one y axis, so a flat well cannot look as if it grows while the plate is scanned.",
        "Four rules flag wells: spikes off a moving median, growth in a media-only blank, no growth without drug, and a poor fit.",
        "Single time points are dropped by clicking them, separately from excluding a whole well, and the dropped times go into the export.",
        "Lag is read from the tangent at the inflection, drawn on the plot, and left blank when the well does not grow.",
        "The summary averages the two replicate rows per strain and concentration and shades them, so the concentration where each strain stops growing shows."
      ]
    }
  },
