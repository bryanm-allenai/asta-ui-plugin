  },
  "app": {
    "title": "Complexation Property Explorer",
    "summary": "A person narrows a read-only reference database of measured equilibrium constants with sidebar filters: which metals, value type, ligand name or class, reaction stoichiometry, and numeric ranges for the value, temperature and ionic strength. They page through the matching records in a table and click one to open its conditions, values, duplicate and identity notes, and the literature references linked to it. They can then set it against a second record, from the same page or found by partial ID, in a field-by-field table that can show only the differences, and finally export every record matching the filters as a CSV.",
    "task": {
      "text": "Find published stability constants that match a chemical system and measurement conditions, check the details and sources of individual records against each other, and export the matching set.",
      "verbs": [
        "lookup",
        "compare",
        "explore",
        "identify"
      ]
    },
    "data": {
      "text": "A curated reference database of equilibrium constants and thermodynamic values, each record joining a metal species and a ligand to an equilibrium expression, a reported value, its measurement conditions, and candidate literature references, merged from more than one source with duplicate links kept.",
      "item": "one reported constant for a metal–ligand equilibrium under stated temperature, ionic strength, solvent and electrolyte",
      "shapes": [
        "table"
      ]
    },
    "stage": {
      "text": "looking up published constants for chosen metals and ligands, before modelling or designing an experiment with them",
      "terms": [
        "explore"
      ]
    },
    "mechanism": {
      "text": "Filters in a sidebar drive a counted, paginated results table; clicking a row sets the selected record, which drives a detail grid, a comparison table against a second record, and a linked-references table below. An export button writes out every record matching the current filters, and the header strip and a provenance panel summarise the database and its checksums.",
      "views": [
        "table view",
        "detail panel",
        "summary stats",
        "side-by-side panes"
      ],
      "interactions": [
        "filter",
        "search",
        "select",
        "toggle view",
        "export"
      ],
      "patterns": [
        "master-detail",
        "side-by-side comparison",
        "overview and detail"
      ]
    },
    "field": {
      "text": "metal–ligand stability constants in coordination chemistry",
      "disciplines": [
        "chemistry"
      ],
      "terms": [
        "coordination chemistry",
        "stability constants",
        "thermodynamic data"
      ]
    },
    "workflow": {
      "name": "filter a reference database, inspect and compare records, and export the matching set",
      "steps": [
        {
          "step": "filter to the items that matter",
          "here": "Sidebar filters choose all metals or chosen oxidation states, the value type (log K, ΔH, ΔS), a ligand-name substring, ligand classes, reaction stoichiometry, parsed-numeric-only, whether strict cross-source duplicates are included, and optional min–max ranges for value, temperature and ionic strength; a reset button restores defaults and an inverted range stops the search.",
          "parts": [
            "filter-sidebar"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The matching records are counted and shown in a compact table (identity, equilibrium, value, conditions), paged 25–250 at a time with first/prev/next/last, and a toggle adds extended columns for source, classification, uncertainty and notes.",
          "parts": [
            "results-table",
            "database-header"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Clicking a result row fills a fact grid with the record's metal, ligand, formula, equilibrium, reported and parsed value and conditions, and notes whether it has an exact cross-source duplicate or a ligand with an identical structure from another source.",
          "parts": [
            "record-detail"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "A second record is chosen from the current page or found by partial Record ID search across the whole database, and a Field / Selected / Comparison / Match table sets the two against each other, optionally showing only the fields that differ.",
          "parts": [
            "record-compare"
          ]
        },
        {
          "step": "check where a value comes from",
          "here": "The literature references linked to the selected record's ligand–metal pair are listed with codes and not-used flags, under a warning that links are at the ligand-plus-metal level rather than to the exact record.",
          "parts": [
            "linked-references",
            "provenance-panel"
          ]
        },
        {
          "step": "export the result",
          "here": "Prepare filtered CSV builds a UTF-8 file of up to 50,000 records matching the current filters with all extended columns, then Download CSV saves it.",
          "parts": [
            "csv-export"
          ]
        }
      ],
      "distinctive": [
        "measurement conditions (temperature, ionic strength) are range filters alongside the value itself, because a constant is only meaningful under its conditions",
        "equilibrium expressions are classified into reaction stoichiometries (1:1 to 1:4 complexes, protonation, hydrolysis, precipitation) so records can be filtered by reaction type",
        "reported source text is kept apart from parsed numeric values, and chemical markup is turned into readable formulae only for display",
        "records merged from several sources keep exact cross-source duplicates, hidden by default but traceable, with structure-identity links between ligands",
        "the database is opened read-only and its checksum and build version are shown, so a looked-up value can be traced to an exact dataset release"
      ]
    }
  },
