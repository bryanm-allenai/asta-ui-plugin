  "app": {
    "title": "Earth Intelligence Platform",
    "summary": "The person types a city and country. The interface finds the place's boundary, shows it on a map and lists the open datasets that cover it. They then run a series of data engines one page at a time: satellite imagery, chosen by date and a maximum cloud-cover threshold; terrain from an elevation model; weather over a chosen date range; and land cover classes. Each engine shows its maps, distributions and summary numbers. Once those have run, a risk step scores five hazards, each with a category, a confidence and its drivers. A final step combines everything into one composite score for the place, broken into components, with short insights, recommendations and stated limitations.",
    "task": {
      "text": "Turn a place name into a composite score for its environmental condition and hazards by pulling and summarising satellite, terrain, weather and land cover data for its boundary.",
      "verbs": [
        "derive",
        "summarize",
        "explore",
        "compare"
      ]
    },
    "data": {
      "text": "An area-of-interest boundary with rasters clipped to it (multispectral imagery, an elevation model and its derivatives, a land cover classification), plus an hourly weather series for the area and a fixed list of land cover classes and hazard categories",
      "item": "an area of interest (one city's boundary) with every data layer clipped to it",
      "shapes": [
        "geospatial",
        "field",
        "image",
        "time series",
        "categories",
        "table"
      ]
    },
    "stage": {
      "text": "screening a place's environmental hazards from open Earth-observation data, at the start of an assessment",
      "terms": [
        "analyze",
        "explore"
      ]
    },
    "mechanism": {
      "text": "A Home page turns a typed place into a boundary that every later page needs. A sidebar of pages runs one engine each, and each page stays locked until the engines it depends on have run, with a checklist on Home showing which have finished. Each engine page draws its own raster maps, histograms and summary cards, and the last two pages bring those results together into hazard gauges and a composite-score dashboard.",
      "views": [
        "map",
        "image viewer",
        "bar chart",
        "line chart",
        "summary stats",
        "table view",
        "heatmap"
      ],
      "interactions": [
        "search",
        "filter",
        "zoom and pan",
        "toggle view",
        "hover for detail",
        "select"
      ],
      "patterns": [
        "dashboard",
        "status pipeline",
        "overview and detail"
      ]
    },
    "field": {
      "text": "multi-hazard risk screening from satellite remote sensing in earth science",
      "disciplines": [
        "earth science"
      ],
      "terms": [
        "remote sensing",
        "multi hazard risk assessment",
        "geoai"
      ]
    },
    "workflow": {
      "name": "build a composite score for a place by running data layers in sequence",
      "steps": [
        {
          "step": "bring the data in",
          "here": "City and Country text boxes and an Analyze Area button resolve the place to a boundary, draw it on a map with its area and perimeter, and list the datasets that apply to it",
          "parts": [
            "aoi-home",
            "aoi-map"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "on the Satellite page a start date and a Maximum Cloud Cover slider narrow the candidate scenes, and a live check warns when nothing matches before the engine is run",
          "parts": [
            "satellite-view"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "each engine page has a Run button. Terrain derives elevation, slope, aspect and hillshade; Weather fetches the hourly series for a chosen date range; Land Cover gives area and percentage per class, with an optional date-specific ML classification",
          "parts": [
            "terrain-view",
            "weather-view",
            "landcover-view"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "zoomable RGB, false-colour and cloud-mask images, raster tabs with histograms and an aspect rose, climographs and a wind rose, and class-percentage bars, each with min, max, mean and standard deviation cards",
          "parts": [
            "satellite-view",
            "terrain-view",
            "weather-view",
            "landcover-view"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Run Risk Engine, locked until Terrain, Land Cover, Weather and Satellite have succeeded, scores five hazards from 0 to 100 with a category, a confidence and drivers. A tab for each hazard opens its gauge, and for wildfire an ML-calibrated score is shown beside the formula score",
          "parts": [
            "risk-view"
          ]
        },
        {
          "step": "write up the result",
          "here": "Run Earth Intelligence Engine combines five weighted components into one score, shown as a gauge and a radar chart, and lists rule-based insights, recommendations, the drivers behind the highest hazard, and the limitations",
          "parts": [
            "intelligence-view"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "a Workflow checklist on Home ticks each of the eight engines as it completes, and each page points to the next one",
          "parts": [
            "aoi-home"
          ]
        }
      ],
      "distinctive": [
        "each page is locked until its upstream engines have run successfully, so the work has to follow the dependency order",
        "the cloud-cover threshold is checked against scene availability before the slow download, with advice to raise it when nothing matches",
        "hazard scores carry a confidence and named drivers, and one hazard shows a learned score next to the hand-weighted formula for comparison",
        "a static land cover map and a date-specific ML classification can be shown side by side with the same class legend",
        "the final score is a fixed weighting of environmental quality, terrain stability, climate conditions, hazard resilience and sustainability"
      ]
    }
  },
