  "app": {
    "title": "Complex Network Analysis Tool (CNATool)",
    "summary": "A person opens a network file (Pajek, JSON or an adjacency-matrix CSV) or generates a synthetic network of a chosen topology, and sees it drawn as a graph they can lay out with a force-directed or no-overlap algorithm and drag by hand. A side panel shows the network's counts and density. Ticking 'Calculate Properties' computes average degree, average clustering, average shortest path, diameter and global efficiency, optionally on the GPU. Per-vertex tables of degree, clustering and centrality open in new windows, and the network, an SVG of the drawing and an HTML properties report can be saved.",
    "task": {
      "text": "Compute the topological properties of a network, overall and per vertex, and save them as a report alongside the drawn graph.",
      "verbs": [
        "derive",
        "summarize",
        "explore"
      ]
    },
    "data": {
      "text": "A graph of vertices and possibly weighted, possibly directed edges, loaded from a network file or generated from a topology model, with derived per-vertex measures shown as tables.",
      "item": "a network, made of vertices and the edges between them",
      "shapes": [
        "network",
        "table"
      ]
    },
    "stage": {
      "text": "analysing a network's structure once it has been built, before writing up its properties",
      "terms": [
        "analyze",
        "explore"
      ]
    },
    "mechanism": {
      "text": "A properties panel beside a canvas drawing of the network: the panel's checkboxes and layout menu redraw the graph and recompute the global measures, while the menus generate or load networks, open per-vertex report tables in new windows and save the network, drawing and report.",
      "views": [
        "network diagram",
        "summary stats",
        "table view"
      ],
      "interactions": [
        "import",
        "toggle view",
        "drag to arrange",
        "export"
      ],
      "patterns": [
        "overview and detail"
      ]
    },
    "field": {
      "text": "complex network analysis in network science",
      "disciplines": [
        "computer science"
      ],
      "terms": [
        "network science",
        "complex networks",
        "social network analysis"
      ]
    },
    "workflow": {
      "name": "compute and report the structural measures of a graph",
      "steps": [
        {
          "step": "bring the data in",
          "here": "File > Open reads a Pajek .net, a JSON nodes/edges file or a CSV adjacency matrix; File > New instead generates a complete, random, scale-free, small-world or hybrid network from vertex count, edge count, probability or average degree typed into prompts.",
          "parts": [
            "file-menu",
            "network-generator"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The network is drawn on a canvas; a layout menu runs Force Atlas 2 or No Overlap, nodes can be dragged, and checkboxes show labels and scale edge widths by weight.",
          "parts": [
            "network-canvas",
            "layout-controls"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "The panel always shows vertices, edges and density; ticking 'Calculate Properties' adds average degree, average clustering coefficient, average shortest path, diameter and global efficiency, with a directed-graph switch and an option to run on the GPU.",
          "parts": [
            "properties-panel"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "View menu opens tables of each vertex's degree, clustering coefficient and centralities, or the full properties summary, in a new window; these refuse until properties have been calculated.",
          "parts": [
            "vertex-reports"
          ]
        },
        {
          "step": "export the result",
          "here": "File > Save writes the network as Pajek or JSON, the drawing as SVG, or the properties summary as an HTML report.",
          "parts": [
            "save-menu"
          ]
        }
      ],
      "distinctive": [
        "Synthetic networks of standard topologies (complete, random, scale-free, small-world, hybrid) can be generated as baselines to compare against loaded networks.",
        "The expensive all-pairs measures (shortest paths, diameter, efficiency) only run when a checkbox is ticked, and can be offloaded to the GPU.",
        "A directed/undirected switch changes how density and the other measures are computed.",
        "Reads and writes the Pajek network format as well as JSON and adjacency-matrix CSV."
      ]
    }
  },
