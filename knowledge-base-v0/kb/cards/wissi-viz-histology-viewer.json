  "app": {
    "title": "wissi-viz: whole-slide histology viewer with annotation and spatial analysis",
    "summary": "A person opens whole-slide images, plus any cell tables or annotation files for them, and views them in up to 32 panes that can pan and zoom together. They outline a few example objects with SAM or the drawing tools, saving each to a layer and class, and then find all similar objects in the view or across the whole slide, by example, by a text prompt or with a cell model. A strictness slider sets how close a match must be. They then run spatial analyses on a cell layer, optionally only inside chosen regions, and measure regions. The result is overlay layers, charts and tables, which they export as annotation files, CSVs and snapshots.",
    "task": {
      "text": "Outline objects on gigapixel tissue images, find every similar one, and compute counts and spatial statistics of the cells inside chosen regions.",
      "verbs": [
        "annotate",
        "identify",
        "derive",
        "explore",
        "summarize",
        "compare"
      ]
    },
    "data": {
      "text": "Very large multi-resolution microscope images, brightfield or multi-channel fluorescence, with tables of detected objects (one row per cell, with class and measurements) and region annotations drawn on top.",
      "item": "a whole-slide image with its layers of outlined cells and regions",
      "shapes": [
        "image collection",
        "image",
        "table",
        "categories"
      ]
    },
    "stage": {
      "text": "annotating and analysing scanned tissue slides, after scanning and before reporting results",
      "terms": [
        "annotate",
        "analyze",
        "explore"
      ]
    },
    "mechanism": {
      "text": "A slide list drives a grid of synced GPU image panes. Object and annotation layers are drawn on the panes, and an inspector beside them follows the active pane. In the inspector's tabs the person shows or hides layers and classes, marks examples and finds all like them, runs analyses that add layers, charts and tables, and measures regions. Clicking an object on the slide opens a card with its measurements.",
      "views": [
        "sidebar list",
        "image viewer",
        "side-by-side panes",
        "detail panel",
        "list",
        "bar chart",
        "table view",
        "summary stats",
        "form"
      ],
      "interactions": [
        "select",
        "zoom and pan",
        "filter",
        "search",
        "apply label",
        "keyboard shortcuts",
        "hover for detail",
        "toggle view",
        "import",
        "export"
      ],
      "patterns": [
        "master-detail",
        "overview and detail",
        "linked views",
        "category palette",
        "side-by-side comparison",
        "focus and context"
      ]
    },
    "field": {
      "text": "cell segmentation and spatial analysis of whole-slide images in digital pathology",
      "disciplines": [
        "medicine"
      ],
      "terms": [
        "digital pathology",
        "spatial analysis",
        "histology"
      ]
    },
    "workflow": {
      "name": "mark examples on large images, find all like them, and measure what was found",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Open slides, a folder or pasted paths, or connect to a tile API. Then add a cell table or annotation file (CSV, Parquet, AnnData, GeoJSON, HALO XML) to the active slide.",
          "parts": [
            "slide-list",
            "slide-panes"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Show slides in 1–32 panes with pan or zoom sync. Jump to 2.5–40× and use the overview map and the scale bar.",
          "parts": [
            "slide-panes",
            "slide-list"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "Choose a layer, a class and a colour. Then outline examples with SAM (click to include, shift-click to exclude, drag a box) or the drawing tools, and press Accept. Picking existing objects also makes them examples.",
          "parts": [
            "annotate-find"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Find all like them as similar objects, segment everything, areas or by text, in this view or the whole slide, leaving out regions if needed. A strictness slider sets how close matches must be. The find runs as a background job with progress and a Cancel button.",
          "parts": [
            "annotate-find"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Pick a cell layer and, optionally, regions to stay inside. Then run density and hotspots, nearest neighbours, proximity, margin bands, composition, Ripley's L, neighbourhoods, contacts or Moran's I. Each run adds slide layers and a result card with a chart and a table.",
          "parts": [
            "analyze",
            "inspector"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Click a cell for a card with its measurements and where it ranks in its layer. The Measure tab gives counts and shares per class and shape, intensity and texture for each region.",
          "parts": [
            "object-card",
            "measure",
            "layers"
          ]
        },
        {
          "step": "export the result",
          "here": "Export layers as GeoParquet, QuPath GeoJSON, HALO or Aperio XML, CSV or COCO JSON. Download a CSV of each analysis or measurement, or save a PNG snapshot of a pane with its scale bar.",
          "parts": [
            "layers",
            "analyze",
            "measure",
            "slide-panes"
          ]
        }
      ],
      "distinctive": [
        "Images are gigapixel pyramids, so navigation works at objective magnifications (2.5–40×), and object layers are drawn as aggregated dots when zoomed out and as outlines up close.",
        "Examples can come from a click-to-segment model, a text prompt or a cell model, and one strictness setting re-thresholds the matches without rerunning the search.",
        "Analyses can be limited to the cells inside regions found or drawn earlier, which chains find → region → analysis.",
        "Spatial statistics of point patterns (Ripley's L, neighbour enrichment, contact graphs, Moran's I) are computed per class, and each one adds a layer on the slide.",
        "Fluorescence channels have their own histograms, min/max, gamma and colour, and brightfield slides can be shown by stain through stain deconvolution."
      ]
    }
  },
