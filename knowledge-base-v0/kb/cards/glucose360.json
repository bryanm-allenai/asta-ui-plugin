  "app": {
    "title": "Glucose360 (web app)",
    "summary": "A person loads continuous glucose sensor exports (or example data), choosing the device format, resampling interval and largest gap to interpolate, and the app detects glycemic episodes and excursions as events. They can add their own events, such as meals, in bulk from a file or one at a time, each with a window before and after. They read a table of glycemic metrics per patient and a table of per-event-type metrics, view one patient's trace as daily, weekly, overlaid-day or ambulatory-profile plots, and open single events to see their metrics and trace. Metrics tables, event lists, plots and a per-patient profile report are downloaded.",
    "task": {
      "text": "Turn raw continuous glucose sensor exports into per-patient glycemic metrics and event-level response measures, with standard plots and reports to check them.",
      "verbs": [
        "derive",
        "summarize",
        "identify",
        "explore",
        "annotate"
      ]
    },
    "data": {
      "text": "Glucose readings over days or weeks for one or more patients, resampled to a regular interval, plus a table of timed events (detected episodes, imported meals, custom events) each with a window before and after.",
      "item": "a patient's sensor trace, and an event: a timestamp on that trace with a window, a type and a description",
      "shapes": [
        "time series",
        "events",
        "table"
      ]
    },
    "stage": {
      "text": "computing metrics from raw sensor exports, after collection and before statistical analysis",
      "terms": [
        "analyze",
        "explore"
      ]
    },
    "mechanism": {
      "text": "Tabs move from import, to adding events, to metric tables, to plots, to an event browser; a patient dropdown drives the plots and the event views. In the event browser, selecting event types in a small table filters the event list, and a row number picks one event whose metrics table and windowed trace plot are shown beside it.",
      "views": [
        "form",
        "table view",
        "line chart",
        "detail panel"
      ],
      "interactions": [
        "import",
        "select",
        "filter",
        "toggle view",
        "inline edit",
        "export"
      ],
      "patterns": [
        "master-detail",
        "overview and detail"
      ]
    },
    "field": {
      "text": "continuous glucose monitoring analysis in diabetes research",
      "disciplines": [
        "medicine"
      ],
      "terms": [
        "continuous glucose monitoring",
        "glycemic variability",
        "ambulatory glucose profile"
      ]
    },
    "workflow": {
      "name": "compute per-subject metrics and event responses from sensor time series",
      "steps": [
        {
          "step": "bring the data in",
          "here": "pick a device format (or custom glucose and time columns), upload a .csv or .zip, set the resampling interval and maximum gap to interpolate, optionally an ID template and a CSV that splits the data into intervals; or use the example data",
          "parts": [
            "import-data"
          ]
        },
        {
          "step": "mark events on the time series",
          "here": "hypo- and hyperglycemic episodes and excursions are detected automatically; meals are bulk-imported from a day/time CSV with minutes before and after, or a single event is added by date, time, type and description for the chosen patient",
          "parts": [
            "import-events"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "one row per patient of glycemic metrics (time in ranges, variability indices, risk indices), and a second table of metrics per event type",
          "parts": [
            "features"
          ]
        },
        {
          "step": "look over one subject's series",
          "here": "choose a patient and a plot type (daily, weekly, spaghetti with an optional weekday/weekend split, AGP), set its height, and pick event types to mark on the daily plot",
          "parts": [
            "plots"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "filter the patient's events by type, pick one by row number, and read its baseline, peak, delta, AUC, iAUC and post-event values beside a plot of its window; fix a field of an event by row and column",
          "parts": [
            "event-type-filter",
            "event-detail",
            "event-editor"
          ]
        },
        {
          "step": "export the result",
          "here": "download metrics and event metrics as .csv, selected events as .csv, the current plot as a PDF+HTML zip, and an AGP report as HTML",
          "parts": [
            "features",
            "plots",
            "event-type-filter"
          ]
        }
      ],
      "distinctive": [
        "readings are resampled to a fixed interval and gaps are interpolated only up to a set maximum, before any metric is computed",
        "events are windows: a timestamp with minutes before and after, so the same metrics apply to detected episodes and to imported meals",
        "episodes use clinical glucose thresholds by level, and excursions use standard deviations from each patient's own mean",
        "event responses are measured from a baseline: peak, delta, incremental AUC and values at fixed minutes after the event",
        "a standard clinical summary (the ambulatory glucose profile report) can be generated per patient"
      ]
    }
  },
