  "app": {
    "title": "VGG Image Annotator (VIA) 2.0.5",
    "summary": "A person adds images to a project from disk, URLs, file paths or a list, and defines region and file attributes (text, checkbox, radio, dropdown or image options) that can be changed as the work goes on. They step through the images, pick a shape and draw regions on each image, then fill in each region's attributes in an editor on the image or in a spreadsheet-like editor below it. A filtered file list shows which images still lack regions or annotations. A grid view groups images by attribute values so many can be selected and labelled at once. The annotations are exported as CSV or JSON, or saved as a project file to carry on later.",
    "task": {
      "text": "Mark regions on a collection of images and attach attribute labels to each region and image, producing an annotation file.",
      "verbs": [
        "annotate",
        "organize",
        "curate"
      ]
    },
    "data": {
      "text": "A collection of images, each with drawn regions (rectangles, circles, ellipses, polygons, points, polylines) carrying attribute values, plus attributes for the whole image, under a user-defined attribute scheme.",
      "item": "a region drawn on one image, with its attribute values",
      "shapes": [
        "image collection",
        "image",
        "categories",
        "table"
      ]
    },
    "stage": {
      "text": "annotating image collections with regions and labels, before training or evaluating a model",
      "terms": [
        "annotate"
      ]
    },
    "mechanism": {
      "text": "A sidebar file list drives a large image canvas where regions are drawn with a chosen shape. An attribute editor defines the label scheme, and an annotation editor (on the image or as a table below it) fills in values for regions and files. A grid view groups images by attribute value so whole groups can be selected and labelled together.",
      "views": [
        "image viewer",
        "sidebar list",
        "thumbnail grid",
        "table view",
        "form"
      ],
      "interactions": [
        "import",
        "select",
        "multi-select",
        "filter",
        "search",
        "zoom and pan",
        "apply label",
        "inline edit",
        "keyboard shortcuts",
        "drag to arrange",
        "toggle view",
        "export",
        "undo"
      ],
      "patterns": [
        "master-detail",
        "category palette",
        "overview and detail"
      ]
    },
    "field": {
      "text": "region annotation of images for computer vision datasets",
      "disciplines": [
        "computer science"
      ],
      "terms": [
        "computer vision",
        "image annotation",
        "ground truth"
      ]
    },
    "workflow": {
      "name": "mark regions on images and label each with attributes from a scheme",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Add local files, URLs, absolute paths or a text list of paths; previous annotations come in as CSV/JSON, or a whole saved project is loaded",
          "parts": [
            "top-bar",
            "file-list"
          ]
        },
        {
          "step": "define the categories to apply",
          "here": "Attributes editor: add region or file attributes by name and set the type (text, checkbox, radio, dropdown, image) and its options and defaults; this can be edited at any point",
          "parts": [
            "attributes-editor"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "Arrow keys, Home/End, PgUp/PgDn or a click in the file list move between images; filters show files without regions, missing annotations or failed loads, or match a regular expression",
          "parts": [
            "file-list",
            "image-canvas"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "Choose rectangle, circle, ellipse, polygon, point or polyline (keys 1–6), draw on the zoomable canvas, move or resize, and copy or paste regions across images",
          "parts": [
            "shape-palette",
            "image-canvas"
          ]
        },
        {
          "step": "attach values to each region and item",
          "here": "Fill in attribute values in the on-image editor or in the spreadsheet-like region/file annotation editor, one row per region",
          "parts": [
            "annotation-editor"
          ]
        },
        {
          "step": "group items into clusters",
          "here": "Image grid groups images by file or region attribute values; select many thumbnails and set an attribute for all of them at once",
          "parts": [
            "image-grid",
            "annotation-editor"
          ]
        },
        {
          "step": "export the result",
          "here": "Export annotations as CSV or JSON, export the attribute scheme, download an image with the annotations drawn on it, or save the project as JSON",
          "parts": [
            "top-bar"
          ]
        }
      ],
      "distinctive": [
        "Six region shapes, including polygon and polyline with vertex editing, are stored in image pixel coordinates whatever the zoom",
        "Labels live at two levels, the region and the whole file, and each attribute has a typed input that can include image options to pick from",
        "Preset filters find files still missing regions or annotations, so the person can see what work is left",
        "Grid view groups thumbnails by nested attribute values for bulk labelling and for checking a group's consistency",
        "Regions can be pasted into many images at once, and that paste can be undone"
      ]
    }
  },
