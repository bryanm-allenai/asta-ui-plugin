  "app": {
    "title": "Matrix editor for aligned manuscript witnesses",
    "summary": "A person opens one or more aligned files (TEI XML or CSV), with one witness per row and one aligned reading per column. They fix the alignment in the matrix: they select, merge, group, insert or delete columns, edit cells and reorder rows, mark columns as insignificant or binary, and switch between normalized and diplomatic readings, with undo and redo. They can open each witness as running text and load a phylogenetic tree in NeXML. Clicking a reading highlights it in every view and colours the tree by variant. Clicking an internal node of the tree reconstructs that ancestor's text by parsimony and adds it to the matrix as a new row. The corrected alignment is saved, or exported as a TEI corpus, a TEI critical apparatus, CSV, or NEXUS for tree-building software.",
    "task": {
      "text": "Correct a multiple alignment of a text's witnesses, then reconstruct ancestral readings from a tree to produce a critical text and apparatus.",
      "verbs": [
        "clean",
        "compare",
        "derive",
        "annotate",
        "write"
      ]
    },
    "data": {
      "text": "Several versions of one text aligned into a matrix of witnesses by aligned positions, plus a rooted phylogenetic tree over those witnesses.",
      "item": "an aligned reading: one witness's text at one position in the alignment",
      "shapes": [
        "sequence",
        "table",
        "versions",
        "hierarchy",
        "text corpus"
      ]
    },
    "stage": {
      "text": "correcting a machine collation of witnesses and reconstructing the text from a tree, before publishing the edition",
      "terms": [
        "clean",
        "analyze",
        "compare"
      ]
    },
    "mechanism": {
      "text": "An editable alignment matrix is linked to running-text views of each witness and to tree views. Selecting a column or reading highlights it everywhere, colours the tree's leaves by variant and fills in reconstructed readings. Clicking a tree node runs a parsimony reconstruction in a background worker and appends the result to the matrix as a new row.",
      "views": [
        "table view",
        "document reader",
        "tree view",
        "sidebar list"
      ],
      "interactions": [
        "import",
        "select",
        "brush",
        "inline edit",
        "drag to arrange",
        "apply label",
        "toggle view",
        "hover for detail",
        "keyboard shortcuts",
        "undo",
        "export"
      ],
      "patterns": [
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "computer-aided collation and stemmatic reconstruction in textual criticism",
      "disciplines": [
        "humanities"
      ],
      "terms": [
        "textual criticism",
        "stemmatics",
        "sanskrit philology"
      ]
    },
    "workflow": {
      "name": "correct an alignment of versions and reconstruct their common ancestor",
      "steps": [
        {
          "step": "bring the data in",
          "here": "One or more aligned TEI XML or CSV files are loaded into the matrix. Several files are joined into one matrix. A NeXML tree can be added later from the Trees menu.",
          "parts": [
            "file-loader"
          ]
        },
        {
          "step": "fix the alignment by editing positions and versions",
          "here": "Columns are selected by click or drag, then merged, grouped, inserted, deleted or renormalized. Cells are edited with Enter, and rows are dragged to reorder. Empty columns and rows can be removed in bulk. Ctrl-Z and Ctrl-Shift-Z undo and redo.",
          "parts": [
            "alignment-matrix",
            "column-tools"
          ]
        },
        {
          "step": "label positions that should not count",
          "here": "Columns are marked 'insignificant' or 'binary', and the View menu switches between normalized and diplomatic readings.",
          "parts": [
            "column-tools",
            "editor-menu"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Each witness can be opened as running text. The arrow keys step through readings, and a selected reading is highlighted in the matrix, in every text and on the tree, where the leaves are coloured by variant.",
          "parts": [
            "witness-text",
            "tree-view"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Clicking an internal node of the tree asks for a label. A Fitch parsimony pass in a web worker then reconstructs that node's reading at every position and adds it to the matrix as a new row. Hovering over a node shows its reconstructed reading.",
          "parts": [
            "reconstruction",
            "tree-view"
          ]
        },
        {
          "step": "export the result",
          "here": "The corrected matrix is saved with Save As, or exported as a TEI corpus, a TEI apparatus, CSV, or NEXUS character data for tree-building software.",
          "parts": [
            "exporter"
          ]
        }
      ],
      "distinctive": [
        "Ancestral readings are worked out by Fitch parsimony over a tree loaded from NeXML, and each reconstructed node becomes an extra version in the same matrix.",
        "Hand edits to a reconstructed row are recorded as emendations and shown apart from the computed reading.",
        "Columns can be flagged 'insignificant' or 'binary', which changes how they are treated, and each reading has both a normalized and a diplomatic form.",
        "The NEXUS export turns each aligned position into a character, with one state per distinct reading, ready for phylogenetic software.",
        "Text views can be switched between several Indic scripts by transliteration."
      ]
    }
  },
