  "app": {
    "title": "ActiSleep Tracker: correcting automatic sleep windows in actigraphy",
    "summary": "A person picks one participant's processed accelerometer output and loads it. They step through the recording one day at a time, each shown as a 36-hour plot of wrist angle and movement with the current sleep window shaded over it and the algorithm's original window listed beside the corrected one. They drag range sliders to move sleep onset and wake-up, add extra windows for naps or broken nights, and switch on flags for multiple sleep periods, nights needing review, or nights with too much missing data. Every change is saved straight away into a corrected sleep log, a multiple-sleep log and a data-cleaning file that lists the nights to leave out of later analysis.",
    "task": {
      "text": "Check and correct an algorithm's sleep onset and wake-up times day by day against the raw movement signal, flag problem nights, and write out corrected logs for re-analysis.",
      "verbs": [
        "clean",
        "annotate",
        "review",
        "triage"
      ]
    },
    "data": {
      "text": "One participant's multi-day wrist accelerometer recording as regular epochs of sensor angle, movement and non-wear, with the algorithm's sleep windows per day and the person's corrected windows and flags.",
      "item": "one day of a participant's recording, shown as a 36-hour window from noon to the next midnight",
      "shapes": [
        "time series",
        "events",
        "judgements"
      ]
    },
    "stage": {
      "text": "cleaning automatic sleep detection after accelerometer processing, before sleep analysis",
      "terms": [
        "clean",
        "annotate"
      ]
    },
    "mechanism": {
      "text": "A day slider chooses which 36-hour window is drawn as a dual-axis line chart; range sliders under the chart set each sleep window, which is shaded on the chart and listed in a table next to the algorithm's original times. Toggle switches record per-day flags, and every slider move or toggle writes the corrected logs to disk at once.",
      "views": [
        "line chart",
        "table view",
        "form"
      ],
      "interactions": [
        "select",
        "brush",
        "time slider",
        "hover for detail",
        "inline edit",
        "export",
        "import",
        "sort"
      ],
      "patterns": [
        "review queue",
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "sleep scoring of wrist actigraphy in sleep and health research",
      "disciplines": [
        "medicine"
      ],
      "terms": [
        "actigraphy",
        "sleep scoring",
        "ggir"
      ]
    },
    "workflow": {
      "name": "correct automatically detected time windows in a long recording, period by period, and save the corrected log",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Pick a participant's processing output folder from a dropdown and press Load Files; the first load converts it into a local database behind a spinner.",
          "parts": [
            "file-selection"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "A slider numbered by day picks which 36-hour window to show; a banner warns when a daylight-saving shift falls in the recording.",
          "parts": [
            "day-slider"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "The day is drawn as sensor z-angle and arm movement on two axes, with sleep windows shaded red, non-wear shaded green, and the algorithm's onset, offset and duration in a table.",
          "parts": [
            "sensor-graph",
            "sleep-tables"
          ]
        },
        {
          "step": "adjust a detected time window against the signal",
          "here": "Drag a range slider under the chart to move onset and wake-up; Add Slider and Remove Slider create or drop extra windows for naps, and overlapping windows are pushed apart automatically.",
          "parts": [
            "sleep-window-sliders",
            "sleep-tables"
          ]
        },
        {
          "step": "flag items that need attention or exclusion",
          "here": "Three switches per day mark multiple sleep periods, a night needing further review, and more than two hours of data missing overnight.",
          "parts": [
            "night-flags"
          ]
        },
        {
          "step": "export the result",
          "here": "Each change rewrites a sleep log in the processing tool's format (longest window per night), a log of every sleep window, and a data-cleaning file listing nights to omit.",
          "parts": [
            "sleep-window-sliders",
            "night-flags"
          ]
        },
        {
          "step": "mark the item set as finished",
          "here": "A checkbox records that the participant is done before moving on to the next one.",
          "parts": [
            "finished-checkbox"
          ]
        }
      ],
      "distinctive": [
        "Each day is shown as a 36-hour window starting at noon, so sleep that runs past the algorithm's usual detection window stays visible.",
        "The algorithm's original window is kept and shown beside the corrected one, so the change can be traced.",
        "Several sleep windows can exist per day and are kept from overlapping; the longest one becomes the night's main window in the exported log.",
        "Outputs are written in the processing tool's own sleep-log and data-cleaning formats so it can be rerun on them; nights with no window or flagged as missing data are excluded automatically.",
        "Daylight-saving shifts are detected per day and handled in the time axis and slider positions."
      ]
    }
  },
