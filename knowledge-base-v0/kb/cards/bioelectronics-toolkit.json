  "app": {
    "title": "DataProcess: local toolkit for turning lab instrument recordings into figures and CSV exports",
    "summary": "A person picks a tool from a dashboard, points it at a folder of instrument files, and chooses one file from the list beside the plot; the folder can be watched so new recordings appear and open as they are written. For the chosen recording they choose which sweep and channel to show. They can subtract a baseline window and normalise by resistance, then crop the time and value range and downsample. The trace redraws after each change. They export the processed trace as a PNG, SVG or CSV, or queue several files and export them all with the same settings, and each export is logged with its inputs and parameters.",
    "task": {
      "text": "Preview raw electrophysiology and other instrument recordings, apply baseline and window settings, and export reproducible figures and trace CSVs one file or a whole queue at a time.",
      "verbs": [
        "explore",
        "derive",
        "lookup",
        "curate"
      ]
    },
    "data": {
      "text": "Folders of raw instrument recordings, each holding one or more sweeps of several channels sampled over time, plus file metadata such as sweep count, channel count, duration and sample rate.",
      "item": "one recording file, shown as one sweep of one channel at a time",
      "shapes": [
        "time series",
        "table",
        "events"
      ]
    },
    "stage": {
      "text": "processing raw recordings right after acquisition, before figures and statistics",
      "terms": [
        "explore",
        "clean",
        "analyze"
      ]
    },
    "mechanism": {
      "text": "A sidebar of folder controls and a file list drives a main line chart. Picking a file loads its metadata and fills the sweep and channel menus, and every parameter field redraws the chart. An export section and a reorderable batch queue apply the current settings to one file or many, and each export is written to a run history.",
      "views": [
        "sidebar list",
        "line chart",
        "form",
        "summary stats",
        "list"
      ],
      "interactions": [
        "select",
        "filter",
        "hover for detail",
        "zoom and pan",
        "toggle view",
        "export",
        "import"
      ],
      "patterns": [
        "master-detail",
        "overview and detail",
        "version history"
      ]
    },
    "field": {
      "text": "trace processing of patch-clamp, electrochemical and EMG recordings in bioelectronics",
      "disciplines": [
        "biology",
        "engineering"
      ],
      "terms": [
        "electrophysiology",
        "bioelectronics",
        "patch clamp"
      ]
    },
    "workflow": {
      "name": "preview a recording, set processing parameters, and export the processed trace for one or many files",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Type or choose a folder, or open the demo examples. The folder is scanned for .abf files, with Up and Refresh buttons, and an optional auto-refresh every 3, 5 or 10 seconds that can open the newest file as it appears.",
          "parts": [
            "folder-picker"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Click a file in the filterable list. Its sweep count, channel count, duration and sample rate fill the File Info panel, and the channel menus fill from its channels.",
          "parts": [
            "file-list",
            "file-info"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Choose sweep and channel, set a baseline window in ms to subtract, and optionally tick R normalization to estimate resistance from the current and voltage channels and rescale the trace.",
          "parts": [
            "trace-params",
            "trace-plot"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Set X and Y min/max to crop the view window and choose a downsample factor. The chart redraws on every change, with a value readout on hover.",
          "parts": [
            "trace-params",
            "trace-plot"
          ]
        },
        {
          "step": "export the result",
          "here": "Export the current processed trace as PNG, SVG or CSV through a background job with a progress readout. The export is recorded in run history with its source file and parameters.",
          "parts": [
            "export-controls"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "Add the current file or all files to a batch queue. Reorder it, remove items or clear it, then export every queued file to CSV with the same settings, with a running count of how many were saved.",
          "parts": [
            "batch-queue"
          ]
        }
      ],
      "distinctive": [
        "A watched folder picks up new recordings while the instrument is still acquiring, and can open each new file automatically",
        "Resistance normalisation uses a current channel and a voltage channel from the same sweep to rescale the shown channel",
        "Every export goes to a run manifest with its input files and parameters, so figures can be reproduced",
        "One toolkit offers the same folder-list-plot-export pattern for many instrument types (patch-clamp, electrochemistry, EMG, fluorescence stacks, histology), each chosen from a dashboard of tool cards"
      ]
    }
  },
