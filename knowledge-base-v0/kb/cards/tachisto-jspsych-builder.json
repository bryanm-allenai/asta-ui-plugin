  "app": {
    "title": "Tachisto builder",
    "summary": "A researcher starts from an empty timeline, an example study or a spec someone sent, and lays out an experiment as a nested list of steps: trials, blocks over a conditions table, loops that repeat until accuracy is high enough, splits into groups, counterbalanced task orders, branches and early endings. They build a conditions table by crossing factors or pasting CSV, and fill in each step's parameters in a form generated from the plugin's own schema, dragging canvas objects into place where a step draws shapes. A live preview runs the whole study or just the selected step while a timing strip follows along, and the builder lists the problems the compiler finds. The researcher then sets where the data goes and how participants arrive from and return to a recruitment platform, and downloads the study as one HTML file, a project zip with flow and trial figures, or the spec file.",
    "task": {
      "text": "Assemble a browser-based behavioural experiment without writing code and export it as runnable jsPsych source, ready to host and recruit for.",
      "verbs": [
        "plan",
        "write",
        "review"
      ]
    },
    "data": {
      "text": "A declarative study spec: a nested timeline of steps with per-step parameters, named conditions tables, embedded media files and study-level settings for data saving and recruitment.",
      "item": "a step in an experiment's timeline (a trial, block, loop, split or branch)",
      "shapes": [
        "hierarchy",
        "table",
        "categories",
        "media",
        "image"
      ]
    },
    "stage": {
      "text": "designing and building an online experiment before any data is collected",
      "terms": [
        "plan"
      ]
    },
    "mechanism": {
      "text": "A tree of timeline steps on the left drives a generated parameter form and a timing strip in the middle. Every edit recompiles the spec into a sandboxed live preview on the right, which can also show the study as a flow diagram, paper figures, generated code or the project file, and it reports compile problems back onto the steps in the tree.",
      "views": [
        "tree view",
        "form",
        "table view",
        "canvas",
        "sequence track",
        "network diagram",
        "side-by-side panes"
      ],
      "interactions": [
        "select",
        "inline edit",
        "drag to arrange",
        "keyboard shortcuts",
        "toggle view",
        "import",
        "export"
      ],
      "patterns": [
        "master-detail",
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "building online behavioural experiments with jsPsych in experimental psychology",
      "disciplines": [
        "psychology"
      ],
      "terms": [
        "experimental psychology",
        "jspsych",
        "online experiments"
      ]
    },
    "workflow": {
      "name": "compose a procedure from nested steps and export it as a runnable artefact",
      "steps": [
        {
          "step": "bring the data in",
          "here": "start with a blank timeline, open a bundled example (flanker, shapes, Stroop), open a project .json, or paste a spec or https address someone sent, which asks before opening",
          "parts": [
            "timeline-tree"
          ]
        },
        {
          "step": "lay out the procedure as a nested sequence of steps",
          "here": "'Add step' slots between rows insert trials, blocks, loops, splits, counterbalance, branches, checkpoints or ends; rows move up and down, and blocks and groups nest their own steps",
          "parts": [
            "timeline-tree"
          ]
        },
        {
          "step": "define the conditions each repeated step runs over",
          "here": "build a conditions table by naming factors and levels that are fully crossed into rows, or paste CSV/TSV, then edit cells, rename columns and add or remove rows",
          "parts": [
            "conditions-table"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "selecting a step opens a form generated from the jsPsych plugin's parameter schema, with rich text, code fields, column references, rules for branches and loops, and a canvas where shapes are dragged and snapped to centre lines",
          "parts": [
            "step-form",
            "canvas-stage",
            "sequence-strip"
          ]
        },
        {
          "step": "run the result and check it for problems",
          "here": "the sandboxed preview recompiles after each edit and runs the whole study or just the selected step; the compiler's errors and warnings are shown above it and flagged on the steps in the tree",
          "parts": [
            "preview",
            "timeline-tree"
          ]
        },
        {
          "step": "set how the result is delivered and recorded",
          "here": "the Study tab records authors, where data is saved (download or DataPipe, streaming optional), the recruitment platform's id parameter, return URLs and early endings with what each keeps",
          "parts": [
            "study-panels"
          ]
        },
        {
          "step": "export the result",
          "here": "download one HTML file, a zipped project with figures and a DataPipe setup checklist, or the spec JSON alone, optionally self-contained with jsPsych bundled in",
          "parts": [
            "preview"
          ]
        }
      ],
      "distinctive": [
        "parameter forms are generated from each jsPsych plugin's own schema and JSDoc, so the editor covers the whole plugin ecosystem without per-plugin UI code",
        "the spec compiles one way to readable jsPsych source, with a validator that catches errors hand-written experiments would make silently, such as a column read before it exists",
        "control-flow steps are specific to experimental design: blocks over a crossed-factor conditions table, loops that repeat while accuracy is below a threshold, balanced group assignment and Latin-square task orders",
        "the preview runs in a sandboxed frame that saves no data, and a timing strip follows whichever step is on screen",
        "the export produces a flow figure and trial-sequence figures for a methods section alongside the runnable study"
      ]
    }
  },
