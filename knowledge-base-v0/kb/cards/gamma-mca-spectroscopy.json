  "app": {
    "title": "Gamma MCA: gamma-ray spectrum recorder and analyser",
    "summary": "A person loads a spectrum and a background spectrum from files, or records them live from a serial detector while watching count rates. They map channel numbers to energy by clicking peaks on the plot and entering their known energies, which fits a polynomial. Then they drag over the plot to get total, net and background counts in a region, and turn on peak finding and an isotope reference list to work out which lines are present. Last, they add sample and device details and save everything as a combined JSON or XML file, as CSV files or as a printed analysis report.",
    "task": {
      "text": "Record or load a pulse-height spectrum, calibrate its channels to energy, and work out which isotopes produce its peaks after subtracting background.",
      "verbs": [
        "identify",
        "derive",
        "record",
        "explore",
        "summarize"
      ]
    },
    "data": {
      "text": "Histograms of detector counts per channel (a sample spectrum and a background spectrum), or the stream of single pulse events they are built from, plus calibration points, a reference list of isotope line energies and free-text sample details.",
      "item": "a pulse-height spectrum: counts in each channel over one measurement time",
      "shapes": [
        "histogram",
        "events",
        "time series",
        "table",
        "notes"
      ]
    },
    "stage": {
      "text": "acquiring detector spectra and analysing them to identify the isotopes present",
      "terms": [
        "analyze",
        "collect",
        "explore"
      ]
    },
    "mechanism": {
      "text": "One large spectrum plot sits under tabs for file import, serial recording, calibration and sample info. A click on the plot fills a calibration bin, a drag over it fills a side panel with region counts, and peak markers and isotope lines picked in a sortable reference table are drawn on the same plot.",
      "views": [
        "line chart",
        "bar chart",
        "summary stats",
        "table view",
        "form"
      ],
      "interactions": [
        "import",
        "hover for detail",
        "select",
        "brush",
        "zoom and pan",
        "toggle view",
        "sort",
        "multi-select",
        "inline edit",
        "write notes",
        "export"
      ],
      "patterns": [
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "gamma-ray spectroscopy with a multichannel analyzer in nuclear physics",
      "disciplines": [
        "physics"
      ],
      "terms": [
        "gamma spectroscopy",
        "multichannel analyzer",
        "nuclear physics"
      ]
    },
    "workflow": {
      "name": "calibrate a measured spectrum, identify its peaks against a reference list, and save it with its metadata",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Open a spectrum file and a background file (CSV, TKA, TXT, XML, NPES JSON), read either as a histogram or as a chronological event stream. Or press Record on a serial or USB device, choose Spectrum or Background, and watch the plot, counts per second and the time limit progress bar update live.",
          "parts": [
            "data-files",
            "serial-recording"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "For each calibration row, click the pointer button and then a peak on the plot to fill its bin, type the known energy in keV, and press Calibrate. This fits an nth-degree polynomial, shows its coefficients and switches the x-axis to energy.",
          "parts": [
            "energy-calibration",
            "spectrum-plot"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Look over the spectrum and the background-subtracted spectrum. Switch between linear and log axes, bar and line plots, and total counts and counts per second, and smooth with a moving average of a chosen length.",
          "parts": [
            "spectrum-plot"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Drag a box over a region of the plot. The side panel shows that region's range, total counts, background counts, net counts and background ratio.",
          "parts": [
            "roi-panel",
            "spectrum-plot"
          ]
        },
        {
          "step": "identify which items have a property",
          "here": "Cycle the Peaks button through Gaussian-correlation, energy and isotope peak finding. Tick isotopes in the sortable reference table to draw their line energies, and turn on hover to show the nearest isotope line.",
          "parts": [
            "spectrum-plot",
            "isotope-table"
          ]
        },
        {
          "step": "write up the result",
          "here": "Fill in the sample's name, location, time, weight and volume, the device name and free notes. These go into exports and the printed report.",
          "parts": [
            "sample-info"
          ]
        },
        {
          "step": "export the result",
          "here": "Save As a combined NPES JSON or XML file, or as separate CSVs for the spectrum and background. Export the calibration as JSON and the count-rate history as CSV, or print an analysis report with the plot image and a peak table.",
          "parts": [
            "export-dialog",
            "sample-info",
            "energy-calibration"
          ]
        }
      ],
      "distinctive": [
        "A separate background spectrum is kept beside the sample spectrum, and region counts are reported gross, background and net.",
        "Channels become energies through a polynomial of any degree, fitted from points chosen by clicking peaks on the plot.",
        "Peaks are matched against a reference list of isotope gamma-line energies, and the list can be swapped for a custom one from a URL.",
        "Data can come live from a serial detector as single pulse events or as whole histograms, with autosave, a time limit and a live count-rate history."
      ]
    }
  },
