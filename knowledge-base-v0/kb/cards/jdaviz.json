  "app": {
    "title": "Jdaviz Imviz: image viewer with region-based aperture photometry",
    "summary": "A person gives a file path in the launcher, or picks the image tool, and the image opens in a viewer where they zoom, pan and hover to read pixel values and sky coordinates. When several images are loaded, they line them up by pixels or by sky coordinates and choose an orientation. They draw regions on the image, then pick one region as the aperture and another region (or a typed value) as the background, and calculate photometry with a radial profile or curve of growth. Each result goes into a results history table. A catalog search can mark known sources on the image, and the export panel saves the viewer, the regions and the tables to files.",
    "task": {
      "text": "Measure the brightness of sources in images through regions drawn on them, and keep a table of the measurements.",
      "verbs": [
        "derive",
        "explore",
        "locate",
        "identify",
        "compare"
      ]
    },
    "data": {
      "text": "Calibrated 2D images with sky-coordinate (WCS) metadata, plus regions drawn on them and optional source catalogs.",
      "item": "a 2D telescope image, with regions of interest drawn on it",
      "shapes": [
        "image",
        "image collection",
        "spans",
        "table"
      ]
    },
    "stage": {
      "text": "measuring sources on processed telescope images, before analysing the catalog",
      "terms": [
        "analyze",
        "explore"
      ]
    },
    "mechanism": {
      "text": "A central image viewer with a hover readout and drawing tools makes region subsets that every tray plugin can pick from; the photometry plugin turns a chosen aperture and background region into a result, a profile plot and a new row in a history table, while catalog search draws markers back onto the same viewer.",
      "views": [
        "image viewer",
        "detail panel",
        "table view",
        "line chart",
        "scatter plot",
        "form",
        "summary stats"
      ],
      "interactions": [
        "import",
        "zoom and pan",
        "hover for detail",
        "brush",
        "select",
        "multi-select",
        "search",
        "toggle view",
        "export",
        "inline edit"
      ],
      "patterns": [
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "aperture photometry on calibrated images in astronomy",
      "disciplines": [
        "astronomy"
      ],
      "terms": [
        "astronomy",
        "aperture photometry",
        "astronomical imaging"
      ]
    },
    "workflow": {
      "name": "measure regions drawn on an image and keep a table of results",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Type a file path in the launcher or browse for one, then open it with the IMVIZ tile; FITS, ASDF and other image formats are parsed into the viewer.",
          "parts": [
            "launcher"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Zoom and pan the image; hovering shows the pixel position, the value and the RA/Dec under the pointer, and can step through the stacked layers.",
          "parts": [
            "image-viewer",
            "coords-info"
          ]
        },
        {
          "step": "line up several images on a common frame",
          "here": "The orientation panel links the images by pixels or by WCS, sets the reference image, and offers north-up east-left or east-right presets or a custom rotation.",
          "parts": [
            "orientation"
          ]
        },
        {
          "step": "mark regions of interest on the image",
          "here": "Draw circle, ellipse, rectangle or annulus regions with the toolbar; the subset panel edits their centres and sizes, recentres them on the source, renames or deletes them.",
          "parts": [
            "image-viewer",
            "subset-tools"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Pick data, an aperture region and a background region or manual value, set the counts factor, pixel area and flux scaling, and press Calculate; it shows sums, magnitude and centroid, a curve of growth or radial profile with an optional Gaussian fit, and adds a row to the results history. Batch mode runs many images and apertures at once.",
          "parts": [
            "aperture-photometry"
          ]
        },
        {
          "step": "identify known items on the image",
          "here": "Search a catalog (or import one from a file) over the viewer's field, mark the sources on the image, select rows in its table and zoom to them.",
          "parts": [
            "catalogs"
          ]
        },
        {
          "step": "export the result",
          "here": "The export panel saves the viewer as an image, regions as region files and plugin tables (such as the photometry history) as files.",
          "parts": [
            "export"
          ]
        }
      ],
      "distinctive": [
        "Regions are drawn once in the viewer and shared as named subsets, so the same aperture and background can be reused across plugins and images.",
        "Background can come from a second region (median) or a typed value, and cannot be the same region as the aperture.",
        "Magnitudes use a flux scaling the person sets (-2.5 log(flux / flux_scaling)), with defaults read from the image metadata, and units are converted for surface brightness through the pixel area.",
        "Images can be aligned by sky coordinates (WCS) rather than pixels, with a chosen north-up orientation.",
        "Every panel can show the Python API call for each control, so the same steps can be scripted in a notebook."
      ]
    }
  },
