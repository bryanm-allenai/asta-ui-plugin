  },
  "app": {
    "title": "qPCR Melt Curve Viewer",
    "summary": "A person uploads melt curve text files or a ZIP of experiment folders. The tool finds the curve files by name, pairs them into wells and shows a pairing table. The person searches and ticks the wells they want. The tool computes melt peaks (−dF/dT) for every replicate, takes the tallest-peak Tm and a peak count per well for a summary table, and plots all selected wells overlaid as well as each well's curve and peak side by side. The person can turn on outlier removal, leaving replicates out by hand or letting the tool preselect those whose Tm is too far from the well median; the table and plots then recompute. Finally they export the plots as PNG, PDF, an HTML report or one long PNG.",
    "task": {
      "text": "Derive each well's melt temperature from its replicate melt curves, check the replicates against each other, leave out outliers and export the plots.",
      "verbs": [
        "derive",
        "compare",
        "clean",
        "summarize"
      ]
    },
    "data": {
      "text": "Instrument export files of fluorescence against temperature, one file per well holding several replicate curves as repeating X/signal column pairs, in nested experiment folders.",
      "item": "a well with its replicate melt curves",
      "shapes": [
        "time series",
        "table",
        "hierarchy"
      ]
    },
    "stage": {
      "text": "analysing melt curves after a qPCR run, before reporting",
      "terms": [
        "analyze",
        "clean"
      ]
    },
    "mechanism": {
      "text": "A sidebar holds the steps in order: upload, a search filter and a checklist of wells, plot options, outlier removal and export. Every change redraws the main column: the pairing table, a summary table with each well's Tm, an overlay of all selected wells (mean ± SD), and, for each well, the melt curve and the derived melt peak shown side by side.",
      "views": [
        "sidebar list",
        "table view",
        "line chart",
        "small multiples",
        "summary stats",
        "tree view"
      ],
      "interactions": [
        "import",
        "search",
        "filter",
        "multi-select",
        "toggle view",
        "exclude and refit",
        "hover for detail",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "small multiples",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "melt curve analysis of qPCR products in molecular biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "qpcr",
        "melt curve analysis",
        "molecular biology"
      ]
    },
    "workflow": {
      "name": "derive a characteristic value per sample from replicate curves, leaving out outlier replicates",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Drop or pick TXT/TSV files or ZIPs (folders are read recursively). Melt-curve files are recognised by name, paired into wells and listed in a pairing table, with a warning for files it does not recognise.",
          "parts": [
            "upload-zone",
            "results"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "An experiment tree groups wells by folder. A search box filters the well checklist, and 'Select all (filtered)' ticks every match.",
          "parts": [
            "well-selector"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Each replicate curve is resampled with PCHIP, smoothed with Savitzky–Golay and differentiated to −dF/dT. The summary table gives each well's median tallest-peak Tm (°C), its peak count and which replicates are included.",
          "parts": [
            "melt-plots",
            "summary-table"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "An overlay of mean ± SD for all selected wells sits above per-well panels with the curve on the left and the peak on the right. Normalisation can be per well or across all selected wells, and the Y axis can be shared.",
          "parts": [
            "melt-plots"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "With outlier removal on, the person unticks replicates by hand, or switches to Tm deviation so that replicates beyond a °C threshold from the well median are preselected. The peaks, Tm and plots then recompute.",
          "parts": [
            "outlier-panel",
            "summary-table"
          ]
        },
        {
          "step": "export the result",
          "here": "Checkboxes choose PNG per plot, a PDF, or an interactive HTML report for the selected wells. A second button saves all plots as one long PNG.",
          "parts": [
            "export-panel"
          ]
        }
      ],
      "distinctive": [
        "The derived signal (the negative derivative of each curve) is computed from the raw curves instead of read from the instrument's own peak files, which are ignored.",
        "Outliers are judged on one quantity from each replicate: the temperature of its tallest peak, compared with the well median against a threshold in degrees.",
        "Files are paired into samples by fuzzy filename matching, and the pairing table shows the matching key and status.",
        "Raw and derived curves are normalised separately, each by its own range, either per sample or across all selected samples."
      ]
    }
  },
