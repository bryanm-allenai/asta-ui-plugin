        "category palette"
      ]
    },
    "field": {
      "text": "growth curve fitting of plate reader OD data in microbiology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "microbiology",
        "growth curves",
        "plate reader"
      ]
    },
    "workflow": {
      "name": "fit a model to every series in a batch, correct the bad fits, and export the parameters",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload a plate reader Excel file (Time plus well columns) and an optional wide- or long-format plate map, then click 'Match samples with names'.",
          "parts": [
            "upload-analyse"
          ]
        },
        {
          "step": "set up corrections before computing",
          "here": "Pick the time unit and pathlength, drag the analysis window, multiselect wells to exclude, turn on MAD-based outlier removal, and paint blank groups onto the plate grid so each blank is subtracted only from samples in its colour group.",
          "parts": [
            "upload-analyse",
            "blank-group-grid"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Choose a model family and method (sliding window, spline, logistic, Gompertz, Richards, Baranyi), phase-boundary cutoffs as a fraction of μmax and no-growth thresholds, then 'Update parameters and analyse selected plate'.",
          "parts": [
            "upload-analyse"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Replicate curves grouped by sample, blank baselines by group, and a plate-layout grid of per-well fits outlined green, red or grey by fit quality.",
          "parts": [
            "plate-overviews"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "A plate and well selector with Left/Right arrow shortcuts opens each well's annotated OD curve, its dOD/dt and μ plots, and popovers with its statistics and parameters.",
          "parts": [
            "well-fit-editor"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "Lasso points on the curve to refit μmax from them, slide the phase boundaries and max OD, re-analyse with edited thresholds, mark the well no-growth, or delete it.",
          "parts": [
            "well-fit-editor"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Select samples, group the x axis and legend by strain, condition or name, reorder the groups, and make one plot per growth statistic plus mean and replicate curve plots over a chosen time range.",
          "parts": [
            "visualizations"
          ]
        },
        {
          "step": "export the result",
          "here": "Tick tables (baseline-corrected series, per-well and per-sample statistics, analysis parameters) and plots (global and per-well with chosen annotations, filtered by plate and well), then download one ZIP.",
          "parts": [
            "export-zip"
          ]
        }
      ],
      "distinctive": [
        "Blanks are subtracted per group: the person paints blank and sample wells on a plate grid in colour groups, and blanks in the same group are averaged before subtraction.",
        "Growth phases are split by thresholds relative to the maximum specific growth rate, and the lag-end and exponential-end boundaries can be moved by hand for each well.",
        "Wells can be marked no-growth automatically, from minimum OD increase, growth rate, signal-to-noise and point-count thresholds, or by hand. A no-growth well keeps a reason and is left out of the statistics.",
        "Wells that share a name in the plate map are treated as replicates and averaged into per-sample statistics, and the first underscore splits the name into strain and condition for plotting.",
        "Each well gets three linked readouts: OD (linear or log), the first derivative and the specific growth rate μ over time."
      ]
    }
  },
