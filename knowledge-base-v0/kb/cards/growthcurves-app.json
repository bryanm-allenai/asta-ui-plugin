  "app": {
    "title": "MicroGrowth: microbial growth curves from plate reader runs",
    "summary": "A person uploads a plate reader time series and a plate map that names each well, matches wells to sample names, and sets up preprocessing: time unit, optical pathlength, an analysis time window, wells to exclude, outlier removal and which blank wells are subtracted from which samples. They choose a growth model or a non-parametric method, phase-boundary cutoffs and no-growth thresholds, and analyse the plate to get growth statistics for every well. They check the fits across the whole plate, then step through wells one at a time to fix the bad ones: move phase boundaries, cap the maximum OD, lasso a subset of points to refit, mark a well as no growth, or delete it. Finally they plot growth statistics and mean or replicate curves by sample and condition, and export a ZIP of corrected data, per-well and per-sample statistics, the parameters used and plots.",
    "task": {
      "text": "Fit growth curves to every well of a microplate run, correct the fits that went wrong, and export growth statistics per well and per sample.",
      "verbs": [
        "derive",
        "clean",
        "review",
        "compare",
        "summarize"
      ]
    },
    "data": {
      "text": "Optical density time series from a plate reader with one column per well, plus a plate map that gives each well a sample name, with replicates sharing a name and blank wells marked.",
      "item": "a well on a 96-well plate, with its OD time series and fitted growth statistics",
      "shapes": [
        "grid of series",
        "time series",
        "per element",
        "table"
      ]
    },
    "stage": {
      "text": "fitting and correcting growth curves after a plate reader run, before comparing samples and reporting",
      "terms": [
        "analyze",
        "clean"
      ]
    },
    "mechanism": {
      "text": "A stepped upload page loads the plate, builds the blank-subtraction groups on a clickable plate grid and runs the fit. A plate-layout overview outlines each well's fit by quality and leads into a one-well-at-a-time editor, where sliders, lasso selection and buttons refit the well and update the shared statistics that the plotting and export pages read.",
      "views": [
        "fixed-layout grid",
        "small multiples",
        "line chart",
        "scatter plot",
        "bar chart",
        "detail panel",
        "form",
        "table view"
      ],
      "interactions": [
        "import",
        "select",
        "brush",
        "exclude and refit",
        "keyboard shortcuts",
        "toggle view",
        "filter",
        "drag to arrange",
        "hover for detail",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "small multiples",
