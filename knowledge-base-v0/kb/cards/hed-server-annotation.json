  "app": {
    "title": "HED online tools: validate, assemble and search event annotations against a vocabulary schema",
    "summary": "A person picks an action (validate, check annotation quality, assemble, search, generate a sidecar template, or run a remodel script), and the form shows only the options and inputs that action needs. They upload a tab-separated events table, along with an optional JSON sidecar, definitions file or remodel script, and choose a released vocabulary version or upload their own schema file. For a sidecar template they tick which columns to include and which are categorical, using each column's count of unique values. For a search they type a query. Process sends the job to the server and downloads the result: an error or quality report, the assembled annotations, a match vector, a sidecar template, or a remodelled table.",
    "task": {
      "text": "Check that the event annotations in a tabular data file follow a hierarchical controlled vocabulary, and turn those annotations into assembled strings, search matches or annotation templates.",
      "verbs": [
        "clean",
        "review",
        "annotate",
        "derive",
        "identify"
      ]
    },
    "data": {
      "text": "Tab-separated event tables with named columns, JSON sidecars that map column values to vocabulary tags, and a versioned hierarchical tag vocabulary (schema) to check them against",
      "item": "a row of an events table: one event marker at a time onset, whose column values map to annotation tags",
      "shapes": [
        "table",
        "events",
        "categories",
        "hierarchy"
      ]
    },
    "stage": {
      "text": "checking and assembling event annotations after tagging a dataset, before analysis or sharing",
      "terms": [
        "clean",
        "annotate",
        "confirm"
      ]
    },
    "mechanism": {
      "text": "A single form is driven by an action dropdown that shows or hides option switches, file inputs, a query box and a column table, so each operation asks only for what it needs. Process sends the whole form to the server, and the result comes back as a downloaded file with a status message beneath the buttons.",
      "views": [
        "form",
        "table view"
      ],
      "interactions": [
        "import",
        "toggle view",
        "select",
        "multi-select",
        "search",
        "export"
      ],
      "patterns": []
    },
    "field": {
      "text": "event annotation with a hierarchical controlled vocabulary for neuroimaging and behavioural experiment data",
      "disciplines": [
        "psychology"
      ],
      "terms": [
        "neuroimaging",
        "event annotation",
        "bids"
      ]
    },
    "workflow": {
      "name": "check annotations against a controlled vocabulary and download the report",
      "steps": [
        {
          "step": "choose the operation to run",
          "here": "the Action dropdown (Validate, Check HED quality, Assemble, Search, Generate sidecar template, Execute remodel script) shows and hides the option switches and the inputs each action needs",
          "parts": [
            "action-options"
          ]
        },
        {
          "step": "bring the data in",
          "here": "upload a tabular .tsv events file, plus an optional JSON sidecar, a definitions file, or a remodel .json script",
          "parts": [
            "events-form"
          ]
        },
        {
          "step": "pick the scheme to check against",
          "here": "a Schema dropdown filled with released vocabulary versions, with an Include prereleases switch and an upload for your own schema file when Other is chosen",
          "parts": [
            "schema-picker"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "for a sidecar template, a table lists each column with its count of unique values and checkboxes for Include? and Categorical?; for a search, a HED query box",
          "parts": [
            "column-table",
            "query-box"
          ]
        },
        {
          "step": "export the result",
          "here": "Process posts the form and downloads a .txt error or quality report, an assembled-annotation .tsv, a search match vector, a sidecar template or a remodelled table, with a status message below the buttons; Clear resets every input",
          "parts": [
            "process-buttons"
          ]
        }
      ],
      "distinctive": [
        "annotations are checked against a versioned hierarchical tag vocabulary that the person picks from a list or uploads",
        "a Limit errors switch reports at most two errors of each type, for a first pass before a full check with warnings on",
        "a sidecar annotation template is generated from the table by marking columns as included and categorical, guided by each column's count of unique values",
        "assembly can expand or replace definitions and keep or drop ongoing event context before writing one annotation string per event"
      ]
    }
  },
