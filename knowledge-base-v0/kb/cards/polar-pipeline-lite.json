  "app": {
    "title": "Polar Pipeline (lite): File Search + Protein Figure Generator",
    "summary": "A person browses a folder of tab- or comma-separated variant files and opens one. They build a stack of filter conditions, each a column, an operator, a value and whether to keep missing values. They then run the search, which keeps only the rows that meet every condition. They preview the first matching rows and download the filtered table. In a second tool they enter a protein's length, its structural regions and the positions of features for each allele, and generate an SVG figure of the protein's domains to download, saving the setup as a named preset to reload later.",
    "task": {
      "text": "Filter a variant table down to the rows that meet a set of column conditions, and draw a per-allele diagram of a protein's domains with marked feature positions.",
      "verbs": [
        "identify",
        "derive",
        "write"
      ]
    },
    "data": {
      "text": "Variant call tables (VCF, TSV or CSV) with a header line of columns such as position, quality, depth, allele frequency, gene, zygosity and consequence; for the figure, a protein length with named regions (start, stop, colour) and point features per allele.",
      "item": "a variant row in a call table; for the figure, a structural region or feature position on a protein",
      "shapes": [
        "table",
        "sequence",
        "spans"
      ]
    },
    "stage": {
      "text": "filtering variant calls down to candidates and drawing figures of the affected protein, after variant calling",
      "terms": [
        "analyze",
        "report"
      ]
    },
    "mechanism": {
      "text": "A folder browser leads to a page where the person stacks filter blocks, each with a column picked from the file's header, an operator, a value and a missing-value switch. A server pass works out each column's type, writes the rows that pass every block to a TSV, and shows them in a preview table with a download link. A separate form collects protein regions and features for one allele (homozygous) or two (heterozygous, optionally the same structure). The server draws them as coloured bars on a scaled line in an SVG, and the setup can be saved and reloaded as presets.",
      "views": [
        "list",
        "form",
        "table view",
        "sequence track",
        "side-by-side panes"
      ],
      "interactions": [
        "select",
        "filter",
        "toggle view",
        "inline edit",
        "export"
      ],
      "patterns": [
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "variant filtering and protein domain figures in genomics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "genomics",
        "variant filtering",
        "protein domains"
      ]
    },
    "workflow": {
      "name": "filter a table by stacked column conditions and export the matching rows",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Files are copied into an input folder, and the person browses its directories in a list, folders first, then clicks a file to open it for search.",
          "parts": [
            "file-browser"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Add Parameter stacks blocks of column (autocompleted from the file's header line), operator (==, >=, <=, >, <, !=, Contains), value and an Include N/As checkbox. The blocks are remembered in local storage for the next file.",
          "parts": [
            "filter-builder"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Search infers each filtered column as integer, float or text from its values, treating '-' and '.' as missing, and writes the rows that pass every block to a timestamped TSV.",
          "parts": [
            "filter-builder"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "A preview page shows the header and up to the first 50 matching rows in a striped table with a sticky header.",
          "parts": [
            "result-preview"
          ]
        },
        {
          "step": "export the result",
          "here": "A Download button sends the filtered TSV as a file.",
          "parts": [
            "result-preview"
          ]
        },
        {
          "step": "write up the result",
          "here": "In the figure generator the person picks zygosity and whether both alleles share a structure. They then enter protein length, coloured structure ranges and named feature positions per allele, and Generate draws an SVG to download.",
          "parts": [
            "figure-form",
            "figure-result"
          ]
        },
        {
          "step": "keep a record of changes",
          "here": "Save Preset stores the whole figure setup under a name in an INI file; Load Preset refills the form from a chosen preset.",
          "parts": [
            "figure-presets"
          ]
        }
      ],
      "distinctive": [
        "Each filter condition has its own switch for whether missing values ('-' or '.') pass, as variant tables often lack quality or frequency.",
        "Column types are inferred from the data at search time, so the same operators compare numbers numerically and text as strings.",
        "The header is found by skipping '#' metadata lines in VCF-style files, and the column picker is filled from that header.",
        "The protein figure is drawn per allele (0|1 and 1|0 for heterozygous, 1|1 for homozygous), with the two alleles' bars scaled to the longer protein.",
        "Overlapping feature labels are raised by adding '^' characters to the feature name, one level per caret."
      ]
    }
  },
