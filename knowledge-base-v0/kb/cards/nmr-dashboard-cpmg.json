  "app": {
    "title": "NMR Dashboard: relaxometry processing in the browser (CPMG, T1 recovery, T2–D)",
    "summary": "A person drops a folder of spectrometer data, or opens a bundled sample. The page reads the acquisition parameters and uses the sequence name to decide which analysis to offer. They check the raw echoes and the summed decay, then choose how to process the echoes and which models to fit: a multi-exponential fit, a regularised inverse Laplace spectrum, or a 2D T2–D inversion with a few-population model. Optionally they can leave out the first points. After the run they read the fits, the fit-quality and model-comparison tables, the spectra and any depth-resolved maps. If they turned it on, they also get MCMC and bootstrap intervals compared side by side. They end with a saved folder or zip of tables, figures, a PDF report and a provenance record. They can also export a params file and script, or run the same settings over every dataset as a time series.",
    "task": {
      "text": "Fit relaxation and diffusion models to measured decay curves, with intervals, and save a reproducible record of the result for one dataset or a series.",
      "verbs": [
        "derive",
        "explore",
        "compare",
        "summarize"
      ]
    },
    "data": {
      "text": "Instrument output from a single-sided NMR spectrometer: trains of echoes measured over time, sometimes over a second delay axis, plus the acquisition parameters. A folder can hold many datasets taken over time.",
      "item": "one acquisition: an echo train (or a set of trains at several delays) with its parameter file",
      "shapes": [
        "time series",
        "field",
        "table",
        "versions"
      ]
    },
    "stage": {
      "text": "analysing raw relaxometry decays into fitted times and spectra, from first look to saved results",
      "terms": [
        "analyze",
        "explore",
        "confirm"
      ]
    },
    "mechanism": {
      "text": "Numbered tabs unlock in order: load, raw data, process, results, batch. One settings form feeds a single Run button, and the results tab collects collapsible sections of linked charts and tables. Uncertainty runs, saving and batch all reuse the same settings.",
      "views": [
        "form",
        "line chart",
        "heatmap",
        "table view",
        "scatter plot",
        "summary stats"
      ],
      "interactions": [
        "import",
        "toggle view",
        "exclude and refit",
        "hover for detail",
        "select",
        "export",
        "zoom and pan"
      ],
      "patterns": [
        "status pipeline",
        "linked views",
        "overview and detail",
        "side-by-side comparison",
        "dashboard"
      ]
    },
    "field": {
      "text": "multi-exponential and inverse-Laplace analysis of NMR relaxation and diffusion decays",
      "disciplines": [
        "chemistry"
      ],
      "terms": [
        "nmr relaxometry",
        "inverse laplace transform",
        "t2 d correlation"
      ]
    },
    "workflow": {
      "name": "fit models to measured curves and save the results with uncertainties",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Drop or browse for a data folder or .tnt files, or pick a sample. If the folder holds several datasets, a chooser appears. A parameters table shows what was read, and the sequence name decides which analysis is offered.",
          "parts": [
            "load-panel"
          ]
        },
        {
          "step": "look over the raw data",
          "here": "An echo-magnitude heat map, a single echo (real, imaginary and magnitude) picked with a slider, and the summed decay on linear or log axes. Previous and Next buttons step through the loaded datasets.",
          "parts": [
            "raw-panel"
          ]
        },
        {
          "step": "choose the computation and its settings",
          "here": "Integrate each echo, or Fourier-transform it to get signal against depth. Choose 1–4 exponential components with an optional offset, the ILT range and α, how many early echoes to exclude, and the confidence level. Settings can also be filled in from a params file.",
          "parts": [
            "process-form"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Run processing gives the decay with its fits and residuals, a component table with intervals, fit quality, a ΔAIC/ΔBIC model comparison and the T2 spectrum with a peak table. In FT mode it also gives T2(z) maps with a linked cross-section viewer.",
          "parts": [
            "fit-results",
            "spatial-viewer"
          ]
        },
        {
          "step": "check how far the result can be trusted",
          "here": "Optional MCMC and bootstrap runs start after a time estimate and a confirmation. They show traces, a corner plot and histograms, plus a table comparing the three interval methods that flags the odd one out.",
          "parts": [
            "uncertainty-section"
          ]
        },
        {
          "step": "export the result",
          "here": "Save into a new processed_ folder, another folder or a .zip: CSV tables, figures in a chosen format and dpi, a PDF report, params_used.toml and provenance.json. A separate button exports the params plus a script to rerun the analysis offline.",
          "parts": [
            "save-card",
            "process-form"
          ]
        },
        {
          "step": "apply the same settings to every item",
          "here": "Batch runs the checked settings on every dataset in the folder and logs each one as ok, skipped or failed. It writes a time-series summary and fit tables. It warns if the settings were not first tried on a single dataset.",
          "parts": [
            "batch-panel"
          ]
        }
      ],
      "distinctive": [
        "The acquisition's sequence name decides the analysis and which controls are shown: a decay, a saturation recovery or a 2D T2–D correlation.",
        "Fourier-transforming each echo in a static gradient turns time into depth, so every fit is repeated at each position. A linked cross-section viewer then follows the spectrum peaks along depth.",
        "Diffusion coefficients that the measured b-values cannot resolve are shaded and flagged. One button limits the inversion grid to that range.",
        "Least-squares, MCMC and bootstrap intervals are set side by side, and any value outside all the other methods' intervals is marked.",
        "Every save records input file hashes, the resolved settings and the software versions. The settings can be exported as a params file plus a script that reruns the same analysis."
      ]
    }
  },
