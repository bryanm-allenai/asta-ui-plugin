  "app": {
    "title": "kana: single-cell analysis in the browser",
    "summary": "A person loads a count matrix (or a saved analysis, or a demo dataset), picks the modalities and an optional batch or subset column, and runs a standard pipeline whose steps they can tune in a parameter panel. The results screen shows a t-SNE or UMAP embedding coloured by cluster, gene expression or any annotation, next to a ranked marker table for the chosen cluster that can be searched, filtered by statistic sliders and set against another cluster. They can lasso cells into a custom selection to get its markers, switch to gene set enrichment or reference-based cell type labels for the cluster, and keep snapshots of plots in a gallery of diagnostic plots. The analysis is saved to the browser or downloaded as a state file or a ZIP of results, and marker or gene set tables are downloaded as CSV.",
    "task": {
      "text": "Run a standard single-cell analysis on a count matrix and explore its clusters to find the marker genes and likely cell types of each.",
      "verbs": [
        "derive",
        "explore",
        "identify",
        "compare",
        "summarize"
      ]
    },
    "data": {
      "text": "A cells-by-features count matrix, optionally with RNA, protein-tag (ADT) and CRISPR modalities and per-cell annotation columns, from which embeddings, clusters, marker statistics, gene set scores and cell type labels are computed.",
      "item": "a cell, grouped into a cluster or a hand-made selection",
      "shapes": [
        "table",
        "categories",
        "network"
      ]
    },
    "stage": {
      "text": "exploring a new single-cell dataset after quantification, from quality control through clustering to marker and cell type calls",
      "terms": [
        "explore",
        "analyze",
        "clean"
      ]
    },
    "mechanism": {
      "text": "An embedding scatter plot sits beside a marker table and a gallery of diagnostic plots; choosing a cluster in the table, a gene's colour icon, or a lasso selection on the plot updates the others, and the same cluster choice syncs across the marker, gene set and cell type panels. A sidebar switches between the input form, parameter form, results and logs.",
      "views": [
        "scatter plot",
        "table view",
        "bar chart",
        "summary stats",
        "form",
        "thumbnail grid",
        "heatmap",
        "sidebar list"
      ],
      "interactions": [
        "import",
        "select",
        "brush",
        "search",
        "filter",
        "sort",
        "hover for detail",
        "toggle view",
        "drag to arrange",
        "export",
        "zoom and pan"
      ],
      "patterns": [
        "linked views",
        "overview and detail",
        "dashboard",
        "small multiples"
      ]
    },
    "field": {
      "text": "single-cell RNA-seq clustering and marker detection in bioinformatics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "single cell rna seq",
        "bioinformatics",
        "cell type annotation"
      ]
    },
    "workflow": {
      "name": "run a computational pipeline on a dataset, then explore the groups it finds and what distinguishes them",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Add one or more datasets as Matrix Market, 10x HDF5, H5AD, RDS SummarizedExperiment, zipped ArtifactDB or an ExperimentHub id; choose modalities, a batch column for MNN correction or a subset filter; or load a saved .kana analysis.",
          "parts": [
            "new-analysis"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Run the pipeline (QC filtering, normalisation, variable genes, PCA, graph clustering, t-SNE/UMAP, markers, gene set enrichment, reference cell type labels), adjusting each step's parameters in the PARAMS panel and rerunning.",
          "parts": [
            "param-selection",
            "gallery"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The embedding plot shows every cell coloured by cluster, by any annotation or by a gene's expression; legend clicks highlight one cluster, and the embedding can be animated through its iterations.",
          "parts": [
            "dim-plot"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Pick a cluster to rank its marker genes by effect size, optionally against one other cluster (vs mode); search for a gene and narrow by statistic sliders, and click a gene to colour the plot by it.",
          "parts": [
            "marker-table",
            "dim-plot"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Lasso cells on the embedding to save a custom selection, which then gets its own marker list like any cluster.",
          "parts": [
            "dim-plot",
            "marker-table"
          ]
        },
        {
          "step": "identify what each group is",
          "here": "Switch the side panel to gene set enrichment for the cluster's top markers, or to cell type scores against selected human or mouse reference datasets.",
          "parts": [
            "feature-sets",
            "cell-annotation"
          ]
        },
        {
          "step": "export the result",
          "here": "Save the analysis to the browser, download parameters as a .kana file or results as a ZIP, download marker or gene set tables as CSV, and save plot snapshots or PNGs to the gallery.",
          "parts": [
            "marker-table",
            "feature-sets",
            "gallery",
            "results"
          ]
        }
      ],
      "distinctive": [
        "all computation runs client-side in WebAssembly workers, so data never leaves the machine",
        "multi-modal data (RNA, protein tags, CRISPR guides) are processed in parallel and combined with weights before clustering",
        "markers can be ranked for a cluster against all others or against one chosen cluster, by several effect-size summaries",
        "hand-drawn lasso selections become groups with their own markers, alongside computed clusters and any supplied annotation",
        "a saved analysis file restores the full state, so a run can be reopened and reanalysed with new parameters"
      ]
    }
  },
