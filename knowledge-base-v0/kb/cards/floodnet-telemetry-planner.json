  "app": {
    "title": "Flood-Net (ALERT flood-warning telemetry network planner)",
    "summary": "A person loads a register of radio telemetry stations from a file, a repository or a database. They narrow it with stacked searches and filters by network, role, sensor, region and owner, and watch the matching stations and their radio relay links redraw on a map and in a table. Picking a station, from a pin or a row, opens its card and lists the repeaters whose address ranges carry it. Clicking a radio path shows the terrain profile and link budget along it. A person can then mark a set of stations on the map and export it as a file.",
    "task": {
      "text": "Find, inspect and plan the stations, repeaters and radio paths of a telemetry network from its register.",
      "verbs": [
        "lookup",
        "locate",
        "explore",
        "curate",
        "plan",
        "derive"
      ]
    },
    "data": {
      "text": "A register of field stations with coordinates, roles, sensors and radio addresses, together with the relay links between stations and repeaters that come from each repeater's address ranges.",
      "item": "a telemetry station (a field gauge, repeater or base station) in the register",
      "shapes": [
        "table",
        "geospatial",
        "network"
      ]
    },
    "stage": {
      "text": "keeping a telemetry network's station register in order and planning its radio paths",
      "terms": [
        "maintain",
        "plan"
      ]
    },
    "mechanism": {
      "text": "A search and filter card drives one filtered set, which the map draws as pins with relay links and the table lists row by row. Choosing a station on either view opens its card and its carrying repeaters, and clicking a link opens a terrain profile and link budget for that path.",
      "views": [
        "map",
        "table view",
        "detail panel",
        "network diagram",
        "line chart",
        "form"
      ],
      "interactions": [
        "search",
        "filter",
        "select",
        "multi-select",
        "hover for detail",
        "zoom and pan",
        "toggle view",
        "import",
        "export",
        "inline edit"
      ],
      "patterns": [
        "linked views",
        "master-detail",
        "overview and detail"
      ]
    },
    "field": {
      "text": "radio telemetry network engineering for flood warning",
      "disciplines": [
        "engineering"
      ],
      "terms": [
        "radio telemetry",
        "link budget",
        "alert network"
      ]
    },
    "workflow": {
      "name": "find items in a register on a map and inspect how they connect",
      "steps": [
        {
          "step": "bring the data in",
          "here": "the station register is loaded as stations.json from the device, from GitHub, or from the database by default",
          "parts": [
            "load-register"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "stacked search rows with abbreviation and address-range matching, plus filters by network, role, sensor type, region and owner, all feed one filtered set",
          "parts": [
            "station-filters"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "the filtered stations are drawn as pins on a Leaflet map with relay links between them, and listed in a table with a live count",
          "parts": [
            "stations-map",
            "stations-table"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "clicking a pin or a table row selects the station, zooms to it and opens its card with its owner, sensors and actions",
          "parts": [
            "station-card",
            "stations-map",
            "stations-table"
          ]
        },
        {
          "step": "trace the links of the selected item",
          "here": "the carriers card lists the repeaters whose address ranges carry the station, and the map can focus on one repeater's stations",
          "parts": [
            "carriers-card"
          ]
        },
        {
          "step": "export the result",
          "here": "a set of stations picked on the map is saved as a CSV",
          "parts": [
            "stations-map"
          ]
        }
      ],
      "distinctive": [
        "Links between stations come from address ranges: a repeater carries a station when the station's radio address falls inside one of the repeater's ranges.",
        "A clicked radio path opens a terrain elevation profile and a fade-margin link budget for that path.",
        "Stations can be proposed, meaning planned but not yet built, and these are marked apart from stations on the ground."
      ]
    }
  },
