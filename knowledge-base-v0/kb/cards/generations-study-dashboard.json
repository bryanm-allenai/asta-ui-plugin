  "app": {
    "title": "Generations Study — Data Dashboard",
    "summary": "A person loads one or more participant data files, with optional JSON Schema files that give variable labels, types, codes and not-applicable sentinel values. Multiple files are joined on the participant ID. They browse variables in a searchable, grouped sidebar to see each distribution, check how much is missing per variable, and compare a variable's distribution across the levels of a grouping variable. They build a cohort from AND/OR filter rows, watching an attrition flow show how many participants each criterion removes. Then they generate a descriptive Table 1 for that cohort, optionally stratified, and export the cohort definition as JSON, the attrition flow and charts as PNG, and the table as CSV.",
    "task": {
      "text": "Define a study cohort by inclusion criteria on participant variables and produce its descriptive summary table, with attrition counts and missingness.",
      "verbs": [
        "filter",
        "summarize",
        "explore",
        "compare",
        "derive"
      ]
    },
    "data": {
      "text": "Participant-level questionnaire-derived variables from a cohort study, one row per participant, with a schema giving each variable's type, coded categories, units, group and not-applicable sentinel values; extra files such as tumour records can be joined on the participant ID.",
      "item": "a participant record with numeric, integer, categorical and binary variables",
      "shapes": [
        "table",
        "categories"
      ]
    },
    "stage": {
      "text": "exploring cohort data and selecting a study population, before formal analysis",
      "terms": [
        "explore",
        "analyze"
      ]
    },
    "mechanism": {
      "text": "A sidebar variable list drives a per-variable distribution view. Filter rows in the cohort builder define the active cohort, and every other tab (overview, explore, missingness, stratified, descriptive table) recomputes on that cohort, while the attrition flow shows the count left after each criterion.",
      "views": [
        "sidebar list",
        "summary stats",
        "bar chart",
        "detail panel",
        "form",
        "table view",
        "side-by-side panes"
      ],
      "interactions": [
        "import",
        "search",
        "filter",
        "select",
        "toggle view",
        "hover for detail",
        "export"
      ],
      "patterns": [
        "dashboard",
        "master-detail",
        "linked views",
        "small multiples"
      ]
    },
    "field": {
      "text": "cohort selection and descriptive statistics in epidemiology",
      "disciplines": [
        "medicine"
      ],
      "terms": [
        "epidemiology",
        "cohort study",
        "table 1"
      ]
    },
    "workflow": {
      "name": "define a subset by filter criteria and describe it in a summary table",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Drop or pick one or more JSON data files and optional JSON Schema files. Files are joined on the participant ID with a full outer join. If no schema is given, one is inferred from the data. Continue to Dashboard opens the tabs.",
          "parts": [
            "load-screen"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The Overview shows the participant count, completeness and variable groups. The Missingness tab charts null % and 999/9999 sentinel % for every variable.",
          "parts": [
            "overview-tab",
            "missingness-tab"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Search or filter the sidebar by variable group and click a variable. The Explore tab shows its metadata, summary chips, a histogram, violin, bar or pie chart, and the code reference, with a PNG download.",
          "parts": [
            "variable-sidebar",
            "explore-tab"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Pick a grouping variable and a target variable, then press Compare to see the target's distribution for each group side by side.",
          "parts": [
            "stratified-tab"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Add WHERE/AND/OR filter rows. Numeric fields take comparison operators and categorical fields take is / is not a code. The attrition flow shows the count after each criterion and how many it dropped, and the header badge shows cohort n out of the total.",
          "parts": [
            "cohort-builder"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Generate a Table 1 for the active cohort with mean (SD) for continuous variables, n (%) for the top categories, and null % and NA-sentinel % columns, optionally split by a stratifying variable.",
          "parts": [
            "descriptive-table"
          ]
        },
        {
          "step": "export the result",
          "here": "Export the cohort definition as JSON, the attrition flow as a branded PNG, and the descriptive table as CSV.",
          "parts": [
            "cohort-builder",
            "descriptive-table"
          ]
        }
      ],
      "distinctive": [
        "Sentinel codes such as 999/9999 mean 'not applicable by design' and are counted apart from genuinely missing nulls in the missingness chart and in Table 1.",
        "An attrition flow shows how many participants remain and how many drop at each inclusion criterion, as in a cohort-selection flow diagram.",
        "The cohort's filter chain becomes the active subset for every other tab, so all distributions and tables describe the selected population.",
        "A JSON Schema supplies variable types, code labels, units and groupings; with several files they are merged and checked for overlapping variable names.",
        "All processing stays in the browser so individual-level participant data never leaves the device."
      ]
    }
  },
