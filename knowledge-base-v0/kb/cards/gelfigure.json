  "app": {
    "title": "GelFigure",
    "summary": "A person drops in a raw gel image, or several exposures of one gel, and the interface straightens and crops it, finds the lanes, decides whether it is a DNA or protein gel and fits a size ladder to the marker lane. The person checks and corrects each automatic step on the raw image: contrast, rotation, crop box, lane lines, the marker's ladder and its band positions. On the figure beside it, they type lane names and add group lines, +/− condition rows, target-band arrows with estimated sizes, boxes, brackets and side text, and cut unwanted lanes, which leaves a splice mark. A pre-flight check flags integrity and legibility problems, and the result is exported as a publication figure along with supplementary files: the uncropped image, the original bytes and a processing log.",
    "task": {
      "text": "Turn a raw electrophoresis gel image into a labelled, journal-compliant figure with calibrated band sizes and a record of every adjustment.",
      "verbs": [
        "annotate",
        "derive",
        "identify",
        "clean"
      ]
    },
    "data": {
      "text": "A single raw grayscale or colour image of a gel from an imager or scanner, optionally several exposures of the same gel, plus a catalogue of size ladders with known band sizes.",
      "item": "a lane on a gel image, with its bands",
      "shapes": [
        "image",
        "image collection",
        "categories"
      ]
    },
    "stage": {
      "text": "preparing gel images as publication figures after the run, before writing up",
      "terms": [
        "report"
      ]
    },
    "mechanism": {
      "text": "A numbered side panel walks through image, lanes, marker, annotations and layout. A raw-image canvas, where the crop box, lane lines and marker bands are dragged, drives a live figure preview beside it, where text and annotations are edited in place. Exports pass through a pre-flight check with one-click fixes.",
      "views": [
        "image viewer",
        "side-by-side panes",
        "form",
        "list",
        "summary stats"
      ],
      "interactions": [
        "import",
        "zoom and pan",
        "drag to arrange",
        "select",
        "inline edit",
        "apply label",
        "keyboard shortcuts",
        "exclude and refit",
        "toggle view",
        "undo",
        "export"
      ],
      "patterns": [
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "gel electrophoresis figure preparation in molecular biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "molecular biology",
        "gel electrophoresis",
        "sds page"
      ]
    },
    "workflow": {
      "name": "turn a raw instrument image into an annotated publication figure",
      "steps": [
        {
          "step": "bring the data in",
          "here": "drop or choose a TIFF/PNG/JPG (or several exposures, of which the least saturated is picked), open a saved .gelfig project, or load the synthetic example",
          "parts": [
            "side-panel",
            "raw-editor"
          ]
        },
        {
          "step": "correct the automatic geometry and contrast by hand",
          "here": "auto straighten, quarter turns and flips, black/white points with a histogram and a clipping readout, a red crop box to drag, and lane lines whose two end guides space the middle evenly",
          "parts": [
            "image-controls",
            "lane-controls",
            "raw-editor"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "pick the marker lane and its ladder from the bp or kDa catalogue; bands are matched with a robust fit, and dragging one band refits the rest",
          "parts": [
            "marker-panel",
            "raw-editor"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "type lane names on the figure, drag across names for a group line, click cells to cycle +/−, and click a band for an arrow whose size is estimated from the marker",
          "parts": [
            "figure-preview",
            "annotation-tools"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "H cuts a lane out of the figure and adds a visible splice gap or line; empty lanes are suggested for removal but never cut silently",
          "parts": [
            "lane-controls"
          ]
        },
        {
          "step": "check the result against field rules before release",
          "here": "pre-flight lists effective resolution below 300 dpi, camera saturation, contrast clipping, tiny fonts, gamma and extrapolated sizes, each with a one-click fix",
          "parts": [
            "export-preflight"
          ]
        },
        {
          "step": "export the result",
          "here": "PNG or TIFF at 300/600/1200 dpi, SVG, editable PPTX, the uncropped image with the same processing, the original bytes with SHA-256, and a JSON processing log",
          "parts": [
            "export-preflight"
          ]
        }
      ],
      "distinctive": [
        "image-integrity rules from journal policy are built in: only linear whole-image adjustments by default, gamma locked unless unlocked, and cut lanes always marked with a splice",
        "band sizes come from a ladder catalogue matched to the marker lane, and sizes outside the ladder are flagged with ≈",
        "lanes are numbered by well across the whole gel, so changing the crop never loses names or markers",
        "the gel's effective resolution is tracked separately from the export resolution, with a suggested width that keeps 300 dpi",
        "each export can be accompanied by supplementary files: the uncropped processed image, the original file bytes and a processing log"
      ]
    }
  },
