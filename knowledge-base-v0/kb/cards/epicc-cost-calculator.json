  "app": {
    "title": "Epidemiological Cost Calculator (EPICC)",
    "summary": "The person picks a cost model from a list, or loads their own model file. They adjust its grouped parameters, stack presets or a saved parameter file on top, and set up several named scenarios that each have their own values. They run the model, which evaluates its equations once per scenario and fills in a report of prose, tables with scenarios as columns, and charts. They then save the changed parameters as a YAML or Excel preset, export the report as a PDF or DOCX, or share the calculation through the URL in the address bar. A tabbed editor lets them change the model itself (parameters, equations, scenarios, report blocks, presets) and try the edited version in the calculator before saving it.",
    "task": {
      "text": "Estimate what an outbreak and the public health response to it cost under several alternative scenarios, so a policy choice can be compared and justified.",
      "verbs": [
        "derive",
        "compare",
        "decide",
        "write"
      ]
    },
    "data": {
      "text": "A model document of typed parameters with defaults, ranges, units and references, plus ordered equations, named scenarios that override some parameters, presets, and report blocks. The output is a set of computed values for each scenario.",
      "item": "a cost or epidemiological parameter of a model, with its default, range, unit and source",
      "shapes": [
        "table",
        "hierarchy",
        "document"
      ]
    },
    "stage": {
      "text": "estimating and comparing intervention costs across scenarios to support a public health policy decision",
      "terms": [
        "analyze",
        "compare",
        "decide"
      ]
    },
    "mechanism": {
      "text": "The parameter form drives the model. Presets, scenarios and edited values change its inputs, and Run evaluates the equations and fills in a report pane beside the form, with one column per scenario in its tables and charts. Every change is also written into the URL, and the report and the parameters can each be exported. A separate tabbed editor changes the model itself and can be tried live in the calculator.",
      "views": [
        "form",
        "table view",
        "bar chart",
        "line chart",
        "document reader",
        "text editor"
      ],
      "interactions": [
        "select",
        "inline edit",
        "import",
        "export",
        "toggle view",
        "undo"
      ],
      "patterns": [
        "side-by-side comparison",
        "master-detail"
      ]
    },
    "field": {
      "text": "scenario-based outbreak cost estimation in public health epidemiology",
      "disciplines": [
        "medicine"
      ],
      "terms": [
        "epidemiology",
        "public health",
        "cost estimation"
      ]
    },
    "workflow": {
      "name": "compute and compare outcomes of a parameterised model across scenarios",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Pick a bundled model from the 'Select a model...' box, or load a custom model YAML through 'Load Custom Model', which accepts a file, a URL or pasted code. A shared link can also open a model with its values already filled in.",
          "parts": [
            "model-picker",
            "permalink"
          ]
        },
        {
          "step": "set the inputs for the computation",
          "here": "Edit the parameters, grouped in nested expanders and each with help text, a unit and a range. Stack built-in presets or a preset uploaded from a file, and reorder them with the up and down arrows. 'Reset to Preset' undoes edits.",
          "parts": [
            "parameter-panel",
            "preset-stack"
          ]
        },
        {
          "step": "define the alternatives to compare",
          "here": "In the Scenarios expander, label each scenario, set its own variables, and add or remove scenarios within a minimum and maximum count.",
          "parts": [
            "scenario-editor"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "'Run Simulation' (disabled while any input has an error) evaluates the model's equations in dependency order for each scenario.",
          "parts": [
            "parameter-panel"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "The report pane renders the model's markdown, tables with one column per scenario, and bar, stacked-bar, line or pie charts.",
          "parts": [
            "results-report"
          ]
        },
        {
          "step": "export the result",
          "here": "'Save Changes as Preset' downloads the changed parameters as YAML or XLSX. The report exports as a print-to-PDF or a DOCX file, and the URL keeps only the values that differ from the defaults.",
          "parts": [
            "report-export",
            "permalink",
            "parameter-panel"
          ]
        },
        {
          "step": "revise the model and try it",
          "here": "'Open Model Editor' has tabs for metadata, parameters, equations, scenarios, report and presets. The edited model is validated, and 'Try in Calculator' runs it without saving.",
          "parts": [
            "model-editor"
          ]
        }
      ],
      "distinctive": [
        "Models are declarative documents (parameters, equations, scenarios, report layout), compiled at runtime. Their equations are checked against a restricted syntax before they are evaluated.",
        "Each parameter carries its unit, its allowed range and its literature references, so every figure in the report can be traced to a source.",
        "Presets stack in an ordered list, and a parameter file can be uploaded as one more layer. The panel tracks which values differ from the model's defaults.",
        "The address bar is a readable, hand-editable permalink that stores only the changes from the defaults. Values out of range are clamped, and the app shows a warning about them.",
        "Parameter files can be written and read as YAML or as Excel spreadsheets, for people who work in spreadsheets."
      ]
    }
  },
