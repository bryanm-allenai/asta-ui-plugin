  "app": {
    "title": "Plasmid sequence annotator",
    "summary": "A person reads a DNA sequence laid out in numbered rows, drags across bases to select a stretch, picks a strand and a feature type from a palette, and the stretch becomes a coloured, strand-arrowed bar on a track above the sequence, stacked in lanes where features overlap. The features are listed in a table where names, types, coordinates and strands can be corrected by typing or deleted. A side panel reports the length, GC content, a rough melting temperature and the reverse complement of the current selection, searches a short motif on both strands and jumps to each hit, and exports the features as a tab-separated table; a new sequence can be pasted in, and the sequence and features are kept between visits.",
    "task": {
      "text": "Mark and keep track of the features along a DNA construct, and check where a short motif such as a primer binds on either strand.",
      "verbs": [
        "annotate",
        "locate",
        "derive"
      ]
    },
    "data": {
      "text": "One nucleotide sequence of a construct, with labelled, stranded features marked along it from a small set of feature types.",
      "item": "a feature marked as a stretch of bases on one strand of a plasmid sequence",
      "shapes": [
        "sequence",
        "spans",
        "categories",
        "table"
      ]
    },
    "stage": {
      "text": "designing and checking a DNA construct while assembling it",
      "terms": [
        "annotate",
        "plan"
      ]
    },
    "mechanism": {
      "text": "Dragging across bases in the sequence view makes a selection that a palette of feature types turns into a span, drawn as a bar on the track above the bases and listed as an editable row in the feature table. Clicking a bar, a table row's Show button or a motif hit selects that stretch back in the sequence and scrolls to it, and the selection readout updates with its properties.",
      "views": [
        "sequence track",
        "table view",
        "summary stats"
      ],
      "interactions": [
        "select text span",
        "apply label",
        "inline edit",
        "search",
        "select",
        "export",
        "import"
      ],
      "patterns": [
        "category palette",
        "linked views"
      ]
    },
    "field": {
      "text": "synthetic biology, reporter plasmid construction",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "synthetic biology",
        "molecular cloning",
        "plasmid design"
      ]
    },
    "workflow": {
      "name": "mark labelled stretches along one sequence and keep them in an editable list",
      "steps": [
        {
          "step": "bring the data in",
          "here": "A sequence is pasted raw or as a GenBank ORIGIN block; numbers and spaces are stripped, other characters become N, and features that run past the new end are dropped. A synthetic placeholder is shown until then.",
          "parts": [
            "export-load"
          ]
        },
        {
          "step": "read the whole sequence with its labels drawn along it",
          "here": "The sequence runs in rows of 60 bases with a gap every 10 and the start position at the left of each row, and each feature is a bar above the bases it covers.",
          "parts": [
            "sequence-view",
            "feature-track"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "Dragging or shift-clicking across bases selects a stretch; the person picks the plus or minus strand, then a type from the palette (promoter, CDS, terminator, primer site, other), and the stretch becomes a muted coloured bar pointed by strand, stacked in lanes where features overlap.",
          "parts": [
            "sequence-view",
            "feature-palette",
            "feature-track"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "The selection readout gives the range, length and GC percentage, a rough melting temperature for 8 to 60 bases, and the top and bottom strand sequences up to 120 bases.",
          "parts": [
            "selection-readout"
          ]
        },
        {
          "step": "find every place a pattern occurs",
          "here": "Typing a motif of at least four bases highlights exact matches of it and of its reverse complement, counts the hits on each strand, and lists them; clicking a hit selects it and scrolls to it.",
          "parts": [
            "motif-search"
          ]
        },
        {
          "step": "correct or delete labels in a list",
          "here": "The feature table, in order of start, lets name, type, start, end and strand be edited in place, shows the length, and has Show, which selects the feature and scrolls to it, and Delete; clicking a bar also brings a feature up. Features are kept between visits.",
          "parts": [
            "feature-table",
            "feature-track"
          ]
        },
        {
          "step": "export the result",
          "here": "The features are written as a tab-separated GFF3-style table, with each type mapped to a GFF type, to copy into a sheet or download as a .gff file.",
          "parts": [
            "export-load"
          ]
        }
      ],
      "distinctive": [
        "Every label has a strand, shown as the direction of its bar's point and carried into the export.",
        "Coordinates are 1-based and inclusive, as in GenBank, and can be fixed by typing.",
        "The motif search looks on both strands at once by also matching the reverse complement, and says which strand each hit is on.",
        "The selection readout gives GC content, a rough melting temperature at primer length, and the reverse complement for minus-strand primers.",
        "Overlapping features are stacked in lanes so the lower one can still be clicked."
      ]
    }
  },
