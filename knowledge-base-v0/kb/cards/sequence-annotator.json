  "app": {
    "title": "Plasmid construct annotator",
    "summary": "A person loads a DNA sequence by pasting raw bases or a GenBank ORIGIN block, then searches it for short motifs on both strands. They drag across bases to select a stretch, read its length, GC content and rough melting temperature, choose a strand and mark the stretch as a feature type from a fixed palette. Features appear as arrowed bars above the sequence and as rows in an editable table, where names, types, coordinates and strand can be corrected or deleted. The finished feature list is exported as a GFF3 table to copy or download.",
    "task": {
      "text": "Mark where the functional parts of a DNA construct lie, on which strand, and export them as a standard feature table.",
      "verbs": [
        "annotate",
        "locate",
        "derive"
      ]
    },
    "data": {
      "text": "One linear DNA sequence with a growing list of typed, stranded features given by start and end coordinates.",
      "item": "a feature: a stretch of bases on one strand with a name and a type",
      "shapes": [
        "sequence",
        "spans",
        "categories",
        "table"
      ]
    },
    "stage": {
      "text": "annotating features on a DNA construct sequence with a fixed set of types, before handing the feature table on",
      "terms": [
        "annotate"
      ]
    },
    "mechanism": {
      "text": "The sequence is drawn in numbered rows of 60 bases with a lane-stacked feature track above each row; a drag selection there drives a readout and a type palette that turns the selection into a feature. The feature table, the track bars and motif hits are linked to the sequence, so clicking any of them selects and scrolls to that stretch.",
      "views": [
        "sequence track",
        "table view",
        "detail panel",
        "form"
      ],
      "interactions": [
        "select text span",
        "apply label",
        "inline edit",
        "search",
        "select",
        "keyboard shortcuts",
        "export",
        "import"
      ],
      "patterns": [
        "category palette",
        "linked views"
      ]
    },
    "field": {
      "text": "feature annotation of DNA construct sequences, in molecular biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "molecular biology",
        "sequence annotation",
        "gff"
      ]
    },
    "workflow": {
      "name": "mark stretches of a sequence as typed features and export the feature list",
      "steps": [
        {
          "step": "bring the data in",
          "here": "paste raw bases or a GenBank ORIGIN block under 'Paste a different sequence'; numbers and spaces are stripped, odd characters become N, and features that run past the new end are dropped",
          "parts": [
            "sequence-load",
            "sequence-view"
          ]
        },
        {
          "step": "find every occurrence of a pattern",
          "here": "type a motif of at least four bases; exact matches and reverse-complement matches are highlighted in the sequence, counted per strand, and listed so a click jumps to each",
          "parts": [
            "motif-search",
            "sequence-view"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "drag across bases (shift-click extends, Esc clears), pick + or − strand, then click Promoter, CDS, Terminator, Primer site or Other",
          "parts": [
            "sequence-view",
            "type-palette"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "the selection readout shows range, length, GC percent, a rough Tm for 8–60 base stretches, and the top and bottom strand 5′→3′",
          "parts": [
            "selection-readout"
          ]
        },
        {
          "step": "correct each labelled item where it is listed",
          "here": "the feature table edits name, type, start, end and strand in place, deletes rows, and Show selects the feature; clicking a bar in the track does the same",
          "parts": [
            "feature-table",
            "feature-track"
          ]
        },
        {
          "step": "export the result",
          "here": "Show features as GFF table writes GFF3 lines with sequence-region and feature types mapped to GFF terms; Copy puts it on the clipboard, Download saves a .gff file",
          "parts": [
            "gff-export"
          ]
        }
      ],
      "distinctive": [
        "every feature has a strand, drawn as the direction of its arrowed bar and exported in the strand column",
        "motif search checks the reverse complement too and notes when a motif is a palindrome that matches both strands at once",
        "a selection of primer length shows a rough melting temperature (Wallace rule under 14 bases, a GC formula above)",
        "coordinates are 1-based and inclusive, overlapping features stack in lanes, and CDS rows get phase 0 in the export"
      ]
    }
  },
