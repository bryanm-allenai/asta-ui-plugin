  },
  "app": {
    "title": "NPLinker Webapp",
    "summary": "A person imports a saved file of predictions, or loads a demo, and both directions of the analysis open up. In one tab they start from gene cluster families and in the other from molecular families of spectra. They narrow the table with filter rows (by ID list, or by biosynthetic class for the chosen MIBiG version), look at a bar chart of family sizes or classes, and tick the rows they care about. They then set the scoring method, raw or standardised scores and a minimum cutoff, and press Show Results. This gives a Candidate Links table: one row per selected family, with its number of links, average score and top-scoring partner. The person can filter and sort this table, choose which columns it shows, and download it as a two-sheet Excel file of best and all candidate links.",
    "task": {
      "text": "Rank candidate links between gene cluster families and metabolite families by correlation score, so the person can pick the most promising pairings and export them.",
      "verbs": [
        "identify",
        "explore",
        "summarize",
        "lookup",
        "compare"
      ]
    },
    "data": {
      "text": "Precomputed links between two kinds of entity: gene cluster families (groups of biosynthetic gene clusters with classes and strains) and mass spectra or molecular families of spectra (with precursor m/z, GNPS IDs and strains). Each link carries a score from a scoring method, its cutoff and whether it is standardised.",
      "item": "a candidate link between one gene cluster family and one spectrum or molecular family, with its score",
      "shapes": [
        "network",
        "table",
        "hierarchy",
        "categories"
      ]
    },
    "stage": {
      "text": "analysing precomputed genome–metabolome link scores to pick candidates for follow-up",
      "terms": [
        "analyze",
        "explore"
      ]
    },
    "mechanism": {
      "text": "Two parallel tabs, one per link direction, each stack the same steps: filter rows narrow a selectable data table of families, and the selected rows plus scoring blocks (method, raw/standardised, cutoff) feed a results table that groups links per family and shows count, mean and top-scoring partner. Hovering over cells shows tooltip tables of members, strains and the top five links, and the results table filters, sorts, picks its columns and exports to Excel.",
      "views": [
        "table view",
        "bar chart",
        "form",
        "summary stats"
      ],
      "interactions": [
        "import",
        "filter",
        "multi-select",
        "sort",
        "hover for detail",
        "toggle view",
        "export"
      ],
      "patterns": [
        "overview and detail"
      ]
    },
    "field": {
      "text": "linking biosynthetic gene clusters to metabolomics spectra by strain-correlation scoring in natural product discovery",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "metabologenomics",
        "natural products",
        "genome mining"
      ]
    },
    "workflow": {
      "name": "rank candidate pairings between two linked sets of items by score",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload a single .pkl/.pickle file saved by the linking tool, or press Load Demo Data. The file is validated and unpacked into families and links, and the two direction tabs become enabled.",
          "parts": [
            "data-import",
            "direction-tabs"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "A bar chart counts gene cluster families by number of clusters or by cluster class. Hovering over a bar lists its family IDs.",
          "parts": [
            "family-bar-chart"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Add filter rows with +. Each row filters by GCF ID list or BGC class (classes follow the chosen MIBiG version), or in the other tab by MF ID or spectrum ID. The rows are combined with OR when Apply Filters is pressed.",
          "parts": [
            "filter-builder",
            "family-table"
          ]
        },
        {
          "step": "choose the items to work on",
          "here": "Tick rows in the paged family table, or use select-all on the filtered rows. Hovering over a cell shows member clusters with their classes and strains, and counters show total and selected rows.",
          "parts": [
            "family-table"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Scoring blocks set the method (Metcalf), raw or standardised scores and a minimum cutoff. Show Results keeps the matching links for the selected families, then groups them per family to give the number of links, the average score and the top-scoring partner.",
          "parts": [
            "scoring-blocks",
            "candidate-links-table"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Each column of the Candidate Links table takes typed filters (> 30, contains Polyketide) and can be sorted. A Columns settings switch list adds optional columns about the top partner, and hovering over # Links shows the top five links.",
          "parts": [
            "candidate-links-table"
          ]
        },
        {
          "step": "export the result",
          "here": "Download Results (Excel) writes a 'Best Candidate Links' sheet and an 'All Candidate Links' sheet with every link per family.",
          "parts": [
            "excel-export"
          ]
        }
      ],
      "distinctive": [
        "The same pipeline runs in both directions, genes to metabolites and metabolites to genes, as two mirrored tabs with their own filters and outputs.",
        "Scores can be read raw or standardised, against the cutoff they were computed with, so only links from the chosen scoring setting are ranked.",
        "Each family's results show the link count, the mean score and the top-scoring partner. Ties for top score each get their own row.",
        "Class filters switch between biosynthetic class vocabularies from before and after MIBiG 4.0.",
        "Links are not computed in the interface: it reads scores already computed elsewhere, and scoring is disabled when the file has none."
      ]
    }
  },
