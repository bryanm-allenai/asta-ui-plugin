  "app": {
    "title": "HydroPlot · Pacific Northwest",
    "summary": "A person finds a stream gage by searching or clicking the station map, checks its current condition and how far back its record goes, then opens it for single-site analysis over a chosen date range. One plot workspace shows a single view at a time: an interactive hydrograph, a flow-duration curve, a raster, percentile bands, flood frequency fitted to annual peaks, a stage-discharge rating, and drought and baseflow indicators. They can also compare periods or gages, or pick an upstream–downstream gage pair to screen whether the reach gains or loses flow. Each workflow ends with exported figures, and the single-site export adds a plain-language analysis they can download as Markdown.",
    "task": {
      "text": "Characterise the flow record at a stream gage, or a pair of gages, and export figures and a written screening summary of its behaviour.",
      "verbs": [
        "derive",
        "explore",
        "compare",
        "summarize",
        "locate"
      ]
    },
    "data": {
      "text": "Daily and instantaneous discharge and stage records from monitoring stations, joined with nearby climate series, annual peak flows and the river network that links the stations.",
      "item": "a stream gage with its daily discharge record",
      "shapes": [
        "time series",
        "geospatial",
        "table",
        "network"
      ]
    },
    "stage": {
      "text": "analysing public gage records to characterise flow at a site or reach, before writing up",
      "terms": [
        "analyze",
        "explore",
        "compare"
      ]
    },
    "mechanism": {
      "text": "A station map and search pick the site, and that choice carries across pages. The analysis page loads the site's record and shows one interactive chart at a time, switched with a view selector. Comparison and reach pages set periods, gages or upstream–downstream pairs against each other, and each workflow ends with a generated multi-panel figure grid for export.",
      "views": [
        "map",
        "line chart",
        "summary stats",
        "table view",
        "heatmap",
        "scatter plot",
        "side-by-side panes",
        "small multiples"
      ],
      "interactions": [
        "search",
        "select",
        "filter",
        "toggle view",
        "hover for detail",
        "zoom and pan",
        "time slider",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "side-by-side comparison",
        "small multiples",
        "dashboard"
      ]
    },
    "field": {
      "text": "streamflow record analysis at stream gages in hydrology",
      "disciplines": [
        "earth science"
      ],
      "terms": [
        "hydrology",
        "flood frequency",
        "baseflow separation"
      ]
    },
    "workflow": {
      "name": "analyse one monitoring station's record and export figures with a written summary",
      "steps": [
        {
          "step": "find the item to work on",
          "here": "Search gages by name, number or state, or click a marker on the station map. Markers can be coloured by current flow percentile, and basin, flowline and dam layers can be added.",
          "parts": [
            "station-finder"
          ]
        },
        {
          "step": "bring the data in",
          "here": "On Site Analysis, pick a USGS or Ecology gage and a date range. The discharge record, nearby climate data and stage (when the gage has it) load automatically. Availability badges and record coverage cards show what is present.",
          "parts": [
            "site-analysis"
          ]
        },
        {
          "step": "look over the record in several views",
          "here": "The Plot view selector switches between Hydrograph (daily, weekly or monthly, with optional NWM and stage overlays), Duration (with dQ/dt colouring), Raster, Percentiles and Indicators (SPI, SRI, baseflow, anomaly).",
          "parts": [
            "plot-workspace"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Frequency fits several distributions to the annual peaks. It shows return-period flows with confidence intervals, an LP3 diagnostic table and AIC, BIC and KS scores. Rating fits a stage-discharge curve.",
          "parts": [
            "flood-frequency",
            "plot-workspace"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Compare Sites sets two periods (using year sliders or shift arrows), several gages (overlay, one panel per site, or a grid) or a 2x2 of two sites over two periods against each other.",
          "parts": [
            "compare-sites"
          ]
        },
        {
          "step": "compute a value from a pair of items",
          "here": "Reach Analysis finds related gages on the river network from an anchor gage and steps through candidate upstream–downstream pairs on a reach map. Run Analysis computes gain or loss per km with a confidence level and draws a baseflow waterfall.",
          "parts": [
            "reach-analysis"
          ]
        },
        {
          "step": "export the result",
          "here": "Pick plots from presets or the catalogue, set the layout and DPI, and click Generate Plots. The figure can be downloaded, along with an automated plain-language analysis as Markdown and the raw discharge data.",
          "parts": [
            "export-report"
          ]
        }
      ],
      "distinctive": [
        "Each analysis checks it has enough data first, for example at least 10 annual peaks for flood frequency, and the Rating view appears only when the gage records stage",
        "Records are read by water year and against seasonal flow percentiles, so the condition is shown as above or below normal for the date",
        "Upstream–downstream gage pairs are found on the river network, and the reach length comes from the network distance, so gain or loss can be given per km",
        "Results are presented as screening only, with a confidence label, and are not claimed as calibrated groundwater modelling"
      ]
    }
  },
