  "app": {
    "title": "Aether: NetCDF Explorer",
    "summary": "A person types the path to a gridded data file and loads it. They pick a variable and which dimensions are the map axes, time and any extra levels. They then step or animate through time on a coloured map and adjust its palette and colour range. Clicking a grid point, or dragging a box over a region, pulls out that place's time series and its anomalies. The series is smoothed and fitted with a trend line, and the person can drag two endpoints to get the slope and significance for any sub-period. Side charts show the mean annual cycle and the latitude-weighted zonal mean profile, and a notes box keeps the person's own record of what they found.",
    "task": {
      "text": "Explore a gridded space-time dataset and estimate the trend, anomalies and seasonal cycle at a chosen point or region over a chosen period.",
      "verbs": [
        "explore",
        "derive",
        "summarize",
        "locate",
        "compare"
      ]
    },
    "data": {
      "text": "A multidimensional gridded file with one or more variables over longitude, latitude and time, sometimes with extra dimensions such as level or ensemble member",
      "item": "the time series of one variable at one grid cell or averaged over a selected box of cells",
      "shapes": [
        "field",
        "geospatial",
        "time series",
        "notes"
      ]
    },
    "stage": {
      "text": "exploring gridded model or reanalysis output for trends and anomalies, before a focused analysis",
      "terms": [
        "explore",
        "analyze"
      ]
    },
    "mechanism": {
      "text": "A sidebar of controls sets the variable, dimension slices, time step and colour scale for a gridded map. A click or box drag on the map fills the linked raw and anomaly time-series tabs, the annual-cycle bar chart and the statistics. On the time series, two draggable endpoints recompute OLS and Theil–Sen slopes over the chosen span.",
      "views": [
        "map",
        "heatmap",
        "line chart",
        "bar chart",
        "summary stats",
        "sidebar list",
        "text editor",
        "detail panel"
      ],
      "interactions": [
        "import",
        "select",
        "brush",
        "hover for detail",
        "zoom and pan",
        "time slider",
        "toggle view",
        "write notes",
        "drag to arrange"
      ],
      "patterns": [
        "linked views",
        "overview and detail",
        "dashboard"
      ]
    },
    "field": {
      "text": "trend and anomaly analysis of gridded climate data in earth science",
      "disciplines": [
        "earth science"
      ],
      "terms": [
        "climate science",
        "netcdf",
        "trend analysis"
      ]
    },
    "workflow": {
      "name": "pick a place and period in a space-time grid and estimate its trend",
      "steps": [
        {
          "step": "bring the data in",
          "here": "type or paste a .nc file path and press Load File; the dataset's structure is printed in an info panel",
          "parts": [
            "load-and-dimensions",
            "info-and-notes"
          ]
        },
        {
          "step": "choose what slice of the data to show",
          "here": "pick the variable, the X/Y map dimensions, the time dimension and a value for a 4th and 5th dimension, which are detected automatically from their names",
          "parts": [
            "load-and-dimensions"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "a gridded heatmap with coastlines for one time step, with min/max/mean statistics, a latitude-weighted zonal mean profile beside it, a time slider, a date picker, a Play animation, and a palette with robust 1st–99th percentile colour limits",
          "parts": [
            "map-view",
            "time-and-colour",
            "lat-profile"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "clicking a cell marks it with a cross and extracts its time series, and box-selecting extracts the time series averaged over the region; both fill raw and anomaly tabs",
          "parts": [
            "map-view",
            "timeseries-tabs"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "a Savitzky–Golay smoothed line (window and polynomial order set by spinners) and an OLS or Theil–Sen trend with its p-value; monthly data also gets an annual-cycle bar chart and month-wise anomalies",
          "parts": [
            "timeseries-tabs",
            "annual-cycle"
          ]
        },
        {
          "step": "narrow the computation to a sub-range",
          "here": "a toolbar toggle shows two endpoints on the series; dragging them reports Δx, Δy, the slope per time unit, and the OLS and Theil–Sen slopes over the span",
          "parts": [
            "timeseries-tabs"
          ]
        },
        {
          "step": "write up the result",
          "here": "free notes typed into a 'My notes' box beside the dataset info",
          "parts": [
            "info-and-notes"
          ]
        }
      ],
      "distinctive": [
        "anomalies are taken from the climatology of each calendar month when the time step is monthly, and from the overall mean otherwise",
        "the zonal mean profile weights each latitude by the cosine of latitude to account for grid-cell area",
        "the trend can be estimated with a robust Theil–Sen slope and Kendall p-value as well as ordinary least squares",
        "files with more than three dimensions are reduced by choosing a value for a 4th and 5th dimension",
        "the time axis is parsed from datetime, non-standard calendar (cftime) or plain numeric years, and its step size is detected to give slopes per year, per month or per day"
      ]
    }
  },
