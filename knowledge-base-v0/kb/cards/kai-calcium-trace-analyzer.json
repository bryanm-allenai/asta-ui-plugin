  "app": {
    "title": "KAI - Calcium Imaging Analyzer",
    "summary": "A person loads a raw fluorescence trace, plus an optional ambient trace that can be shifted and scaled and then subtracted. They set a pacing rate, pick a smoothing level and detect peaks, which splits the trace into periods running from one minimum to the next. In edit mode, clicking the trace drops or restores whole periods, and adds or removes minima to move period boundaries. The kept periods are overlaid on a normalised time axis with a mean ± SD band, summarised as transient metrics for the raw and filtered signals, and exported as an Excel workbook, PNG figures and a session JSON.",
    "task": {
      "text": "Turn a periodic calcium-imaging trace into curated periods and per-period transient metrics (APD20/50/90, rise and decay times, slopes, AUC) that can be exported.",
      "verbs": [
        "derive",
        "clean",
        "summarize",
        "compare"
      ]
    },
    "data": {
      "text": "One time series of signal intensity from a CSV or Excel file, with an optional ambient background series in the same format. Detection splits it into repeated periods, each with its own computed metrics.",
      "item": "one period of a periodic trace, from one minimum to the next",
      "shapes": [
        "time series",
        "table"
      ]
    },
    "stage": {
      "text": "measuring transients from raw imaging traces, after recording and before statistics across samples",
      "terms": [
        "analyze",
        "clean"
      ]
    },
    "mechanism": {
      "text": "A sidebar drives a step-by-step pipeline (load, ambient subtraction, pacing, smoothing, peak detection) that feeds a signal plot. In edit mode, clicks on that plot change minima and toggle periods, and each change recomputes the periods list, the overlay of normalised periods and the metrics table in the other tabs.",
      "views": [
        "line chart",
        "list",
        "table view",
        "summary stats"
      ],
      "interactions": [
        "import",
        "select",
        "exclude and refit",
        "toggle view",
        "hover for detail",
        "zoom and pan",
        "export"
      ],
      "patterns": [
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "periodic calcium transient analysis in calcium imaging",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "calcium imaging",
        "calcium transients",
        "action potential duration"
      ]
    },
    "workflow": {
      "name": "split a periodic signal into cycles, curate them, and export per-cycle metrics",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Load Raw takes a CSV or XLSX trace. Load Ambient (optional) takes a background trace, which is resampled, shifted by an offset in ms, scaled and then subtracted when Apply is pressed.",
          "parts": [
            "load-and-correct"
          ]
        },
        {
          "step": "clean the signal before measuring",
          "here": "A manual pacing rate in Hz guides filtering and detection. A smoothing dial from S=0 to 5 picks Savitzky–Golay, Butterworth or Gaussian smoothing, and the filtered line is drawn over the raw one.",
          "parts": [
            "smoothing-and-detection",
            "signal-plot"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Detect Peaks finds alternating minima and maxima adaptively, using the pacing rate. The trace is then cut into periods from one minimum to the next, and the period boundaries are drawn on the plot.",
          "parts": [
            "smoothing-and-detection",
            "signal-plot",
            "periods-list"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "In Edit Mode, clicking near a maximum toggles its whole period (removed periods are shaded red), and clicking near a minimum inserts or removes a boundary. Clicks snap to the nearest extremum, alternation is enforced, and periods and metrics are recomputed.",
          "parts": [
            "signal-plot"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "The kept periods are resampled to 200 points, normalised to their baseline and overlaid on τ ∈ [0,1], with a mean ± SD band.",
          "parts": [
            "period-overlay"
          ]
        },
        {
          "step": "summarize across items",
          "here": "The metrics table lists the mean and std of APD20/50/90, rise_10_90, decay_90_10, time to peak, upstroke and downstroke angles, AUC and more, for the raw and filtered signals side by side.",
          "parts": [
            "metrics-table"
          ]
        },
        {
          "step": "export the result",
          "here": "Export XLSX/CSV produces a workbook with sheets for parameters, periods, per-period and aggregated metrics and the resampled periods. It also offers signal and overlay PNGs and a session JSON with the peaks, the removed periods and the settings.",
          "parts": [
            "export"
          ]
        }
      ],
      "distinctive": [
        "An ambient background trace can be aligned by a time offset and a scale factor before it is subtracted from the raw trace",
        "One smoothing dial (0–5) maps to tuned filter backends, and every metric is reported for both the raw and the filtered signal so the effect of smoothing can be seen",
        "A known pacing frequency guides peak spacing and filtering",
        "One click on the trace snaps to a local extremum: a maximum toggles its whole period, and a minimum edits a period boundary",
        "Waveform metrics from cardiac physiology (APD20/50/90, 10–90% rise and decay times, upstroke angles) are computed for each period"
      ]
    }
  },
