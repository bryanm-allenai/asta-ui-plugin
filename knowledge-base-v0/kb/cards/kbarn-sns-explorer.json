  "app": {
    "title": "KBarn Social Network Explorer",
    "summary": "A person loads timestamped RFID detection files from a tracked animal colony. The files are cleaned and turned into co-location counts within sampling periods. They then set the sampling period, edge threshold, time window, permutation count and date range, and work through three layers. The group layer draws the association network, its communities and directed approach counts, and runs a permutation test that marks which pairs are significantly preferred or avoided. The group sociality layer gives cohesion, density, differentiation and modularity, and shows how they change across time windows. The individual layer builds a multi-parameter sociality profile for each animal and clusters the animals into named types. It opens any one animal in detail and correlates the profiles with behavioural metrics. Each layer exports its matrices and tables as CSV, and a full phenotype run can be saved with its parameters.",
    "task": {
      "text": "Infer a social network from co-location records, test which bonds exceed chance, track how group structure changes over time, and characterise each individual's social phenotype.",
      "verbs": [
        "derive",
        "explore",
        "summarize",
        "compare",
        "organize",
        "identify"
      ]
    },
    "data": {
      "text": "Timestamped tag detections of individuals at fixed antennas. These become an animal-by-animal association matrix, per-animal network metrics, per-window time series and a per-animal phenotype table.",
      "item": "an individual animal in the colony, or a pair of animals (a dyad)",
      "shapes": [
        "events",
        "network",
        "table",
        "time series"
      ]
    },
    "stage": {
      "text": "analysing social structure from cleaned tracking detections, exploratory, before reporting",
      "terms": [
        "analyze",
        "explore"
      ]
    },
    "mechanism": {
      "text": "Sidebar parameters and a date-range slider feed every view, and a layer switch picks a set of tabbed views. These include network diagrams, heatmaps, metric tables and charts, plus a per-animal detail view and a phenotype-vs-behaviour correlation view with a scatter you pick from two dropdowns. Every figure can be opened full size, and each layer has its own CSV export tab.",
      "views": [
        "network diagram",
        "heatmap",
        "table view",
        "summary stats",
        "bar chart",
        "line chart",
        "scatter plot",
        "small multiples",
        "detail panel",
        "radar chart"
      ],
      "interactions": [
        "import",
        "time slider",
        "toggle view",
        "select",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "small multiples",
        "dashboard"
      ]
    },
    "field": {
      "text": "animal social network analysis of co-location from automated RFID tracking, in animal behaviour",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "animal social network analysis",
        "behavioural phenotyping",
        "rfid tracking"
      ]
    },
    "workflow": {
      "name": "turn co-occurrence records into a tested association network and per-member profiles",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload the per-pen RFID CSVs or point to a data folder, then press Load data. Duplicate exports, bad-UID noise reads and stray tags are dropped, and the sidebar reports how many reads and animals are left.",
          "parts": [
            "data-controls"
          ]
        },
        {
          "step": "set the analysis parameters and narrow to a time range",
          "here": "Pick the sampling period, minimum SRI for an edge, temporal window length and number of permutations, then drag the date-range slider. Every view recomputes from those settings.",
          "parts": [
            "data-controls"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "A Simple Ratio Index is computed for every pair and drawn as an association network (size = strength, colour = greedy-modularity community) and an SRI heatmap. Alongside are a node-metrics table (strength, partners, eigenvector, betweenness, clustering) and a directed approach-count matrix.",
          "parts": [
            "network-layer"
          ]
        },
        {
          "step": "test which links differ from chance",
          "here": "A datastream permutation test classes each dyad as preferred, avoided or neutral and draws them as green and red edges. Mouse A and Mouse B pickers plot one dyad's SRI across time windows, and a table lists each pair's p-values.",
          "parts": [
            "significant-dyads"
          ]
        },
        {
          "step": "track change across time windows",
          "here": "Headline cohesion, density, differentiation and modularity, plus an SRI histogram and centrality bars. Then the same group metrics and a chosen centrality per animal over time, as a line chart and a heatmap, and network snapshots per window on a fixed layout.",
          "parts": [
            "group-sociality",
            "network-layer"
          ]
        },
        {
          "step": "group items into clusters",
          "here": "Builds a 14-parameter sociality profile per animal, z-scores it and runs PCA and Ward clustering into k types, each named from its standout z-scores. A Focus mouse picker opens one animal's radar, raw values against the group median, ego-network, approach arrows, significant partners and partner trajectories. A Pearson correlation heatmap and a scatter set the phenotypes against behavioural metrics.",
          "parts": [
            "phenotype-overview",
            "individual-detail",
            "phenotype-behaviour"
          ]
        },
        {
          "step": "export the result",
          "here": "Download CSVs of the SRI, node-metric, approach, group-over-time, phenotype, z-score and correlation tables. Save phenotype run writes all of them plus a params.txt into a timestamped outputs folder.",
          "parts": [
            "exports"
          ]
        }
      ],
      "distinctive": [
        "Two individuals count as associated only when both are at the same pen, floor and zone within the same sampling period, using each animal's most-read location in that period.",
        "Significance comes from a datastream permutation that shuffles locations among the animals present in each period. This keeps group sizes fixed and marks each pair as preferred or avoided.",
        "A social-residual parameter regresses association on Pianka spatial overlap, which separates real attraction from shared space use.",
        "Directed approach counts record who arrived where another animal already was, giving an initiator-vs-magnet balance for each animal.",
        "Clusters are named automatically from their standout profile axes, for example social hub, broker or peripheral loner, and a glossary popover defines every metric."
      ]
    }
  },
