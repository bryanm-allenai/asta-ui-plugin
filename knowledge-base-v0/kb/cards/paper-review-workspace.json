  "app": {
    "title": "Conference paper review workspace",
    "summary": "A reviewer reads a submission in one pane, jumping between sections from a sticky contents bar, and fills in the venue's review form in the other: an overall recommendation, their expertise, and a rating with a one-sentence note for each criterion. Selecting a passage in the paper offers to quote it into the review at the cursor, with its section or figure as the source, and quoted passages stay highlighted in the paper while the review still holds them. A word count separates their own words from quoted ones against a personal target, a checklist from the reviewer guidelines is ticked off, and a readiness list names everything still missing. The finished review is copied as plain text or downloaded as a .txt file, in the order the submission form asks for.",
    "task": {
      "text": "Write a peer review of one paper submission against a venue's form and checklist, quoting the paper as evidence, ready to paste into the submission system.",
      "verbs": [
        "review",
        "write",
        "rate"
      ]
    },
    "data": {
      "text": "One paper laid out as numbered sections of paragraphs with figure captions, and the reviewer's own draft: scores on fixed scales, per-criterion ratings and notes, review text with quotes, and checklist ticks.",
      "item": "a paper submission under review",
      "shapes": [
        "document",
        "judgements",
        "notes",
        "spans"
      ]
    },
    "stage": {
      "text": "writing a peer review of one submission, before pasting it into the conference system",
      "terms": [
        "review"
      ]
    },
    "mechanism": {
      "text": "A paper reader and a review form sit side by side; selecting text in the reader pops up a button that inserts the passage as a sourced quote at the last cursor position in the review textarea, and the reader highlights the passages the review still quotes. Every change to the form saves to the browser and updates the word meter and the list of what is still missing before export.",
      "views": [
        "side-by-side panes",
        "document reader",
        "form",
        "text editor",
        "summary stats"
      ],
      "interactions": [
        "select text span",
        "quote into text",
        "score",
        "write notes",
        "export"
      ],
      "patterns": [
        "rubric"
      ]
    },
    "field": {
      "text": "peer review of a conference paper submission on the venue's review form, in HCI",
      "disciplines": [
        "hci"
      ],
      "terms": [
        "hci",
        "peer review",
        "conference reviewing"
      ]
    },
    "workflow": {
      "name": "judge one document against fixed criteria and write the review",
      "steps": [
        {
          "step": "open one item in detail",
          "here": "The submission is shown as a paper with title, numbered sections, subsections and figure captions, with a sticky bar of links to each top-level section.",
          "parts": [
            "paper-reader"
          ]
        },
        {
          "step": "score each item against criteria",
          "here": "Radio scales for the overall recommendation (1 argue to reject to 5 argue to accept) and self-rated expertise (1 to 4), then Low, Medium or High plus one sentence for originality, significance, rigour and clarity.",
          "parts": [
            "review-form",
            "criteria-rubric"
          ]
        },
        {
          "step": "quote evidence from the item into the write-up",
          "here": "Selecting text in the paper shows Quote into review, which inserts it as a '>' line with its section or figure caption at the cursor; quoted passages are highlighted in the paper until deleted from the review.",
          "parts": [
            "quote-button",
            "paper-reader",
            "review-text"
          ]
        },
        {
          "step": "write up the result",
          "here": "The review is written in a textarea; the count splits own words from quoted words and a meter fills toward a 500-word personal target.",
          "parts": [
            "review-text"
          ]
        },
        {
          "step": "check the item against a checklist",
          "here": "Seven items from the reviewer guidelines (anonymisation, ethics, participants, figure descriptions, limitations, contribution type, open materials) are ticked once checked in the paper.",
          "parts": [
            "reviewer-checklist"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "A readiness list names every unset score, unrated or un-noted criterion, word shortfall and unticked checklist item, until everything is done.",
          "parts": [
            "readiness-export"
          ]
        },
        {
          "step": "export the result",
          "here": "Copy review as plain text or Download as .txt produces recommendation, expertise, the review text and ratings by criterion in the form's order; Clear draft empties it after a confirm. The draft is saved in the browser throughout.",
          "parts": [
            "readiness-export"
          ]
        }
      ],
      "distinctive": [
        "quotes are inserted with their source (section number or figure caption) and the paper highlights only those still present in the review text",
        "word counts separate the reviewer's own words from quoted words, and only own words count toward the target",
        "a readiness list before export gathers every missing score, criterion note and unticked guideline check",
        "the export is ordered to match the venue's submission form so it can be pasted straight in"
      ]
    }
  },
