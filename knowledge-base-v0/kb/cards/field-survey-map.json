  "app": {
    "title": "Transect survey map with linked species totals and observation table",
    "summary": "A person loads a CSV of survey observations, each a dated count of one species at a point on a local grid, or starts from seeded sample data. They narrow the observations to a period with season buttons or from and to sliders, and to chosen habitats and species with checklists. The map, the per-species totals chart, the observation table and a running summary of observations and individuals all redraw to the current filters, and clicking a bar narrows to that species. Clicking a point on the map or a row in the table selects the same observation in both.",
    "task": {
      "text": "Look over where, when and in which habitat each species was counted on a set of transects, and total the counts per species for any chosen period, habitat and species set.",
      "verbs": [
        "explore",
        "summarize",
        "locate",
        "lookup"
      ]
    },
    "data": {
      "text": "A table of field observations, each with a date, transect, observer, species, count, habitat and x and y coordinates in metres on a local grid, drawn over a fixed study-area outline and transect lines.",
      "item": "one observation: a count of one species at one point on one transect visit",
      "shapes": [
        "table",
        "geospatial"
      ]
    },
    "stage": {
      "text": "exploring survey counts by place, period and habitat after a season of fieldwork, before analysis",
      "terms": [
        "explore"
      ]
    },
    "mechanism": {
      "text": "A filter panel (season presets, date sliders, habitat and species checklists) drives three linked views at once: a map of points coloured by habitat and sized by count, a bar chart of totals per species, and an observation table ordered by date and transect. Clicking a bar narrows the species filter to it, and selecting a point or a row highlights the same observation in the other view.",
      "views": [
        "map",
        "bar chart",
        "table view",
        "summary stats"
      ],
      "interactions": [
        "import",
        "filter",
        "time slider",
        "hover for detail",
        "select"
      ],
      "patterns": [
        "linked views",
        "dashboard",
        "overview and detail"
      ]
    },
    "field": {
      "text": "transect count surveys of species, in field ecology",
      "disciplines": [
        "ecology"
      ],
      "terms": [
        "ecology",
        "transect survey",
        "bird survey"
      ]
    },
    "workflow": {
      "name": "filter located count records by period and category, then map and total them",
      "steps": [
        {
          "step": "bring the data in",
          "here": "\"Load observations CSV\" reads a file that must have date, transect, observer, species, count, habitat, x and y columns, checks every row and reports the first bad one; until then seeded sample observations are shown.",
          "parts": [
            "load-header"
          ]
        },
        {
          "step": "narrow to one period of time",
          "here": "Spring, Summer, Autumn and Whole period buttons set the range, or From and To sliders move it a day at a time; the dates are shown under each slider.",
          "parts": [
            "date-range"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Habitat and species checklists, each with its number of observations, plus All and None buttons for species.",
          "parts": [
            "category-checks"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Every matching observation is a circle on the study-area map over the dashed transect lines, coloured by habitat and sized by count, with a size key, scale bar and north arrow; hovering gives species, count, date, transect, habitat and observer.",
          "parts": [
            "survey-map"
          ]
        },
        {
          "step": "total the items by category",
          "here": "A bar chart of individuals counted per species, largest first, and a header line giving observations, individuals and the date range; clicking a bar shows only that species, and \"Show all species\" undoes it.",
          "parts": [
            "species-chart",
            "load-header"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Clicking a map point or a table row selects that observation in both: the point is outlined and drawn on top, the row is highlighted, and the table scrolls to it.",
          "parts": [
            "observation-table",
            "survey-map"
          ]
        }
      ],
      "distinctive": [
        "Points sit on a local metre grid inside a drawn study-area boundary with the transect lines labelled, a 500 m scale bar and a north arrow.",
        "Circle area grows with the square root of the count, so flocks and single birds can share the map, with big counts drawn first so small ones stay clickable.",
        "Season presets sit beside free from and to date sliders, and the matching season button lights up when the range equals it.",
        "Totals are counts of individuals, not of observations, so the chart and the header report both."
      ]
    }
  },
