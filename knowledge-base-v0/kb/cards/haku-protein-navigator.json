  "app": {
    "title": "Haku - protein structure navigator",
    "summary": "A person starts from a protein accession or a list of structure codes and fetches what the public protein and structure databases hold about it. They get every structure of the protein with its papers, flagged where the databases disagree. Then they open the structures to see which proteins, chains and ligands each contains, filter the residues each ligand contacts, and look at a selected protein highlighted in 3D. They can align a structure chain to the reference sequence, edit transmembrane ranges and see them coloured on the structure. What they take away is binding-site tables, sequence-mapping records and PyMOL commands for their own structural work.",
    "task": {
      "text": "Gather and cross-check everything the public databases hold on a protein's experimental structures, so the person can choose and prepare structures for their own structural work.",
      "verbs": [
        "lookup",
        "explore",
        "identify",
        "compare",
        "derive",
        "annotate"
      ]
    },
    "data": {
      "text": "Records fetched by accession from protein, structure and literature databases: lists of structures and papers, chain-to-protein mappings, ligand contact residues, residue sequences, annotated residue ranges and 3D coordinate files.",
      "item": "an experimental structure entry of a protein, with its chains, the proteins they map to and its bound ligands",
      "shapes": [
        "table",
        "sequence",
        "spans",
        "molecular structure"
      ]
    },
    "stage": {
      "text": "surveying and checking a protein's known structures before structural analysis or modelling",
      "terms": [
        "explore"
      ]
    },
    "mechanism": {
      "text": "Each page is its own tool. An accession or structure codes typed into a sidebar query are fetched into tables, sequence blocks and 3D views. Selection boxes narrow the results to one ligand, structure or protein, and every page ends in copyable commands or a downloadable file.",
      "views": [
        "table view",
        "summary stats",
        "side-by-side panes",
        "3d structure viewer",
        "sequence alignment",
        "form"
      ],
      "interactions": [
        "search",
        "select",
        "multi-select",
        "filter",
        "toggle view",
        "zoom and pan",
        "inline edit",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "master-detail",
        "focus and context",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "protein structure retrieval and cross-referencing in structural biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "structural biology",
        "structural bioinformatics",
        "transmembrane topology"
      ]
    },
    "workflow": {
      "name": "gather everything known about one item from linked reference databases",
      "steps": [
        {
          "step": "bring the data in",
          "here": "each page has a sidebar 'New query' box: a protein accession, or one or more structure codes separated by commas or spaces, followed by Fetch data / Analyse structure / Process structures",
          "parts": [
            "find-structures",
            "structure-proteins",
            "binding-sites"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "a table of every structure of the protein with its papers, rows highlighted where the structure is not yet in the protein database, and a paper table that marks curated papers",
          "parts": [
            "find-structures"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "a per-entity table of chains, mapped protein, ligands, resolution and method for each structure, with a warning when a chain maps to more than one protein. Picking a structure and a protein shows that protein in purple in a 3D viewer, with the other chains shown or hidden",
          "parts": [
            "structure-proteins",
            "structure-3d-viewer"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "choose a ligand to list the residues it contacts across all the structures, filter further by structure and protein, and open a 2D view of the ligand's environment",
          "parts": [
            "binding-sites"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "local pairwise alignment of one structure chain to the reference sequence, reporting identity, coverage, overlap, gap frequency and score above a block that marks matching residues",
          "parts": [
            "sequence-alignment"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "the reference transmembrane ranges are coloured on the structure as membrane, inside and outside. The person edits the range lines in a form and sees the change on a second copy of the structure",
          "parts": [
            "tm-annotation-editor"
          ]
        },
        {
          "step": "export the result",
          "here": "download the binding-site table as CSV and the merged sequence mappings as dbref.txt, and copy PyMOL commands that fetch, colour and label each protein",
          "parts": [
            "binding-sites",
            "sifts-dbref",
            "structure-proteins"
          ]
        }
      ],
      "distinctive": [
        "structures already released but not yet listed in the protein database are flagged, as are papers the protein database has curated",
        "a chain that maps to more than one protein accession is warned about as a chimera",
        "copies of a ligand are numbered by grouping the ligand positions they share across structures",
        "adjacent residue ranges for the same chain and protein are merged into a single DBREF record, and duplicate records are reported",
        "every view hands off to desktop molecular graphics as ready-made PyMOL commands"
      ]
    }
  },
