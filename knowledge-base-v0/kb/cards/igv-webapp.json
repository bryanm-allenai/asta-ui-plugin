  "app": {
    "title": "IGV-Web (igv-webapp)",
    "summary": "A person picks a reference genome, then loads data tracks and a sample-information table onto it from local files, cloud storage, URLs or curated track lists. They move to a region by typing a locus or zooming with keys and the scroll wheel, can search for where a pasted sequence matches the reference, and can open a circular view to see links between distant regions. They leave with a saved or shared session that restores the same view, or with an SVG or PNG image of it.",
    "task": {
      "text": "Lay many kinds of genomic data side by side along a reference genome so a region can be found, inspected and saved or shared as a view.",
      "verbs": [
        "explore",
        "locate",
        "compare",
        "lookup"
      ]
    },
    "data": {
      "text": "Data files positioned on a reference genome: sequence, gene annotations, aligned reads, variants and signal tracks, plus a table of per-sample attributes and saved session files.",
      "item": "a data track positioned along the chromosomes of a reference genome",
      "shapes": [
        "sequence",
        "spans",
        "table"
      ]
    },
    "stage": {
      "text": "inspecting processed sequencing data and annotations region by region, after alignment and calling, before reporting",
      "terms": [
        "explore",
        "confirm"
      ]
    },
    "mechanism": {
      "text": "A menu bar loads the genome, tracks, sample info and sessions into one browser panel where tracks stack under a shared genomic coordinate axis that is searched, zoomed and panned together; an optional draggable circular view draws links between regions, and the current state is exported as a session file, a shareable URL or an image.",
      "views": [
        "sequence track",
        "form"
      ],
      "interactions": [
        "import",
        "search",
        "zoom and pan",
        "keyboard shortcuts",
        "toggle view",
        "export"
      ],
      "patterns": [
        "linked views"
      ]
    },
    "field": {
      "text": "genome browsing of sequencing data tracks in genomics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "genomics",
        "genome browser"
      ]
    },
    "workflow": {
      "name": "stack data layers on a shared coordinate axis, inspect a region and save the view",
      "steps": [
        {
          "step": "choose the reference the data will be placed on",
          "here": "the Genome menu picks a hosted genome, a recent one, a UCSC GenArk assembly, or one loaded from a local file, Dropbox, Google Drive or URL; the Tracks menu is rebuilt for that genome",
          "parts": [
            "genome-menu"
          ]
        },
        {
          "step": "bring the data in",
          "here": "the Tracks menu loads track files from disk, cloud or URL, or picks from registry, track-hub and ENCODE lists; Sample Info loads a table of per-sample attributes; Session loads a saved session",
          "parts": [
            "track-menu",
            "session-share"
          ]
        },
        {
          "step": "move to the region of interest",
          "here": "the browser panel jumps to a typed locus, zooms with + / - keys or shift-scroll, and pans along the shared axis",
          "parts": [
            "browser-panel"
          ]
        },
        {
          "step": "find where a query matches the reference",
          "here": "Tools > BLAT takes a pasted sequence of 20 to 8000 bases and shows where it aligns",
          "parts": [
            "blat-tool"
          ]
        },
        {
          "step": "look at links between distant regions",
          "here": "the Circular View is shown or hidden, resized and cleared of chords from its menu, and dragged around the page",
          "parts": [
            "circular-view"
          ]
        },
        {
          "step": "export the result",
          "here": "Session > Save writes a session file; Share gives a long or shortened session URL, an iframe snippet or a QR code; Save Image writes the view as SVG or PNG",
          "parts": [
            "session-share",
            "save-image"
          ]
        }
      ],
      "distinctive": [
        "every layer is positioned on one reference coordinate system, so the reference must be chosen before tracks can be loaded and the track lists change with it",
        "the whole view state compresses into a URL, so a region and its tracks can be shared without a server",
        "a pasted query sequence is aligned against the reference to locate it (BLAT, 20 to 8000 bases)",
        "a circular view of the whole genome shows links between distant regions alongside the linear tracks"
      ]
    }
  },
