  "app": {
    "title": "Cutout Image List Tool for DESI Legacy Imaging Surveys and More",
    "summary": "A person pastes a table of sky coordinates, picks a survey image layer and a cutout size, and gets a grid with one image cutout per row. Pointing at a cutout shows that row's values, and clicking one opens it in the full sky viewer. With marking turned on, clicking a cutout marks or unmarks it. Record marks then writes the table back into the paste box with a true/false marked column, ready to copy out or paste in again later.",
    "task": {
      "text": "Look at a sky image of every object in a coordinate list and mark the ones that pass inspection, so the selection can be written back to the table.",
      "verbs": [
        "identify",
        "triage",
        "explore"
      ]
    },
    "data": {
      "text": "A table of objects with sky coordinates and other columns, shown as image cutouts fetched from sky survey services, plus a yes/no mark on each object",
      "item": "one catalog row (an object at a right ascension and declination) shown as one image cutout",
      "shapes": [
        "table",
        "image collection",
        "judgements"
      ]
    },
    "stage": {
      "text": "visually inspecting catalog candidates during target selection, before follow-up",
      "terms": [
        "review"
      ]
    },
    "mechanism": {
      "text": "The pasted table is parsed into a grid of cutouts, and the layer and size controls swap the images in place. With marking on, clicks toggle a flag on each tile, and Record marks writes the flags back into the same text box as a new column. Pasting that table again brings the marks back.",
      "views": [
        "form",
        "thumbnail grid"
      ],
      "interactions": [
        "import",
        "toggle view",
        "hover for detail",
        "multi-select"
      ],
      "patterns": [
        "round trip table"
      ]
    },
    "field": {
      "text": "visual inspection of imaging-survey cutouts for target selection in astronomy",
      "disciplines": [
        "astronomy"
      ],
      "terms": [
        "target selection",
        "imaging surveys",
        "visual inspection"
      ]
    },
    "workflow": {
      "name": "mark items by eye in an image grid and write the marks back to the table",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Paste a space-, tab- or comma-separated table into the text box. The RA and Dec columns are found by header name (many aliases) or by position, and an optional last 'marked' column brings back earlier marks. The table can also come in through a URL parameter.",
          "parts": [
            "input-form"
          ]
        },
        {
          "step": "choose how each item is shown",
          "here": "A dropdown picks the image source: Legacy Surveys image, model or residual layers, unWISE, SDSS, DES, HSC, GALEX, dust maps, VLASS or DSS. A number field sets the cutout side length in arcminutes. Changing either one swaps the images in place and keeps the marks.",
          "parts": [
            "source-controls"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "One 180-pixel cutout per row in a responsive grid. Images load lazily and failed loads are retried. Pointing at a cutout shows all of its row's values, and clicking opens that position in the survey's full sky viewer.",
          "parts": [
            "cutout-grid"
          ]
        },
        {
          "step": "mark the items that pass inspection",
          "here": "Ticking 'Enable marking' makes a click toggle a blue border on a cutout, while Ctrl-click still opens the sky viewer. The text box is locked while marking is on.",
          "parts": [
            "marking"
          ]
        },
        {
          "step": "export the result",
          "here": "'Record marks' rewrites the text box as the original table plus a marked column of true/false. The page warns before closing if some marks have not been recorded.",
          "parts": [
            "record-marks"
          ]
        }
      ],
      "distinctive": [
        "Images are not uploaded: each cutout is fetched live from a sky survey cutout service, using the row's coordinates and an angular size in arcminutes",
        "The same objects can be checked in image, model and residual layers, or in other surveys, without losing marks, because switching layers only rewrites the image URLs",
        "The output is the input table with one added true/false column, so the marks go back to the catalog and can be loaded again later",
        "A URL option rotates and flips each cutout at random, so the inspection is less biased by orientation"
      ]
    }
  },
