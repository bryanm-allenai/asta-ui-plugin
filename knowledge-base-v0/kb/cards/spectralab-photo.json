  "app": {
    "title": "SpectraLab: spectrometer photo analysis",
    "summary": "The person loads a photo of a spectrum by file, camera, drag, paste or a synthetic demo. The tool takes a brightness profile along one chosen row and finds the line peaks, which are re-detected as the person moves the row, band width and detection sliders. They then turn pixel positions into wavelengths, either automatically against a chosen reference lamp, optionally with a quadratic correction, or from two points they type in. They check the fit quality, the residual plot and the ranked element matches. They can also compute a grating constant with its uncertainty from angle readings. Finally they export the line list as CSV or JSON, or produce a report image to save or print.",
    "task": {
      "text": "Turn a photographed emission spectrum into a calibrated, checkable line list with element identification and a grating constant for a lab report.",
      "verbs": [
        "derive",
        "identify",
        "explore",
        "write"
      ]
    },
    "data": {
      "text": "A single photograph of a dispersed spectrum, reduced to a 1-D brightness profile along one row, with a built-in library of reference emission lines per element.",
      "item": "a spectral line (peak) found along the profile, with pixel position, intensity and calibrated wavelength",
      "shapes": [
        "image",
        "table",
        "categories"
      ]
    },
    "stage": {
      "text": "analysing a spectrum photo from a teaching lab, then writing up the result",
      "terms": [
        "analyze",
        "report"
      ]
    },
    "mechanism": {
      "text": "An image canvas with a draggable profile row sits above a profile chart that shares its x axis. Every parameter change re-runs peak finding, lamp calibration and element matching. A tabbed results panel shows the line table, the fit statistics with a fit chart, ranked element cards and a report generator.",
      "views": [
        "image viewer",
        "line chart",
        "table view",
        "summary stats",
        "scatter plot",
        "form",
        "list"
      ],
      "interactions": [
        "import",
        "zoom and pan",
        "hover for detail",
        "toggle view",
        "select",
        "export"
      ],
      "patterns": [
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "emission spectroscopy with wavelength calibration in an undergraduate physics lab",
      "disciplines": [
        "physics"
      ],
      "terms": [
        "spectroscopy",
        "wavelength calibration",
        "diffraction grating"
      ]
    },
    "workflow": {
      "name": "compute calibrated measurements from one image and write them up",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Choose a file, take a phone photo, drag or paste an image, or load a synthetic demo spectrum with known lines",
          "parts": [
            "image-intake"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Peaks are found along a brightness profile taken from a row the person drags on the image. Sliders for sensitivity, minimum spacing, smoothing and band width re-run detection live",
          "parts": [
            "detection-params",
            "spectrum-stage"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Map pixels to wavelengths: auto-calibrate against a Hg, Na, H or He lamp (optionally quadratic), or enter two pixel and wavelength pairs by hand",
          "parts": [
            "calibration-controls"
          ]
        },
        {
          "step": "check the result against references",
          "here": "Read the dispersion, intercept, R² and RMS with a fit chart. Then read the elements ranked by matched lines, with chips marking which library lines were hit",
          "parts": [
            "results-tabs"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Enter the order, left and right vernier angles and a wavelength to get d = kλ/sinθ with propagated uncertainty",
          "parts": [
            "grating-calc"
          ]
        },
        {
          "step": "export the result",
          "here": "Export the line table as CSV or the full analysis as JSON, or generate a PNG report with image, line table, calibration and grating result, then save or print it",
          "parts": [
            "results-tabs",
            "report"
          ]
        }
      ],
      "distinctive": [
        "The brightness profile comes from a user-chosen image row and band width, dragged directly on the photo",
        "Peak markers and table swatches are coloured by their calibrated wavelength",
        "Calibration matches detected peaks to a reference lamp's known lines and reports R² and RMS, so the fit can be checked",
        "An element is only named when at least three of its library lines match",
        "A grating-equation calculator propagates the angle uncertainty into the grating constant"
      ]
    }
  },
