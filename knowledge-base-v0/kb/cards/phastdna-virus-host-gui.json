  "app": {
    "title": "phastDNA 1.2.0 (web GUI)",
    "summary": "A person picks Predict or Train. To predict, they enter an output folder, a trained classifier and a folder of viral genomes, set the number of host hits and threads, and press Run. To train, they point at host and virus genome folders with taxonomy metadata, and give a lower and upper bound for each model setting (word-vector size, k-mer sizes, read length, samples, learning rate, epochs, noise), plus one or more loss functions, the number of optimisation iterations and the taxonomic filter and label level. They can check the whole setup in a preview panel before starting. A run page then follows the job through its named pipeline stages, counts optimisation iterations, scores each iteration and marks the best one, and shows the raw log, the full command to copy and the path of the predictions file.",
    "task": {
      "text": "Configure and launch training or prediction runs of a k-mer embedding classifier that predicts each virus's host, then follow the runs and compare how each hyperparameter-search iteration scores.",
      "verbs": [
        "derive",
        "monitor",
        "compare",
        "identify"
      ]
    },
    "data": {
      "text": "Folders of genome sequence files for viruses and candidate hosts, with taxonomic lineage metadata per genome. Training also produces a per-iteration log of chosen hyperparameters and evaluation scores at taxonomic ranks.",
      "item": "a virus genome whose host taxon is predicted, or one iteration of a hyperparameter search",
      "shapes": [
        "sequence",
        "hierarchy",
        "events",
        "table"
      ]
    },
    "stage": {
      "text": "analyzing genome collections by training and running a classifier, after the sequences and taxonomy are gathered",
      "terms": [
        "analyze"
      ]
    },
    "mechanism": {
      "text": "Tabbed accordion forms collect paths and parameter bounds, which are checked live and summarised in an off-canvas preview. Submitting opens a run page that polls the server log every few seconds and updates a step-progress bar, an iteration counter, a console view and an expanding list of iteration records with score badges.",
      "views": [
        "form",
        "list",
        "detail panel",
        "summary stats"
      ],
      "interactions": [
        "toggle view",
        "select",
        "import",
        "export"
      ],
      "patterns": [
        "status pipeline",
        "overview and detail"
      ]
    },
    "field": {
      "text": "machine-learning host prediction from k-mer embeddings of genomes, in bioinformatics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "bioinformatics",
        "virus host prediction",
        "sequence classification"
      ]
    },
    "workflow": {
      "name": "configure a model run with parameter ranges, launch it and follow its search iterations",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Text fields with path validation for the output folder, the classifier or host/virus genome folders, and the fastDNA executable. Each field has an info toggle that explains it.",
          "parts": [
            "predict-form",
            "train-form"
          ]
        },
        {
          "step": "set each parameter as a fixed value or a range to search",
          "here": "Lower and upper bound inputs for each hyperparameter, with sliders for k-mer sizes and threads. When the bounds differ, an 'optimise' icon appears, and an upper bound below the lower one is raised to match. Several loss functions can be picked in a multi-select.",
          "parts": [
            "train-form",
            "bound-validation"
          ]
        },
        {
          "step": "check the whole setup before running",
          "here": "'Parameters preview' opens a 'Current setup' panel listing every filled field, with ranges shown as low–high. Run raises toasts naming each accordion section that has invalid fields.",
          "parts": [
            "params-preview"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "The run page polls the log and moves a seven-step progress bar (reading metadata → sampling genomes → labelling → sampling virus sequences → fastDNA-supervised → fastDNA-predict → scoring), with hover popovers showing progress inside a step and an iteration counter out of the total.",
          "parts": [
            "run-monitor",
            "run-server"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Each optimisation iteration gets a record with its accordance score as a badge, and the highest score so far is marked. Opening a record shows the chosen hyperparameters, top/top-3 accuracy at each taxonomic rank, and elapsed time.",
          "parts": [
            "iteration-records"
          ]
        },
        {
          "step": "export the result",
          "here": "Run details show the search space and the full command, with a copy-to-clipboard button. Prediction runs show the path of the predictions.csv they write, and the raw console log stays readable.",
          "parts": [
            "run-details",
            "run-monitor"
          ]
        }
      ],
      "distinctive": [
        "Every training hyperparameter is entered as a lower/upper bound, so the same form either fixes a value or defines the space for Bayesian optimisation.",
        "Accuracy is reported at each taxonomic rank (species up to phylum) as top-1 and top-3, along with a single accordance score used to rank iterations.",
        "Taxonomic data and label filters choose which rank genomes are grouped by and which rank the classifier predicts.",
        "The GUI only wraps a command-line pipeline: it launches it as a subprocess and parses its log lines for events, progress, hyperparameters and evaluations."
      ]
    }
  },
