  "app": {
    "title": "LasReader: infer analyte concentration from a biosensor's standard curve",
    "summary": "A person pastes a plate reader's 8 × 12 export, marks wells as standards, samples or medium blanks on a plate map, and fills an editable table of replicates. If needed, they switch to fluorescence divided by OD600. They then look at the standards' readings, exclude bad ones with a written reason, and fit a weighted four-parameter logistic curve, which gives EC50, Hill slope, LOD and RMSE. The page averages each sample's replicates, inverts the mean through the curve and scales it by the dilution. The result is a concentration with a 95% confidence interval, or only a bound when the value is out of range. Everything is exported as a CSV of every reading and result plus a PNG of the curve, which a companion page can read back to compare against a second instrument.",
    "task": {
      "text": "Turn raw biosensor readings into each sample's inferred concentration with a confidence interval, using standards read on the same plate.",
      "verbs": [
        "derive",
        "clean",
        "annotate",
        "compare"
      ]
    },
    "data": {
      "text": "Plate-reader readings from one plate: replicate wells of standards at known concentrations, blanks and unknown samples, optionally paired with optical-density readings.",
      "item": "a well on a 96-well plate, grouped with its replicates into a standard concentration or a named sample",
      "shapes": [
        "table",
        "per element",
        "notes"
      ]
    },
    "stage": {
      "text": "quantifying samples against in-plate standards, straight from the reader's export",
      "terms": [
        "analyze",
        "clean"
      ]
    },
    "mechanism": {
      "text": "Four step cards open in order, and each says what it is still waiting for. A clickable 96-well plate map builds the replicate table, and the table drives a standards table with per-reading exclusions. Fitting draws the curve with error bars and fills summary tiles. A results table then inverts every sample through the fit, and the export buttons save the readings and the curve.",
      "views": [
        "fixed-layout grid",
        "table view",
        "scatter plot",
        "summary stats",
        "form"
      ],
      "interactions": [
        "import",
        "multi-select",
        "apply label",
        "inline edit",
        "exclude and refit",
        "toggle view",
        "export"
      ],
      "patterns": [
        "status pipeline",
        "category palette"
      ]
    },
    "field": {
      "text": "biosensor calibration with a 4PL standard curve in synthetic biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "synthetic biology",
        "standard curve",
        "igem"
      ]
    },
    "workflow": {
      "name": "estimate unknowns' concentrations from a standard curve",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Paste the reader's 8 × 12 fluorescence block (and an OD600 block in F ÷ OD mode), with or without row and column headers, or type or paste rows from a spreadsheet straight into the table.",
          "parts": [
            "data-entry",
            "plate-map"
          ]
        },
        {
          "step": "label each item's role in the layout",
          "here": "Select wells by click, Shift-click range or row/column header, mark them Standard (nM), Sample (name, dilution) or Medium blank, then 'Fill the table'. Wells marked alike become replicates.",
          "parts": [
            "plate-map",
            "replicate-table"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "In the standards table, tick any reading to exclude it and type a required reason. Any change discards the current fit.",
          "parts": [
            "fit-step"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Fit fits a weighted 4PL by Levenberg–Marquardt (at least 4 concentrations and 2 blanks) and shows the curve with error bars plus EC50, Hill slope, LOD and RMSE tiles.",
          "parts": [
            "fit-step"
          ]
        },
        {
          "step": "convert each unknown through the fit, with its uncertainty",
          "here": "Each sample's replicates are averaged and inverted once, giving the concentration in the well and × dilution in the sample, with a delta-method 95% CI and CV. Outside the usable range only the bound is shown.",
          "parts": [
            "results-table"
          ]
        },
        {
          "step": "export the result",
          "here": "Export CSV gives one row per reading with its well, exclusion reason, curve and sample result. Export curve saves the PNG. Nothing is stored, and the page warns before you leave with unexported data.",
          "parts": [
            "export-step"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "On the Cross-Validation page, the exported CSV and a batch from the team's own reader are paired by sample name. A log-log plot shows both CIs, alongside the geometric mean ratio and Bland–Altman limits of agreement.",
          "parts": [
            "cross-validation"
          ]
        }
      ],
      "distinctive": [
        "The curve never extrapolates: a usable range is cut at the LOD/lowest standard and at the highest standard or 95% of the curve's span, and anything outside reports only a bound.",
        "Replicates are averaged in signal space and converted once, so reading variance shrinks with n but curve uncertainty does not.",
        "An optional fluorescence ÷ OD600 mode adds a medium-blank role and subtracts its mean F and OD from every well before dividing.",
        "Every exclusion needs a written reason, and each step stays locked until the step before is complete, with the reason it is waiting shown.",
        "The same fitting module serves a low-cost custom reader whose curves are bound to an instrument configuration fingerprint, so results from both instruments can be cross-validated."
      ]
    }
  },
