  "app": {
    "title": "Scheduling-policy benchmark results explorer",
    "summary": "A person reads through a report-like page section by section, with a table of contents beside it. Each result section has a chart over real experiment runs, where the person picks a condition and a metric and compares the competing designs. They hover for single runs, open the numbers behind each chart, and check its provenance: the source files with their checksums and the command that produced them. A separate live mode shows a running system's health over time and lets the person inject faults to watch how it recovers.",
    "task": {
      "text": "Compare how competing scheduling designs perform across workloads and loads, using benchmark results that can each be traced back to the raw files and command that produced them.",
      "verbs": [
        "compare",
        "explore",
        "summarize",
        "monitor"
      ]
    },
    "data": {
      "text": "Tables of benchmark runs exported from raw CSV results. Each row is one repeated experiment under one design and condition, with latency percentiles, throughput, deadline misses, fairness and outage measures. The live mode adds polled telemetry and a timestamped event and dispatch log.",
      "item": "one experiment run: one design under one workload and offered load, for one repetition",
      "shapes": [
        "table",
        "time series",
        "events"
      ]
    },
    "stage": {
      "text": "reporting and comparing benchmark results after the experiment matrix has run",
      "terms": [
        "report",
        "compare"
      ]
    },
    "mechanism": {
      "text": "A long page of result sections sits beside a table of contents that follows the scroll. In each section, segmented buttons choose the condition and the metric, and the chart, its caption and its numbers table all redraw together. Every figure carries a collapsible provenance block naming the source files, their checksums and the producing command.",
      "views": [
        "sidebar list",
        "strip plot",
        "line chart",
        "bar chart",
        "table view",
        "summary stats"
      ],
      "interactions": [
        "toggle view",
        "filter",
        "hover for detail"
      ],
      "patterns": [
        "overview and detail",
        "side-by-side comparison",
        "dashboard"
      ]
    },
    "field": {
      "text": "benchmarking scheduling policies in distributed systems",
      "disciplines": [
        "computer science"
      ],
      "terms": [
        "distributed systems",
        "scheduling",
        "benchmarking"
      ]
    },
    "workflow": {
      "name": "compare designs across conditions from repeated experiment runs",
      "steps": [
        {
          "step": "bring the data in",
          "here": "An export script turns the raw result CSVs into one JSON dataset per section, with file checksums and the producing command. It refuses to export unless every number the report quotes recomputes from the raw files.",
          "parts": [
            "site-data-export"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "A table of contents lists the sections, grouped as Scheduling, Failure and Validity. It highlights the section being read as the page scrolls.",
          "parts": [
            "section-nav"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Segmented buttons pick one workload and one metric (miss rate, p50, p99, max wait, throughput, utilisation, Jain index). Only values present in the data are offered.",
          "parts": [
            "matrix-explorer",
            "load-sweep-explorer"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Policies are set against each other in two ways. In the matrix, each repetition is a dot on a strip per policy, with a tick at the mean. In the load sweep, mean lines run across offered load, with a bar chart of the worst-versus-best spread at each load.",
          "parts": [
            "matrix-explorer",
            "load-sweep-explorer"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Hovering a dot shows that repetition's value and its run id. A collapsible table lists the mean, standard deviation and n per policy.",
          "parts": [
            "matrix-explorer",
            "figure-provenance"
          ]
        },
        {
          "step": "keep a record of changes",
          "here": "Each figure's provenance block lists its source files, row counts, sha256 digests, the producing command and any caveats.",
          "parts": [
            "figure-provenance"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "Live mode polls a running cluster for KPIs, leadership, history charts, a dispatch log and dead letters. It flags data that is stale, and a token-gated panel can kill, freeze or partition the leader.",
          "parts": [
            "live-console"
          ]
        }
      ],
      "distinctive": [
        "Every chart names the exact source files with checksums and the command that made them, so any number can be checked.",
        "The export refuses to run unless every figure quoted in the written report recomputes from the raw CSVs.",
        "Conditions that are not load-matched carry a warning flag on their selector button and a caveat note.",
        "Offered load is expressed as a multiple of each workload's own capacity, so designs are compared at equal load, with a spread-across-designs bar at each load.",
        "A live mode beside the static results can inject real faults into a demo cluster to watch failover as it happens."
      ]
    }
  },
