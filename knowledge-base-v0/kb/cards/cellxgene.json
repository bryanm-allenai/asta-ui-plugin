  "app": {
    "title": "cellxgene (CELL×GENE | Annotate) v1.3.0",
    "summary": "A person launches the explorer on a processed single-cell dataset and sees every cell as a point on a chosen embedding, coloured by a metadata category or by a gene's expression. They narrow the cells by ticking category labels, brushing histograms of continuous metadata and genes, or brushing and lassoing on the embedding, and can subset the view to the selection. They create their own categories and labels and assign the selected cells to a label, and they can store two selections as cell sets and compute the genes most differentially expressed between them, which arrive as two new gene sets. The labels and gene sets they make are saved automatically to a named folder of user data.",
    "task": {
      "text": "Explore a single-cell dataset on its embedding, select groups of cells by metadata, expression or position, label them with one's own categories, and find the genes that set two groups apart.",
      "verbs": [
        "explore",
        "annotate",
        "identify",
        "compare",
        "summarize"
      ]
    },
    "data": {
      "text": "A cell-by-gene expression matrix with per-cell metadata (categorical and continuous), one or more 2D embeddings, and optional gene sets, loaded from an AnnData (.h5ad) file.",
      "item": "a single cell, with its position in each embedding, its metadata values and its gene expression",
      "shapes": [
        "table",
        "categories"
      ]
    },
    "stage": {
      "text": "annotating cells by type in a processed single-cell dataset, after clustering and embedding",
      "terms": [
        "annotate",
        "explore"
      ]
    },
    "mechanism": {
      "text": "An embedding scatter plot, category lists with counts and histograms of continuous values and genes all share one crossfilter: ticking labels, brushing a histogram or lassoing points narrows the same selection everywhere, and that selection is what gets labelled, subset or stored as a cell set for differential expression.",
      "views": [
        "scatter plot",
        "bar chart",
        "sidebar list",
        "summary stats"
      ],
      "interactions": [
        "brush",
        "select",
        "multi-select",
        "filter",
        "search",
        "zoom and pan",
        "apply label",
        "inline edit",
        "undo",
        "toggle view",
        "hover for detail"
      ],
      "patterns": [
        "linked views",
        "category palette",
        "overview and detail"
      ]
    },
    "field": {
      "text": "cell type annotation and differential expression in single-cell transcriptomics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "single cell transcriptomics",
        "cell type annotation",
        "differential expression"
      ]
    },
    "workflow": {
      "name": "select groups of items on a map, label them, and find what sets two groups apart",
      "steps": [
        {
          "step": "look over every item at a glance",
          "here": "every cell is a WebGL point on an embedding picked from the layout menu (with cell counts per embedding), coloured by a category or a gene; centroid labels can be drawn for the coloured category",
          "parts": [
            "embedding-graph",
            "view-tools"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "tick or untick category labels, brush histograms of continuous metadata, genes or gene-set means, and brush or lasso on the embedding; all combine in one crossfilter, and Subset narrows the whole view to the selected cells (with undo, redo and percentile clipping)",
          "parts": [
            "category-panel",
            "metric-histograms",
            "embedding-graph",
            "view-tools"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "create a new category (blank or duplicated from an existing one), add labels to it, and re-label the currently selected cells as a label; labels can be renamed or deleted, sending their cells back to 'unassigned'",
          "parts": [
            "label-editor",
            "category-panel"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "store the current selection as cell set 1 and cell set 2, then compute the top differentially expressed genes; the up- and down-regulated genes arrive as two dated gene sets",
          "parts": [
            "diffexp-buttons",
            "gene-panel"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "search a gene or build gene sets, then colour cells by a gene, see its expression histogram, or plot two genes against each other in a scatterplot",
          "parts": [
            "gene-panel",
            "metric-histograms"
          ]
        },
        {
          "step": "export the result",
          "here": "user categories and gene sets are autosaved to a named user-data directory on the server, with a status message showing whether changes are saved",
          "parts": [
            "autosave"
          ]
        }
      ],
      "distinctive": [
        "the same crossfilter selection, built from labels, histograms and a lasso on the embedding, is what gets labelled, subset or stored as a comparison group",
        "the label scheme is the person's own and grows as they go: categories can be created, duplicated from existing metadata, and their labels added, renamed or deleted",
        "differential expression between two stored cell sets is capped at a maximum cell count, and its result becomes editable gene sets",
        "continuous values can be clipped to a percentile range before colouring and histograms",
        "built to stay interactive with a million or more cells, through WebGL drawing and lazily loaded columns"
      ]
    }
  },
