  "app": {
    "title": "Screenr – Systematic Review Screening Platform",
    "summary": "A person imports a library of bibliographic records and narrows the list with a field-aware search and status filters. They open each record to read its title, authors and abstract with key terms highlighted, alongside a check of the record against configured inclusion rules, and mark it include, exclude, maybe or duplicate. The decision records a reason, and the next record opens. Two screeners work under separate roles, and an adjudicator settles the records where they disagree. Included studies then get structured data extraction and a risk-of-bias assessment, and the person exports the screening decisions with progress and conflict counts.",
    "task": {
      "text": "Screen a library of study records for inclusion in a systematic review, using two independent screeners and adjudication, then extract data from the included studies and assess their risk of bias.",
      "verbs": [
        "triage",
        "reconcile",
        "review",
        "record",
        "summarize"
      ]
    },
    "data": {
      "text": "A library of bibliographic records (title, authors, journal, year, abstract, identifiers) imported from reference files. Each screener's decisions and reasons, extraction fields and risk-of-bias judgements are stored per record.",
      "item": "a bibliographic record of one study (title and abstract)",
      "shapes": [
        "text corpus",
        "table",
        "judgements",
        "categories",
        "events"
      ]
    },
    "stage": {
      "text": "screening search results for inclusion in an evidence synthesis, before data extraction and pooling",
      "terms": [
        "decide",
        "review",
        "annotate"
      ]
    },
    "mechanism": {
      "text": "A filterable record list drives a central detail view with a decision bar. Keyboard keys decide each record and move on to the next. A tabbed side panel shows the selected record's rule matches, extraction form and risk-of-bias questions, and a screener selector sets whose decisions are recorded.",
      "views": [
        "sidebar list",
        "detail panel",
        "form",
        "summary stats"
      ],
      "interactions": [
        "import",
        "search",
        "filter",
        "select",
        "accept or reject",
        "keyboard shortcuts",
        "score",
        "toggle view",
        "export"
      ],
      "patterns": [
        "master-detail",
        "review queue",
        "rubric",
        "agreement summary"
      ]
    },
    "field": {
      "text": "title-abstract screening for systematic reviews and meta-analysis in evidence-based medicine",
      "disciplines": [
        "medicine"
      ],
      "terms": [
        "systematic review",
        "evidence synthesis",
        "risk of bias"
      ]
    },
    "workflow": {
      "name": "screen a collection for inclusion with two reviewers and adjudication",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Import a reference library from RIS, BibTeX, PubMed, EndNote XML or CSV through a hidden file input.",
          "parts": [
            "records-list"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "A search box with title:/author: field operators and AND/OR/NOT, plus status chips (pending, include, exclude, maybe, conflicts, duplicates, provenance) with counts.",
          "parts": [
            "records-list"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Clicking a record shows its full citation and abstract with terms highlighted, and the side panel checks it level by level against the inclusion rules.",
          "parts": [
            "record-detail",
            "pico-rules"
          ]
        },
        {
          "step": "decide keep or drop for each item, with a reason",
          "here": "I/E/M/D keys or buttons mark include, exclude, maybe or duplicate. The reason defaults to the first failed rule level, an audit entry is logged, and the next record opens; N skips.",
          "parts": [
            "decision-bar"
          ]
        },
        {
          "step": "find where people disagree and resolve it",
          "here": "Switching the role between Screener 1, Screener 2 and Adjudicator stores decisions separately. Records where the two screeners differ show under a Conflicts filter, and the adjudicator's decision becomes final.",
          "parts": [
            "screener-role",
            "records-list"
          ]
        },
        {
          "step": "score each item against criteria",
          "here": "For included studies, fill a templated extraction form (auto-filled from pasted full text) and answer risk-of-bias signalling questions per domain as low, some concerns or high.",
          "parts": [
            "extraction-form",
            "rob-assessment"
          ]
        },
        {
          "step": "export the result",
          "here": "A progress view counts screened, included, excluded and conflicting records for each screener. Decisions export as CSV or JSON with each screener's call and the reason.",
          "parts": [
            "progress-stats"
          ]
        }
      ],
      "distinctive": [
        "Each record carries separate decisions from two screeners plus a final adjudicator decision, and disagreements become a filterable conflict queue.",
        "Exclusion reasons are filled in automatically from the first inclusion-rule level the record fails.",
        "Duplicate is a decision of its own alongside include, exclude and maybe, as in a reporting flow diagram.",
        "Extraction fields track where in the source each value came from, and records can be filtered by how complete that provenance is."
      ]
    }
  },
