  "app": {
    "title": "iLOSCAR: forward and inverse runs of an ocean-atmosphere-sediment carbon cycle model",
    "summary": "The person picks a model version and edits the parameter values in a series of numbered setup tables. They name an experiment and run it, either forward from an emission scenario they define, or inversely from observed records they point it at, with bounds on the emission rate that the solver searches. A progress bar and run log follow the integration. The results are saved as CSV files in a folder named for the experiment and drawn as stacked time series; inverse runs also show the fitted curve against the target record and the emission history that was inferred. A separate page smooths a record with LOWESS before it is used as a target, and downloads the smoothed, resampled series.",
    "task": {
      "text": "Run a box model of the carbon cycle forward from a set emission scenario, or invert observed records to infer the emission history that would reproduce them.",
      "verbs": [
        "derive",
        "compare",
        "plan"
      ]
    },
    "data": {
      "text": "Model parameters in editable tables, observed records as two-column CSVs of age and value, and simulated time series of many tracers written out per experiment.",
      "item": "one model experiment: a parameter set and a forcing scenario, with the time series it produces",
      "shapes": [
        "table",
        "time series"
      ]
    },
    "stage": {
      "text": "simulating carbon release and inverting proxy records, after the records are compiled",
      "terms": [
        "analyze"
      ]
    },
    "mechanism": {
      "text": "Numbered setup tables whose first column is edited in place feed parameter stores that are merged when Run is pressed; the run reports progress and a log, and its saved output is read back to draw stacked line charts. Inverse runs plot the model's fit on top of the target record and the inferred cumulative emission below it, and a separate smoothing page redraws the LOWESS curve over the raw points as a fraction slider moves.",
      "views": [
        "table view",
        "form",
        "line chart",
        "scatter plot"
      ],
      "interactions": [
        "inline edit",
        "import",
        "toggle view",
        "hover for detail",
        "zoom and pan",
        "export",
        "parameter slider"
      ],
      "patterns": [
        "step by step setup"
      ]
    },
    "field": {
      "text": "forward and inverse box modelling of the ocean-atmosphere-sediment carbon cycle in paleoceanography",
      "disciplines": [
        "earth science"
      ],
      "terms": [
        "carbon cycle modelling",
        "paleoceanography",
        "inverse modelling"
      ]
    },
    "workflow": {
      "name": "configure and run a simulation model, forward or inverted against observations",
      "steps": [
        {
          "step": "set up the model's configuration and parameters",
          "here": "Step 1 and Step 2 tables take a version (paleo or modern, sediment on or off, load initial state, temperature feedback, save final state) and eighteen physical parameters with units; switching to paleo rewrites the defaults, and invalid flags raise a warning",
          "parts": [
            "forward-setup",
            "inverse-setup"
          ]
        },
        {
          "step": "bring the data in",
          "here": "file-path cells name the initial steady-state file and an emission file; on the inverse page a dropdown picks the target (pCO2, surface d13C, surface pH, or one of them paired with d13C) and one or two CSV path boxes appear to match",
          "parts": [
            "forward-setup",
            "inverse-target"
          ]
        },
        {
          "step": "smooth the observed records before using them",
          "here": "a CSV path loads a record as points, a fraction slider redraws its LOWESS curve, and Save results downloads the curve resampled every 200 years",
          "parts": [
            "lowess-smoother"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Run integrates the ODE system with LSODA, or, for an inversion, solves interval by interval for the emission rate between the lower and upper bounds with TOMS 748; a progress bar and run log follow, and Cancel stops an inversion",
          "parts": [
            "run-panel",
            "inverse-setup"
          ]
        },
        {
          "step": "compare the model against the observations",
          "here": "inverse results plot the model curve over the target record, with cumulative emission and, for paired targets, the inferred d13C of the emission below",
          "parts": [
            "inverse-results"
          ]
        },
        {
          "step": "export the result",
          "here": "every tracer is written to CSV in a folder named after the experiment, the inferred emission history is saved with it, and a spin-up can save its final state as the starting file for later runs; forward results are drawn as stacked surface-chemistry and per-basin compensation-depth charts",
          "parts": [
            "run-panel",
            "forward-results"
          ]
        }
      ],
      "distinctive": [
        "A spin-up run with emissions off saves its final state, which later perturbation and inverse runs load as their starting point.",
        "Inversion needs a bracket on the unknown forcing: the person sets a lower and upper emission rate, and a bracket that is too narrow makes the run fail.",
        "Two records can be inverted together to infer both how much carbon was released and its isotopic signature over time.",
        "Results are organised by experiment name, one output folder per run, rather than kept in the interface."
      ]
    }
  },
