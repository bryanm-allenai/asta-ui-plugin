  "app": {
    "title": "EOZ / Decentration Analysis — Pentacam TCDM",
    "summary": "A person loads a screenshot of a corneal tangential curvature difference map. The tool finds the map origin and the pixel-per-millimetre scale on its own, and the person can correct either by hand. Optionally they mark the pupil centre and enter the surgeon's centration offset and the programmed zone diameter, then run the analysis. It traces the zero-dioptre boundary, fits an ellipse to it, and reports the zone's area, axes, shape, retention ratio and two decentration values. Each eye can be added to a series and exported as CSV, or a folder of images can be run as a batch that produces a CSV and an HTML summary report.",
    "task": {
      "text": "Measure the effective optical zone and its decentration from a corneal difference-map image, one eye at a time or in a batch, and export the measurements for a study.",
      "verbs": [
        "derive",
        "summarize",
        "clean"
      ]
    },
    "data": {
      "text": "Screenshots of corneal topography difference maps that include a colour scale bar and a ruler, plus a table of measurements for each eye built from them.",
      "item": "one eye's difference-map image",
      "shapes": [
        "image",
        "image collection",
        "table"
      ]
    },
    "stage": {
      "text": "measuring treatment zones on post-operative maps, before the statistical analysis",
      "terms": [
        "analyze"
      ]
    },
    "mechanism": {
      "text": "A zoomable canvas shows the map with layers that can be turned on and off (vertex, pupil, target, ablation centre, traced contour, fitted ellipse and axes), a loupe for exact clicks, and point and ruler tools. A side panel of numbered steps leads through calibration, marking and analysis settings, then shows a result readout. A series table gathers eyes analysed one by one, and a batch runner with a progress bar handles many images and exports CSV and a report.",
      "views": [
        "image viewer",
        "form",
        "summary stats",
        "table view"
      ],
      "interactions": [
        "import",
        "zoom and pan",
        "select",
        "toggle view",
        "hover for detail",
        "keyboard shortcuts",
        "drag to arrange",
        "export"
      ],
      "patterns": [
        "overview and detail"
      ]
    },
    "field": {
      "text": "image-based measurement of optical zones on corneal topography maps in refractive surgery",
      "disciplines": [
        "medicine"
      ],
      "terms": [
        "ophthalmology",
        "corneal topography",
        "refractive surgery"
      ]
    },
    "workflow": {
      "name": "measure a geometric feature on calibrated images and tabulate it per item",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Drop a map screenshot on the stage or use Open file. Once it loads, Auto-calibrate and Reset become available.",
          "parts": [
            "map-stage",
            "load-calibrate"
          ]
        },
        {
          "step": "calibrate the image to real units and an origin",
          "here": "The tool reads px/mm from the ruler ticks and finds the vertex (the map origin, shown as a black dot). The person can type a px/mm value, or drag or arrow-key the vertex marker if detection is off. A chip shows the calibration status.",
          "parts": [
            "load-calibrate",
            "marking-tools",
            "map-stage"
          ]
        },
        {
          "step": "mark reference points on the image",
          "here": "Mode buttons set what a click on the map places: pupil centre, vertex, a coordinate probe, or a two-point ruler. A loupe magnifies the spot under the cursor.",
          "parts": [
            "marking-tools",
            "map-stage"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "The person enters the Px/Py offset and the POZ diameter, chooses the centre definition (ellipse fit or area centroid) and the boundary method (scale or hue), then presses Analyze. The tool traces the 0.00 D contour and fits an ellipse.",
          "parts": [
            "analysis-settings"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "The result card shows vertex-referenced and target-referenced decentration, area, axes, meridian, retention ratio and flags. Overlay layers draw the contour and axes on the map. The result can be saved as a PNG, and a help dialog explains each formula.",
          "parts": [
            "result-card",
            "map-stage"
          ]
        },
        {
          "step": "process many items in one run",
          "here": "A multi-file input runs up to 500 images, each calibrated on its own. A progress bar shows how far it has got, and Stop keeps the rows finished so far.",
          "parts": [
            "batch-runner"
          ]
        },
        {
          "step": "export the result",
          "here": "Add to series puts the eye in a table that exports as CSV. A batch run exports as CSV or as an HTML summary report that lists the images that failed.",
          "parts": [
            "series-table",
            "batch-runner"
          ]
        }
      ],
      "distinctive": [
        "Two decentrations are reported: one from a fixed anatomical origin, and one from an intended target computed as the marked pupil plus a user-entered offset, with sign-convention toggles.",
        "The boundary is an iso-value contour read through a colour scale bar decoded from the image itself, with a hue-threshold fallback. Measurements that fall back are flagged as degraded.",
        "The direction of the difference map (pre minus post, or post minus pre) can be switched, which reverses which colours mean treated.",
        "Batch mode cannot carry manual marks, so batch output has only the origin-referenced measure, and failed images are listed rather than skipped."
      ]
    }
  },
