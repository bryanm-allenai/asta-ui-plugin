  "app": {
    "title": "hplcsim — Cockpit",
    "summary": "A person enters the instrument and column constants, including a required dwell, and types or loads two scouting runs that differ only in gradient time. They enter each compound's retention time in both runs as one row, optionally with areas and half-height widths. The app fits a two-parameter retention model for each peak and shows the fitted parameters with the composition range each peak was calibrated over. The person then types a candidate gradient programme as a table of time and %B rows and reads the predicted chromatogram, the retention times, the widths, the resolution of each adjacent pair and the critical pair, along with warnings when the prediction leaves the calibrated range. They can save the inputs as a session file and reopen it later.",
    "task": {
      "text": "Predict how a candidate gradient programme will separate a mixture, using a retention model fitted to two scouting runs, so the person can pick a method to run next.",
      "verbs": [
        "derive",
        "plan",
        "decide",
        "compare"
      ]
    },
    "data": {
      "text": "Method constants for one instrument and column, a scouting programme run at two gradient times, a table pairing each compound's measured retention times (with optional areas and widths) across the two runs, and a candidate gradient programme given as time and composition rows.",
      "item": "a compound's peak, measured once in each of two scouting runs",
      "shapes": [
        "table",
        "time series"
      ]
    },
    "stage": {
      "text": "developing a separation method after the scouting runs, before the confirming injection",
      "terms": [
        "plan",
        "analyze"
      ]
    },
    "mechanism": {
      "text": "A sidebar holds the instrument constants and the session file. A left rail holds the scouting and candidate programme tables with a summary of the result beneath them. Tabs hold the peak entry, the fit and the resolution tables, and a pinned chromatogram underneath redraws with every edit, with the programmes overlaid on a %B axis and an axis-range strip below it. Warnings are placed beside the input or output they concern, and stamps mark resolution numbers that are only indicative.",
      "views": [
        "form",
        "table view",
        "line chart",
        "summary stats",
        "detail panel"
      ],
      "interactions": [
        "inline edit",
        "select",
        "hover for detail",
        "zoom and pan",
        "import",
        "export",
        "toggle view"
      ],
      "patterns": [
        "overview and detail",
        "linked views",
        "dashboard"
      ]
    },
    "field": {
      "text": "gradient retention modelling for HPLC method development in analytical chemistry",
      "disciplines": [
        "chemistry"
      ],
      "terms": [
        "analytical chemistry",
        "hplc method development",
        "linear solvent strength"
      ]
    },
    "workflow": {
      "name": "fit a model to calibration runs and predict the outcome of a new condition",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Load a session JSON, or fill in the column, flow, dead time (measured with a marker, or estimated from geometry once the packing is chosen) and the required dwell; nothing is predicted until the dwell is entered",
          "parts": [
            "sidebar",
            "session-file"
          ]
        },
        {
          "step": "enter the calibration conditions and the paired measurements",
          "here": "The scouting table gives the start %B, hold and end %B at two gradient times; the peak table takes one row per compound with tR in both runs, plus optional area and W½. Rows missing a tR are counted as untracked, and area-share or elution-order mismatches are flagged",
          "parts": [
            "programme-rail",
            "peak-table"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Each peak gets a fitted log10 k0, S and plate count, shown on the fit tab with the calibrated composition window per peak and a warning when the two scouting runs are spaced too closely",
          "parts": [
            "results-tabs"
          ]
        },
        {
          "step": "set the new condition to predict",
          "here": "Type the candidate programme as time / %B rows; it follows the scouting table until edited, a new row adds a segment, and Reset returns it to the default ramp; extrapolation and start-composition warnings sit directly beneath it",
          "parts": [
            "programme-rail"
          ]
        },
        {
          "step": "read the predicted outcome and its quality",
          "here": "The pinned chromatogram draws the predicted peaks with the candidate and scouting programmes overlaid and each peak's window as a whisker, and an axis strip crops the view; the rail shows min. Rs, the critical pair, the run time and a selected peak's detail, and the resolution tab lists every pair with an Rs grade",
          "parts": [
            "chromatogram",
            "method-summary",
            "results-tabs",
            "status-bar"
          ]
        },
        {
          "step": "export the result",
          "here": "Save session downloads the inputs only as JSON, and the fit is recomputed when the file is reopened",
          "parts": [
            "session-file"
          ]
        }
      ],
      "distinctive": [
        "Each peak's prediction is judged against the composition window the two calibration runs actually covered; the chromatogram shows this window as a whisker and a table reports the distance in window-widths",
        "Resolution and the critical pair are stamped indicative, not decision-grade, when the candidate is far outside the calibrated range, while retention times are still shown as numbers",
        "The dwell has no default and blocks prediction until entered, and the dead time records where it came from (a measured marker or a geometry estimate) and is stamped on every output when estimated",
        "The candidate is a multi-segment programme typed as a table and drawn on the detector's time base, so each peak's marker sits on the candidate curve",
        "The session file holds inputs only, so a reopened session never carries a stale fit"
      ]
    }
  },
