  "app": {
    "title": "ASReview LAB",
    "summary": "A person creates a project by importing a set of bibliographic records (a file, a URL or a benchmark dataset), optionally searches the set to label a few records they already know are relevant or not, picks the model, and can define tag groups. They then screen records one at a time in the order an active learning model ranks them, marking each relevant or not relevant with optional tags and a note, while the model retrains on their decisions. A dashboard tracks how many records are labelled and how many irrelevant records in a row have been seen against a stopping threshold, and a history view lets them filter and change past decisions. They end by exporting the labelled records as CSV, Excel, RIS or TSV.",
    "task": {
      "text": "Screen a large set of records for relevance with a model that keeps putting the most likely relevant ones first, and decide when enough has been screened to stop.",
      "verbs": [
        "triage",
        "decide",
        "annotate",
        "monitor",
        "summarize"
      ]
    },
    "data": {
      "text": "Bibliographic records from a literature search (title, abstract, authors, keywords, year, DOI), possibly with some labels already set, plus the reviewer's relevance decisions, tags and notes.",
      "item": "a record from a literature search: a paper's title and abstract",
      "shapes": [
        "text corpus",
        "table",
        "judgements",
        "categories",
        "notes",
        "events"
      ]
    },
    "stage": {
      "text": "screening search results for relevance in a systematic review, before full-text reading and extraction",
      "terms": [
        "annotate",
        "decide"
      ]
    },
    "mechanism": {
      "text": "Setup panels bring in the records, seed prior knowledge by search and choose the model; the review screen then shows one record at a time as a card with relevant / not relevant buttons and keyboard shortcuts, the next record chosen by a model retrained after each decision. A separate dashboard of charts and counts shows progress toward a stopping threshold, and a filterable history list lets past decisions be changed and exported.",
      "views": [
        "detail panel",
        "list",
        "form",
        "summary stats",
        "line chart",
        "bar chart"
      ],
      "interactions": [
        "import",
        "search",
        "accept or reject",
        "apply label",
        "write notes",
        "keyboard shortcuts",
        "filter",
        "inline edit",
        "export"
      ],
      "patterns": [
        "review queue",
        "dashboard",
        "category palette"
      ]
    },
    "field": {
      "text": "active-learning title and abstract screening for systematic reviews",
      "disciplines": [
        "medicine"
      ],
      "terms": [
        "systematic review",
        "title abstract screening",
        "active learning"
      ]
    },
    "workflow": {
      "name": "screen a large collection for relevance in a ranked queue, deciding when to stop",
      "steps": [
        {
          "step": "bring the data in",
          "here": "a new project imports a CSV, TSV, Excel or RIS file, a URL/DOI, or a benchmark dataset; labels already in the file become prior knowledge and duplicate titles and texts are grouped and hidden",
          "parts": [
            "project-setup",
            "dataset-import"
          ]
        },
        {
          "step": "seed the ranking with a few known items",
          "here": "search the records by keyword and mark the hits relevant or not relevant without retraining, then choose the classifier, feature extractor and querier",
          "parts": [
            "prior-knowledge-search",
            "project-setup"
          ]
        },
        {
          "step": "set up the labels to attach",
          "here": "optional tag groups (each a set of checkboxes) are defined in setup and can be edited later",
          "parts": [
            "tag-groups"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "the review screen shows the top-ranked unlabelled record; the model retrains after each decision and the next record is fetched",
          "parts": [
            "review-screen"
          ]
        },
        {
          "step": "decide keep or drop for each item, with a reason",
          "here": "Relevant / Not relevant buttons or the r and i keys, with tag checkboxes and a note (n key) attached to the decision",
          "parts": [
            "record-labeler"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "dashboard counts, recall and density charts, and a stopping suggestion that counts consecutive not-relevant records against an editable threshold; reaching it opens a dialog to finish, review more or export",
          "parts": [
            "progress-dashboard",
            "review-screen"
          ]
        },
        {
          "step": "export the result",
          "here": "the collection lists relevant, not relevant or all labelled records, filtered by note or prior knowledge, where decisions can be changed; Export saves chosen groups (relevant, not relevant, not seen) as CSV, Excel, RIS or TSV, optionally with hidden duplicates",
          "parts": [
            "collection-history"
          ]
        }
      ],
      "distinctive": [
        "the order of the queue is set by an active learning model retrained on every decision, so relevant items come early",
        "stopping is judged by a rule: a threshold of consecutive not-relevant records, editable on the dashboard",
        "prior knowledge is seeded by searching the set and labelling hits before screening begins",
        "records with duplicate titles and texts are grouped and hidden during screening, with the option to include them in the export",
        "several reviewers can screen one project, with their names and emails optionally included in the export"
      ]
    }
  },
