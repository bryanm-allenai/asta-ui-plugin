  "app": {
    "title": "Heatwise — Urban Heat Mitigation dashboard",
    "summary": "A person opens a city's grid of surface temperature cells, or drops in a grid they built, and sees it as a continuous thermal surface on a map. They narrow the scope by priority tier or by dragging a box over an area. Then they set a budget and switch types of measure on or off, and the interface fills the budget with eligible cells in a fixed priority order. A divider on the map shows the current and the projected surface side by side, charts show the plan against the current state, and clicking a cell explains why it is or is not funded. The result is a costed, budget-capped plan of where to intervene, which can be exported as a printable report.",
    "task": {
      "text": "Decide which grid cells of a city to fund for cooling measures under a fixed budget, and see what the plan costs and how much cooling it is projected to give.",
      "verbs": [
        "decide",
        "plan",
        "derive",
        "compare",
        "explore"
      ]
    },
    "data": {
      "text": "A regular spatial grid over a study area. Each cell carries a satellite-derived surface temperature, vegetation and built-up indices, a land-cover class, a heat-priority tier, an assigned measure with its estimated cost and assumed cooling, an exclusion reason, and a precomputed funding rank.",
      "item": "a grid cell of roughly 100 m with its temperature, land cover and costed recommended measure",
      "shapes": [
        "geospatial",
        "field",
        "table"
      ]
    },
    "stage": {
      "text": "choosing where to spend a cooling budget after the heat mapping and rule-based recommendations are done, before writing up the plan",
      "terms": [
        "decide"
      ]
    },
    "mechanism": {
      "text": "Every change to the scope (priority tier, a box drawn on the map), the budget or the enabled measures re-runs one greedy fill in the precomputed rank order. The map surfaces, the plan panel, the metrics strip and the charts all read that one shared result. A draggable divider splits the map into the current and the projected surface, and clicking a cell opens an inspector explaining its drivers and its funding status.",
      "views": [
        "map",
        "summary stats",
        "detail panel",
        "bar chart",
        "scatter plot",
        "form"
      ],
      "interactions": [
        "import",
        "filter",
        "brush",
        "select",
        "zoom and pan",
        "search",
        "toggle view",
        "export"
      ],
      "patterns": [
        "dashboard",
        "linked views",
        "overview and detail",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "satellite land-surface-temperature mapping for urban heat mitigation planning",
      "disciplines": [
        "earth science"
      ],
      "terms": [
        "remote sensing",
        "urban planning",
        "land surface temperature"
      ]
    },
    "workflow": {
      "name": "allocate a fixed budget across ranked candidate sites and report the plan",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Pick a prebuilt city from the dropdown, or load or drag in a grid.geojson file, which is read in the browser; a Data menu downloads the city's files",
          "parts": [
            "app-bar"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The grid is drawn as a smoothed thermal surface or as cells, with layers for temperature, interventions, priority and labels, a legend and a key-metrics strip",
          "parts": [
            "map-region",
            "analytics"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "All / High / Medium / Low priority buttons, plus 'Select area' to drag a box on the map that narrows the scope; 'Clear area' resets it",
          "parts": [
            "scope-bar"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "A budget slider and presets (₹10–100 Cr) re-run a greedy fill of eligible cells in the precomputed rank order; checkboxes include or drop each measure type; the panel shows sites funded, cost, committed and unspent, and projected mean cooling",
          "parts": [
            "budget-control",
            "intervention-list",
            "plan-panel"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Dragging a divider across the map shows the current surface on one side and the post-plan surface on the other; charts set the temperature distribution before and after against each other, with vegetation against temperature and cooling per crore",
          "parts": [
            "map-region",
            "analytics"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Clicking a cell opens an inspector with its place name, its temperature drivers, a 'why' text, and its recommended measure marked funded or excluded with the reason",
          "parts": [
            "inspector"
          ]
        },
        {
          "step": "export the result",
          "here": "'Export report' opens a printable plan with the scope, the budget, a table of measures, the projected impact, a snapshot of the map surface, the method and the caveats",
          "parts": [
            "app-bar"
          ]
        }
      ],
      "distinctive": [
        "The funding order is a rank computed upstream (cooling per rupee, then temperature) and carried in the data, so any filtered plan keeps the same relative order; the greedy fill skips cells that do not fit and keeps filling.",
        "Which measure a cell can receive depends on its land cover (water and wetland are never touched, built-up cells get roof measures only), and cells left out carry an explicit reason that the inspector shows.",
        "A swipe divider sets the current surface against the projected one on the same map, and a click inspects the cell on whichever side the person is looking at.",
        "Budget presets frame 'what would more money buy' scenarios, with a committed/unspent bar against the cost of treating every eligible cell.",
        "Cooling figures are labelled as planning assumptions throughout, and rupee figures carry a cost-basis banner for cities where the rates do not apply."
      ]
    }
  },
