  },
  "app": {
    "title": "RTD Reactor Calculator",
    "summary": "A person enters a tube reactor's geometry, flow and fluid properties, then picks a microbiological or a chemical calculation. Microbiological mode predicts a survival ratio from a rate constant and a fluence rate. A measured survival ratio can be added, and the tool works back from it to the rate constant, either for one point or for a pasted batch of points. Chemical mode derives the rate constant from photochemical properties and works back from each measured conversion to the fluence rate. A sweep over fluence rates sets the residence-time-weighted prediction against a naive average-dose prediction, as a table and as a log-scale chart, and the inputs can be saved to a file and reloaded.",
    "task": {
      "text": "Validate a laminar-flow UV reactor by predicting survival under its residence time distribution and back-solving the rate constant or fluence rate from measured survival ratios.",
      "verbs": [
        "derive",
        "compare",
        "decide"
      ]
    },
    "data": {
      "text": "A handful of reactor and kinetic parameters, plus short lists of measured survival or conversion ratios and fluence rates pasted from a spreadsheet.",
      "item": "one measured survival ratio (C/C0) from a bioassay or actinometer run, with its fluence rate",
      "shapes": [
        "table"
      ]
    },
    "stage": {
      "text": "analysing bioassay or actinometry measurements to validate a UV reactor, after the runs",
      "terms": [
        "analyze",
        "confirm"
      ]
    },
    "mechanism": {
      "text": "A form of reactor and kinetic inputs, with a mode switch for microbiological or chemical inputs, recalculates everything live as values are edited. Its results go to a summary panel with regime verdict badges, a batch back-solve table, a sweep table and a log-scale chart of the residence-time-weighted and well-mixed survival curves with fitted exponential trendlines.",
      "views": [
        "form",
        "summary stats",
        "table view",
        "scatter plot",
        "line chart"
      ],
      "interactions": [
        "toggle view",
        "import",
        "export",
        "hover for detail"
      ],
      "patterns": [
        "dashboard",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "residence time distribution modelling of UV disinfection reactors in environmental engineering",
      "disciplines": [
        "engineering"
      ],
      "terms": [
        "uv disinfection",
        "residence time distribution",
        "chemical actinometry"
      ]
    },
    "workflow": {
      "name": "back-solve a model parameter from measurements through a forward model",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Reactor length, radius, flow rate, viscosity, density and diffusivity are typed into a form, or a saved inputs JSON file is loaded. Values are seeded from the legacy spreadsheet's defaults.",
          "parts": [
            "inputs-panel",
            "save-load"
          ]
        },
        {
          "step": "choose which kind of calculation applies",
          "here": "A Calculation type selector swaps between a microbiological fieldset (rate constant k, fluence rate, optional measured C/C0) and a chemical fieldset (wavelength, cross-section, quantum yield, molecular weight). Choosing chemical also fills in the diffusivity estimated from molecular weight.",
          "parts": [
            "mode-toggle"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Every edit triggers a debounced recalculation of the predicted reactor C/C0, the mean residence time, the velocities, and Reynolds and Peclet verdicts shown as coloured badges. If a measured C/C0 is given, an estimated k and its residual are also shown.",
          "parts": [
            "results-panel"
          ]
        },
        {
          "step": "work back from each measurement to the unknown parameter",
          "here": "Measured C/C0 values (and in microbiological mode their paired fluence rates) are pasted from Excel into a list. Calculate fills a table with k per row, or E' per row in chemical mode. Rows outside the solver bracket are marked unreachable, and the bracket can be widened under the advanced settings.",
          "parts": [
            "backsolve-table",
            "inputs-panel"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "A list of fluence rates is swept. The table gives the RTD and well-mixed C/C0, the log10 inactivation and the % relative difference. The chart plots both curves on a log axis with forced-intercept exponential trendlines.",
          "parts": [
            "sweep-table",
            "sweep-chart"
          ]
        },
        {
          "step": "export the result",
          "here": "Save inputs downloads every input, including the mode and the value lists, as a JSON scenario file.",
          "parts": [
            "save-load"
          ]
        }
      ],
      "distinctive": [
        "The direction of the back-solve flips with the mode: microbiological mode solves for the rate constant at known fluence rates, and chemical mode holds a rate constant derived from photochemistry fixed and solves for the fluence rate.",
        "Reynolds and Peclet numbers give plain-language verdicts on whether the model's assumptions (laminar flow, no diffusion) hold for the entered reactor.",
        "A user-adjustable root-finding bracket marks out-of-range measurements as unreachable instead of returning a wrong answer.",
        "Every prediction is set against a naive well-mixed average-dose estimate, to show how much dose non-uniformity matters.",
        "In chemical mode, diffusivity is estimated from molecular weight with a power-law fit to reference compounds."
      ]
    }
  },
