  "app": {
    "title": "Paper Section Extractor",
    "summary": "A person uploads a PDF of a paper, can type a search term, and presses Extract. Text is pulled from the PDF locally. Section headers are found with fixed rules, and page numbers are worked out from the page-number lines in the text. The sections then appear as a collapsible list, each with its page range, and each opens to show its paragraphs in order. If a search term was entered, only sections whose title or text contains it are kept. The sections are also saved as Markdown and JSON files.",
    "task": {
      "text": "Split a paper PDF into its sections, each with the pages it covers, so a chosen section can be found and handed on as a clean chunk instead of the whole paper.",
      "verbs": [
        "derive",
        "organize",
        "locate",
        "lookup"
      ]
    },
    "data": {
      "text": "One scientific paper as a PDF, turned into plain text and then into an ordered set of sections, each with a page range and paragraphs.",
      "item": "a section of a paper: its header, first and last page, and paragraphs",
      "shapes": [
        "document",
        "table"
      ]
    },
    "stage": {
      "text": "preparing paper PDFs as section chunks with page sources, before retrieval or metadata extraction",
      "terms": [
        "clean"
      ]
    },
    "mechanism": {
      "text": "A left column holds the PDF upload, a search box, a debug checkbox and the Extract button. One run fills the right column with a list of collapsible sections, each titled with its page range, filtered by the search term. The same sections are written out as Markdown and JSON files.",
      "views": [
        "form",
        "list",
        "document reader"
      ],
      "interactions": [
        "import",
        "search",
        "filter",
        "toggle view",
        "export"
      ],
      "patterns": [
        "overview and detail"
      ]
    },
    "field": {
      "text": "section segmentation of scientific PDFs for retrieval-augmented generation",
      "disciplines": [
        "computer science"
      ],
      "terms": [
        "document parsing",
        "retrieval augmented generation",
        "information extraction"
      ]
    },
    "workflow": {
      "name": "split a long document into titled sections and export them",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload one PDF. It is copied into a local raw-data folder before processing.",
          "parts": [
            "control-panel",
            "pdf-upload"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Optionally type a term in 'Search sections' before extracting. Only sections whose title or any paragraph contains it are kept.",
          "parts": [
            "section-search"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "'Extract Sections' turns the PDF into text lines and gives each line a page from the page-number lines. It then starts a new section at each line that passes the header rules.",
          "parts": [
            "pdf-upload",
            "control-panel"
          ]
        },
        {
          "step": "look over every item at a glance, then open one in detail",
          "here": "Each section is listed as a collapsed row titled with its header and page range. Expanding a row shows its paragraphs in order.",
          "parts": [
            "sections-view"
          ]
        },
        {
          "step": "check the raw computed output",
          "here": "The 'Debug mode' checkbox fills a debug output box with the first 4000 characters of the raw section dictionary.",
          "parts": [
            "debug-output"
          ]
        },
        {
          "step": "export the result",
          "here": "Every run writes extracted_sections.md (header, page range, paragraphs) and extracted_sections.json to an outputs folder. These are offered through download buttons.",
          "parts": [
            "downloads"
          ]
        }
      ],
      "distinctive": [
        "Headers are found by rules, with no model: a fixed list of academic section names, numbered (1.2.3), Roman-numeral and appendix patterns. Lines with more than ten words, more than four commas, 'et al' or a leading URL are rejected.",
        "Page numbers come from the text itself: a line that is only a number, or a short running header that starts with a number and contains 'et al', sets the current page. That line is then dropped from the content.",
        "Each section keeps its first and last page, so a chunk handed to a model can be traced back to where it sits in the paper.",
        "Everything runs locally with no API calls. The search filter also limits what goes into the exported files."
      ]
    }
  },
