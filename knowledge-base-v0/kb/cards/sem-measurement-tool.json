  },
  "app": {
    "title": "SEM measurement tool",
    "summary": "A person opens a micrograph, along with the microscope's metadata file if it writes one, and checks or sets the calibration: pixel size, stage tilt correction, tilt axis, rotation and origin. They then trace contours and place rulers, angles and line profiles on the image, with clicks snapping to nearby edges. Each measurement goes into one list, where they can select, rename, delete or inspect it. They can fine-tune a contour's vertices in a table and read distances along a profile using two markers on its plot. They save the work as a session file and download the selected measurements as CSV tables, polygon files, profile plots or a GDSII layout.",
    "task": {
      "text": "Take calibrated, tilt-corrected dimensions, angles, areas and intensity profiles of features in a microscope image, and export them for analysis or layout tools.",
      "verbs": [
        "derive",
        "annotate",
        "locate"
      ]
    },
    "data": {
      "text": "One greyscale microscope image with its instrument metadata, and the geometric measurements a person draws on it. The measurements are contours, rulers, angles and banded line profiles, each kept as points in stored pixel coordinates.",
      "item": "a measurement drawn on the image: a contour, a ruler, an angle or a line profile",
      "shapes": [
        "image",
        "table"
      ]
    },
    "stage": {
      "text": "measuring features on micrographs after imaging, before modelling or reporting",
      "terms": [
        "analyze"
      ]
    },
    "mechanism": {
      "text": "A large zoomable image canvas takes clicks from the active tool, snaps them to a precomputed edge map and draws every measurement through one calibration map. The side panel sets that map and lists the measurements, and the selected measurement drives floating windows: a vertex table for a contour, a profile plot with markers for a profile. Both windows are linked back to the image.",
      "views": [
        "image viewer",
        "list",
        "form",
        "table view",
        "line chart",
        "bar chart",
        "detail panel"
      ],
      "interactions": [
        "select",
        "multi-select",
        "zoom and pan",
        "keyboard shortcuts",
        "inline edit",
        "hover for detail",
        "toggle view",
        "undo",
        "import",
        "export"
      ],
      "patterns": [
        "master-detail",
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "dimensional metrology on scanning electron micrographs and FIB cross-sections in materials science",
      "disciplines": [
        "materials science"
      ],
      "terms": [
        "electron microscopy",
        "sem metrology",
        "fib cross section"
      ]
    },
    "workflow": {
      "name": "measure features on a calibrated image and export the measurements",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Open image or a drop loads a TIFF, PNG or JPEG, together with a .txt or .hdr metadata file if there is one. Pixel size, tilt and microscope are read from the vendor metadata, and the edge map is computed. Open session reloads earlier work or a polygon CSV.",
          "parts": [
            "image-view",
            "control-panel"
          ]
        },
        {
          "step": "set the scale and frame the measurements are taken in",
          "here": "Pixel width and height in nm, stage tilt with a cross-section, tilted-surface or custom correction factor, tilt axis, rotation and origin. A selected ruler can level the image or set the tilt axis.",
          "parts": [
            "calibration-form"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Contour, ruler, angle and two-line tools (keys 1–4) place points that snap to the strongest nearby edge. Each measurement shows its length, angle, perimeter, area or bounding box in the calibrated frame.",
          "parts": [
            "tool-palette",
            "image-view"
          ]
        },
        {
          "step": "read an intensity profile across a feature and measure along it",
          "here": "The profile tool (5) draws a band-averaged grey-value profile that turns square to the edge it crosses. Markers A and B on the plot snap to the steepest slope and give an edge-to-edge distance.",
          "parts": [
            "profile-window",
            "image-view"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "The measurement list selects one or several items. A selected contour's vertices open in a table where they can be reordered, dropped, reversed or retyped in micrometres, and are highlighted on the image.",
          "parts": [
            "measurement-list",
            "vertex-window"
          ]
        },
        {
          "step": "adjust how the image is shown",
          "here": "A histogram without the info bar, with draggable black and white levels, brightness and contrast sliders, Auto and Full range. This changes the display only, never the measures.",
          "parts": [
            "display-histogram"
          ]
        },
        {
          "step": "export the result",
          "here": "Save session writes JSON. Download writes, for the selection or for all, a measurements CSV, a polygon CSV, a profile CSV or PNG, or a GDSII file with a layer per contour.",
          "parts": [
            "measurement-list",
            "control-panel"
          ]
        }
      ],
      "distinctive": [
        "Every point is stored in raw pixel coordinates and mapped through one affine calibration (pixel size, tilt foreshortening correction, tilt axis, rotation, origin), so changing the calibration never moves a traced point",
        "Clicks snap to sub-pixel edge crests found on a Gaussian-gradient edge map, with a noise threshold set as a multiple of the median gradient",
        "Line profiles are averaged across a band of adjustable width, turned square to the edge they cross, and annotated with the contours they cross",
        "Contours export as GDSII polygons or paths on per-contour layers for layout tools, and as polygon CSV files for a mode solver",
        "Vendor metadata from several microscope makers is parsed, and the instrument's info bar is excluded from the histogram and edge detection"
      ]
    }
  },
