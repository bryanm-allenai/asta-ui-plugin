  "app": {
    "title": "Affinity board for usability observations",
    "summary": "A person starts with observation notes scattered on a large board, each tinted by the participant it came from, and drags them into cluster boxes; a note joins whichever box its centre is dropped inside, and moving a box carries its notes along. Boxes are added, resized, renamed by double-clicking their titles and deleted, and the board can be zoomed or fitted to the screen while the selected note is nudged with the arrow keys. A side list ranks the themes by size with note and participant counts, and clicking a theme highlights its notes and dims the rest. The themes and their notes, with unsorted notes last, are copied or downloaded as Markdown for the report.",
    "task": {
      "text": "Group observation notes by hand into named themes and see whether each theme rests on many participants or only a few.",
      "verbs": [
        "organize",
        "summarize"
      ]
    },
    "data": {
      "text": "Short observation notes from usability sessions, each tagged with the participant it came from, grouped by hand into named clusters that become themes.",
      "item": "an observation note from one usability session",
      "shapes": [
        "notes",
        "categories"
      ]
    },
    "stage": {
      "text": "synthesising findings after usability sessions",
      "terms": [
        "analyze",
        "report"
      ]
    },
    "mechanism": {
      "text": "A zoomable board holds participant-tinted notes and resizable cluster boxes; a note belongs to the box its centre sits in, so dragging a note in or out changes membership and dragging a box carries its members. A side list of themes, sorted by size with participant counts, drives the board: clicking a theme highlights its notes and dims the rest.",
      "views": [
        "canvas",
        "sidebar list",
        "summary stats"
      ],
      "interactions": [
        "drag to arrange",
        "zoom and pan",
        "keyboard shortcuts",
        "select",
        "inline edit",
        "export"
      ],
      "patterns": [
        "spatial clustering",
        "linked views"
      ]
    },
    "field": {
      "text": "usability testing in human factors and UX research",
      "disciplines": [
        "hci"
      ],
      "terms": [
        "human factors",
        "ux research",
        "usability testing"
      ]
    },
    "workflow": {
      "name": "group items by hand into named clusters on a board",
      "steps": [
        {
          "step": "look over every item at a glance",
          "here": "Every observation note sits on a large board as a sticky tinted by its participant; the board zooms with buttons or Ctrl and the scroll wheel around the pointer, and Fit all brings every note and cluster on screen.",
          "parts": [
            "board",
            "zoom-controls"
          ]
        },
        {
          "step": "add a new category as the work goes",
          "here": "New cluster places an empty box in free space with its name open for typing; double-clicking a title renames it, the corner grip resizes it, and deleting it leaves its notes on the board unsorted.",
          "parts": [
            "cluster-controls",
            "drag-and-resize"
          ]
        },
        {
          "step": "group items into clusters",
          "here": "Notes are dragged into boxes, or nudged with the arrow keys, and belong to whichever box their centre sits inside; dragging a box carries its notes, and a status line says when a note joins or leaves one.",
          "parts": [
            "drag-and-resize",
            "nudge-keys",
            "board"
          ]
        },
        {
          "step": "count each category's items and how many sources they come from",
          "here": "A side list ranks the clusters by size, each with its note count, how many of the participants it draws on and a swatch per participant, plus a count of notes not yet in a cluster.",
          "parts": [
            "theme-list"
          ]
        },
        {
          "step": "highlight one group's items and dim the rest",
          "here": "Clicking a theme in the side list outlines its box, dims every other note and box, and scrolls the board to it; the unsorted entry picks out notes in no cluster, and Escape clears it.",
          "parts": [
            "theme-list",
            "board",
            "nudge-keys"
          ]
        },
        {
          "step": "export the result",
          "here": "The themes copy to the clipboard or download as Markdown, one heading per theme with its note count, participants and notes in board order, and the unsorted notes last.",
          "parts": [
            "markdown-export"
          ]
        }
      ],
      "distinctive": [
        "Membership is spatial: a note belongs to the topmost cluster its centre sits inside, so the grouping always matches what is on the board.",
        "Notes are coloured by the participant they came from and each theme counts its participants, so a theme that rests on one person stands out.",
        "The board can be zoomed around the pointer and fitted to the screen, and a selected note nudged with the arrow keys for small moves.",
        "The board lives only in memory and is lost on reload; the Markdown export, ready to paste into a report, is the record."
      ]
    }
  },
