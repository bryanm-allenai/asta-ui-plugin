  "app": {
    "title": "Affinity board for usability observations",
    "summary": "A person starts with a board of observation notes from usability sessions, each tinted by the participant it came from, a few already sitting in clusters and the rest scattered below. They make new clusters, name them, and drag notes (or nudge them with the arrow keys) into the cluster they belong to, moving and resizing clusters as the groups grow, and zooming or fitting the board to see it all. A side list ranks the themes by how many notes they hold and how many of the participants they cover, and clicking a theme highlights its notes on the board. When the grouping is done they copy or download the themes as a Markdown list, each theme with its notes and participants, plus the notes still unsorted.",
    "task": {
      "text": "Group observation notes from several participants into named themes on a free board and export the themes with their notes and participant coverage.",
      "verbs": [
        "organize",
        "summarize",
        "explore"
      ]
    },
    "data": {
      "text": "Short observation notes taken during usability sessions, each tagged with the participant it came from, and the clusters (themes) the person draws around them on a board.",
      "item": "a short observation note from one participant's session",
      "shapes": [
        "notes",
        "categories"
      ]
    },
    "stage": {
      "text": "grouping usability-session notes into themes as they emerge, after the sessions and before the write-up",
      "terms": [
        "analyze"
      ]
    },
    "mechanism": {
      "text": "Notes and clusters sit on a zoomable canvas, and a note belongs to whichever cluster its centre lies in, so dragging a note is how it is grouped. A side list recomputes each theme's note count and participant coverage after every move, and selecting a theme there dims everything outside it on the board and scrolls to it.",
      "views": [
        "canvas",
        "sidebar list",
        "summary stats"
      ],
      "interactions": [
        "drag to arrange",
        "inline edit",
        "select",
        "keyboard shortcuts",
        "zoom and pan",
        "filter",
        "export"
      ],
      "patterns": [
        "spatial clustering",
        "linked views",
        "overview and detail"
      ]
    },
    "field": {
      "text": "affinity diagramming of usability-test observations, in HCI",
      "disciplines": [
        "hci"
      ],
      "terms": [
        "hci",
        "affinity diagramming",
        "usability testing"
      ]
    },
    "workflow": {
      "name": "group short notes into named themes by hand on a board",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Observation notes are seeded on the board, each tinted and labelled by participant, with two first-pass clusters already holding some and the rest scattered below.",
          "parts": [
            "board",
            "participant-legend"
          ]
        },
        {
          "step": "make and name a group",
          "here": "New cluster places an empty box beside the others and opens its title for typing; double-click renames a cluster, and × deletes it while leaving its notes on the board.",
          "parts": [
            "cluster-box"
          ]
        },
        {
          "step": "group items into clusters",
          "here": "Drag a note so its centre sits inside a cluster (or nudge it with the arrow keys, Shift for bigger steps); the status line says which cluster it moved into or out of. Dragging a cluster head carries its notes, and the corner grip resizes it.",
          "parts": [
            "board",
            "cluster-box"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Zoom buttons, Ctrl+scroll around the pointer, and Fit all, which scales the board to every note and cluster.",
          "parts": [
            "zoom-controls",
            "board"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "The Themes list ranks clusters by note count, says how many of the participants each covers with a coloured dot per participant, and counts the notes not in a cluster.",
          "parts": [
            "themes-list",
            "participant-legend"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Clicking a theme (or Not in a cluster) dims every other note and cluster and scrolls the board to it; Esc clears it.",
          "parts": [
            "themes-list",
            "board"
          ]
        },
        {
          "step": "export the result",
          "here": "Copy themes as Markdown, or Download .md, writes one heading per theme with its note count, participants and notes in board order, then the unsorted notes.",
          "parts": [
            "markdown-export"
          ]
        }
      ],
      "distinctive": [
        "Membership is spatial: a note belongs to the topmost cluster its centre sits in, so there is no separate assign step.",
        "Each theme shows how many of the participants it draws on, not just how many notes, so a theme resting on one person stands out.",
        "Deleting a cluster never deletes notes; they go back to Not in a cluster.",
        "Notes are colour-coded by participant on the board and in the theme list."
      ]
    }
  },
