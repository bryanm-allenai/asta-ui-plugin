  "app": {
    "title": "GraphBin-Viz: Interactive Visual Analytics for Exploring Graph-based Metagenomic Binning",
    "summary": "A person loads an assembly graph, its contigs, an initial binning result and optionally other tools' binning results, sets the refinement parameters, and runs graph-based bin refinement in the browser. They then explore the result in a coordinated workspace: the assembly graph coloured by bin, confidence, disagreement or decision stage; a run summary with a list of contigs needing attention; a per-contig record explaining how each bin was decided; a brushable composition scatter; and a flow diagram between results. They can replay label propagation iteration by iteration, lock selected contigs to a bin and re-run refinement with those as fixed seeds, and finally export the curated binning as a CSV.",
    "task": {
      "text": "Check how graph-based refinement reassigned contigs to bins, find the assignments that are disputed or weakly supported, and correct them by re-running refinement under locked assignments.",
      "verbs": [
        "compare",
        "identify",
        "clean",
        "explore",
        "derive"
      ]
    },
    "data": {
      "text": "An assembly graph of contigs with their sequences, length, GC and coverage, plus several binning results that each assign contigs to bins, and a per-contig decision record from refinement.",
      "item": "a contig: a node in the assembly graph with its bin under each result",
      "shapes": [
        "network",
        "table",
        "sequence",
        "versions"
      ]
    },
    "stage": {
      "text": "comparing and correcting metagenomic bins after assembly and initial binning, before downstream genome analysis",
      "terms": [
        "compare",
        "clean"
      ]
    },
    "mechanism": {
      "text": "A canvas network diagram of the assembly graph, a brushable scatter of contig features and a Sankey-style flow between binning results all share one selection, so brushing, clicking a flow or clicking a node highlights the same contigs everywhere; an inspector beside them summarises the run when nothing is selected and opens one contig's decision record when one is. A curation panel locks selected contigs to a bin and re-runs refinement, and a replay slider steps the graph through propagation iterations.",
      "views": [
        "network diagram",
        "scatter plot",
        "summary stats",
        "detail panel",
        "form",
        "bar chart",
        "list"
      ],
      "interactions": [
        "import",
        "select",
        "multi-select",
        "brush",
        "hover for detail",
        "zoom and pan",
        "filter",
        "toggle view",
        "time slider",
        "apply label",
        "exclude and refit",
        "export"
      ],
      "patterns": [
        "linked views",
        "overview and detail",
        "master-detail",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "graph-based contig binning of metagenomic assemblies in bioinformatics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "metagenomics",
        "metagenomic binning",
        "assembly graphs"
      ]
    },
    "workflow": {
      "name": "check and correct group assignments of items in a network, then export the curated assignment",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Pick the assembler, then upload the GFA graph, contigs FASTA, a paths file (SPAdes only), the initial binning CSV/TSV and any other tools' binning results; each file is validated on pick.",
          "parts": [
            "config-panel"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Set max iterations, difference threshold and minimum bin size and run refinement in the browser; it records for every contig its decision stage, supporting neighbours, competing bin scores, hop distance to seeds and a confidence.",
          "parts": [
            "config-panel"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The assembly graph is drawn with contigs coloured by bin under any chosen result, or by confidence, disagreement, decision stage or a sequence feature; the summary shows counts per decision stage, a confidence histogram and a needs-attention list.",
          "parts": [
            "graph-view",
            "workspace-toolbar",
            "inspector"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Chips show only disputed or low-confidence contigs, a select narrows to one bin, and brushing the GC-by-coverage scatter or clicking a flow between results selects that group in every view.",
          "parts": [
            "workspace-toolbar",
            "feature-scatter",
            "contig-flow"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Clicking a contig opens its record: its bin under every result, the stage and reason its label was kept, stripped or inferred, its supporting neighbours with weights, and the competing scores; the replay slider steps the graph through propagation iterations.",
          "parts": [
            "inspector",
            "replay-bar"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "Select contigs, choose a bin and Lock assignment, then Re-run refinement so the locked contigs act as fixed seeds and the correction propagates through the graph.",
          "parts": [
            "curation-panel"
          ]
        },
        {
          "step": "export the result",
          "here": "Export binning downloads the curated contig-to-bin assignment as a CSV; the propagation replay can also be saved as a GIF.",
          "parts": [
            "curation-panel",
            "replay-bar"
          ]
        }
      ],
      "distinctive": [
        "Every assignment carries a decision provenance: whether its initial label was kept as a seed, stripped because graph neighbours contradicted it, inferred by propagation, or unresolved, with the reason.",
        "Confidence combines the vote margin with a decay by hop distance from the nearest seed, so a label carried far through the graph is trusted less.",
        "Disagreement across any number of binning results is measured only over the results that placed the contig in a bin, so leaving a contig unbinned is not counted as a conflict.",
        "Corrections are not relabels: locked contigs are fed back as immovable seeds and the whole refinement is re-run under them.",
        "A replay slider steps through label propagation iteration by iteration, hiding final-result markers so only the spreading labels move."
      ]
    }
  },
