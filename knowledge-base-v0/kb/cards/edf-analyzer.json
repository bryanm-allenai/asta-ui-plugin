  "app": {
    "title": "EDF-Analyzer",
    "summary": "A person uploads a multichannel physiological recording. The file is checked for size, format and identifying header fields, and the person sets the subject's age and sex group. The app works out what type each channel is and gives a confidence; the person can sort the channels and correct the type. They page through the raw traces, then compute spectral, aperiodic, complexity, heart-beat, heart-rate-variability and rhythm measures on separate pages. An automatic artifact mask, which the person can edit by clicking, gives a corrected version of each measure next to the version for the whole recording. Finally the person builds tabular and visual reports that record how they were made.",
    "task": {
      "text": "Derive quantitative brain-signal and heart-signal measures from one routine recording, compare them before and after artifact removal, and export a report that records how they were made.",
      "verbs": [
        "derive",
        "clean",
        "identify",
        "explore",
        "compare",
        "summarize"
      ]
    },
    "data": {
      "text": "One multichannel recording of biosignals sampled over time, with channel labels and header metadata, plus subject age and sex for the reference ranges.",
      "item": "a channel of a continuous recording, analysed in epochs and windows of time",
      "shapes": [
        "time series",
        "grid of series",
        "per element",
        "events",
        "table"
      ]
    },
    "stage": {
      "text": "computing quantitative measures from a routine recording, with artifact cleanup, before writing up findings",
      "terms": [
        "analyze",
        "clean"
      ]
    },
    "mechanism": {
      "text": "A sidebar of pages leads from upload through channel identification, a raw-signal viewer and several analysis pages to a report page. Channel corrections and the artifact mask, which the person edits on a clickable timeline, feed every later computation, and each measure is shown for the whole recording next to the cleaned version.",
      "views": [
        "line chart",
        "heatmap",
        "bar chart",
        "summary stats",
        "table view",
        "timeline",
        "form",
        "side-by-side panes"
      ],
      "interactions": [
        "import",
        "apply label",
        "sort",
        "select",
        "toggle view",
        "exclude and refit",
        "hover for detail",
        "zoom and pan",
        "keyboard shortcuts",
        "export"
      ],
      "patterns": [
        "dashboard",
        "overview and detail",
        "side-by-side comparison",
        "linked views"
      ]
    },
    "field": {
      "text": "quantitative EEG spectral analysis and heart-rate variability in clinical neurophysiology",
      "disciplines": [
        "medicine"
      ],
      "terms": [
        "clinical neurophysiology",
        "quantitative eeg",
        "heart rate variability"
      ]
    },
    "workflow": {
      "name": "derive measures from a multichannel recording, clean out artifacts, and export a report with provenance",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload a recording file. It is validated for size, sample count and format, and its header is checked for identifying fields, which must be acknowledged before loading. Then pick the subject's age group and sex.",
          "parts": [
            "file-patient"
          ]
        },
        {
          "step": "identify what each channel is and correct it",
          "here": "A classifier labels each channel by type (brain, heart, eye, muscle, reference, vital) with a confidence. The person sorts the list and overrides a type, or resets all overrides.",
          "parts": [
            "channel-report"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Page through the recording in epochs with arrow keys, montage and filter choices, with the heart trace fixed at the bottom.",
          "parts": [
            "eeg-viewer"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Power spectra, band power and ratios, alpha peak, aperiodic exponent and complexity per channel. R-peak detection with RR cleaning, time- and frequency-domain variability measures graded against age-dependent reference ranges, and rhythm screening that flags irregular rhythm and ectopic beats.",
          "parts": [
            "eeg-spectrum",
            "ecg-hrv",
            "rhythm-screening"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "A rule-based mask marks movement artifacts and suggests bad channels. The person adds or removes segments on a clickable timeline, and spectral and variability measures are shown for the whole recording next to the cleaned version.",
          "parts": [
            "artifact-selection",
            "rhythm-screening"
          ]
        },
        {
          "step": "export the result",
          "here": "Generate tabular PDF/Excel reports (whole recording vs corrected) and a visual PDF summary, each with version, commit, file hash and an analysis fingerprint. A report is marked stale when the settings change.",
          "parts": [
            "report"
          ]
        }
      ],
      "distinctive": [
        "Every measure is computed twice, on the whole recording and on the artifact-corrected recording, and the two are shown side by side",
        "Each method is labelled by how faithful the implementation is to its source and by the level of evidence behind it, and simplified defaults are shown next to full reference implementations",
        "Variability values are graded against reference ranges that depend on age and sex, with pediatric ranges",
        "Reports carry a provenance fingerprint and are flagged stale once file, age, sex or channel corrections change",
        "The upload checks the header for identifying fields, and uploaded files are deleted automatically after a time limit"
      ]
    }
  },
