  "app": {
    "title": "Project Field Mouse (Dev Station dashboard)",
    "summary": "A person opens an overview of what an unattended acoustic station has detected today: counts, highlights, a seven-day bar chart and an hourly activity strip. From there they open the listening log. It lists every automated detection newest first, can be narrowed to a minimum detector confidence and loads more as they scroll. For each detection they can play the stored clip and expand the verification details to see the evidence for and against it. Clicking a species name opens that species' page with its totals, rhythm, daily history, confidence distribution and filtered clips. A sortable collection of every species heard and a device page with service and storage health finish the round.",
    "task": {
      "text": "Keep watch over an automated wildlife sound detector's output, check how confident each detection is and what evidence backs it, and summarize which species the station has heard and when.",
      "verbs": [
        "monitor",
        "summarize",
        "explore",
        "lookup",
        "identify"
      ]
    },
    "data": {
      "text": "A growing log of automated species detections from scheduled audio recordings. Each detection has a time, a detector confidence, an optional verification verdict with evidence, and a link to its audio clip. There is also station health telemetry.",
      "item": "one automated detection of a species in a timed audio recording, with its confidence and clip",
      "shapes": [
        "events",
        "media",
        "table",
        "time series",
        "judgements"
      ]
    },
    "stage": {
      "text": "watching automated detections arrive during a field deployment, before any formal analysis",
      "terms": [
        "collect",
        "explore"
      ]
    },
    "mechanism": {
      "text": "An overview dashboard of daily counts and bar charts links to a confidence-filtered, infinitely scrolling detection log. Each entry has an audio player and an expandable evidence panel, and species names link through to a per-species detail page and a sortable collection grid. Server-rendered pages pass filter and sort choices in the URL, and a small script scales the bars and loads the next page of the log.",
      "views": [
        "summary stats",
        "bar chart",
        "list",
        "detail panel",
        "thumbnail grid",
        "timeline"
      ],
      "interactions": [
        "filter",
        "sort",
        "select",
        "toggle view"
      ],
      "patterns": [
        "dashboard",
        "overview and detail",
        "master-detail"
      ]
    },
    "field": {
      "text": "automated species detection from passive acoustic recordings in ecology",
      "disciplines": [
        "ecology"
      ],
      "terms": [
        "passive acoustic monitoring",
        "bioacoustics",
        "birdnet"
      ]
    },
    "workflow": {
      "name": "watch an automated detector's output and check individual detections",
      "steps": [
        {
          "step": "look over every item at a glance",
          "here": "The overview shows today's detection, species and average-confidence counts, highlight cards, a seven-day bar chart and an hourly activity strip.",
          "parts": [
            "overview"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "The listening log lists detections newest first. Chips narrow it to All, 60%+, 80%+ or 90%+ detector confidence, and a scroll sentinel loads more pages.",
          "parts": [
            "activity-log"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Each detection plays its stored clip, colours its confidence high, medium or low, and expands into combined verification confidence with evidence marked as supporting or opposing.",
          "parts": [
            "detection-item"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "A species page totals detections, active days, average and best confidence, typical hour, a 14-day history and confidence buckets, and lists its clips with the same confidence filter.",
          "parts": [
            "species-page"
          ]
        },
        {
          "step": "summarize the collection",
          "here": "The life list shows a card for every species heard, sortable by Recent, Name, Most heard or Confidence, with first, newest and most frequent highlights.",
          "parts": [
            "life-list"
          ]
        },
        {
          "step": "check the health of the source",
          "here": "The device page shows vitals, systemd service states and resource and storage meters, so stale recording or detection can be noticed.",
          "parts": [
            "device-health"
          ]
        }
      ],
      "distinctive": [
        "Every detection shows two separate certainties: the detector's own confidence and an optional verification score built from independent evidence. When no evidence is available it is labelled 'BirdNET only'.",
        "Audio expires under a retention policy, but the observation stays. An entry then shows that its clip is no longer stored.",
        "Activity is read in station-local time: hourly, daily and dawn-window counts, plus a streak of consecutive active days.",
        "The station's own health is shown next to the wildlife data, because a stopped recorder looks the same as a quiet site."
      ]
    }
  },
