  "app": {
    "title": "Trill View (TrillView + Spec View)",
    "summary": "A person loads a CSV of a sound classifier's predictions. Each sound frame is a point at 2D coordinates, coloured and shaped by its class. They pan and zoom the scatter, hide classes from the legend, hover a point to see its spectrogram, and click it to hear the clip. With the box or lasso tool they select points and append those frames to a saved CSV. A second page then shows the saved frames as pages of spectrogram cards, each with an audio player and a moving playhead, where the person corrects each frame's label and writes the edited labels out to a CSV.",
    "task": {
      "text": "Explore where a classifier placed each sound frame, pick out the frames that look wrong or interesting, listen to them and correct their labels.",
      "verbs": [
        "explore",
        "identify",
        "review",
        "clean",
        "annotate"
      ]
    },
    "data": {
      "text": "A table of audio frames, one row each, with source recording, start and end time, true class, predicted class and score, and 2D coordinates computed from the class probabilities. The audio is loaded on demand to draw spectrograms and play clips.",
      "item": "a short time window (frame) of an audio recording, with its true and predicted class",
      "shapes": [
        "table",
        "media",
        "judgements",
        "categories"
      ]
    },
    "stage": {
      "text": "reviewing a trained sound classifier's predictions, and correcting frame labels, after inference",
      "terms": [
        "review",
        "explore",
        "clean"
      ]
    },
    "mechanism": {
      "text": "A scatter plot of every frame is the overview: hovering a point shows its spectrogram in a tooltip, clicking plays the clip, and a box or lasso selection saves frames to a shared CSV. The second page reads that CSV and lays the frames out as pages of spectrogram cards with audio players, a playhead that follows playback, and label fields you can edit.",
      "views": [
        "scatter plot",
        "heatmap",
        "small multiples",
        "summary stats"
      ],
      "interactions": [
        "import",
        "hover for detail",
        "select",
        "multi-select",
        "brush",
        "zoom and pan",
        "filter",
        "toggle view",
        "inline edit",
        "keyboard shortcuts",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "small multiples"
      ]
    },
    "field": {
      "text": "evaluating sound-classifier predictions in bioacoustics",
      "disciplines": [
        "ecology"
      ],
      "terms": [
        "bioacoustics",
        "model evaluation",
        "spectrogram"
      ]
    },
    "workflow": {
      "name": "select items from a 2D projection, inspect each, and correct their labels",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Drag and drop a .csv or .csv.zst of frames with x, y, file path, timestamps and classes. Each class becomes one legend trace with its own colour and marker.",
          "parts": [
            "scatter-view"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Pan and zoom a scatter of all frames placed by their radial coordinates. Clicking a legend entry hides that class, and double-clicking isolates it.",
          "parts": [
            "scatter-view"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "After a short pause, hovering a point shows a mel or STFT spectrogram (n_fft is selectable) with the true and predicted class, score, file and time range. Clicking the point plays the clip.",
          "parts": [
            "hover-spectrogram",
            "click-playback"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Box or lasso select a group of points. The button counts the selected markers, and each press appends those frames to the saved CSV.",
          "parts": [
            "selection-saver"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "Spec View pages through the saved frames as a grid of spectrogram cards. Columns and frames per page are set from dropdowns, and arrow or PageUp/PageDown keys turn pages. Each card has an audio player, and a red playhead moves across the spectrogram during playback.",
          "parts": [
            "spec-grid",
            "pagination",
            "playhead"
          ]
        },
        {
          "step": "apply a label to each item",
          "here": "Clicking a card's label, pencil or spectrogram opens a text field. ✓ or Enter saves the new label, and ✕ cancels.",
          "parts": [
            "label-editor"
          ]
        },
        {
          "step": "export the result",
          "here": "'Save labels to CSV' writes every frame with an added edited_label column.",
          "parts": [
            "label-editor"
          ]
        }
      ],
      "distinctive": [
        "Classes are laid out at fixed points on a circle, and each frame is placed by its class probabilities, so a frame's distance and direction from its class show the model's confidence and confusion.",
        "Spectrograms are computed live from the source audio, with a choice of mel or linear STFT and the FFT window size, on a fixed dB scale with one shared colour bar.",
        "A playhead line follows audio playback across each spectrogram card.",
        "Selections from the scatter build up across saves in one shared CSV, which the detail page then reads."
      ]
    }
