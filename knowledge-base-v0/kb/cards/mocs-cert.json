  "app": {
    "title": "MOCS-Cert Trajectory Verification Studio",
    "summary": "A person picks a molecular structure or simulation trajectory and writes a declarative distance query, either typed or taken from presets that change with the dataset. Running the query compiles it into a staged execution plan. The interface then shows the trajectory as a strip of time blocks, each coloured true, false or unknown according to bounds on the distance. The person selects blocks and refines the uncertain ones into sub-blocks with tighter bounds. Finally they verify the hash-committed certificate against invariant checks and a reference oracle, then copy its hash or download it as JSON.",
    "task": {
      "text": "Find the stretches of a simulation where a distance condition between two atom selections holds, skip the stretches that provably cannot satisfy it, and produce a checkable certificate of the answer.",
      "verbs": [
        "derive",
        "locate",
        "identify",
        "review"
      ]
    },
    "data": {
      "text": "Molecular structures and trajectories of sampled frames, split into fixed time blocks. Each block has lower and upper bounds on a distance and a three-valued verdict, and the run produces a certificate record with hashes.",
      "item": "a block of consecutive trajectory frames with its distance bounds and true/false/unknown verdict",
      "shapes": [
        "time series",
        "judgements",
        "hierarchy",
        "table"
      ]
    },
    "stage": {
      "text": "querying simulation trajectories for contact events and certifying the answer, after the simulations are run",
      "terms": [
        "analyze",
        "confirm"
      ]
    },
    "mechanism": {
      "text": "A query editor drives a compile-and-execute run. Its plan stages fill a table, its block verdicts colour a timeline lattice, and its evidence fills a tabbed certificate panel. Selecting a block on the timeline focuses its bounds in the detail rows, the 3D viewer and the proof panel, where it can be refined. Audit views re-verify the certificate against fixed checks and export it.",
      "views": [
        "sidebar list",
        "text editor",
        "3d viewer",
        "table view",
        "timeline",
        "detail panel",
        "summary stats"
      ],
      "interactions": [
        "select",
        "keyboard shortcuts",
        "search",
        "toggle view",
        "zoom and pan",
        "exclude and refit",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "linked views",
        "rubric",
        "dashboard"
      ]
    },
    "field": {
      "text": "certified distance-contact queries over molecular dynamics trajectories in computational biophysics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "molecular dynamics",
        "computational biophysics",
        "structural biology"
      ]
    },
    "workflow": {
      "name": "query a long record for when a condition holds, rule out stretches by bounds, refine the uncertain ones, and certify the answer",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Pick a dataset (trajectory and topology) in the sidebar, or a structure from the catalog of experimental and predicted structures. Switching dataset clears the previous results and loads that dataset's preset queries.",
          "parts": [
            "dataset-sidebar",
            "molecular-viewport"
          ]
        },
        {
          "step": "state the condition to look for",
          "here": "Type a query of the form FIND [ALL] (selection) WITHIN distance OF (selection) [WHERE DURATION >= time], or choose a preset. Ctrl+Enter runs it, and errors come back with a code and a suggested fix.",
          "parts": [
            "query-editor"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "The query compiles into a nine-stage plan: parse, resolve selections, set up periodic boundaries, look up the index, prune, refine, evaluate exact frames, build the certificate and verify. The plan table shows each stage's status.",
          "parts": [
            "query-editor",
            "execution-plan"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "A canvas strip shows every time block coloured True, False or Unknown. Click a block or use the arrow keys to select it and see its time range, lower and upper bounds, and verdict.",
          "parts": [
            "temporal-lattice"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Refine Block is enabled only for blocks whose bounds straddle the threshold. It splits the block in two and shows each sub-block's tighter bounds and verdict, while the 3D viewer shows the selected atoms with bounding boxes and a distance caliper.",
          "parts": [
            "temporal-lattice",
            "molecular-viewport"
          ]
        },
        {
          "step": "check the result against criteria",
          "here": "The certificate panel and Formal Audit view re-run verification. They show the certificate hash, source and index commitments, fixed invariant checks, and frame-by-frame agreement with a reference analysis library.",
          "parts": [
            "certificate-panel",
            "formal-audit"
          ]
        },
        {
          "step": "export the result",
          "here": "Copy the certificate hash, or download the certificate as a JSON file.",
          "parts": [
            "certificate-panel",
            "formal-audit"
          ]
        }
      ],
      "distinctive": [
        "Each interval gets a three-valued verdict. If the lower bound is above the threshold the block is ruled out without reading frames; if the upper bound is at or below it, the block is certified true; otherwise it is unknown.",
        "Only unknown blocks can be refined. Refinement halves the block, and each child's bounds must stay inside its parent's bounds.",
        "Distances use the minimum-image rule for periodic simulation boxes, and unsupported box shapes fail closed.",
        "The result is a canonicalised, SHA-256-hashed certificate. It is re-verified independently and checked against a reference library rather than trusted as reported.",
        "The query language has existential and universal quantifiers and a minimum-duration clause, and the preset queries change with the dataset."
      ]
    }
  },
