  "app": {
    "title": "Colony Counter (colony·counter)",
    "summary": "A person drops in or takes a photo of an agar plate, and a detector marks each colony it finds with a ring. They correct the marks on the image: tapping an unmarked colony adds one that sizes itself to the colony, tapping a ring removes it, and sliding or scrolling on a ring resizes it. A sensitivity slider and an option to split merged colonies re-run detection and keep the person's own additions. They read the total, broken down into auto-detected, added and removed, with a warning when the plate is past the countable range. They can save the corrected plate as a training example. A companion labeller presents a folder of plates one at a time, pre-marked, to build a training dataset with keyboard save and skip.",
    "task": {
      "text": "Get a colony count for a plate photo that the analyst agrees with, by correcting an automatic detection one colony at a time.",
      "verbs": [
        "derive",
        "identify",
        "annotate",
        "clean"
      ]
    },
    "data": {
      "text": "Photos of culture plates with colonies marked as circles, either detected automatically or placed by hand. The corrected marks are saved as object-detection labels.",
      "item": "a photo of one agar plate, with a mark for each colony on it",
      "shapes": [
        "image",
        "image collection",
        "judgements"
      ]
    },
    "stage": {
      "text": "counting colonies on incubated plates and checking the automatic count, before reporting a quality-control result",
      "terms": [
        "analyze",
        "annotate"
      ]
    },
    "mechanism": {
      "text": "An image viewer shows the plate with a ring over each detected colony. Clicks on the image add or remove rings, and a press-and-slide resizes one. A side panel keeps a running total with its breakdown, and holds the controls that re-run detection with new settings without losing hand-added marks. In the labeller, plates arrive one at a time with a progress bar and keyboard shortcuts.",
      "views": [
        "image viewer",
        "summary stats",
        "form"
      ],
      "interactions": [
        "import",
        "select",
        "accept or reject",
        "inline edit",
        "exclude and refit",
        "undo",
        "keyboard shortcuts",
        "zoom and pan",
        "export"
      ],
      "patterns": [
        "review queue",
        "overview and detail"
      ]
    },
    "field": {
      "text": "colony counting on culture plates with object detection, in microbiology quality control",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "microbiology",
        "colony counting",
        "food microbiology"
      ]
    },
    "workflow": {
      "name": "correct automatic detections on an image to reach a trusted count",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Drop a plate photo on the dish-shaped target, take one with the phone camera, or browse for a JPG or PNG. The server detects colonies with the trained model, or with classical thresholding if no model is available.",
          "parts": [
            "upload-view"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Each detected colony is drawn as a green ring on the plate. Colonies recovered by the split pass are drawn dotted, and a header label shows which detection engine ran.",
          "parts": [
            "plate-stage"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "Releasing the sensitivity slider or ticking 'Split merged colonies' re-runs detection and keeps the hand-added marks. 'Reset this plate' clears all edits and detects again from scratch.",
          "parts": [
            "detection-controls"
          ]
        },
        {
          "step": "decide keep or drop for each item, with a reason",
          "here": "Tap a ring to remove a false detection. Tap an unmarked colony to add a mark, which measures its own size from the colony under it, or stays dashed if it can't. Press and slide, or scroll, on a ring to resize it.",
          "parts": [
            "plate-stage"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "The total count updates with each change, broken down into auto, added and removed. A banner warns when the plate is above the countable range, and another when nothing was detected.",
          "parts": [
            "count-readout"
          ]
        },
        {
          "step": "export the result",
          "here": "'Save this plate for training' writes the image and the final marks as YOLO labels, recording for each box whether its size was measured or a default guess.",
          "parts": [
            "save-for-training"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "In the labeller, plates from an inbox folder arrive pre-marked one at a time with a progress bar. S saves and moves on, K skips, Z undoes the last mark and C clears all marks. Number keys pick the class for new marks.",
          "parts": [
            "labeller-queue"
          ]
        }
      ],
      "distinctive": [
        "Counts above the plate's reliable range trigger a too-numerous-to-count advisory instead of a bare number.",
        "A hand-placed mark sizes itself by segmenting the colony under the tap, and stays drawn dashed when the measurement fails, so unmeasured sizes stay visible.",
        "Re-detecting at a new sensitivity keeps the analyst's own additions, so tuning the detector doesn't throw away corrections.",
        "Corrected plates go back into the training set, so using the counter also improves the next model.",
        "The count is broken down by where each mark came from (auto, added, removed), so the correction effort is visible."
      ]
    }
  },
