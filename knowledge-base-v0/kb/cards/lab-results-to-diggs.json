  "app": {
    "title": "Lab Results → DIGGS",
    "summary": "A person loads a project's existing data-exchange file, which lists the sampling locations and samples, and says whether the locations are proposed or final. From that file they download a spreadsheet workbook with the locations and samples already filled in. They enter test results on one sheet per test type, set the project units and drop the workbook back on the page. The page matches each result row to a sample in the file, and lists counts, errors and warnings for the person to fix. Once nothing blocks the build, they preview and download the standard XML file with the results merged in, and can optionally check it against an online validator. Without a starting file, a blank workbook is used instead and each location's coordinates are typed in a table.",
    "task": {
      "text": "Move finished laboratory test results from a spreadsheet into a project's standard data-exchange file without changing any value, then check the file against the standard's rules.",
      "verbs": [
        "curate",
        "clean",
        "summarize"
      ]
    },
    "data": {
      "text": "Sampling locations, each holding samples taken at depth intervals; each sample has laboratory test results on per-test sheets, with the raw measurements behind them, all ending up in one hierarchical XML file",
      "item": "a test result row for one sample, identified by its location, sample name and depth interval",
      "shapes": [
        "table",
        "hierarchy",
        "geospatial",
        "document"
      ]
    },
    "stage": {
      "text": "handing over finished lab test results into the project's shared data file, after testing",
      "terms": [
        "report",
        "maintain"
      ]
    },
    "mechanism": {
      "text": "A numbered sequence of panels runs from loading the starting file and downloading a prefilled workbook, through units and the workbook drop, to the build panel. Any change to an input rebuilds the dataset straight away and redraws the summary counts, error and warning lists, location table and XML preview. The download and online-check buttons stay disabled until there are no errors.",
      "views": [
        "form",
        "table view",
        "summary stats",
        "list",
        "document reader"
      ],
      "interactions": [
        "import",
        "export",
        "inline edit",
        "select"
      ],
      "patterns": [
        "stepwise wizard"
      ]
    },
    "field": {
      "text": "translating soil laboratory test results into a data-exchange standard, in geotechnical engineering",
      "disciplines": [
        "engineering"
      ],
      "terms": [
        "geotechnical engineering",
        "soil testing",
        "diggs"
      ]
    },
    "workflow": {
      "name": "convert spreadsheet results into a standard exchange file and check it against the standard's rules",
      "steps": [
        {
          "step": "bring the reference data in",
          "here": "Drop the project's DIGGS XML file. The page shows counts of borings, borings with locations and samples, and warns about problems in the file. Radio buttons say whether the locations are proposed or as drilled, and whether to replace or keep results added on an earlier run.",
          "parts": [
            "source-step"
          ]
        },
        {
          "step": "get a template prefilled from the reference",
          "here": "Download an .xlsx workbook already listing the file's borings and samples, with a sheet per test and a note on every column. A blank workbook or CSV templates are available when there is no starting file, and a reference table lists each sheet's columns and ASTM method.",
          "parts": [
            "workbook-templates"
          ]
        },
        {
          "step": "set project details and units",
          "here": "Fill in the project name, laboratory and the units for depth, density, raw mass, dimension and volume. These come from the workbook's Project sheet, or from the source file when there is one, and every value is labelled with them.",
          "parts": [
            "project-units"
          ]
        },
        {
          "step": "bring the data in",
          "here": "Drop the filled-in workbook or CSV files. Each sheet's test type is detected from its header row, with a dropdown to override it. Adding a file again replaces the earlier copy.",
          "parts": [
            "file-loader"
          ]
        },
        {
          "step": "fill in what the reference lacks",
          "here": "Without a starting file, a table lists each boring found in the results for typing latitude, longitude, ground elevation, total depth and date drilled. Missing coordinates are outlined in red.",
          "parts": [
            "boring-locations"
          ]
        },
        {
          "step": "check and fix problems",
          "here": "Counts of borings, samples and tests, with totals by test type and how many samples were matched to the source file. Below them, numbered error and warning lists name the file and row of each problem. Errors block the build until fixed.",
          "parts": [
            "build-summary"
          ]
        },
        {
          "step": "export the result",
          "here": "Preview the added XML records and download the merged DIGGS XML under a chosen name. Optionally, send it to an online validator for schema, codelist and business-rule checks, or wrap it in an inspector page.",
          "parts": [
            "build-summary",
            "online-check"
          ]
        }
      ],
      "distinctive": [
        "The tool translates and never calculates: values are written as entered, and a result the lab did not report is marked 'notReported', so a test can carry its raw measurements alone",
        "Results are matched to the file's existing samples by sample name within the boring, or else by a depth interval within a small tolerance. When depths disagree, the file's depths win and a warning is raised",
        "The original file is kept as it was: new samples and tests are inserted with their own id prefix, and an audit-trail entry records who added them and whether the locations were proposed",
        "Each test type maps to an ASTM method and a procedure element in the standard, with raw trial data (sieve points, hydrometer readings, Proctor trials) carried into the procedure",
        "Everything runs offline in one HTML file, and nothing leaves the computer unless the person presses an online button"
      ]
    }
  },
