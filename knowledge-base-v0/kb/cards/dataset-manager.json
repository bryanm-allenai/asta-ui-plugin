  "app": {
    "title": "Lab dataset and version tracker",
    "summary": "The person keeps one table of every dataset a group holds, with its source instrument, owner, last update, size, current version, pipeline status and project tags. They search across names, tags and notes, filter by status, by tag or to datasets with a version used in a paper, sort by any column, and tick several rows to change their status in one go. Opening a row shows its full metadata and storage location, its versions with what changed in each, a control to mark the one version that went into a paper and name the paper, and a notes box, all kept in the browser between visits. The rows currently shown can be exported as a CSV.",
    "task": {
      "text": "Keep a group's datasets, their processing versions and pipeline status in order, and record which version went into a publication.",
      "verbs": [
        "curate",
        "lookup",
        "annotate",
        "identify"
      ]
    },
    "data": {
      "text": "A catalogue of datasets from several instruments, each with metadata (instrument, owner, format, storage location, size, status, tags), a list of processing versions with a date, author, size and a note on what changed, an optional mark on the version used in a paper, and free notes.",
      "item": "one dataset: an instrument export with its metadata and version history",
      "shapes": [
        "table",
        "versions",
        "notes"
      ]
    },
    "stage": {
      "text": "keeping data in order over time and tracing what went into a paper",
      "terms": [
        "maintain",
        "report"
      ]
    },
    "mechanism": {
      "text": "A searchable, filterable, sortable table of datasets opens the selected one in a side drawer with its metadata, version history and notes; checkboxes pick rows for a bulk status change, edits are saved in the browser, and the rows shown export as CSV.",
      "views": [
        "table view",
        "detail panel",
        "list"
      ],
      "interactions": [
        "search",
        "filter",
        "sort",
        "select",
        "multi-select",
        "inline edit",
        "write notes",
        "export"
      ],
      "patterns": [
        "master-detail",
        "version history",
        "status pipeline"
      ]
    },
    "field": {
      "text": "protein biochemistry and biophysics lab, managing instrument data",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "biochemistry",
        "biophysics",
        "data management"
      ]
    },
    "workflow": {
      "name": "keep a catalogue of items, their status and versions in order",
      "steps": [
        {
          "step": "look over every item at a glance",
          "here": "One table lists every dataset with name, instrument, owner, last update, size, current version with any paper version beside it, pipeline status and project tags; any column header sorts it, and a second click reverses.",
          "parts": [
            "dataset-table"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "A search box looks through names, instruments, owners, storage paths, notes, paper names and tags; a status menu, tag chips that must all apply and a checkbox for datasets with a paper version narrow the table, and the header says how many are showing.",
          "parts": [
            "search-filters",
            "dataset-table"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Clicking a row opens a side drawer with the dataset's status, instrument, owner, file format, location on the lab share, first and latest export and tags, and its versions newest first with date, who made it, size and what changed.",
          "parts": [
            "detail-drawer",
            "version-history"
          ]
        },
        {
          "step": "mark which version of an item went into a publication",
          "here": "Each version has a button to mark it as the one used in the paper; only one version per dataset can hold the mark, a field then asks which paper, and the table shows the marked version.",
          "parts": [
            "version-history"
          ]
        },
        {
          "step": "move items to a new status, one or many at once",
          "here": "The drawer's status menu changes one dataset; ticking rows, or the header box for every shown row, opens a bar that sets them all to raw, cleaned, analysed or archived.",
          "parts": [
            "detail-drawer",
            "bulk-status"
          ]
        },
        {
          "step": "write notes on an item",
          "here": "A notes box in the drawer saves itself in the browser shortly after typing stops and says when it was saved; the notes are searchable from the table.",
          "parts": [
            "dataset-notes"
          ]
        },
        {
          "step": "export the result",
          "here": "A button downloads only the rows the current search and filters show, as a CSV with metadata, current and paper version, paper name, status, tags, location and notes.",
          "parts": [
            "export-shown"
          ]
        }
      ],
      "distinctive": [
        "Exactly one version per item can carry the publication mark, with the publication named beside it, so it is clear which processing of the data a figure used.",
        "Status follows a fixed pipeline of raw, cleaned, analysed and archived, and ticked rows can be moved to one status in one go.",
        "Statuses, publication marks and notes persist in the browser between visits, with a reset back to the sample data.",
        "Search reaches into tags, notes, storage paths and publication names, not only item names.",
        "Each version carries a note on what changed in that processing step, who made it and its size."
      ]
    }
  },
