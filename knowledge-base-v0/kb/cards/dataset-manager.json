  "app": {
    "title": "Lab dataset and version tracker",
    "summary": "A lab's instrument datasets are listed in one sortable table with their instrument, owner, last update, size, current version, status and tags. The person narrows the list by search, status, tag chips or only those with a paper version, and can tick several rows to set their status at once. Opening a dataset shows its metadata, storage location and full version history, where they mark which version went into a paper, name the paper and keep notes. The shown rows export as a CSV inventory, and all edits are kept in the browser.",
    "task": {
      "text": "Keep a lab's datasets in order over time: their processing status, version history, which version was used in a paper, and notes, and export an inventory of them.",
      "verbs": [
        "curate",
        "lookup",
        "organize"
      ]
    },
    "data": {
      "text": "A catalogue of instrument datasets, each with metadata (instrument, owner, file format, storage path, status, tags) and an ordered list of processed versions with date, author, size and a note on what changed.",
      "item": "one instrument dataset with its version history",
      "shapes": [
        "table",
        "versions",
        "notes"
      ]
    },
    "stage": {
      "text": "keeping a lab's instrument datasets and their versions in order, from raw export through to publication",
      "terms": [
        "maintain"
      ]
    },
    "mechanism": {
      "text": "A filterable, sortable table of datasets drives a side drawer that opens the clicked dataset's metadata, version list and notes; checkboxes in the table feed a bulk status bar, and both the drawer and the bar write back to the table.",
      "views": [
        "table view",
        "detail panel",
        "list",
        "text editor"
      ],
      "interactions": [
        "search",
        "filter",
        "sort",
        "select",
        "multi-select",
        "inline edit",
        "write notes",
        "export",
        "keyboard shortcuts"
      ],
      "patterns": [
        "master-detail",
        "status pipeline",
        "version history"
      ]
    },
    "field": {
      "text": "research data management and version provenance for instrument data, in a protein biochemistry lab",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "biochemistry",
        "research data management",
        "data provenance"
      ]
    },
    "workflow": {
      "name": "keep a collection's items, their versions and status in order",
      "steps": [
        {
          "step": "look over every item at a glance",
          "here": "one table of every dataset with instrument, owner, last updated date, size of the latest version, version count with the paper version flagged, status and tags, plus a count of how many are shown",
          "parts": [
            "dataset-table"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "a search over names, owners, tags, paths, papers and notes; a status dropdown; tag chips that must all match; and a checkbox for only datasets with a paper version",
          "parts": [
            "filter-toolbar"
          ]
        },
        {
          "step": "sort by a value",
          "here": "clicking a column header sorts by name, instrument, owner, updated date, size, version count or status order, clicking again reverses it",
          "parts": [
            "dataset-table"
          ]
        },
        {
          "step": "move several items to a new status at once",
          "here": "tick rows or select all shown, then set them to raw, cleaned, analysed or archived in one go",
          "parts": [
            "bulk-status"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "a drawer with status, instrument, owner, file format, storage path, first export and latest version, editable status, and Escape to close",
          "parts": [
            "detail-drawer"
          ]
        },
        {
          "step": "keep a record of changes",
          "here": "the version history lists each version's date, author, size and processing note, newest first; one version can be marked as used in the paper and the paper named, and free notes autosave",
          "parts": [
            "version-history",
            "detail-drawer"
          ]
        },
        {
          "step": "export the result",
          "here": "the rows currently shown export as a dated CSV with location, current and paper version, status, tags and notes",
          "parts": [
            "export-reset"
          ]
        }
      ],
      "distinctive": [
        "datasets move through a fixed status pipeline of raw, cleaned, analysed and archived",
        "exactly one version per dataset can be marked as the one used in a paper, so the figures can be traced to the processing step behind them",
        "each version carries a note of the processing step that produced it, such as a refit or a re-search with new settings",
        "each dataset records its instrument's native file format and where it sits on the lab share"
      ]
    }
  },
