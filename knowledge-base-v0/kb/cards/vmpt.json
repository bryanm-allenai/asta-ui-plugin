  "app": {
    "title": "vMPT — visual MSA Planning Tool",
    "summary": "The person loads an image of a sky field and a target catalogue. They aim the multi-shutter mask over it by setting the centre and roll angle, and choose a disperser and filter. They can run an optimizer that searches pointings for the one that places the most targets, or the most weight or priority, in usable shutters, then apply one of the ranked solutions. They pick and remove slitlets by hand on the image while coloured overlays show where each spectrum would fall on the others and where two slitlets conflict. The finished shutter plan is saved as a session and exported as a bundle that the observatory's proposal tool can import.",
    "task": {
      "text": "Plan a multi-object spectroscopy observation by choosing a telescope pointing and the set of open shutters that catches the most high-priority targets without their spectra overlapping, then export the plan.",
      "verbs": [
        "plan",
        "decide",
        "derive",
        "identify",
        "curate"
      ]
    },
    "data": {
      "text": "A world-coordinate image of a field, a table of candidate targets with sky positions and optional priority, weight, magnitude and redshift, and a fixed grid of instrument shutters, each marked operable, stuck open or failed closed.",
      "item": "a candidate target placed in a shutter of the micro-shutter grid",
      "shapes": [
        "image",
        "table",
        "per element",
        "geospatial",
        "judgements"
      ]
    },
    "stage": {
      "text": "planning an observation from an existing image and target catalogue, before submitting it to the proposal tool",
      "terms": [
        "plan",
        "decide"
      ]
    },
    "mechanism": {
      "text": "A large image view shows the shutter grid laid over the field at the current pointing. A sidebar of tabs drives the view: inputs, pointing and optimizer, settings, and plan import and export. Clicking on the image opens or closes slitlets, and every change recomputes the coloured overlap overlays and the summary numbers.",
      "views": [
        "image viewer",
        "map",
        "table view",
        "summary stats",
        "form",
        "sidebar list",
        "bar chart"
      ],
      "interactions": [
        "import",
        "select",
        "zoom and pan",
        "keyboard shortcuts",
        "hover for detail",
        "filter",
        "sort",
        "inline edit",
        "undo",
        "toggle view",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "linked views",
        "dashboard"
      ]
    },
    "field": {
      "text": "multi-object spectroscopy observation planning in astronomy",
      "disciplines": [
        "astronomy"
      ],
      "terms": [
        "multi object spectroscopy",
        "observation planning",
        "jwst nirspec"
      ]
    },
    "workflow": {
      "name": "choose a placement on a fixed grid that captures the most prioritized targets under conflict rules",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Load a FITS image, or a JPG/PNG with a WCS sidecar, plus one or more target catalogues. Each catalogue gets its own colour chip, a visibility checkbox and a stacking order. DS9 regions and contours can be added as overlays. Two bundled example fields load with one click.",
          "parts": [
            "input-tab",
            "catalog-editor"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Filter targets by priority class or magnitude. A spreadsheet editor lets the person sort and edit cells, add columns, derive weight from priority (or the reverse), and apply the changes back.",
          "parts": [
            "catalog-editor"
          ]
        },
        {
          "step": "set where the layout sits",
          "here": "Set RA/Dec and the V3 PA roll with a slider, or type an aperture PA. Pick a disperser/filter. Optionally compute the allowed roll window for a date.",
          "parts": [
            "pointing-tab",
            "field-canvas"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "The optimizer searches a grid of RA, Dec and PA, then refines the top candidates. It scores by count (Democracy), by weight sum (Meritocracy) or by strict priority tiers (Hierarchy), with optional collision protection for chosen targets. It shows live progress and the ten best solutions with per-tier scores, and Apply #N opens slitlets on every target placed.",
          "parts": [
            "optimizer-dialog"
          ]
        },
        {
          "step": "place or remove items by hand with live conflict feedback",
          "here": "Clicking the image opens an N-shutter slitlet at the nearest operable shutter and tags it with the catalogue source inside. Clicking an open shutter closes it, and Space toggles the single shutter under the pointer. Orange, pink and purple overlays mark shutters masked by spectra, masked by stuck-open shutters, or in conflict. Undo and clear are available.",
          "parts": [
            "field-canvas",
            "settings-tab"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "A stats bar shows the pointing, roll, number of open shutters, targets covered, spectral conflicts and the disperser.",
          "parts": [
            "stats-bar"
          ]
        },
        {
          "step": "export the result",
          "here": "Save a session, or export a timestamped bundle containing an APT source catalogue, an MPT plan JSON, a README of the import steps, eMPT target, pointing and shutter-mask files, and a workspace JSON. Earlier APT plans, shutter-mask CSVs or .aptx archives can be imported back in.",
          "parts": [
            "mpt-tab"
          ]
        }
      ],
      "distinctive": [
        "Shutters come from a real instrument grid with a known operability map, so targets can only go in operable shutters and stuck-open shutters always contaminate their rows.",
        "Each open slitlet's spectrum is projected along the dispersion direction, and the overlap is classified live as masked by a pick, masked by a stuck-open shutter, or a conflict between two slitlets.",
        "Three scoring rules are available: equal count, weighted sum, or strict priority tiers where a higher tier is never traded for any number of lower ones.",
        "Selected high-priority targets can be protected so that no other spectrum may overlap theirs during the search.",
        "The plan round-trips with the observatory's proposal tool formats, including a byte-compatible shutter-mask CSV."
      ]
    }
  },
