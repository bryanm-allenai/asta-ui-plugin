  "app": {
    "title": "Plottle: a point-and-click workbench for plotting and analysing scientific data files",
    "summary": "The person loads one or more data files (tables, arrays or instrument spectra), or picks a built-in example, and reads a preview with quick statistics. They can reshape or clean a dataset with non-destructive table operations. They pick a plot type, which is pre-chosen from the data's shape, set columns and style, and generate a figure that they can annotate, zoom, and keep as a reusable style preset. They then run analyses on the same dataset, such as descriptive statistics, curve fits, smoothing and baseline correction, peak finding and fitting, or hypothesis tests. Finally they export figures, derived data, analysis results, a PDF report or a whole session.",
    "task": {
      "text": "Turn raw scientific data files into publication-ready figures and computed results such as fits, peak parameters and test statistics, without writing code.",
      "verbs": [
        "derive",
        "explore",
        "summarize",
        "compare",
        "clean"
      ]
    },
    "data": {
      "text": "Numeric tables and arrays loaded from common and instrument file formats (CSV, Excel, NumPy, JCAMP-DX, SPC, HDF5, NetCDF, mzML), often x–y signals such as spectra or time series.",
      "item": "a dataset: a table of numeric columns or an array, such as one spectrum or one experiment's measurements",
      "shapes": [
        "table",
        "time series",
        "field",
        "versions"
      ]
    },
    "stage": {
      "text": "analysing and plotting measured data after collection, before writing up",
      "terms": [
        "analyze",
        "explore",
        "clean"
      ]
    },
    "mechanism": {
      "text": "A sidebar of pages shares a session store of datasets: the upload page fills it, and the plot, analysis, data-tool and export pages each pick a dataset from it and write their figures and results back into history for export. Each page is a form of column pickers and options that produces a chart or a result table on demand.",
      "views": [
        "form",
        "table view",
        "line chart",
        "scatter plot",
        "heatmap",
        "small multiples",
        "summary stats",
        "sidebar list"
      ],
      "interactions": [
        "import",
        "select",
        "toggle view",
        "zoom and pan",
        "hover for detail",
        "filter",
        "sort",
        "export",
        "exclude and refit"
      ],
      "patterns": [
        "master-detail",
        "small multiples",
        "dashboard"
      ]
    },
    "field": {
      "text": "spectral and signal data analysis and figure-making in physical and analytical chemistry",
      "disciplines": [
        "chemistry"
      ],
      "terms": [
        "spectroscopy",
        "curve fitting",
        "peak analysis"
      ]
    },
    "workflow": {
      "name": "load measurements, plot them, fit and test them, export figures and results",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload a file in one of many tabular, array or instrument formats, load a built-in example, or batch-import a whole folder; the dataset gets a summary card, a preview and quick statistics in the sidebar.",
          "parts": [
            "data-upload"
          ]
        },
        {
          "step": "clean and reshape the table",
          "here": "Data Tools tabs add formula columns, normalise, pivot or melt, filter rows, sort, merge, fill or drop missing values, resample and roll; each result is saved as a new dataset.",
          "parts": [
            "data-tools"
          ]
        },
        {
          "step": "plot the data",
          "here": "Pick a library and one of 27 plot types (pre-chosen from the data's shape), set columns and style, then Generate Plot; overlays, zoom ranges and saved style presets refine the figure.",
          "parts": [
            "quick-plot",
            "multi-plot"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Analysis Tools tabs compute descriptive statistics and normality, linear, polynomial, exponential or custom curve fits with R², smoothing, filtering, FFT and baseline correction.",
          "parts": [
            "analysis-tools"
          ]
        },
        {
          "step": "find and fit peaks",
          "here": "Find & Measure detects peaks and reports position, height, FWHM and area; Fit Peaks fits Gaussian, Lorentzian or Voigt models to one or several peaks together.",
          "parts": [
            "peak-analysis"
          ]
        },
        {
          "step": "compare groups with a statistical test",
          "here": "Statistical Tests runs t-tests, non-parametric tests, ANOVA with Tukey HSD, correlations and chi-square, and shows a significance verdict and a result table.",
          "parts": [
            "analysis-tools"
          ]
        },
        {
          "step": "export the result",
          "here": "Export downloads past plots as PNG, SVG, PDF or HTML, datasets as CSV, JSON or NPY, analysis results as JSON, a PDF report, or a saved session that can be reloaded.",
          "parts": [
            "export-results"
          ]
        }
      ],
      "distinctive": [
        "Reads instrument formats directly (JCAMP-DX, SPC, mzML, NetCDF, HDF5), so spectra come in without conversion.",
        "Peak work fits lineshape models (Gaussian, Lorentzian, Voigt, pseudo-Voigt) and reports FWHM and integrated area per peak.",
        "Signal tools include baseline correction (polynomial, rolling ball, asymmetric least squares) before peaks are measured.",
        "Every figure and analysis is stored in a session history, so a PDF report or the whole session can be exported at the end.",
        "Named style presets save a plot's look and plot type for reuse across datasets."
      ]
    }
  },
