  "app": {
    "title": "CAFE – Cell Analyzer for Flow Experiment",
    "summary": "A person uploads one CSV per sample, checks the detected samples, groups and shared markers, then works through a guided pipeline: outlier filtering on each cell's total signal, optional batch correction on a technical batch they assign, optional PCA, and UMAP with Leiden clustering. Each step's result has to be reviewed before the next opens. The run ends in a ZIP holding the processed AnnData, per-sample clustered CSVs, cluster count, frequency and median tables, and a parameters file with a draft methods paragraph. The person can then reload the AnnData to explore clusters in an interactive embedding and many plot tabs, compare groups statistically, merge clusters, and name clusters as cell types, by hand or with marker-signature gating, before exporting the annotated file.",
    "task": {
      "text": "Turn per-sample cytometry exports into quality-filtered, clustered and cell-type-labelled populations, then compare their abundance and marker expression between groups.",
      "verbs": [
        "derive",
        "clean",
        "annotate",
        "compare",
        "explore",
        "organize",
        "summarize"
      ]
    },
    "data": {
      "text": "Per-cell marker intensity tables, one file per sample named by sample and group, pooled into one cells × markers matrix with sample, group, batch and cluster labels.",
      "item": "a single cell with an intensity value for each marker",
      "shapes": [
        "table",
        "categories",
        "judgements"
      ]
    },
    "stage": {
      "text": "cleaning and clustering gated cytometry exports, then labelling and comparing populations",
      "terms": [
        "clean",
        "analyze",
        "annotate",
        "compare"
      ]
    },
    "mechanism": {
      "text": "A stepper moves the person through upload, QC, batch correction, PCA and clustering. Each step previews its effect, such as % of cells removed or batch distance before and after correction, and waits for review before the next step opens. Downstream pages reload the saved AnnData: a lasso-selectable embedding with tabs of static and statistical plots, a merge builder beside a cluster map, and an annotation form or marker-signature grid that labels clusters or cells.",
      "views": [
        "table view",
        "scatter plot",
        "heatmap",
        "bar chart",
        "form",
        "summary stats",
        "side-by-side panes"
      ],
      "interactions": [
        "import",
        "brush",
        "zoom and pan",
        "hover for detail",
        "toggle view",
        "inline edit",
        "apply label",
        "multi-select",
        "exclude and refit",
        "export"
      ],
      "patterns": [
        "status pipeline",
        "overview and detail",
        "dashboard",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "high-dimensional clustering of spectral flow cytometry in immunology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "flow cytometry",
        "immunology",
        "single cell clustering"
      ]
    },
    "workflow": {
      "name": "clean, cluster and label a pooled set of measurements, then compare groups",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload one CSV per sample named SampleID_Group. A review table lists samples, groups and cell counts, and blocks Proceed until filenames and marker names match across files.",
          "parts": [
            "upload-review"
          ]
        },
        {
          "step": "exclude bad items and recompute",
          "here": "Drop cells whose total marker signal lies beyond n MADs from the median, either globally or per sample. Per-sample n is auto-set from a target % removed per tail, and summary and sensitivity tables preview the effect before Apply QC.",
          "parts": [
            "qc-filter"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Assign each sample to a technical batch, check per-marker batch distance (EMD), and optionally run ComBat while keeping the biological group as a covariate. A before/after EMD table and scatter show the result.",
          "parts": [
            "batch-correction"
          ]
        },
        {
          "step": "group items into clusters",
          "here": "Optionally run PCA to a cumulative-variance threshold. Then set the Leiden resolution, n_neighbors, min_dist and distance metric to compute UMAP and Leiden clusters, shown as UMAPs coloured by cluster and by group.",
          "parts": [
            "clustering-export",
            "pipeline-stepper"
          ]
        },
        {
          "step": "export the result",
          "here": "Download a ZIP containing the processed .h5ad, per-sample CSVs with cluster and UMAP columns, count, frequency and median-expression tables, UMAP PNGs, and a parameters file with a draft methods paragraph.",
          "parts": [
            "clustering-export"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Reload the .h5ad to lasso cells in an interactive UMAP and read their marker profile. Tabs of heatmaps, dot plots, composition bars and Sankeys show the clusters, and statistics tabs compare groups (effect size, differential abundance, normality).",
          "parts": [
            "visualization"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "Merge Leiden clusters into named metaclusters with a validated builder. Then name every cluster as a cell type, or define cell types by +/− marker signatures that per-sample Gaussian mixtures gate into High, Low or Ambiguous confidence calls. Export the annotated AnnData.",
          "parts": [
            "merge-clusters",
            "cluster-annotation"
          ]
        }
      ],
      "distinctive": [
        "Every pipeline step stashes its result and waits for review, so the next step opens only after the person has seen what QC, batch correction or PCA did.",
        "Batch correction is keyed to a technical batch the person assigns per sample, with the biological group kept as a covariate so group differences are not erased. EMD measures the batch effect before and after.",
        "Outlier thresholds can be set per sample from a target % removed per tail, with a sensitivity table across n_MADs.",
        "Probabilistic annotation fits a two-component Gaussian mixture per marker per sample, falling back to a pooled or neutral gate. It labels each cell's call as High, Low or Ambiguous confidence and checks purity against the Leiden clusters.",
        "The export bundles a draft methods paragraph and every parameter used, alongside per-sample CSVs ready to re-import into the gating software."
      ]
    }
  },
