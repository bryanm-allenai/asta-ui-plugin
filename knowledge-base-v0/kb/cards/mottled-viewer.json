  "app": {
    "title": "Mottled — latent trajectory scene viewer",
    "summary": "A person opens a scene file of a language model's captured hidden states, or runs a small model in the page on prompts they type. Each prompt's tokens are drawn as paths that climb through the model's layers over a density terrain made from the states themselves. They switch runs on and off, scrub or play through the layers, and hover or click any point on a path to read the model's readout, nearest neighbours and attention/MLP split at that layer. Along the way they read a distance table between runs, a density-uncertainty overlay, and a panel saying how much of the picture survived the flattening to 2-D and what produced it. For a scene with one point per labelled prompt, they switch layouts, colour by a label, and read a held-out separability score at each layer. What they get is a hypothesis about where the model's states go, with an honest note of how far the picture can be trusted.",
    "task": {
      "text": "Explore how a model's hidden states move and gather layer by layer for one or more prompts, compare runs, and inspect any state, while seeing how faithful the 2-D projection is.",
      "verbs": [
        "explore",
        "compare",
        "identify",
        "locate"
      ]
    },
    "data": {
      "text": "Hidden-state vectors from each layer of a model's forward pass, projected to 2-D, joined into one path per token, laid over a density field estimated from those same states. Each state carries readout predictions, a projection-fidelity score and, optionally, labels per prompt.",
      "item": "one token's hidden state at one layer of a model's forward pass",
      "shapes": [
        "time series",
        "sequence",
        "field",
        "categories"
      ]
    },
    "stage": {
      "text": "exploring a model's hidden states layer by layer to form hypotheses, before testing them causally",
      "terms": [
        "explore",
        "compare"
      ]
    },
    "mechanism": {
      "text": "A 3-D canvas draws the density terrain with token paths over it. A layer slider moves markers along every path at once, and a ray-picked hover or click opens a state's details in an inspector. Side panels toggle runs and overlays, list distances between runs, switch pellet layouts and colouring, and spell out projection fidelity and provenance.",
      "views": [
        "map",
        "line chart",
        "detail panel",
        "summary stats",
        "list",
        "table view"
      ],
      "interactions": [
        "import",
        "zoom and pan",
        "hover for detail",
        "select",
        "time slider",
        "toggle view",
        "filter"
      ],
      "patterns": [
        "overview and detail",
        "linked views"
      ]
    },
    "field": {
      "text": "hidden-state trajectories and logit-lens readouts in language-model interpretability",
      "disciplines": [
        "computer science"
      ],
      "terms": [
        "interpretability",
        "logit lens",
        "residual stream"
      ]
    },
    "workflow": {
      "name": "follow items through ordered stages on one shared map and inspect any point",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Open a .mtj scene with the button, drag it onto the page, or pass ?file=. Alternatively, open 'Run a model in this page', pick or load a model, type one prompt per line (two lines compare them) and press Capture.",
          "parts": [
            "scene-loader",
            "in-page-capture"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "Every token's path is drawn over a density terrain built from all the projected states. Drag to orbit, shift- or right-drag to pan, and scroll or pinch to zoom.",
          "parts": [
            "scene-canvas"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Checkboxes in the runs panel hide or show each prompt's run. Separate toggles add the attention-flow lines and the density standard-error overlay.",
          "parts": [
            "runs-panel"
          ]
        },
        {
          "step": "step through the ordered stages",
          "here": "The layer slider, or play at 0.5×, 1× or 2×, moves a marker along every path from the embedding layer to the last layer.",
          "parts": [
            "layer-scrubber",
            "scene-canvas"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Hovering a path shows the state at that fractional layer: top-k readout labelled with its lens, nearest tokens, attention/MLP share and neighbourhood preservation. A click pins it and Escape clears the pin.",
          "parts": [
            "state-inspector",
            "scene-canvas"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "A table gives the Hausdorff distance, normalised DTW and shared tokens between runs. In a pellet scene, a person switches between the monitor and open layouts, colours by any label, sees rings on pellets whose labels disagree, and reads the held-out AUROC against a shuffle band at the current layer.",
          "parts": [
            "runs-panel",
            "pellet-panel"
          ]
        },
        {
          "step": "judge how far to trust the picture",
          "here": "The 'Reading this scene' panel states the share of states that kept their neighbours through the projection (flagged amber when low), what the terrain does and does not mean, and the models, projection, seed and lens that produced the scene.",
          "parts": [
            "reading-panel"
          ]
        }
      ],
      "distinctive": [
        "Every state carries a measured projection-fidelity score, and states whose local structure did not survive the flattening are marked, so the picture reports how much it distorts.",
        "The terrain is a density field made from the run's own states. A standard-error overlay is on by default to show where that density rests on too few points.",
        "Layers act as the time axis, and generated tokens add a second, decode axis drawn distinctly.",
        "One-point-per-prompt scenes show a cross-fitted linear-monitor score with its AUROC per layer beside a label-shuffle null band.",
        "A model can run entirely in the browser (GGUF or .mwt weights, with WebGPU or CPU) to capture new scenes without a server."
      ]
    }
  },
