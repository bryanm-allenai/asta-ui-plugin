  "app": {
    "title": "MiPrimer (Mi-Primer)",
    "summary": "A person pastes one microRNA sequence into a single field and presses Design. The server checks that the sequence is RNA of an allowed length, converts it to DNA and generates candidate forward and reverse primers, padding each with an adapter until its melting temperature clears a threshold. The result page shows the sequence with two tables, forward and reverse primers, each listing sequence, length and melting temperature. Each row also has three green or red markers for the A/T rules at the 3′ end, and pointing at a marker shows the rule it checks.",
    "task": {
      "text": "Design and screen candidate qPCR primers for a short RNA sequence against melting-temperature and 3′-end composition rules.",
      "verbs": [
        "derive",
        "identify",
        "plan"
      ]
    },
    "data": {
      "text": "One short nucleotide sequence entered by the person, and a table of primer candidates computed from it, each with length, melting temperature and pass/fail flags for its 3′ end.",
      "item": "a candidate primer sequence designed against the input RNA",
      "shapes": [
        "sequence",
        "table",
        "judgements"
      ]
    },
    "stage": {
      "text": "designing primers before a qPCR assay is run",
      "terms": [
        "plan"
      ]
    },
    "mechanism": {
      "text": "A one-field form posts the sequence to the server, which computes the candidates and renders them as two tables. Each row's 3′-end checks appear as coloured squares, and hovering over one explains the rule it tests.",
      "views": [
        "form",
        "table view"
      ],
      "interactions": [
        "import",
        "hover for detail"
      ],
      "patterns": []
    },
    "field": {
      "text": "PCR primer design for microRNA qPCR in molecular biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "primer design",
        "qpcr",
        "microrna"
      ]
    },
    "workflow": {
      "name": "generate candidates from one input and screen them against design rules",
      "steps": [
        {
          "step": "bring the data in",
          "here": "type or paste one microRNA sequence into the 'MiRNA sequence' field and press Design",
          "parts": [
            "sequence-form"
          ]
        },
        {
          "step": "check the input is valid",
          "here": "whitespace is stripped and the sequence must contain only A, C, G and U and be between 15 and 40 nucleotides long",
          "parts": [
            "primer-engine"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "the RNA is converted to DNA. Forward candidates take 12 to 17 bases from the 5′ end, and reverse candidates take the reverse complement of the last 4 to 8 bases behind a poly-T tail. Each candidate is padded with adapter bases until its nearest-neighbour Tm is above 59 °C",
          "parts": [
            "primer-engine"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "forward and reverse primers are listed in two tables with sequence, length in bp and Tm in °C, under the input sequence",
          "parts": [
            "forward-table",
            "reverse-table"
          ]
        },
        {
          "step": "identify which items pass each criterion",
          "here": "three green or red squares per row show whether the last 5, 3 and 2 bases at the 3′ end hold the required number of A or T residues, and hovering shows the rule",
          "parts": [
            "at-status-markers"
          ]
        }
      ],
      "distinctive": [
        "Candidates only appear if adapter padding lifts their melting temperature above a fixed 59 °C threshold, computed with salt-corrected nearest-neighbour thermodynamics",
        "Forward and reverse primers are built differently: reverse primers get a poly-T tail and a separate adapter, so they are shown in separate tables",
        "3′-end A/T composition is checked against three rules of increasing strictness and shown as a row of pass/fail squares with hover explanations",
        "Input is limited to short RNA strings (15–40 nt), which suits microRNA rather than general templates"
      ]
    }
  },
