  "app": {
    "title": "PTMVision – Interactive Exploration of Post Translational Modifications",
    "summary": "A person starts a session in one of three ways: they upload a search-engine result file in a chosen format, with optional modification classes to exclude and a mass-shift tolerance for merging; they re-upload a saved session; or they start an example. An overview of the whole sample shows which modification types share sites, along with each type's mass shift, its site count and the counts per modification class. The person can re-sort it, highlight chosen types and zoom. A sortable, filterable table lists one protein per row. Choosing a protein and clicking Display opens a detail dashboard with modifications per sequence position, modification counts by amino acid and annotation tracks. It can switch to a structure view: a residue contact map is linked to a 3D model, and clicking a contact shows the modifications on both residues and the distance between them. The person can save the session as a file and download each chart as an image.",
    "task": {
      "text": "Explore the post-translational modifications found in a proteomics dataset, first across the whole sample and then on one protein, in its sequence and 3D structural context.",
      "verbs": [
        "explore",
        "summarize",
        "lookup",
        "locate",
        "compare"
      ]
    },
    "data": {
      "text": "Modification sites identified by a mass-spectrometry search engine. Each site is a protein accession, a residue position and a modification with its mass shift and class. The data is enriched with protein annotations, sequences and predicted structures.",
      "item": "a modified residue position on a protein, with its modification type, mass shift and class",
      "shapes": [
        "table",
        "sequence",
        "categories",
        "network",
        "per element"
      ]
    },
    "stage": {
      "text": "exploring identified modification sites after the database search, before deeper analysis",
      "terms": [
        "explore",
        "analyze"
      ]
    },
    "mechanism": {
      "text": "A sample-level overview, made of a co-occurrence heatmap with mass-shift, count and class charts aligned beside it, sits above a filterable protein table. Selecting a row and clicking Display loads a per-protein dashboard. Its modifications view lines a position-by-modification matrix up with annotation tracks. Its structure view links a residue contact map to a 3D structure viewer and a contact-detail chart.",
      "views": [
        "heatmap",
        "bar chart",
        "scatter plot",
        "table view",
        "sequence track",
        "detail panel",
        "image viewer"
      ],
      "interactions": [
        "import",
        "filter",
        "sort",
        "select",
        "hover for detail",
        "zoom and pan",
        "toggle view",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "master-detail",
        "linked views",
        "dashboard"
      ]
    },
    "field": {
      "text": "PTM analysis of mass-spectrometry search results in proteomics",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "proteomics",
        "post translational modifications",
        "mass spectrometry"
      ]
    },
    "workflow": {
      "name": "explore a collection at a glance, then one item in its full context",
      "steps": [
        {
          "step": "bring the data in",
          "here": "The person picks the input format (ionbot, MSFragger, Sage, MaxQuant, Spectronaut, CSV, mzIdentML and others) and uploads a file. They can exclude modification classes and set the mass-shift tolerance before clicking Submit. They can also re-upload a saved .zlib session or start an example.",
          "parts": [
            "session-start"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "A heatmap shows the sites shared between modification types. Beside it, aligned charts show each type's mass shift and site count, plus the counts per class. The person can re-sort by mass shift or count, highlight chosen types and zoom.",
          "parts": [
            "sample-overview"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Multi-select filters on modification name and on protein name or accession narrow the protein table. The filters combine with AND. Columns sort by sequence length, number of modified positions or number of distinct modifications.",
          "parts": [
            "protein-table"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "The person selects one row, which enables Display. The dashboard then shows modifications per position as a presence matrix with UniProt annotation tracks, counts per amino acid and counts per class. A UniProt comment popup is also available.",
          "parts": [
            "protein-table",
            "modifications-view"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "Residue contacts are computed from the protein's predicted structure using a distance cutoff. The structure view draws them as a contact map, colored by whether the residues are modified. Clicking a cell highlights both residues on the 3D model and lists their modifications and distance.",
          "parts": [
            "structure-view"
          ]
        },
        {
          "step": "export the result",
          "here": "The person can download the session as a .zlib file, which they can re-upload later, and save the overview or the dashboard as a PNG.",
          "parts": [
            "session-export",
            "sample-overview",
            "modifications-view"
          ]
        }
      ],
      "distinctive": [
        "Modifications whose mass shifts fall within a user-set tolerance are marked as merge candidates when the overview is sorted by mass shift.",
        "Modification sites are placed in 3D structural context: a residue contact map computed from the predicted structure is linked to a 3D model.",
        "The tool reads output from several search engines and maps every site to standard modification names and classes before display.",
        "A co-occurrence heatmap counts the sites carrying two modification types at once."
      ]
    }
  },
