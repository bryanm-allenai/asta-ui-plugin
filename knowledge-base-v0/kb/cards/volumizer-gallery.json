  "app": {
    "title": "Volumizer Gallery",
    "summary": "A person uploads a protein structure file, picks a voxel resolution and an assembly policy, and runs the analysis. A step strip shows it moving from queued to running, indexing and done, and then the result opens on its own. Analysed structures can also be browsed in a gallery of cards, each with three axis thumbnails. The person narrows the gallery with range filters on protein properties and on the size and shape of each volume type, sorts it by any measure, searches by entry ID, picks which metrics the cards show, and saves filter and display settings as presets. Opening a card shows the structure in an interactive 3D viewer with its pores, pockets and cavities drawn as coloured surfaces, next to summary metrics, a per-volume table and links to download the annotated files.",
    "task": {
      "text": "Find protein structures whose internal solvent volumes (pores, pockets, cavities) have a wanted size and shape, and inspect each match in 3D.",
      "verbs": [
        "identify",
        "explore",
        "lookup",
        "derive",
        "compare"
      ]
    },
    "data": {
      "text": "Protein structures that have been analysed for internal solvent volumes. Each structure has structure-level properties and a list of detected volumes, each with a type and measured geometry, plus rendered thumbnails and annotated structure files.",
      "item": "one analysed protein structure with its detected pores, pockets and cavities",
      "shapes": [
        "table",
        "image collection",
        "molecular structure"
      ]
    },
    "stage": {
      "text": "screening analysed protein structures for wanted internal volumes, after batch volume detection",
      "terms": [
        "explore"
      ]
    },
    "mechanism": {
      "text": "A sidebar of collapsible range filters, sort and page size drives a paged grid of result cards. Each card shows three axis thumbnails and the metrics the person has chosen to display. Opening a card brings up a dialog with a 3D viewer, where the volume types are coloured surfaces over the protein cartoon, beside a metrics panel and a per-volume table.",
      "views": [
        "form",
        "thumbnail grid",
        "detail panel",
        "table view",
        "summary stats",
        "3d structure viewer"
      ],
      "interactions": [
        "import",
        "filter",
        "search",
        "sort",
        "select",
        "toggle view",
        "zoom and pan",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "small multiples"
      ]
    },
    "field": {
      "text": "detecting solvent volumes in protein structures, in structural biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "structural biology",
        "cavity detection",
        "protein structure"
      ]
    },
    "workflow": {
      "name": "filter a collection by computed measures and open each match in detail",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload a .pdb or .cif file with a voxel resolution and an assembly policy, then run the analysis. A step strip goes from Queued to Running to Indexing to Done, and the new result opens automatically. Batch runs can also be picked from a Run selector.",
          "parts": [
            "upload-workbench"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Collapsible Protein, Pores, Pockets and Cavities sections hold min and max fields for chains, residues, secondary-structure fractions, volume, length, diameter, circularity and uniformity. A search box filters by PDB ID.",
          "parts": [
            "filters-panel",
            "results-gallery"
          ]
        },
        {
          "step": "save and reuse a filter setting",
          "here": "Filter and display presets are saved in the browser. Built-in Pores, Pockets and Cavities presets cannot be overwritten, and the active preset comes back when Reset is pressed.",
          "parts": [
            "filter-presets",
            "display-properties"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "A paged grid of cards, each with X, Y and Z thumbnails and metric pills. The person sorts by any measure and chooses which metrics show in the Display Properties popup.",
          "parts": [
            "results-gallery",
            "display-properties"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Open Detail shows a dialog with a Mol* viewer: the protein as a cartoon and each volume type as a coloured surface, with the mouth shells drawn darker. Beside it are structure metrics and a table of every volume, sorted by size.",
          "parts": [
            "detail-dialog",
            "structure-viewer"
          ]
        },
        {
          "step": "export the result",
          "here": "Links in the detail dialog open the annotated CIF and the annotation JSON for that structure.",
          "parts": [
            "detail-dialog"
          ]
        }
      ],
      "distinctive": [
        "Volumes are typed by how many separate openings to the surrounding solvent they have (cavity, pocket, pore), and each type has its own filters, sort keys and colour.",
        "Each item is shown as three fixed-axis renders, so its shape can be compared across the grid without opening it.",
        "Voxel resolution and assembly policy are set when a file is uploaded, and these change what volumes are found.",
        "The 3D view draws the mouth voxels of each volume, where it meets the solvent, in a darker shade than its core."
      ]
    }
  },
