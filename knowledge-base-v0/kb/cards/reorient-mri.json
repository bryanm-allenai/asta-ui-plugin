  "app": {
    "title": "Reorient: manual reorientation and cropping of MRI volumes",
    "summary": "A person drops a 3D MRI volume onto the page and sees it in three linked orthogonal views. They pick the Translate or Rotate tool and drag inside any view to line the brain up with the standard planes. They can also load a saved rotation matrix, append one to the current matrix, or reset it. Then they switch to the Select tool and drag a crop box in the views to enclose the part they want to keep. A side panel keeps the matrices and the crop box up to date. They save the affine matrix and the crop box as text files, and the reoriented, cropped volume as a new NIfTI file, so the same result can be reproduced offline by a script.",
    "task": {
      "text": "Align a 3D brain volume to the standard planes by hand, crop it, and save the transform so the result can be reproduced.",
      "verbs": [
        "derive",
        "clean"
      ]
    },
    "data": {
      "text": "A 3D MRI volume (NIfTI) with its voxel-to-world affine matrix, plus a rotation matrix and a crop box as small text files",
      "item": "one MRI volume in a .nii or .nii.gz file",
      "shapes": [
        "field",
        "image"
      ]
    },
    "stage": {
      "text": "preprocessing raw MRI volumes, before segmentation and analysis",
      "terms": [
        "clean"
      ]
    },
    "mechanism": {
      "text": "Three linked slice views (sagittal, coronal, axial) redraw together as the person drags to translate or rotate the volume, and an info panel shows the updated matrices as they change. A tool switch turns on a resizable crop-box overlay in all three views, and buttons load, append, reset and save the matrix and the box, and resample the volume to export it.",
      "views": [
        "image viewer",
        "side-by-side panes",
        "summary stats"
      ],
      "interactions": [
        "import",
        "drag to transform",
        "toggle view",
        "brush",
        "undo",
        "export"
      ],
      "patterns": [
        "linked views"
      ]
    },
    "field": {
      "text": "manual reorientation and cropping of MRI volumes in neuroimaging",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "neuroimaging",
        "neuroanatomy",
        "mri preprocessing"
      ]
    },
    "workflow": {
      "name": "align and crop a 3D volume by hand and save the transform for reproducible reprocessing",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Drop a .nii or .nii.gz file on the upload box, or click Choose. An error message explains when a file fails to load or is unusually large.",
          "parts": [
            "drop-zone"
          ]
        },
        {
          "step": "adjust the item's position and orientation by direct manipulation",
          "here": "With Translate or Rotate chosen in the tool switch, dragging in the sagittal, coronal or axial view moves or turns the volume, and all three views redraw together.",
          "parts": [
            "tool-chooser",
            "slice-views"
          ]
        },
        {
          "step": "reuse or undo an earlier transform",
          "here": "Load a rotation matrix to replace the current one, append one to compose it with the current one, or reset the matrix to the file's original.",
          "parts": [
            "transform-files"
          ]
        },
        {
          "step": "select the region to keep",
          "here": "The Select tool shows a crop-box overlay in each view. Dragging its edges sets the box's min and max corners. A saved box can be loaded, and Reset Selection returns to the default.",
          "parts": [
            "crop-box",
            "transform-files"
          ]
        },
        {
          "step": "check the computed values",
          "here": "An info panel shows the volume shape, the world-to-voxel and voxel-to-world matrices, and the crop-box corners, and updates live.",
          "parts": [
            "info-panel"
          ]
        },
        {
          "step": "export the result",
          "here": "Save the voxel-to-world matrix (reorient.mat) and the crop box (selection.txt) as text, and save the resampled, cropped volume as reoriented.nii.gz.",
          "parts": [
            "exports"
          ]
        }
      ],
      "distinctive": [
        "The matrix and the crop box are saved as plain text, so a companion script can rebuild the same reoriented volume from the original file offline.",
        "The exported volume is resampled to isotropic voxels set to the median of the three original voxel sizes.",
        "Saving the volume warns when the crop box still has its default size.",
        "A matrix can be appended as well as replaced, which composes a new transform with the existing one.",
        "Each view plane maps drags to a different rotation axis, so a 3D rotation is built up from 2D drags."
      ]
    }
  },
