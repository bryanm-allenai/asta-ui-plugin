  "app": {
    "title": "Title and abstract screening queue with exclusion reasons and PRISMA counts",
    "summary": "Records from several database exports are pasted into the page, and duplicates found by title are removed before screening. The screener steps through the records one at a time in a chosen queue, reading each title and abstract with inclusion terms shaded and exclusion flags underlined. For each record they include, exclude with a numbered reason, or mark maybe, mostly from the keyboard, and can add a note. Progress and the counts for a PRISMA flow diagram update as they go, and the decisions download as a CSV named with the screener's initials.",
    "task": {
      "text": "Decide for each retrieved record, from its title and abstract, whether it goes on to full-text review, recording the exclusion reason, and keep the flow-diagram counts and an export for comparing screeners.",
      "verbs": [
        "triage",
        "decide",
        "summarize",
        "annotate"
      ]
    },
    "data": {
      "text": "Bibliographic records exported from several literature databases, each with an id, source database, year, venue, authors, title and abstract, plus the screener's decisions, reasons and notes about them.",
      "item": "one bibliographic record: a title and abstract with its citation details",
      "shapes": [
        "text corpus",
        "judgements",
        "categories",
        "notes"
      ]
    },
    "stage": {
      "text": "screening search results by title and abstract, after deduplication and before full-text review",
      "terms": [
        "decide"
      ]
    },
    "mechanism": {
      "text": "A single-record reader shows one title and abstract at a time from a queue filtered by decision status, with editable term lists highlighting what the criteria look for; a decision bar takes include, exclude-with-reason or maybe by key and moves to the next record. Beside it a counts table follows every decision and an export panel writes one CSV row per record.",
      "views": [
        "document reader",
        "summary stats",
        "form"
      ],
      "interactions": [
        "keyboard shortcuts",
        "accept or reject",
        "apply label",
        "filter",
        "write notes",
        "export"
      ],
      "patterns": [
        "review queue",
        "category palette"
      ]
    },
    "field": {
      "text": "title and abstract screening for a systematic review, in health research",
      "disciplines": [
        "medicine"
      ],
      "terms": [
        "medicine",
        "systematic review",
        "prisma"
      ]
    },
    "workflow": {
      "name": "decide keep or drop for each item in a queue, with a reason, and export the decisions",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Records from the database exports are pasted into the page's record list; copies with the same title, ignoring case and punctuation, are set aside as duplicates and noted on the record kept.",
          "parts": [
            "record-view",
            "prisma-counts"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "A queue menu (All records, Not screened, Maybe, Included, Excluded) with Previous, Next and Next not screened, or the arrow keys and n, and a \"Record k of N in this queue\" line.",
          "parts": [
            "queue-nav"
          ]
        },
        {
          "step": "highlight what the criteria look for in each item",
          "here": "Comma-separated inclusion terms are shaded and exclusion flags get a dashed underline in the title and abstract, with plurals and a trailing * wildcard matched, and a line tallies which terms were found.",
          "parts": [
            "term-highlight",
            "record-view"
          ]
        },
        {
          "step": "decide keep or drop for each item, with a reason",
          "here": "i includes, e opens the six protocol exclusion reasons to pick with 1 to 6, m marks maybe; the next record comes up, Clear decision takes one back, and / jumps to a note field.",
          "parts": [
            "decision-bar",
            "record-view"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "A progress bar of records screened, and a PRISMA counts table: identified per database, duplicates removed, screened, excluded by reason, included, maybe and not yet screened.",
          "parts": [
            "prisma-counts"
          ]
        },
        {
          "step": "export the result",
          "here": "The screener types their initials and downloads a CSV with one row per record, duplicates included and marked, named with the initials and the date.",
          "parts": [
            "export"
          ]
        }
      ],
      "distinctive": [
        "Exclusions must carry one of a fixed list of reasons from the review protocol, chosen by number key, and the counts break exclusions down by that reason.",
        "Counts are laid out as the boxes of a PRISMA flow diagram, from records identified per database through duplicates removed to included and excluded.",
        "Duplicates across databases are removed automatically by normalised title before screening but still exported, marked with the record they duplicate.",
        "The export keeps one row per record and the screener's initials so two independent screeners' files line up for computing kappa.",
        "Decisions, notes, term lists and the place in the queue persist in the browser between sessions."
      ]
    }
  },
