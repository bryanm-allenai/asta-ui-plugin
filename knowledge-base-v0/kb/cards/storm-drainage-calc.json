  "app": {
    "title": "Storm Drainage Calculation",
    "summary": "A person brings in rainfall records in one of three ways: uploading or pasting a time series, fetching one from an online archive by coordinates, or pasting a ready table of annual maxima. They check that the records can be read and cover enough years, then take the annual maxima for each duration and fit an extreme-value distribution to get an intensity–duration–frequency table, which they adopt as the design table. Instead of raw records they can enter a published table or equation coefficients. They choose a time of concentration and a return period to read off a design intensity. They send that intensity into peak-flow, runoff-depth and design-storm calculators. A results dashboard sums up the key outputs, and the tables, charts and project are exported as CSV, PNG and a project file.",
    "task": {
      "text": "Derive a design rainfall intensity from rainfall records or published curves and carry it through standard runoff and peak-flow calculations for a preliminary drainage design.",
      "verbs": [
        "derive",
        "summarize",
        "clean"
      ]
    },
    "data": {
      "text": "Rainfall depth records over time, reduced to tables of annual maxima and intensity by duration and return period, plus lookup tables of reference coefficients and a library of named storm distributions.",
      "item": "a rainfall reading at a timestamp, or a row of an intensity–duration–frequency table (one duration across return periods)",
      "shapes": [
        "time series",
        "table"
      ]
    },
    "stage": {
      "text": "preliminary design calculations, from rainfall records to a design flow, before detailed sizing",
      "terms": [
        "analyze"
      ]
    },
    "mechanism": {
      "text": "Pages in a side navigation follow the order of the calculation: a numbered wizard turns raw records into an adopted table, a design page reads a single design value off that table, and tabbed calculators take that value and plot and tabulate their own results. Each calculator writes a headline number to a results dashboard.",
      "views": [
        "form",
        "table view",
        "line chart",
        "bar chart",
        "list",
        "summary stats"
      ],
      "interactions": [
        "import",
        "search",
        "filter",
        "select",
        "toggle view",
        "export"
      ],
      "patterns": [
        "dashboard",
        "step by step wizard"
      ]
    },
    "field": {
      "text": "design-storm and peak-runoff calculations in stormwater engineering",
      "disciplines": [
        "engineering"
      ],
      "terms": [
        "stormwater hydrology",
        "idf curves",
        "rational method"
      ]
    },
    "workflow": {
      "name": "fit a frequency curve to records and carry a design value through a chain of calculations",
      "steps": [
        {
          "step": "bring the data in",
          "here": "upload or paste datetime,rain_mm rows or a Year×duration annual-max table, fetch hourly precipitation from Open-Meteo or NASA POWER by latitude/longitude and year range, or load a sample",
          "parts": [
            "raw-rainfall"
          ]
        },
        {
          "step": "check the data for problems before using it",
          "here": "a quality check reports rows, years, maximum rainfall and a status; it warns when the record is short or when requested durations are shorter than the reading interval",
          "parts": [
            "raw-rainfall"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "rolling-window sums give each year's maximum depth per duration; a Gumbel frequency factor turns them into depths per return period, which are converted to mm/hr and adopted into the design table",
          "parts": [
            "annual-max-gumbel"
          ]
        },
        {
          "step": "read the design value off the fitted curve",
          "here": "a table (intensity or depth converted to intensity) or Sherman/general a,b,c,d coefficients builds IDF curves on a log axis; I is interpolated at Tc for the chosen return period, snapping to the nearest return period in the table",
          "parts": [
            "idf-design"
          ]
        },
        {
          "step": "feed the value into the downstream calculations",
          "here": "I is sent to the Rational Method (Q = C·I·A/360, in four flow units), alongside SCS curve-number runoff depth and a design-storm hyetograph built from a searchable pattern library",
          "parts": [
            "hydraulic-calcs",
            "rational-method",
            "cn-runoff",
            "rainfall-designer"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "result cards show the maximum IDF intensity, the runoff depth, the number of hyetograph rows and the peak discharge, with a dash for anything not yet computed",
          "parts": [
            "results-dashboard"
          ]
        },
        {
          "step": "export the result",
          "here": "CSV for each module's table, PNG charts at a chosen resolution scale, and a saved project file that can be reopened",
          "parts": [
            "idf-design",
            "hydraulic-calcs"
          ]
        }
      ],
      "distinctive": [
        "Durations shorter than the raw reading interval are dropped, with a warning that short durations can't be derived from coarser data",
        "A published table can be entered as rainfall depth and is converted to intensity with I = depth × 60 / duration",
        "Coefficients come from built-in reference tables (curve number by land use and soil group, runoff C by surface); a tag shows where each value came from, manual edits are marked, and a button resets the value to the table",
        "A searchable library of about 90 named design-storm distributions, each with an explanation of its method and formulas",
        "Right-to-left Arabic interface with English engineering variable names, and project metadata kept for report headers"
      ]
    }
  },
