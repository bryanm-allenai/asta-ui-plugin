  "app": {
    "title": "FLAT: FoLiA Linguistic Annotation Tool",
    "summary": "A person uploads a document to a shared index, converting it from another format if they need to, and opens it in a reader that shows the text by document, paragraph or sentence. They pick one annotation type as the focus, which colours the words by class and shows a legend. They click a word, or select a span of several words, and in an editor dialog give it a class from the set definition, add comments, features or relations, and submit it straight away or queue it. They can search with a query language to highlight what matches, look at structure as a tree, undo through the history, save labelled versions, and download the annotated document as FoLiA XML.",
    "task": {
      "text": "Add, correct and review layered linguistic annotations on the words and spans of a structured text document, using label sets drawn from shared set definitions.",
      "verbs": [
        "annotate",
        "clean",
        "explore",
        "locate",
        "curate"
      ]
    },
    "data": {
      "text": "Structured text documents (divisions, paragraphs, sentences, words) with several layers of annotation on top, each layer a type with a declared set of classes. Documents sit in a directory index with metadata and a version history.",
      "item": "a word, or a span of words, in a structured text document, with its annotations",
      "shapes": [
        "document",
        "text corpus",
        "spans",
        "categories",
        "hierarchy",
        "versions",
        "notes"
      ]
    },
    "stage": {
      "text": "annotating a tokenised text corpus with linguistic layers, after conversion and before analysis",
      "terms": [
        "annotate",
        "clean"
      ]
    },
    "mechanism": {
      "text": "A document reader shows the text coloured by the chosen focus annotation, with a legend, and hovering a word shows its annotations in a detail panel. Clicking a word opens an editor form whose class choices come from the set definition, and span selection lets the person add further words by clicking them in the text. A search dialog highlights matches in the reader, and a history dialog and version-save box keep a record that can be reverted.",
      "views": [
        "document reader",
        "detail panel",
        "form",
        "sidebar list",
        "tree view",
        "list"
      ],
      "interactions": [
        "import",
        "select",
        "select text span",
        "apply label",
        "hover for detail",
        "search",
        "filter",
        "toggle view",
        "write notes",
        "undo",
        "export"
      ],
      "patterns": [
        "category palette",
        "overview and detail",
        "version history"
      ]
    },
    "field": {
      "text": "multi-layer corpus annotation in computational linguistics",
      "disciplines": [
        "linguistics"
      ],
      "terms": [
        "corpus annotation",
        "computational linguistics",
        "folia"
      ]
    },
    "workflow": {
      "name": "label stretches of a document with categories from a declared scheme, keeping versions",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload a FoLiA XML file, or a CoNLL-U or reStructuredText file through a configured converter, into a namespace directory of the document index, then open it",
          "parts": [
            "document-index"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The reader shows the text by perspective (whole document, table of contents, paragraphs or sentences, paged in slices). Choosing an annotation focus colours each word by its class and fills a legend, and hovering a word lists its annotations",
          "parts": [
            "document-reader",
            "focus-legend"
          ]
        },
        {
          "step": "select a stretch and label it with a category",
          "here": "Clicking a word opens the Annotation Editor. 'Select span>' adds further words by clicking them, the class comes from a drop-down built from the set definition, and comments, features, relations or span roles can be added. Each field can be edited directly, as a correction, as an alternative or as a new annotation",
          "parts": [
            "annotation-editor"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "A search dialog takes CQL or FQL queries, and preset searches from the configuration. It highlights the results in the current perspective or switches to a perspective showing only the matches",
          "parts": [
            "search-dialog"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "'Repeat this annotation for the next target' pre-fills the editor for the next clicked word, and 'Queue for later submission' collects edits as queries that are sent together from the console",
          "parts": [
            "annotation-editor",
            "query-console"
          ]
        },
        {
          "step": "keep a record of changes",
          "here": "History & Undo lists past commits and can revert to any of them. 'Save' with a version label stores an explicit named version",
          "parts": [
            "history-versions"
          ]
        },
        {
          "step": "export the result",
          "here": "'View FoLiA XML source' and the Download link in the index save the annotated document as FoLiA XML",
          "parts": [
            "document-index",
            "document-reader"
          ]
        }
      ],
      "distinctive": [
        "Every annotation type must be declared against an external set definition URL before it can be used, and the closed set of classes it defines becomes the drop-down of labels; new types can be declared while working",
        "Annotations are layered: several types and sets sit on the same words, and each can be shown inline above the words, shown on hover, or hidden",
        "Edits can be recorded as corrections with a correction class or as alternatives, rather than overwriting, so the original text and the suggested changes stay visible",
        "Every edit becomes a query in a query language (FQL) that can be inspected, edited and batch-submitted in a console",
        "Structure (division, paragraph, sentence, word) and syntactic or dependency annotations can be drawn as an SVG tree"
      ]
    }
  },
