  "app": {
    "title": "Wildlife Monitor (Raspberry Pi camera-trap dashboard)",
    "summary": "A camera trap records short clips when motion is sensed or on a schedule, and each clip is classified and boxed automatically before it reaches the interface. The person checks the deployment's status and today's counts on a dashboard, and can trigger a test clip to check the camera's framing. They browse every clip as thumbnails, filtered by trigger, animal class and date range, and open one to watch it with its label, sound label and annotated key frames. On each clip they can re-run classification, star it as a highlight, or delete it; they can also select many clips and delete them together. Charts of daily detection counts and the split by animal class summarise the period, and daily timelapses can be watched as a recap.",
    "task": {
      "text": "Review automatically classified camera-trap clips, keep the good ones, delete the empty ones, and track how many detections of each animal class arrive over time.",
      "verbs": [
        "monitor",
        "triage",
        "summarize",
        "curate",
        "identify",
        "clean"
      ]
    },
    "data": {
      "text": "Short video clips from a motion- and schedule-triggered camera trap, each stored as a database record with its trigger type, machine label and confidence, optional sound label, bounding boxes on key frames, and a highlight flag; also daily counts per class and daily timelapse videos.",
      "item": "a short video clip captured by a camera trap, with its automatic species label",
      "shapes": [
        "media",
        "image collection",
        "table",
        "events",
        "judgements",
        "time series"
      ]
    },
    "stage": {
      "text": "monitoring a running camera-trap deployment while clips are collected, and curating them before analysis",
      "terms": [
        "collect",
        "clean",
        "maintain"
      ]
    },
    "mechanism": {
      "text": "The thumbnail gallery is filtered by trigger, class and date and opens each clip in a detail page, where the person can watch the video, see annotated frames, re-classify, highlight or delete it. Highlights are gathered on their own page, and a dashboard and a statistics page reduce the collection to counts and charts that refresh on their own.",
      "views": [
        "thumbnail grid",
        "detail panel",
        "summary stats",
        "bar chart",
        "list",
        "table view"
      ],
      "interactions": [
        "filter",
        "select",
        "multi-select",
        "accept or reject",
        "toggle view"
      ],
      "patterns": [
        "master-detail",
        "dashboard",
        "overview and detail"
      ]
    },
    "field": {
      "text": "camera-trap monitoring with automatic species classification in wildlife ecology",
      "disciplines": [
        "ecology"
      ],
      "terms": [
        "camera trapping",
        "wildlife monitoring",
        "bioacoustics"
      ]
    },
    "workflow": {
      "name": "review an automatically labelled stream of captures and keep the ones worth keeping",
      "steps": [
        {
          "step": "track progress toward a target or a total",
          "here": "The dashboard shows system status, today's total and per-animal counts, and the most recent detections, refreshed every 30 seconds; a Test Capture button records a clip and opens its result.",
          "parts": [
            "dashboard"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "The gallery shows every detection as a thumbnail card with its trigger badge, animal label with confidence, sound badge and star, and loads more as the person scrolls.",
          "parts": [
            "gallery",
            "gallery-filters"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Dropdowns for trigger type (motion, scheduled, manual) and animal class, and From/To dates, reload the grid.",
          "parts": [
            "gallery-filters"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "A card opens the detection page with the video player, a details table (trigger, analyzed, animal, sound) and a gallery of key frames annotated with bounding boxes.",
          "parts": [
            "detection-detail"
          ]
        },
        {
          "step": "decide keep or drop for each item, with a reason",
          "here": "On the detail page the person can star the clip as a highlight, re-classify it to replace the labels, or delete it with its video after a confirm dialog; in the gallery, checkboxes and Select All feed a bulk Delete Selected.",
          "parts": [
            "detection-detail",
            "gallery",
            "highlights"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "The statistics page shows the total detections, the most common animal and the motion-to-scheduled ratio, a bar chart of daily detections, and a doughnut chart of animals, each over the last 7, 14 or 30 days.",
          "parts": [
            "statistics"
          ]
        }
      ],
      "distinctive": [
        "Every capture records why it was taken (motion, scheduled or manual), so motion-triggered clips can be compared with scheduled background samples.",
        "Two automatic labels sit on each clip, a visual class from frame classification and object detection and a sound class from the audio, and the person can re-run both on demand.",
        "Clips with no animal found are deleted automatically after a set age, so the person reviews a collection that has already been thinned out.",
        "A test-capture button lets the person check camera angle and lighting by recording and analysing a clip on the spot.",
        "A daily timelapse stitches one frame from each of the day's detections into a recap video, shown with that day's animal counts."
      ]
    }
  },
