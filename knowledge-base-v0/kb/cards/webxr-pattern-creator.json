  "app": {
    "title": "WebXR Custom Pattern Creator",
    "summary": "A person opens or uploads a package of test patterns, picks and orders the patterns in a list, and builds or edits each pattern by adding shapes (circles, planes, checkerboards, grilles, dot arrays, bullseyes, text, a timer) and setting their position, rotation, colour, size and texture in a form. Shapes can be given scripted movements that play, pause and stop. The person then steps through the ordered patterns in the browser or a VR headset with arrow keys or controller buttons. The package is saved as a JSON file, or shared through a link, so the same patterns can be shown on other headsets.",
    "task": {
      "text": "Compose, order and share sets of display test patterns so the same stimuli can be shown on different head-mounted displays.",
      "verbs": [
        "plan",
        "organize",
        "curate"
      ]
    },
    "data": {
      "text": "Packages of named scenes. Each scene is a list of parametric 2D shapes placed on a cylinder around the viewer, with optional image textures, and is stored as JSON.",
      "item": "a test pattern: one scene made of positioned shapes with their settings",
      "shapes": [
        "hierarchy",
        "image"
      ]
    },
    "stage": {
      "text": "preparing test stimuli before measuring display image quality on a headset",
      "terms": [
        "plan",
        "collect"
      ]
    },
    "mechanism": {
      "text": "A sidebar list of patterns drives a 3D scene. Clicking a shape in the scene, or choosing it from a dropdown, opens its universal, specific and movement settings in a form that redraws the shape when a value changes. A settings view holds package-level and pattern-level actions, and an ordered animation list for each shape.",
      "views": [
        "canvas",
        "sidebar list",
        "form",
        "list"
      ],
      "interactions": [
        "import",
        "select",
        "multi-select",
        "drag to arrange",
        "inline edit",
        "keyboard shortcuts",
        "toggle view",
        "export"
      ],
      "patterns": [
        "master-detail"
      ]
    },
    "field": {
      "text": "test-pattern creation for image quality assessment of extended reality head-mounted displays",
      "disciplines": [
        "engineering"
      ],
      "terms": [
        "image quality assessment",
        "extended reality",
        "regulatory science"
      ]
    },
    "workflow": {
      "name": "compose a set of stimuli from parametric shapes and present them in order",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Pick the default package or a recent one, or upload package JSON files. The default package has standard patterns: solid colours, grille, crosshair, dot arrays, checkerboards and rings.",
          "parts": [
            "package-panel"
          ]
        },
        {
          "step": "arrange items in the order they will be shown",
          "here": "Add, delete and drag patterns in the Pattern List. Ctrl-click to select several; the order of selection is the display order.",
          "parts": [
            "pattern-list"
          ]
        },
        {
          "step": "build each item from parts and set their parameters",
          "here": "Switch to Edit and add an entity of a chosen type. Select it by clicking it in the scene or from the dropdown, then set position (angle, height, radius), rotation, colours and type-specific values such as rows, tile size, bar count, ring pitch or texture.",
          "parts": [
            "entity-editor",
            "scene-canvas"
          ]
        },
        {
          "step": "script how parts change over time",
          "here": "Give an entity a list of movements (pause, discontinuous jump, start-to-finish, rubberband) with start and end points, speed and acceleration. Play, pause or stop one entity or all of them.",
          "parts": [
            "movement-settings",
            "animation-list"
          ]
        },
        {
          "step": "step through items one at a time",
          "here": "Enter VR, or stay in the browser, and step through the selected patterns with the up and down arrow keys. In the headset, left-controller buttons go back and right-controller buttons go forward.",
          "parts": [
            "pattern-list",
            "scene-canvas"
          ]
        },
        {
          "step": "export the result",
          "here": "Download the package as JSON, with uploaded textures included. Or post it to a paste service to get a shareable link that someone else can import, and rename, cut, copy or paste patterns between packages.",
          "parts": [
            "package-panel",
            "package-settings"
          ]
        }
      ],
      "distinctive": [
        "Shapes are placed on a fixed-radius cylinder around the viewer: horizontal position is an angle in degrees, height is in metres, and depth is worked out for the person.",
        "Standard display-test entities are built in (grille, checkerboard, dot array, circular dot array, bullseye, gradient), along with standard display QC test images as plane textures.",
        "The same package runs on any WebXR headset, so one set of stimuli can be compared across devices.",
        "Entities can carry kinematic motion paths with speed and acceleration, and a scene timer, to make moving stimuli."
      ]
    }
  },
