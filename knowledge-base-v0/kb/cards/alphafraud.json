  },
  "app": {
    "title": "AlphaFraud",
    "summary": "A person opens a dashboard of experimental structures, each already matched to its blind prediction and scored, and picks either the whole archive or one release period. They read the headline counts, scan a scatter of predicted confidence against measured agreement where a shaded zone marks the confident misses, and hover a point to preview its deviation ribbon or click it to open that structure. A searchable, sortable table can be narrowed to the confident misses or the novel sequences and exported as CSV. One structure opens into per-residue error tracks, a calibration plot, error heatmaps, a per-domain table and a 3D viewer with the prediction overlaid. A ranked leaderboard groups repeat structures by protein, and any new identifier can be scored on demand.",
    "task": {
      "text": "Find where blind structure predictions disagree with experimental structures, and flag the cases where the predictor was confident but wrong.",
      "verbs": [
        "compare",
        "identify",
        "derive",
        "summarize",
        "monitor",
        "lookup"
      ]
    },
    "data": {
      "text": "Experimental structures, each paired with its blind prediction and scored on global, local, per-residue, per-domain and confidence-calibration metrics, grouped by release period and by protein.",
      "item": "one protein chain from an experimental structure, paired with its predicted model",
      "shapes": [
        "table",
        "sequence",
        "field",
        "time series",
        "categories",
        "versions"
      ]
    },
    "stage": {
      "text": "auditing predicted models against newly released experimental structures, after both exist",
      "terms": [
        "compare",
        "confirm"
      ]
    },
    "mechanism": {
      "text": "An overview scatter and a filterable table of every scored structure link through to a detail page per structure, where per-residue tracks, heatmaps and a 3D overlay show where the prediction departs from the experiment. A period picker scopes the overview, a grouped leaderboard collapses repeat structures of the same protein, and a lookup box runs the same scoring on demand.",
      "views": [
        "scatter plot",
        "table view",
        "summary stats",
        "line chart",
        "bar chart",
        "heatmap",
        "image viewer",
        "detail panel",
        "list"
      ],
      "interactions": [
        "hover for detail",
        "select",
        "filter",
        "search",
        "sort",
        "toggle view",
        "zoom and pan",
        "export"
      ],
      "patterns": [
        "overview and detail",
        "dashboard",
        "linked views",
        "side-by-side comparison"
      ]
    },
    "field": {
      "text": "assessing protein structure predictions against experiment in structural biology",
      "disciplines": [
        "biology"
      ],
      "terms": [
        "structural biology",
        "structure prediction assessment",
        "protein structure"
      ]
    },
    "workflow": {
      "name": "check computed predictions against measured ground truth and flag confident misses",
      "steps": [
        {
          "step": "choose the batch to look at",
          "here": "A 'Jump to' menu switches between all structures, one release week or one archive deposit month, and the summary counts at the top update to match",
          "parts": [
            "period-dashboard"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "A scatter plots mean predicted confidence (pLDDT) against measured agreement (TM-score), with a shaded confidently-wrong box. Hovering a point previews its Cα-deviation ribbon and clicking it opens the structure. Next to it are metric histograms and a monthly trend",
          "parts": [
            "fraud-scatter"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "A text filter matches PDB id, UniProt, gene or description, two checkboxes keep only confidently-wrong or novel rows, and clicking a column header sorts by any metric",
          "parts": [
            "structures-table"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "The entry page shows per-residue deviation, lDDT and pLDDT tracks, a pLDDT-vs-lDDT calibration scatter, distance-difference and predicted-vs-observed error heatmaps, and a per-domain TM/RMSD table. The flat ribbon can be swapped for a rotatable 3D view with the predicted backbone overlaid as a 'ghost'",
          "parts": [
            "entry-detail",
            "ribbon-3d-viewer"
          ]
        },
        {
          "step": "summarize by group",
          "here": "A leaderboard puts the worst offenders first, one row per protein with a ×N count of its structures. Each row expands to show the individual depositions, and the list can be filtered",
          "parts": [
            "offender-leaderboard"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "A Calculate box autocompletes only to qualifying human entries, runs the full scoring for the chosen ID in the background, polls until it finishes, then injects the result panel",
          "parts": [
            "calculate-lookup"
          ]
        },
        {
          "step": "export the result",
          "here": "Every plot and table has a Download CSV button. Table exports keep only the rows the current filter shows",
          "parts": [
            "structures-table",
            "fraud-scatter"
          ]
        }
      ],
      "distinctive": [
        "A confidently-wrong flag combines the predictor's own confidence with measured error (mean pLDDT above 70 yet TM-score below 0.5), so honest low-confidence misses are kept apart from confident ones",
        "A confidence-weighted error score caps per-residue deviation and weights it by the predictor's per-residue confidence",
        "Only structures released after the predictor's training cutoff count, and a sequence-novelty score marks chains with no close pre-cutoff homolog",
        "Repeat structures of the same protein all share one prediction, so summaries collapse them per protein with a ×N count",
        "The predictor's self-reported pairwise error is set beside the observed error to check whether its confidence is honest"
      ]
    }
  },
