  "app": {
    "title": "联安智盾 (Lian'an Zhidun): federated learning backdoor attack and defense experiment platform",
    "summary": "A person sets up a simulated federated training run in a grouped form: clients and rounds, data partitioning, which backdoor attack the malicious clients use, and which client-side filter, server-side detector and robust aggregator defend against it. Before running, they can see the trigger the attack would add to a chosen training image. They start the run, or queue many runs from a JSON file, and watch accuracy, attack success rate and loss rise round by round alongside the live log. Finished runs land in a searchable history with final metrics, curves, detection statistics and files to download. Several runs can then be gathered into a named comparison summary with overlaid curves, a metrics table, and CSV, LaTeX and ZIP downloads.",
    "task": {
      "text": "Configure and run simulated attack-versus-defense experiments, then compare runs by clean accuracy and attack success rate.",
      "verbs": [
        "compare",
        "monitor",
        "plan",
        "derive",
        "summarize",
        "curate"
      ]
    },
    "data": {
      "text": "Experiment configurations and the per-round metric logs each simulated training run produces: global accuracy, attack success rate and loss, per-client anomaly scores and detection outcomes, plus sample images with triggers added.",
      "item": "one simulated federated training run with its configuration snapshot and per-round metrics",
      "shapes": [
        "table",
        "time series",
        "image",
        "events",
        "judgements",
        "versions"
      ]
    },
    "stage": {
      "text": "running and comparing simulated defense experiments, from configuration through to tables for a paper",
      "terms": [
        "analyze",
        "compare",
        "plan",
        "report"
      ]
    },
    "mechanism": {
      "text": "A grouped parameter form drives a trigger preview of a sample image and a launch panel that streams live round-by-round curves and logs over a websocket. A batch page queues many configurations with progress. Finished runs feed a searchable card grid with a detail modal and a summary builder, where the person picks runs to set side by side in overlaid curves and a table.",
      "views": [
        "form",
        "line chart",
        "image viewer",
        "side-by-side panes",
        "table view",
        "thumbnail grid",
        "detail panel",
        "summary stats",
