    "field": {
      "text": "backdoor attacks and robust aggregation defenses in federated learning",
      "disciplines": [
        "computer science"
      ],
      "terms": [
        "federated learning",
        "backdoor defense",
        "machine learning security"
      ]
    },
    "workflow": {
      "name": "configure, run and compare simulation experiments",
      "steps": [
        {
          "step": "set the parameters of a run",
          "here": "A form grouped into core, federated, attack, defense and management sections. Fields appear or hide depending on the chosen attack, detector or aggregator. A raw TOML editor and named backups support editing the configuration file directly and restoring an earlier version.",
          "parts": [
            "config-page",
            "config-backups"
          ]
        },
        {
          "step": "preview the effect of the chosen treatment on one sample",
          "here": "The original training image is shown next to the same image with the trigger added, along with its target label and the number of changed pixels. Distributed attacks also show one client's local trigger and the full trigger.",
          "parts": [
            "attack-preview"
          ]
        },
        {
          "step": "run it and watch progress live",
          "here": "Start or stop a named run. A progress bar counts rounds, and ACC/ASR and loss curves plus an ANSI-coloured log stream in over a websocket.",
          "parts": [
            "run-monitor"
          ]
        },
        {
          "step": "queue many runs and track the queue",
          "here": "Upload or edit a JSON list of experiments, re-parse it, then run it. Each item shows a status, progress across the whole batch and the current run's curves. The person can pause, resume, end only the current run or cancel the batch, and filter the list by status.",
          "parts": [
            "batch-queue"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Finished runs appear as cards with final ACC and ASR. They can be searched by name or UUID and paged, and opening one shows its curves, detection metrics, configuration snapshot, plots and files.",
          "parts": [
            "run-history"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Pick runs with a searchable checklist and name a summary. The summary overlays their ACC and ASR curves and lists their final metrics in a table.",
          "parts": [
            "summary-compare"
          ]
        },
        {
          "step": "export the result",
          "here": "Download a run's images or all its files as ZIP, or a summary's CSV, LaTeX table and ZIP.",
          "parts": [
            "run-history",
            "summary-compare"
          ]
        }
      ],
      "distinctive": [
        "Each run is judged on two opposing numbers: clean accuracy should stay high while attack success rate should fall to zero.",
        "Defenses stack in three layers (client data filter, server-side update detection, robust aggregation), each with its own parameters.",
        "Malicious clients are tracked as ground truth, so detection precision, recall, FPR and AUC can be computed every round.",
        "The trigger preview uses the same image transforms as training without sampling poison, so the person sees the attack before spending a run on it.",
        "The comparison exports a LaTeX table ready to paste into a paper."
      ]
    }
  },
