  "app": {
    "title": "Paper Fraud Dashboard",
    "summary": "A person uploads a paper's PDF, with optional data spreadsheets, or a single spreadsheet or figure image, and chooses whether to also run image forensics and an LLM review. The app runs a battery of automated statistical, textual and image checks and writes a report. The person reads an overall verdict, a risk score and count cards, then goes through the flagged signals by severity, each with its evidence and an instruction for what to check by hand. They zoom into image-forensic renderings and compare two figures with synced zoom, blink, difference and false-colour tools. They can also question the report in a chat, read an LLM's verdict on each signal, and download a draft public comment along with the full report as Markdown or JSON.",
    "task": {
      "text": "Screen a published paper with automated integrity checks, then have a person review each flagged signal and its evidence before writing up concerns.",
      "verbs": [
        "review",
        "identify",
        "triage",
        "compare",
        "summarize",
        "write"
      ]
    },
    "data": {
      "text": "A paper parsed into sections, tables and extracted figures, plus a report of automated check results. Each result has a severity level, a verdict, evidence excerpts, a confidence value and a note on whether a person needs to review it. Forensic renderings of each figure come with the report.",
      "item": "one automated check result (a signal) on a paper, or one extracted figure image",
      "shapes": [
        "document",
        "table",
        "image collection",
        "judgements",
        "notes",
        "categories"
      ]
    },
    "stage": {
      "text": "reviewing a published paper for integrity problems, before raising concerns publicly",
      "terms": [
        "review",
        "decide"
      ]
    },
    "mechanism": {
      "text": "A sidebar switches between an overview dashboard, pages of signals for each severity, an image-forensics viewer, a two-image comparison workbench, a chat about the report, and pages for the LLM review and export. In the image viewers, a box dragged on the reference figure crops every forensic rendering to the same region, and the comparison canvas zooms and pans both images together or blinks them in place.",
      "views": [
        "summary stats",
        "table view",
        "list",
        "detail panel",
        "image viewer",
        "side-by-side panes",
        "text editor",
        "form"
      ],
      "interactions": [
        "import",
        "select",
        "filter",
        "toggle view",
        "zoom and pan",
        "brush",
        "accept or reject",
        "export"
      ],
      "patterns": [
        "dashboard",
        "overview and detail",
        "linked views",
        "side-by-side comparison",
        "review queue"
      ]
    },
    "field": {
      "text": "statistical and image forensics for research integrity in biomedical papers",
      "disciplines": [
        "medicine"
      ],
      "terms": [
        "research integrity",
        "image forensics",
        "statistical forensics"
      ]
    },
    "workflow": {
      "name": "screen a document with automated checks and review the flagged signals",
      "steps": [
        {
          "step": "bring the data in",
          "here": "Upload a PDF with optional Excel/CSV data and tick 'extract images' or 'LLM review' with a provider. Alternatively, upload just a spreadsheet or one image, or open an existing report.json by path, by upload or from a list of scanned reports ranked by risk score.",
          "parts": [
            "landing-intake"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "An overall verdict banner, count cards for Red/Orange/Yellow/Green/Error, a 'needs human review' warning, and a table of every check with its level, verdict, confidence and review flag.",
          "parts": [
            "overview-dashboard"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Sidebar pages list only the Red, Orange or Yellow signals as expandable cards with verdict, confidence, up to ten evidence lines and a manual-check instruction.",
          "parts": [
            "signal-pages"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Choose LUT, ELA or clone output and pick a figure by page. Dragging a box on the reference image crops all the forensic panels to that region at pixel scale.",
          "parts": [
            "forensic-zoom"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "Choose two figures, or upload a second one, and switch between synced zoom/pan, blinking in place at a set speed, an amplified pixel-difference map with a threshold, and false-colour LUT presets.",
          "parts": [
            "comparison-workbench"
          ]
        },
        {
          "step": "write up the result",
          "here": "Ask the report questions in a chat. Read the LLM's overall assessment, its 0–10 suspicion score and a true or false-positive call per signal, then edit the generated PubPeer-style comment draft.",
          "parts": [
            "report-chat",
            "llm-review-export"
          ]
        },
        {
          "step": "export the result",
          "here": "Download the draft as text and the full report as Markdown or JSON.",
          "parts": [
            "llm-review-export"
          ]
        }
      ],
      "distinctive": [
        "Checks are graded on a fixed severity scale (red, orange, yellow, green, error) and combined into a weighted risk score. Each signal carries a confidence value and a flag saying whether a person must review it.",
        "Image-forensic checks never return a verdict. They only produce LUT, ELA and clone renderings for a person to judge by eye.",
        "Figures are compared by blinking them in place and by pixel subtraction, so splices and duplicated panels stand out.",
        "Candidate fraud patterns that an LLM pulled from crawled post-publication discussions are approved or rejected one at a time. Approved ones are written into YAML rule files that later screenings load.",
        "An LLM second pass labels each flagged signal a true or false positive and drafts a public comment that cites the evidence."
      ]
    }
  },
