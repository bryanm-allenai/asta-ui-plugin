  "app": {
    "title": "EvoVis (ENAS run dashboard)",
    "summary": "The person starts the dashboard on the results folder of an evolutionary search run. They read the run's settings as grouped cards, then open the search space as a graph and click a building block to see its parameters and how often it was used in each generation. On the family tree they pick a span of generations and one candidate, follow its parents and offspring, and click any node to read that candidate's fitness, measured metrics and encoded structure. They finish on the results page, with run progress, healthy and failed counts, mean metrics across generations, a trade-off scatter between objectives and the fittest candidate of every generation.",
    "task": {
      "text": "Understand how an evolutionary search run progressed: what it searched over, how its candidates descend from one another, and how their performance changed across generations.",
      "verbs": [
        "explore",
        "summarize",
        "monitor",
        "compare",
        "lookup"
      ]
    },
    "data": {
      "text": "The output folder of an evolutionary optimisation run: a settings file, a graph of allowed building blocks and the transitions between them, a crossover log of parents and offspring, and for each generation each candidate's encoded structure and measured results.",
      "item": "one candidate (individual) in one generation, with its gene sequence, fitness and measured metrics",
      "shapes": [
        "network",
        "sequence",
        "time series",
        "table",
        "categories"
      ]
    },
    "stage": {
      "text": "analysing an evolutionary search run, during or after it, before choosing an architecture or retuning the search",
      "terms": [
        "analyze",
        "explore"
      ]
    },
    "mechanism": {
      "text": "Four pages are reached from icon buttons in a top bar. On the two graph pages, clicking a node in a network diagram fills a detail panel beside it, and on the family tree a three-handle generation slider and an individual dropdown decide which part of the lineage is drawn. The results page is a static dashboard of summary cards, line charts of per-generation mean and spread, a scatter of objectives and a strip of the fittest chromosomes.",
      "views": [
        "network diagram",
        "detail panel",
        "line chart",
        "scatter plot",
        "bar chart",
        "summary stats",
        "sequence track"
      ],
      "interactions": [
        "select",
        "hover for detail",
        "time slider",
        "zoom and pan",
        "toggle view"
      ],
      "patterns": [
        "master-detail",
        "linked views",
        "dashboard",
        "overview and detail"
      ]
    },
    "field": {
      "text": "evolutionary neural architecture search in machine learning",
      "disciplines": [
        "computer science"
      ],
      "terms": [
        "neural architecture search",
        "evolutionary algorithms",
        "multi objective optimization"
      ]
    },
    "workflow": {
      "name": "trace the lineage and performance of an evolutionary run across generations",
      "steps": [
        {
          "step": "bring the data in",
          "here": "The run results folder is given on the command line; each page checks its files and shows a red warning naming whatever is missing or malformed.",
          "parts": [
            "navbar"
          ]
        },
        {
          "step": "read the settings the run was configured with",
          "here": "Hyperparameters from the config file appear as icon cards grouped by their declared group, each with a tooltip giving its description.",
          "parts": [
            "parameters-overview"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "The search space is drawn as a graph of layer types grouped by stage. Clicking a gene highlights it and its edges and shows its parameter ranges, its total count and a bar chart of how many times it appears in each generation.",
          "parts": [
            "gene-pool-graph",
            "gene-detail"
          ]
        },
        {
          "step": "follow how items descend from one another",
          "here": "A three-handle slider sets the earliest generation, the focus generation and the latest generation. A dropdown lists the focus generation's individuals, and the crossover family tree for that range is drawn breadth-first with crossover points on the edges.",
          "parts": [
            "family-tree"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Clicking a node or choosing from the dropdown shows that individual's fitness bar, each metric as a bar scaled to the run's min and max, its chromosome as hoverable gene badges, and notices if it went extinct or failed to train.",
          "parts": [
            "individual-panel"
          ]
        },
        {
          "step": "track progress toward a target or a total",
          "here": "Generations processed are shown against the configured total, with counts of healthy and errored individuals, fitness and each flagged metric as mean ± standard deviation per generation, and a scatter of two or three objectives to find trade-offs.",
          "parts": [
            "run-results-plots"
          ]
        },
        {
          "step": "compare items side by side",
          "here": "A second tab lines up the fittest individual of every generation as a column of colour-coded gene badges, with its results in a tooltip.",
          "parts": [
            "fittest-individuals"
          ]
        }
      ],
      "distinctive": [
        "Candidates are genealogical: the family tree is built from a crossover log, so lineage can be followed from parents to offspring with the crossover point on each link",
        "The structure each candidate is encoded in is itself a graph of allowed transitions, drawn so the person can see what the search could have produced",
        "A three-handle slider sets a focus generation and how far back and forward the tree reaches",
        "Candidates whose training errored are counted separately and left out of every aggregate",
        "Several objectives are plotted against each other, with a third mapped to colour, to find Pareto trade-offs"
      ]
    }
  },
