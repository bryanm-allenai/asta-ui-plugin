  "app": {
    "title": "ConText (powered by Conc)",
    "summary": "The person picks a corpus and a reference corpus from those already built on disk. The first screen shows information about both corpora and a paged table of keywords that are unusually frequent in the corpus compared with the reference corpus; the person can switch it to raw frequencies. Clicking a word, or typing a search term and choosing a sort order for the context words, opens a keyword-in-context concordance. Next to it is a panel of clusters or collocates, and the concordance can be switched to a plot of where each hit falls in its text. Clicking a hit, a cluster or a line in the plot opens that text with the match highlighted next to its metadata, so every count leads back to the text it came from.",
    "task": {
      "text": "Find the words that set a corpus apart from a reference corpus, then follow any word or phrase into every place it is used and read it in its full text.",
      "verbs": [
        "explore",
        "locate",
        "summarize",
        "derive",
        "compare"
      ]
    },
    "data": {
      "text": "A tokenised corpus of plain-text documents with per-document metadata, compared with a second reference corpus (a full corpus or a list of word frequencies).",
      "item": "a document in a corpus, and each occurrence of a word or phrase inside it",
      "shapes": [
        "text corpus",
        "sequence",
        "table"
      ]
    },
    "stage": {
      "text": "exploring a built corpus against a reference corpus, before interpreting what the texts say",
      "terms": [
        "explore",
        "analyze"
      ]
    },
    "mechanism": {
      "text": "Each table is paged and built on the server. Words in the keyword, frequency and cluster tables are links that load a concordance query into the main area. Concordance hits and lines in the concordance plot load the full text into the left pane, scrolled to the highlighted match, so each step goes from a count down to a passage.",
      "views": [
        "table view",
        "summary stats",
        "document reader",
        "strip plot",
        "side-by-side panes",
        "form"
      ],
      "interactions": [
        "search",
        "sort",
        "select",
        "toggle view",
        "keyboard shortcuts",
        "import"
      ],
      "patterns": [
        "overview and detail",
        "linked views",
        "master-detail"
      ]
    },
    "field": {
      "text": "keyness, concordance and collocation analysis in corpus linguistics",
      "disciplines": [
        "linguistics"
      ],
      "terms": [
        "corpus linguistics",
        "concordancing",
        "keyness"
      ]
    },
    "workflow": {
      "name": "find distinctive terms in a collection of texts and read each use in context",
      "steps": [
        {
          "step": "bring the data in",
          "here": "The Settings panel offers two dropdowns of the corpora built on disk, one for the corpus and one for the reference corpus. Changing either one reloads the corpus details in the header and the information panel.",
          "parts": [
            "corpus-settings",
            "corpus-info"
          ]
        },
        {
          "step": "compute a value from the data",
          "here": "A paged Keywords table ranks tokens by how much more often they appear in the corpus than in the reference corpus, with document frequency shown. The Reports menu switches it to plain Frequencies.",
          "parts": [
            "keywords-table"
          ]
        },
        {
          "step": "filter to the items that matter",
          "here": "Clicking a keyword, or typing a term in the header search box (F2 focuses it), runs a query. The order dropdown sets how the hits are sorted by the words to their left or right (1R2R3R, 1L2L3L, and so on).",
          "parts": [
            "search-form",
            "keywords-table"
          ]
        },
        {
          "step": "look over every item at a glance",
          "here": "A keyword-in-context concordance lists each hit as document id, left context, node and right context, page by page. It can be switched to a concordance plot that marks where each hit falls in each text.",
          "parts": [
            "concordance",
            "concordance-plot"
          ]
        },
        {
          "step": "summarize the patterns around the term",
          "here": "The left pane lists the n-gram clusters around the term, with their side set by the sort order, and can switch to collocates. Clicking a cluster runs a new, narrower query on that phrase.",
          "parts": [
            "clusters-collocates"
          ]
        },
        {
          "step": "open one item in detail",
          "here": "Clicking a node in the concordance, or a line in the plot, opens the full text in the left pane with its metadata table. The text scrolls to the highlighted match.",
          "parts": [
            "text-reader",
            "concordance",
            "concordance-plot"
          ]
        }
      ],
      "distinctive": [
        "Keyness is always computed against a chosen reference corpus. The reference can be swapped at any time, and it can be a list of word frequencies instead of full texts.",
        "The sort order of the concordance (by context words to the right, to the left, or around the node) also decides whether the clusters are built to the left, to the right or in the middle.",
        "Every number links back to the passages it counts: keyword to concordance, concordance to the full text with the match highlighted.",
        "A concordance plot shows where each hit falls along each text, and clicking a mark opens the text at that position."
      ]
    }
  },
